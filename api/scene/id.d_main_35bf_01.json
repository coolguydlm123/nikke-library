{"id":"d_main_35bf_01","cat":"main","group":{"id":"ch35","label":"Chapter 35 · Conversation"},"label":"I Am Me","stage":null,"prev":null,"next":"d_main_35bf_02","speakers":{"rapi_red":"Rapi","ingrid":"Ingrid","anis":"Anis","neon":"Neon"},"icons":{"rapi_red":"si_c016_00_s","ingrid":"si_c900_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_35bf_01_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_35bf_01_1","text":"Elysion Headquarters. Research Lab.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_story_fairytalesend_a","movie":null,"shown":["rapi_red","ingrid","anis","neon"],"affinity":null},{"id":"d_main_35bf_01_2","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_2","text":"Is there anything unusual?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_3","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_3","text":"Yes, it's full of peculiarities. I don't even know where to start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_4","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_4","text":"First of all,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_5","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_5","text":"the faint amount of energy that remained in the core has vanished. It's fair to say that it has completely merged with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_6","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_6","text":"As for your body...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_7","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_7","text":"Even though it was manufactured using technology from Elysion, we can no longer consider it Elysion's creation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_01_8","text":"What does that even mean? In what world does that statement make sense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_01_9","text":"Wow, Boss, I'm impressed that even in a situation like this, you can still crack jokes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_10","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_10","text":"Be quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_01_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_01_12","text":"... Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_13","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_13","text":"A significant portion of the tactical upgrade OS that Eunhwa gave you has been implemented.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_14","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_14","text":"It includes an equilibrium system for use in high-mobility combat as well as comprehensive durability and other physical enhancements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_15","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_15","text":"It's also reconfigured your ability to transform into Red Hood and made it an expansive armament that can be toggled on and off at will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_01_16","text":"Huh? Expansive armament?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_01_17","text":"Isn't that what Dorothy used to have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_18","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_18","text":"Correct, you're on the mark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_01_19","text":"So does that mean she's got a secret weapon hiding in there somewhere?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_20","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_20","text":"I doubt it. The purpose was to allow me to switch back and forth between Red Hood more easily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_21","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_21","text":"Precisely. It was designed to transfer all of the feedback registered while you're Red Hood and reroute it to the expansive armament.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_22","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_22","text":"Should there be a situation where you're unable to transform into Red Hood, the armament will be useless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_01_23","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_24","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_24","text":"Let me get back to discussing Rapi's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_25","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_25","text":"In terms of hard specs, it's the epitome of Elysion's tactical technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_26","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_26","text":"However, we've been unable to identify precisely what it's made out of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_27","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_01_27","text":"Do you have any guesses?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_28","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_28","text":"None whatsoever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_29","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_29","text":"Although it was built according to our blueprints, the material remains a complete mystery to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_30","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_30","text":"What's certain is that it's not something the Ark is ready for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_31","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_31","text":"The very notion of transformation defies all common sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_32","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_32","text":"However, seemingly preposterous events often have preposterous causes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_33","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_33","text":"Finding out those causes will be our next goal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_34","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_34","text":"Commander, this means...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_35","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_01_35","text":"Yes. There are two major possibilities:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_01_36","text":"Dark Matter or A Pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_37","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_37","text":"Our leading hypothesis for the Dark Matter is that it's some kind of liquid metal,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_38","text":"and the A Pillar is capable of constructing foundational materials for an imitation Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_39","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_39","text":"Either of them would be worthy materials for crafting something new.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_40","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_40","text":"Does anything about it feel unnatural to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_41","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_41","text":"No, it feels completely natural. Like this is the body I've always had.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_42","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_42","text":"No sense of discomfort?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_43","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_43","text":"None.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_44","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_44","text":"Are you sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_46","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_46","text":"Instructor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_47","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_47","text":"Regardless of what I am made of, I am still me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_01_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_49","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_01_49","text":"Wow, so cool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_50","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_50","text":"Very good. I'm satisfied with that answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_51","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_51","text":"Then lastly, that weapon of yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_52","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_52","text":"Seven Dwarves Zero, was it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_53","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_53","text":"It's completely outlandish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_54","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_54","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_55","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_55","text":"Not only is it equipped with propulsion engines which allow unparalleled mobility during combat,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_56","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_56","text":"it's also capable of using both standard rounds and grenades simultaneously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_57","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_57","text":"It can also generate a drill bit-shaped electromagnetic field which is capable of decisively ending just about any encounter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_58","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_58","text":"Whoever designed this used the kitchen sink approach, adding in anything and everything they thought was cool, and the result is a weapon that's cartoonish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_59","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_59","text":"From a tactical perspective, to call it a dumpster fire would be doing a disservice to dumpsters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_60","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_61","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_61","text":"However.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_62","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_62","text":"If we consider the possibility that it was manufactured as a custom weapon for someone special,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_63","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_63","text":"then it can be viewed as possessing unparalleled craftsmanship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_64","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_64","text":"It won't operate at full capacity unless wielded by the person it was crafted for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_65","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_01_65","text":"A personalized weapon, essentially.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_01_66","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_01_66","text":"...","jump":null,"exit":fa