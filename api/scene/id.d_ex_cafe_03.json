_cafe_03_28","text":"That's why I'm having someone come in to help you guys.\nThey run one of the most famous cafes in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_03_29","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_03_29","text":"Who the hell do you think you are?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_03_30","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_03_30","text":"You're just a customer, so act like it! Shut up, drink your coffee, and get the hell out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_03_31","type":"Speech","speaker":"belorta","key":"Locale_SuddenStory:d_ex_cafe_03_31","text":"You could at least hear what she has to say. I've already called her, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_03_32","type":"Speech","speaker":"belorta","key":"Locale_SuddenStory:d_ex_cafe_03_32","text":"Who knows, her advice could be a boon for business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_03_33","type":"Speech","speaker":"belorta","key":"Locale_SuddenStory:d_ex_cafe_03_33","text":"Speaking of which, I think that might be her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_03_34","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_03_34","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null}