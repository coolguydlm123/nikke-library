,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_04_e_26","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_04_e_26","text":"Good. Let's get ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_04_e_27","type":"Speech","speaker":"folkwang","key":"Locale_SubScenario:event_lifeagain_04_e_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_04_e_28","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_04_e_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_04_e_29","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_04_e_29","text":"Phew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_04_e_30","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_04_e_30","text":"Don't worry. You're not the one running. The avatar is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_04_e_31","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_04_e_31","text":"Your legs won't get cramps. Your body isn't going to freeze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_04_e_32","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_04_e_32","text":"You think I don't know that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affini