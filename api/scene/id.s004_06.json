{"id":"s004_06","cat":"side","group":{"id":"side4","label":"EDEN SPEAR"},"label":"EDEN SPEAR: 6","stage":null,"prev":"s004_05","next":"s004_07","speakers":{"harran":"Harran","johan":"Johan","isabel":"Isabel","nayuta_n":"Nayuta","noah":"Noah","papillon":"Papillon"},"icons":{"harran":"si_c230_00_s","johan":"si_c925_00_s","isabel":"si_c231_00_s","nayuta_n":"si_c9008_00_s","noah":"si_c232_00_s","papillon":"si_c890_00_s"},"lines":[{"id":"s004_06_1","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_1","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_chapter40_field_turningpoint","movie":null,"shown":["johan","nayuta_n","harran","isabel","noah"],"affinity":null},{"id":"s004_06_2","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_2","text":"The lab door opens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_3","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_3","text":"Nayuta looks at Harran, Isabel, and Noah standing in the doorway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_4","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_4","text":"I heard Monk's here, but I never thought it'd actually be true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_5","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_06_5","text":"It is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_6","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_6","text":"Long time no see, Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_7","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_7","text":"Oh. Dost thou recall this humble one? It is a great honor, for our meeting was but brief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_8","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_8","text":"Well, I did see you get crushed to death by a rock,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_9","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_9","text":"then show up the next day as if nothing happened. Hard to forget that, you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_10","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_10","text":"Haha... Since then, ne'er have I ventured near that rocky mountain, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_11","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_11","text":"So, what's this about? I take it you're not here on a social call.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_12","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_12","text":"Young Hero Johan and Young Lady Cecil sought mine meager knowledge, so I did forsake all else and hastened hither.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_13","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_13","text":"It must have something to do with Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_14","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_14","text":"Indeed, 'tis so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_15","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_15","text":"So, it went well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_16","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_16","text":"'Tis too soon to say for sure, but it fares well enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_17","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_17","text":"All right, I'm counting on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_18","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_18","text":"Thanks for handing over such precious information at the price of some of your lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_19","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_19","text":"You flatter me. Thanks to that, I have had the opportunity to behold Eden, so the matter is hardly unpleasant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_20","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_20","text":"Hmm, so this is the monk you kept running into when I wasn't around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_21","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_21","text":"The one who... never dies or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_22","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_22","text":"Heh, she looks pretty dumb.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_23","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_23","text":"No being in this world is spared from death, Young Lady Noah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_24","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_24","text":"But I heard you come back to life no matter how many times you die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_25","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_25","text":"That's basically cheating death, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_26","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_26","text":"To die is indeed to die; Reviving is no true return to life, so it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_27","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_27","text":"I have no idea what you're talking about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_28","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_28","text":"Can you do a demo for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_29","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_29","text":"Surely thou dost not mean to ask if thou mayest take this humble one's life?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_30","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_30","text":"Yep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_31","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_31","text":"Young Hero Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_32","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_06_32","text":"What now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_33","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_33","text":"Thy teaching doth verily bear fruit. Thou must be filled with great pride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_34","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_06_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_35","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_35","text":"Huh? What nonsense are you babbling about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_36","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_36","text":"Haha. 'Tis but nothing of consequence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_37","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_37","text":"Let us contemplate the notion of mine demise at a more suitable time. If thou wouldst excuse me for a moment,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_38","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_06_38","text":"Young Hero Johan hath graciously offered to show me Eden arm-in-arm, and such a generous offer I shall not refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_39","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_06_39","text":"We're not going arm-in-arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_40","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_40","text":"Hmph. Fine, whatever. Do as you like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_41","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_41","text":"But are you sure it's okay to just show her Eden like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_42","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_06_42","text":"... Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_43","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_06_43","text":"We'll start from the lower levels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_44","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_44","text":"Johan and Nayuta walk away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_45","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_06_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_46","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_47","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_48","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_48","text":"Suddenly, there are an awful lot of guests in Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_49","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_49","text":"Yeah, and these aren't just ordinary folks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_50","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_50","text":"A Heretic, then a Pioneer... Only big shots, the lot of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_51","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_51","text":"There's also Papillon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_52","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_52","text":"It seems you're rather concerned about Papillon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_53","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_53","text":"I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_54","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_06_54","text":"There's little she can do. Don't come down on her so harshly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_55","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_56","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_56","text":"I guess so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s004_06_57","type":"Speech","speaker":"isabel","key":"Locale_SideStory:s004_06_57","text":"I hope I'm just being paranoid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_58","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_58","text":"*Yawwwn*","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":"bgm_chapter32_field_advance","movie":null,"shown":["papillon"],"affinity":null},{"id":"s004_06_59","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_59","text":"Man... being a hostage is no joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_60","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_60","text":"Even if I wanted to steal something, everything is locked behind some kind of authentication.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_61","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_61","text":"I doubt a place this advanced would leave sensitive info written down on paper anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_62","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_62","text":"I can't even turn this tablet on since it's locked with a password.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_63","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_63","text":"Guess I'll just have to memorize as much as I can before heading back...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_64","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_65","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_65","text":"Not sure if I'll ever get out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_66","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_66","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_67","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_67","text":"Might as well take a nap. A little sleep never hurt anybody.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_68","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_68","text":"Papillon throws herself onto the bed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_69","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_69","text":"She opens her eyes and stares at the ceiling for a while. Just then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_70","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_70","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_71","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_71","text":"Her phone rings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_72","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_72","text":"Ugh... I always get a message right when I'm about to sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_73","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_73","text":"Who in the world has such impeccable timing...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_74","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_75","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_75","text":"A message? Here, of all places?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_76","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_76","text":"Papillon picks up her phone and looks at the screen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_77","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_78","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_78","text":"Papillon stares at her phone, which is now in sleep mode.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_79","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_79","text":"Her reflection appears on the black screen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_80","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_80","text":"A smirk tugs at her lips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_81","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_81","text":"... I knew it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_82","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_06_82","text":"I'm always great at picking the right side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_06_83","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_06_83","text":"Papillon walks briskly toward the tablet on the desk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}