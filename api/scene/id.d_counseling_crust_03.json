{"id":"d_counseling_crust_03","cat":"counsel","group":{"id":"char5136","label":"Crust"},"label":"Advising Crust: 03","stage":null,"prev":"d_counseling_crust_02","next":"d_counseling_crust_04","speakers":{"crust":"Crust"},"icons":{"crust":"si_c521_00_s"},"lines":[{"id":"d_counseling_crust_03_1","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_1","text":"I discovered some interesting ingredients recently, and I've been looking into them.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["crust"],"affinity":"_0"},{"id":"d_counseling_crust_03_2","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_2","text":"Unfortunately, my shooting schedule fell behind because of all the time I dedicated to research, and now I'm playing catch-up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_3","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_3","text":"There's just not enough time in the day!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_4","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_4","text":"Now I know what it's like to have to juggle two jobs at once...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_crust_03_5","text":"But doesn't it feel rewarding in a way?","jump":"d_counseling_crust_03_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_crust_03_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_crust_03_6","text":"Now you know how I feel.","jump":"d_counseling_crust_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_crust_03_7","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_crust_03_7","text":"It's precisely that feeling which motivates me to work as hard as I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_8","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_8","text":"Now that I think about it, you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_9","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_9","text":"It does feel rewarding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_10","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_10","text":"Whenever I research new ingredients and feature them on the show, a lot of people get to try it and feel happy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_11","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_11","text":"Hehe, just thinking about that is giving me a second wind! Thank you, Mr. Gourmand.","jump":"d_counseling_crust_03_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_12","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_12","text":"Are you in the same situation too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_13","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_13","text":"I don't know how much longer I can keep this up. I'm liable to collapse soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_14","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_03_14","text":"Well... let's hang in there, Mr. Gourmand.","jump":"d_counseling_crust_03_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_03_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_crust_03_15","text":"Crust and I talk about her professional struggles.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}