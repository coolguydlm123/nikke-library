rshmallow again!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_07_14","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_07_14","text":"Thanks for the tip, Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_07_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_poli_07_15","text":"I talk with Poli, who really does look like a marshmallow.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}