{"id":"d_counseling_poli_07","cat":"counsel","group":{"id":"char5016","label":"Poli"},"label":"Advising Poli: 07","stage":null,"prev":"d_counseling_poli_06","next":"d_counseling_poli_08","speakers":{"poli":"Poli"},"icons":{"poli":"si_c030_00_s"},"lines":[{"id":"d_counseling_poli_07_1","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_07_1","text":"A few days ago, a kid said I look like a marshmallow!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["poli"],"affinity":"_0"},{"id":"d_counseling_poli_07_2","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_07_2","text":"The nerve of that brat! Argh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_07_3","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_07_3","text":"Grr... I'm furious. Why in the world would he say that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_07_4","text":"Because of your fluffy hair?","jump":"d_counseling_poli_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_poli_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_07_5","text":"Because of your chipmunk cheeks?","jump":"d_counseling_poli_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_poli_07_6","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_07_6","text":"Hmm... Okay, fair enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":