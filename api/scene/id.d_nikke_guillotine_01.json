{"id":"d_nikke_guillotine_01","cat":"bond","group":{"id":"char5031","label":"Guillotine"},"label":"Guardian of Balance","stage":null,"prev":null,"next":"d_nikke_guillotine_02","speakers":{"exia":"Exia"},"icons":{"exia":"si_c210_00_s"},"lines":[{"id":"d_nikke_guillotine_01_1","type":"Speech","speaker":"exia","key":"Locale_NikkeEpisode:d_nikke_guillotine_01_1","text":"I am but an observer of the world.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":"bgm_story_languor","movie":null,"shown":["exia"],"affinity":null},{"id":"d_nikke_guillotine_01_2","type":"Speech","speaker":"exia","key":"Locale_NikkeEpisode:d_nikke_guillotine_01_2","text":"This is both my fate, and my destiny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_01_3","type":"Speech","speaker":"exia","key":"Locale_NikkeEpisode:d_nikke_guillotine_01_3","text":"Today I find myself gazing upon the people, and what do I see? A writhing throng of insects, squirming about as they gnaw away at this solitary thing we call joy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_01_4","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_01_4","text":"What on earth are you on about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_01_5","type":"Speech","speaker":"exia","key":"Locale_NikkeEpisode:d_nikke_guillotine_01_5","text":"Oh, I didn't come up with that myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_01_6","type":"Speech","speaker":"exia","key":"Locale_NikkeEpisode:d_nikke_guillotine_01_6","text":"I got it from this articl