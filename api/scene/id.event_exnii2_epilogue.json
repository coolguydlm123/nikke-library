_exnii2_epilogue_37","text":"As she says that, Helm smiles at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_38","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii2_epilogue_38","text":"We also installed the latest steam medical unit on the Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_39","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii2_epilogue_39","text":"It seems to be even more effective than expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_40","type":"Self","speaker":null,"key":"Locale_SubScenario:event_exnii2_epilogue_40","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_41","type":"Self","speaker":null,"key":"Locale_SubScenario:event_exnii2_epilogue_41","text":"It's working surprisingly well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_42","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii2_epilogue_42","text":"I never realized how comforting the sea breeze could be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_43","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii2_epilogue_43","text":"Hey, Subordinate. Would it be okay if we stayed like this for just a little longer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinit