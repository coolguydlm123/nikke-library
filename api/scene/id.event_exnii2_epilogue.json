:null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_25","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_exnii2_epilogue_25","text":"Obviously, I'd train my firepower!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_26","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_exnii2_epilogue_26","text":"The firepower I witnessed in this last battle was unforgettable! I need to train harder and sharpen my skills!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["laplace","drake"],"affinity":null},{"id":"event_exnii2_epilogue_27","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_exnii2_epilogue_27","text":"That's a great mindset! Then how about you join me in hero training?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["maxwell"],"affinity":null},{"id":"event_exnii2_epilogue_28","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_exnii2_epilogue_28","text":"First, I'll teach you how to break windows properly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_29","type":"Speech","speaker":"drake","key":"Locale_SubScenario:event_exnii2_epilogue_29","text":"Windows aren't meant to be broken! Spare a thought for the people who have to fix them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii2_epilogue_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_exnii2_epilogue_30","text":"Everyone really worked hard this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":