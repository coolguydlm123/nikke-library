_6","text":"In order to send a message, I usually take care of these things personally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_02_7","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_02_7","text":"Once we're done here, I'll take care of this latest mole we found.","jump":"d_counseling_rosanna_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_02_8","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_02_8","text":"Lonely?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_02_9","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_02_9","text":"I'm with you, Mister. Why would I be lonesome?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_02_10","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_02_10","text":"We usually weed out these moles before I have time to get emotionally attached to them anyway.","jump":"d_counseling_rosanna_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_02_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_rosanna_02_11","text":"During our session, Rosanna and I talk about traitors.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}