{"id":"d_counseling_admi_09","cat":"counsel","group":{"id":"char5030","label":"Admi"},"label":"Advising Admi: 09","stage":null,"prev":"d_counseling_admi_08","next":"d_counseling_admi_10","speakers":{"admi":"Admi"},"icons":{"admi":"si_c172_00_s"},"lines":[{"id":"d_counseling_admi_09_1","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_09_1","text":"Commander, where do you go when you want to relax and unwind?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["admi"],"affinity":"_0"},{"id":"d_counseling_admi_09_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_09_2","text":"Downtown, somewhere crowded.","jump":"d_counseling_admi_09_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_admi_09_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_09_3","text":"A park without too many people.","jump":"d_counseling_admi_09_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_admi_09_4","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_09_4","text":"Ah... You like places with a lot of people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_09_5","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_09_5","text":"When I go to crowded places, I get tired very quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_09_6","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_09_6","text":"But there are plenty of things to keep you entertained downtown. Maybe, that's why you like it.","jump":"d_counseling_admi_09_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_09_7","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_09_7","text":"I also enjoy quiet places with very few people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_09_8","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_09_8","text":"I feel at peace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_09_9","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_09_9","text":"Perhaps, when I want to relax, I'll go to the same place as you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_09_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_admi_09_10","text":"I have a conversation with Admi about places to relax.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}