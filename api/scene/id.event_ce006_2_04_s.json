{"id":"event_ce006_2_04_s","cat":"event","group":{"id":"ev40080","label":"MEMORIES TELLER · Part 2"},"label":"Something Precious and Always Present: A","stage":null,"prev":"event_ce006_2_intermission_01","next":"event_ce006_2_04_e","speakers":{"elegg":"Elegg","neon":"Neon","ce006_03":"Lily","anis":"Anis","privaty":"Privaty","rapi":"Rapi","ce006_01":"EVE","roam":"Roam"},"icons":{"elegg":"si_c500_00_s","neon":"si_c011_00_s","ce006_03":"si_c852_00_s","anis":"si_c012_00_s","privaty":"si_c170_00_s","rapi":"si_c010_00_s","ce006_01":"si_c850_00_s","roam":"si_c931_00_s"},"lines":[{"id":"event_ce006_2_04_s_1","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_1","text":"As you can see, there are a lot of storage terminals here, and they're huge.","jump":null,"exit":false,"enter":null,"bg":"bunkerofartist","bgArt":"bunkerofartist","image":null,"bgm":"collab_bgm_sb_hallofrecords","movie":null,"shown":["anis","neon","elegg","ce006_03","privaty"],"affinity":null},{"id":"event_ce006_2_04_s_2","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_2","text":"It'd be next to impossible to haul them all out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_3","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_3","text":"What we need is","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_4","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_4","text":"a singular hard disk on which we can store all of their data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_5","text":"You'd need an awfully big hard disk","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_6","text":"to store all the information contained in these terminals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_7","text":"Does a hard disk that big even exist?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_8","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_04_s_8","text":"I doubt it'd be that big, actually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_9","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_04_s_9","text":"Storage media is one of the fastest-evolving technologies there is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_10","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_04_s_10","text":"We might be able to save everything in a device small enough to fit in the palm of your hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_11","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_04_s_11","text":"Uh... at least that'd be the case in our world. I assume it's not too different here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_12","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_12","text":"That's a good point. The data here is all quite old.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_13","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_13","text":"What was considered large-format isn't all that big by today's standards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_14","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_14","text":"If we use the latest storage technology available to us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_15","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_04_s_15","text":"Elegg takes out her smartphone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_16","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_16","text":"It might all fit in here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_17","text":"Huh? Aren't you being a little dramatic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_18","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_18","text":"No exaggeration here, just the truth! Storage compression and media technology advance at an incredible pace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_04_s_19","text":"No kidding... well then, this should be a breeze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_20","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_20","text":"There is one problem, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_21","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_21","text":"The storage terminals here are so old, they're not compatible with those currently found in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_22","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_22","text":"We don't have any way to transfer it to our phones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_23","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_04_s_23","text":"So what should we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_24","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_24","text":"It's simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_25","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_25","text":"We just need to find the most advanced storage device that's compatible with the ones here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_26","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_04_s_26","text":"This is the data center Privaty told us about.","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":null,"movie":null,"shown":["ce006_01","roam","rapi"],"affinity":null},{"id":"event_ce006_2_04_s_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_04_s_27","text":"I can tell all the way from here that the place is crawling with Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_28","text":"The floor and walls have deteriorated severely. If any of the upper floors collapse, they'll fall straight down to the first floor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_04_s_29","text":"Nice, a shortcut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_04_s_30","text":"This place looks pretty dangerous. Do we really have to be that in-depth with our search?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_04_s_31","text":"I don't think we have much of a choice. We all saw that image Elegg sent us. Let's try and find something that matches it as closely as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_32","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_32","text":"Do you think we'll find something as soon as we enter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_33","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_04_s_33","text":"Probably not. These things tend to be on the upper floors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_34","text":"I know, right? That does always seem to be the case for some reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_35","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_04_s_35","text":"Let's hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_36","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_04_s_36","text":"... Tell me again why you had to come with us, Roam?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_37","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_04_s_37","text":"Roam is a transport robot. I am good at transporting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_38","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_04_s_38","text":"This place might contain good artifacts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_39","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_04_s_39","text":"Artifacts that will help with the construction of the second Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_40","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_04_s_40","text":"You're quite industrious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_41","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_04_s_41","text":"Always.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_42","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_04_s_42","text":"Okay, but stay behind us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_43","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_04_s_43","text":"Okay. I am good at hiding and running away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_44","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_04_s_44","text":"Let's head in, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_45","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_04_s_45","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_46","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_04_s_46","text":"Our goal is to find a high-capacity storage device that is compatible with those in the bunker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_04_s_47","text":"Oooh, I think I may have found something.","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":null,"movie":null,"shown":["elegg","ce006_03"],"affinity":null},{"id":"event_ce006_2_04_s_48","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_48","text":"Yeah? Show us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_49","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_04_s_49","text":"Hmm, no, that won't work. Two of the pins are missing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_04_s_50","text":"Ugh. These cables all look identical to me. They're hard to tell apart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_51","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_51","text":"How about this? It looks right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_52","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_04_s_52","text":"It looks similar, but it's a little small.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_53","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_04_s_53","text":"It might still be useful though, so bring it back with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_54","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_04_s_54","text":"Woohoo! I contributed more than Anis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_55","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_04_s_55","text":"... Well, bully for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_56","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_04_s_56","text":"My eyes are tired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_04_s_57","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_04_s_57","text":"It's not surprising, considering how intently we're scrutinizing these cables.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie"