"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_7","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_7","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_8","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_8","text":"To ensure their safety, I attached tracking chips to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_9","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_9","text":"Très bien.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_10","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_10","text":"I investigated les animaux rights l'organisation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_11","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_11","text":"Most of the complaints you've been receiving about the big animaux at the shelter","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_12","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_12","text":"were from animaux rights l'organisation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_13","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_13","text":"So what are you saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_14","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_14","text":"They lied in order to try and expel les animaux from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_15","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_15","text":"I also heard that you received orders to take a vacation. Is that true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_16","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_16","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_17","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_17","text":"It would appear their plan was to spirit the animals away when the shelter was unstaffed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_18","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_18","text":"Fortunately, you all had désigné someone to look after the shelter in your stead, and the animals were kept safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_19","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_19","text":"When that part of their plan failed, they decided instead to extend the closure of the shelter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_20","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_20","text":"So, with that in mind, I must ask you, Leona:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_21","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_21","text":"Did you know about all this when you hatched your scheme to release les animaux?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_22","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_23","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_23","text":"Whether I did or did not know is of no importance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_24","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_24","text":"I would have acted the same regardless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_25","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_25","text":"So you're saying that you acted on behalf of their happiness, and that's all?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_26","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_26","text":"Très bien, je comprends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_27","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_27","text":"Officiellement, however, you acted alone and released numerous animals from the shelter à la surface sans autorisation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_28","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_28","text":"The Ark has incurred a significant loss of property because of your actions,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_29","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_epilogue_29","text":"and therefore, you must bear les conséquences.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_30","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_30","text":"I expected as much,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_epilogue_31","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_epilogue_31","text":"and am fully prepared to accept whatever punishment you have for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":nu