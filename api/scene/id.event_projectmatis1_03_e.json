aker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_51","text":"Because it was efficient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_52","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_52","text":"I could gift her to you while you were going through a rough patch,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_53","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_53","text":"and while I was at it, I could even test the Memory Wipe procedure one more time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_54","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_54","text":"We both benefitted. Two birds with one stone, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_55","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_55","text":"That's exactly why I can't stand you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_56","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_56","text":"Do you think I'm the only one who thinks this way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_57","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_57","text":"Who else could possibly think the way you do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_58","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_58","text":"Our father.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_59","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_59","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_60","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_60","text":"I don't know what sort of person you imagine Father to be,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_61","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_61","text":"but to be blunt, Father and I are very much alike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_62","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_62","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_63","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_63","text":"Do you really believe Father killed that thing because she was a spy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_64","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_64","text":"What are you even talking about...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_65","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_65","text":"Have you ever seen a shred of evidence that your maid was a spy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_66","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_66","text":"Did you ever hear where or how she supposedly acted as a spy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_67","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_67","text":"I...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_68","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_68","text":"She died because she either served the purpose Father assigned her, or she got in his way. I'm certain of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_69","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_69","text":"Don't be ridiculous...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_70","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_70","text":"Don't put too much faith in him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_71","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_71","text":"I'm sure he has ulterior motives, just as he always does.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_72","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_72","text":"And it'll be nothing at all like what you're hoping for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_73","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_73","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_74","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_74","text":"In that man's eyes, Nikkes, humans, the two of us... there's no difference at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_75","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_75","text":"We're all merely resources for Missilis... or for himself, rather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_76","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_76","text":"Don't speak ill of Father!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_77","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_77","text":"Y-you're trying to drive a wedge between me and him right now, aren't you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_78","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_78","text":"Hmm... I suppose you don't trust me enough to believe me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_03_e_79","text":"*Slam*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_03_e_80","text":"Syuen shoots up from her seat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_81","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_81","text":"I'm not talking to you anymore!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_82","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_82","text":"Sweetie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_83","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_83","text":"Don't forget my advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_84","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_84","text":"I don't care!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_85","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_03_e_85","text":"Syuen runs off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_86","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_86","text":"... This is probably the last thing I'll ever do for you, sweetie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_87","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_87","text":"You ran into Jien?","jump":null,"exit":false,"enter":null,"bg":"ArkCleanIndoor","bgArt":"arkcleanindoor","image":null,"bgm":"none","movie":null,"shown":["syuen_young","maxwell_h"],"affinity":null},{"id":"event_projectmatis1_03_e_88","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_88","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_89","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_89","text":"She told me not to trust Father... and said he definitely has some other motive this time too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_90","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_90","text":"She was trying to turn me against Father!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_91","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_91","text":"Some other motive... huh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_92","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_92","text":"She even said Lala wasn't killed for being a spy. She died because of some other reason...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_93","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_93","text":"She's the absolute worst!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_94","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_94","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_95","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_95","text":"Hey, why aren't you saying anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_96","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_96","text":"... She might not be entirely wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_97","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_97","text":"Yeah. Maybe I've been too naive about all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_98","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_98","text":"Entrusting you with something this big, so suddenly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_99","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_99","text":"What in the world is the boss thinking? He must have something up his sleeve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_100","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_100","text":"What motive could there possibly be?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_101","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_101","text":"Father is nothing like her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_102","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_102","text":"I'm sure he