,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_32","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_32","text":"Just how much authority the CEO of Missilis actually holds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_33","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_33","text":"How many secrets they're privy to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_34","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_34","text":"Once you truly understand, I'm certain you'll want that position for yourself too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_35","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_35","text":"I don't need any of that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_36","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_36","text":"I just... I only want to be useful to Father.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_37","type":"Speech","speaker":"jien_young","key":"Locale_MainScenario:event_projectmatis1_03_e_37","text":"To Father? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"