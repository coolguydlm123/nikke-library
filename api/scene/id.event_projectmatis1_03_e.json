ull,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_109","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_109","text":"Yes, I'm sure he's different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_110","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_110","text":"If you say so, then that's how it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_111","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_111","text":"You'd know better than me. After all, you're family and I'm just a mere employee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_112","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_112","text":"I'm right, aren't I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_113","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_113","text":"Yeah. Well, whatever the motive, it doesn't change what needs to be done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_114","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_114","text":"Let's just keep at it and give it our best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_115","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_115","text":"... All right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_116","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_03_e_116","text":"Days go by, until finally...","jump":null,"exit":false,"enter":null,"bg":"EventScene_ProjectMatis_07_1","bgArt":"eventscene_projectmatis_07_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_117","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_117","text":"Well? Is it okay? Anything look off to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_118","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_03_e_118","text":"Maxwell looks at the tablet Syuen holds out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_119","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_e_119","text":"Yeah. This'll do nicely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_120","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_e_120","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_e_121","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_0