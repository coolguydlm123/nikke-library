null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_78","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_78","text":"but I heard Brid say she was too busy and left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_79","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_brid_01_79","text":"Do you want Brid to take a break, too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_80","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_80","text":"Of course. If the people under you never take their annual leave...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_81","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_81","text":"What kind of leader does that make you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_82","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_brid_01_82","text":"Now you know why it's hard to be a leader.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_83","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_83","text":"Yeah, I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_84","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_84","text":"That's why I'm with you on this, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_85","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_85","text":"Although I know Brid is a workaholic and a perfectionist,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_86","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_86","text":"she still needs to go on a proper break.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_87","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_brid_01_87","text":"The problem is, she's really stubborn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_88","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_88","text":"Hmm. Let me help you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_89","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_89","text":"I mean, if I ask Brid to take a break directly, as an order from her leader,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_90","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_brid_01_90","text":"she would do it, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_brid_01_91","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_brid_01_91","text":"I'll just talk to her myself.","jump":null,"exit":false,"enter":nul