{"id":"msg_m_ex_electricshock_01","cat":"messenger","group":{"id":"room_electricshock","label":"Electric Shock · Group"},"label":"1. Oh boy,","stage":null,"prev":null,"next":"msg_m_ex_electricshock_02","speakers":{"elegg":"Elegg","trony":"Trony"},"icons":{"elegg":"si_c500_00_s","trony":"si_c501_00_s"},"lines":[{"id":"m_ex_electricshock_01_1","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_1","text":"Oh boy,","jump":null},{"id":"m_ex_electricshock_01_2","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_2","text":"something major has happened.","jump":null},{"id":"m_ex_electricshock_01_3","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_3","text":"??","jump":null},{"id":"m_ex_electricshock_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_4","text":"What's wrong?","jump":null},{"id":"m_ex_electricshock_01_5","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_5","text":"It has to do with Syuen.","jump":null},{"id":"m_ex_electricshock_01_6","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_6","text":"O.O","jump":null},{"id":"m_ex_electricshock_01_7","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_7","text":"Elegg, it's been a pleasure knowing you.","jump":null},{"id":"m_ex_electricshock_01_8","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_8","text":"I'll go ahead first.","jump":null},{"id":"m_ex_electricshock_01_9","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_9","text":"What are you talking about?","jump":null},{"id":"m_ex_electricshock_01_10","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_10","text":"I haven't even said anything yet.","jump":null},{"id":"m_ex_electricshock_01_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_11","text":"Trony, calm down. Let's listen to what Elegg has to say first.","jump":null},{"id":"m_ex_electricshock_01_12","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_12","text":"Okay.","jump":null},{"id":"m_ex_electricshock_01_13","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_13","text":"Elegg,","jump":null},{"id":"m_ex_electricshock_01_14","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_14","text":"sorry for interrupting.","jump":null},{"id":"m_ex_electricshock_01_15","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_15","text":"Hehe, it's okay.","jump":null},{"id":"m_ex_electricshock_01_16","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_16","text":"As I was saying, Syuen...","jump":null},{"id":"m_ex_electricshock_01_17","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_17","text":"O.O","jump":null},{"id":"m_ex_electricshock_01_18","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_18","text":"Elegg, it's been a pleasure knowing you.","jump":null},{"id":"m_ex_electricshock_01_19","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_19","text":"It looks like this is where it all ends for me.","jump":null},{"id":"m_ex_electricshock_01_20","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_20","text":"...","jump":null},{"id":"m_ex_electricshock_01_21","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_21","text":"Sorry.","jump":null},{"id":"m_ex_electricshock_01_22","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_22","text":"It's a reflex, I swear!","jump":null},{"id":"m_ex_electricshock_01_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_23","text":"Seems like you two have had some traumatic experiences with Syuen in the past.","jump":null},{"id":"m_ex_electricshock_01_24","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_24","text":"We certainly have.","jump":null},{"id":"m_ex_electricshock_01_25","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_25","text":"She's always asking me to do all sorts of weird things.","jump":null},{"id":"m_ex_electricshock_01_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_26","text":"Like...?","jump":null},{"id":"m_ex_electricshock_01_27","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_27","text":"Like sticking a screen protector on her computer monitors.","jump":null},{"id":"m_ex_electricshock_01_28","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_28","text":"Filling out paperwork for her.","jump":null},{"id":"m_ex_electricshock_01_29","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_29","text":"Turning off the lights when she goes to sleep.","jump":null},{"id":"m_ex_electricshock_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_30","text":"Is this what you do regularly?","jump":null},{"id":"m_ex_electricshock_01_31","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_31","text":"T_T","jump":null},{"id":"m_ex_electricshock_01_32","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_32","text":"Anyway, Elegg,","jump":null},{"id":"m_ex_electricshock_01_33","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_33","text":"what were you going to say about Syuen?","jump":null},{"id":"m_ex_electricshock_01_34","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_34","text":"Oh, right.","jump":null},{"id":"m_ex_electricshock_01_35","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_35","text":"She's heading to our dorm right now, so I figured we should probably clean up beforehand.","jump":null},{"id":"m_ex_electricshock_01_36","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_36","text":"Uh oh.","jump":null},{"id":"m_ex_electricshock_01_37","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_37","text":"Syuen is calling me from outside my door right now.","jump":null},{"id":"m_ex_electricshock_01_38","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_38","text":"... Sorry, Trony,","jump":null},{"id":"m_ex_electricshock_01_39","type":"Speech","speaker":"elegg","key":"Locale_SuddenMessage:m_ex_electricshock_01_39","text":"but I might be a little late.","jump":null},{"id":"m_ex_electricshock_01_40","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_40","text":"Elegg?","jump":null},{"id":"m_ex_electricshock_01_41","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_41","text":"There is no further response from Elegg.","jump":null},{"id":"m_ex_electricshock_01_42","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_42","text":"Commander,","jump":null},{"id":"m_ex_electricshock_01_43","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_43","text":"if you don't hear from me tomorrow,","jump":null},{"id":"m_ex_electricshock_01_44","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_electricshock_01_44","text":"don't forget to contact the A.C.P.U.","jump":null},{"id":"m_ex_electricshock_01_45","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_45","text":"After that, there are no more messages from Trony either.","jump":null},{"id":"m_ex_electricshock_01_46","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_46","text":"R.I.P.","jump":null},{"id":"m_ex_electricshock_01_47","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_electricshock_01_47","text":"I silently mourn for both of them.","jump":null}],"chat":true}