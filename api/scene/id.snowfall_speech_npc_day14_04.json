},{"id":"snowfall_speech_npc_day14_04_6","type":"Speech","speaker":"vesti","key":"Locale_SubScenario:snowfall_speech_npc_day14_04_6","text":"B-but you didn't make it so that others could eat, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day14_04_7","type":"Speech","speaker":"eunhwa","key":"Locale_SubScenario:snowfall_speech_npc_day14_04_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day14_04_8","type":"Speech","speaker":"eunhwa","key":"Locale_SubScenario:snowfall_speech_npc_day14_04_8","text":"By the time morning is over, there isn't enough for me to eat either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day14_04_9","type":"Speech","speaker":"eunhwa","key":"Locale_SubScenario:snowfall_speech_npc_day14_04_9","text":"Just eat a big breakfast early in the morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day14_04_10","type":"Speech","speaker":"vesti","key":"Locale_SubScenario:snowfall_speech_npc_day14_04_10","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day14_04_11","type":"Narration","speaker":null,"key":"Locale_SubScenario:snowfall_speech_npc_day14_04_11","text":"Vesti and Eunhwa continue their conversation in the bamboo forest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}