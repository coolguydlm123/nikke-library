It's a deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_02_98","type":"Speech","speaker":"nihilister","key":"Locale_NikkeEpisode:d_nikke_nihilister_02_98","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_02_99","type":"Speech","speaker":"nihilister","key":"Locale_NikkeEpisode:d_nikke_nihilister_02_99","text":"Good thinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_02_100","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nihilister_02_100","text":"Just remember that if you don't keep your promise,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_02_101","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nihilister_02_101","text":"there will be hell to pay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_02_102","type":"Speech","speaker":"nihilister","key":"Locale_NikkeEpisode:d_nikke_nihilister_02_102","text":"Your eyes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_02_103","type":"Speech","speaker":"nihilister","key":"Locale_NikkeEpisode:d_nikke_nihilister_02_103","text":"Could it be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_02_104","type":"Speech","speaker":"nihilister","key":"Locale_NikkeEpisode:d_nikke_nihilister_02_104","text":"you've got something else up your sl