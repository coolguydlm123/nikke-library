gm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_35","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_02_35","text":"We are doctors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_36","type":"Speech","speaker":"pepper","key":"Locale_SuddenStory:d_ex_hospital_02_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_37","type":"Speech","speaker":"pepper","key":"Locale_SuddenStory:d_ex_hospital_02_37","text":"Yes, ma'am! I will bring her to the ward!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_38","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_02_38","text":"Thanks, Pepper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_39","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_02_39","text":"I need to check on her. Please wait here, guardian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_40","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_02_40","text":"Soon after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_41","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_02_41","text":"Pepper and Mary come out of the ward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mary","pepper"],"affinity":null},{"id":"d_ex_hospital_02_42","typ