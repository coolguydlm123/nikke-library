null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_84","type":"Speech","speaker":"pepper","key":"Locale_SuddenStory:d_ex_hospital_02_84","text":"Yes, senpai.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_85","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_02_85","text":"... Payment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_02_86","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_02_86","text":"I look around to see a beautiful white wine bottle on the bedside table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}