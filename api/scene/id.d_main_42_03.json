null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_94","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_42_03_94","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_95","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_42_03_95","text":"L-Levi...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_96","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_42_03_96","text":"I'll die first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_97","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_42_03_97","text":"Goodbye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_98","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_42_03_98","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_99","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_42_03_99","text":"*Gasp!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_100","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_42_03_100","text":"Gluttony's giant mouth crashes down on Leviathan,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_03_101","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_42_03_101","text":"and closes.","jump":null,"exit":false,"enter":null,"b