onsaga1_03_e_11","text":"You've got to break open every wooden box and jar you see on the streets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_03_e_12","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_icedragonsaga1_03_e_12","text":"System: Thornleaf discovered! What luck!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_03_e_13","type":"Speech","speaker":"maiden_w","key":"Locale_MainScenario:event_icedragonsaga1_03_e_13","text":"... We can't use this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_03_e_14","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_03_e_14","text":"Um, Maiden...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_03_e_15","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_03_e_15","text":"The street is a complete wreck now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_03_e_16","type":"Speech","speaker":"maiden_w","key":"Locale_MainScenario:event_icedragonsaga1_03_e_16","text":"Guillotine,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_03_e_17","type":"Speech","speaker":"maiden_w","key":"Locale_MainScenario:event_icedragonsaga1_03_e_17","text":"don't make me repeat myself!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null