ull,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_darkhero_05_e_28","type":"Speech","speaker":"elegg","key":"Locale_SubScenario:event_darkhero_05_e_28","text":"That's right. I'm a heinous criminal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_darkhero_05_e_29","type":"Speech","speaker":"elegg","key":"Locale_SubScenario:event_darkhero_05_e_29","text":"You ought to be careful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_darkhero_05_e_30","type":"Speech","speaker":"elegg","key":"Locale_SubScenario:event_darkhero_05_e_30","text":"Nothing good will come out of associating with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_darkhero_05_e_31","type":"Speech","speaker":"elegg","key":"Locale_SubScenario:event_darkhero_05_e_31","text":"Even Trony, who had nothing to do with any of this, was mistaken as a co-conspirator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_darkhero_05_e_32","type":"Speech","speaker":"maiden","key":"Locale_SubScenario:event_darkhero_05_e_32","text":"Elegg, it's just you and me right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_darkhero_05_e_33","type":"Speech","speaker":"maiden","key":"Locale_SubScenario:event_darkhero_05_e_33","text":"I asked the other to give us a few moments alone...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_darkhero_05_e_34","type":"Speech","speaker":"maiden","key":"Locale_SubScenario:event_darkhero_05_e