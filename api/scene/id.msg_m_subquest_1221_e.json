{"id":"msg_m_subquest_1221_e","cat":"messenger","group":{"id":"room_musiclover","label":"Music Lover · Quest"},"label":"2. Chat 2","stage":null,"prev":"msg_m_subquest_1221_s","next":"msg_m_subquest_1222_s","speakers":{"musiclover":"Music Lover"},"icons":{},"lines":[{"id":"m_subquest_1221_e_0","type":"Narration","speaker":"musiclover","key":null,"text":"Reward: Compass ×2","jump":null},{"id":"m_subquest_1221_e_1","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_1","text":"I can't thank you enough.","jump":null},{"id":"m_subquest_1221_e_2","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_2","text":"Now that you've given my teacher a new lease on life,","jump":null},{"id":"m_subquest_1221_e_3","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_3","text":"we finally have someone else to sing songs from the past with.","jump":null},{"id":"m_subquest_1221_e_4","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1221_e_4","text":"It's fun for us as well.","jump":null},{"id":"m_subquest_1221_e_5","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_5","text":"I'm sure he was honored.","jump":null},{"id":"m_subquest_1221_e_6","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_6","text":"For a musician, there's nothing greater","jump":null},{"id":"m_subquest_1221_e_7","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_7","text":"than performing in front of an audience.","jump":null},{"id":"m_subquest_1221_e_8","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_8","text":"Since that audience consisted of someone as thoughtful as you,","jump":null},{"id":"m_subquest_1221_e_9","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_9","text":"I'm sure that made him","jump":null},{"id":"m_subquest_1221_e_10","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_10","text":"throw himself into the melody more than usual.","jump":null},{"id":"m_subquest_1221_e_11","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_11","text":"If the opportunity ever presents itself,","jump":null},{"id":"m_subquest_1221_e_12","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_12","text":"will you all be willing to","jump":null},{"id":"m_subquest_1221_e_13","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_13","text":"be my teacher's audience again?","jump":null},{"id":"m_subquest_1221_e_14","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1221_e_14","text":"Of course.","jump":null},{"id":"m_subquest_1221_e_15","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_15","text":"!!","jump":null},{"id":"m_subquest_1221_e_16","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_16","text":"Fantastic!","jump":null},{"id":"m_subquest_1221_e_17","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_17","text":"Thank you, Commander!","jump":null},{"id":"m_subquest_1221_e_18","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_18","text":"I shall be practicing my part each and every day,","jump":null},{"id":"m_subquest_1221_e_19","type":"Speech","speaker":"musiclover","key":"Locale_SubScenario:m_subquest_1221_e_19","text":"waiting for that time to arrive.","jump":null}],"chat":true}