{"id":"d_main_45_06","cat":"main","group":{"id":"ch45","label":"Chapter 45 · The Price of Sin"},"label":"Beyond the World","stage":"45-17 STAGE · End","prev":"d_main_45_05","next":"d_main_45_07","speakers":{"eyeri":"Eyeri","arcana":"Arcana"},"icons":{"eyeri":"si_c440_00_s","arcana":"si_c581_00_s"},"lines":[{"id":"d_main_45_06_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_45_06_1","text":"10 minutes earlier...","jump":null,"exit":false,"enter":null,"bg":"Library","bgArt":"library","image":null,"bgm":"bgm_story_sogood","movie":null,"shown":["eyeri","arcana"],"affinity":null},{"id":"d_main_45_06_2","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_2","text":"Hello. I'm back again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_3","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_3","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_4","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_4","text":"I've been coming here for the past few days, and every time, you look at me like we've never met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_5","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_5","text":"I'm Eyeri, from the inspection unit Overseer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_6","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_6","text":"... Ah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_7","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_7","text":"I remember.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_8","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_8","text":"You can come by all you want. It won't change anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_9","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_9","text":"This isn't a video game. My affinity for you isn't going to increase, and no new features will be unlocked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_10","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_10","text":"Oh, don't be like that. I'm sure as we spend more time together, we'll become great friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_11","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_11","text":"Like I said, this isn't a game.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_12","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_12","text":"I have my own life to attend to. If you keep showing up unannounced, I'll have no choice but to call for help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_13","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_13","text":"Call who? Someone scary?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_14","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_14","text":"Maybe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_15","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_15","text":"I'm part of an inspection unit. I have more pull than most squads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_16","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_16","text":"That much I can believe, seeing how you uncovered the existence of the Forbidden Library.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_17","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_17","text":"And considering that you always show up right when I clock in and out,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_18","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_18","text":"you must understand how this place operates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_19","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_19","text":"Hehe. All part of the job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_20","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_20","text":"Look, Eyeri, I can be cold and ruthless, so I'm going to be blunt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_21","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_21","text":"Stop coming here. I'm saying this for your sake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_22","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_22","text":"It could get dangerous for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_23","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_24","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_24","text":"What value does information have if it's hidden away forever?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_25","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_26","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_26","text":"The fact that it's stored in a place called the Forbidden Library can only mean one thing:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_27","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_27","text":"if that information ever left the Ark, there would be serious consequences.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_28","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_28","text":"Having an entire squad dedicated to safeguarding it only further proves how important it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_29","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_29","text":"I understand that. The Ark is an extremely closed system.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_30","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_30","text":"*Sigh...* Then why are you acting like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_31","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_31","text":"Because if we can take a look at just some of those thoroughly hidden records,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_32","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_32","text":"we might be able to save the Ark from danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_33","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_33","text":"You mean Dorothy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_34","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_34","text":"I dabble a bit in fortune telling, and I'm also good at reading faces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_35","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_35","text":"She doesn't have the face of someone who harms others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_36","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_36","text":"It could be the other way around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_37","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_37","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_38","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_38","text":"Some are assuming that Dorothy intends to harm the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_39","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_39","text":"but what if it's the Ark that's harmed her? What's if it's currently harming her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_40","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_41","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_41","text":"We have to know so that when the time comes, we can make the right decision:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_42","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_42","text":"either we get rid of her, or we help her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_43","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_43","text":"Imagine that she's already been wronged, and then no one takes her side. How sad would that be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_44","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_44","text":"The ultimate goal of my investigation is to determine the truth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_45","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_46","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_46","text":"Ooh, have I convinced you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_47","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_47","text":"You almost did, but no still means no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_48","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_48","text":"Do you work out very much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_49","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_49","text":"What, so now you're going to use force?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_50","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_50","text":"Yep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_51","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_51","text":"*Sigh...* Fine. As a master of Stellar Fate Fist, I accept the challenge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_45_06_52","text":"Eyeri lunges forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_53","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_45_06_53","text":"She abruptly lowers her stance and grabs onto Arcana's legs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_54","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_55","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_56","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_56","text":"Don't tell me your plan is to cling onto my pant leg, is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_57","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_57","text":"That's precisely my plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_58","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_58","text":"You're coming off more like someone who just got dumped than an opponent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_59","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_59","text":"Have you ever tried it before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_60","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_60","text":"It's on my bucket list.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_61","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_45_06_61","text":"Aahh! Please! Just give me one more chance!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_06_62","type":"Speech","speaker":"arcana","key":"Locale_MainScenario:d_main_45_06_62","text":"Let go! My heart and body belong to another!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":n