{"id":"d_ex_armory_01","cat":"outpost","group":{"id":"outpost10801","label":"Armory"},"label":"Armory Ghost Story","stage":null,"prev":null,"next":"d_ex_armory_02","speakers":{"emma":"Emma","vesti":"Vesti","unknown":"???"},"icons":{"emma":"si_c090_00_s","vesti":"si_c091_00_s","unknown":"si_c999_00_s"},"notes":["Unlock: Emma · Vesti","Featuring Vesti · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_armory_01_1","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_1","text":"Commander...","jump":null,"exit":false,"enter":null,"bg":"Armory","bgArt":"armory","image":null,"bgm":"bgm_distress","movie":null,"shown":["emma","vesti"],"affinity":null},{"id":"d_ex_armory_01_2","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_2","text":"Have you ever heard of the Talking Gun?\nIt's one of the 7 mysteries of the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_3","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_01_3","text":"Never heard of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_4","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_4","text":"Really? Then allow me to explain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_5","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_5","text":"A long time ago, back before Nikkes existed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_6","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_6","text":"when humans were powerless against the Raptures,","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_7","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_7","text":"Elysion's weapon institute crafted a whole bunch of experimental weapons.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_8","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_8","text":"The Talking Gun was rumored to be one of them, and one of the materials used to create it was...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_9","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_9","text":"... living human beings!","jump":null,"exit":false,"enter":null,"bg":"Armory","bgArt":"armory","image":null,"bgm":null,"movie":null,"shown":["emma","vesti"],"affinity":null},{"id":"d_ex_armory_01_10","type":"Speech","speaker":"vesti","key":"Locale_SuddenStory:d_ex_armory_01_10","text":"Eeek!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_11","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_11","text":"That's why it can talk like a human. Hehehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_12","type":"Speech","speaker":"vesti","key":"Locale_SuddenStory:d_ex_armory_01_12","text":"Emma... you know I can't stand creepy stories like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_13","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_13","text":"You're not scared, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_14","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_14","text":"After all, Nikkes are basically a weapons system with a human brain as a component.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_15","type":"Speech","speaker":"vesti","key":"Locale_SuddenStory:d_ex_armory_01_15","text":"Yeah, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_16","type":"Speech","speaker":"vesti","key":"Locale_SuddenStory:d_ex_armory_01_16","text":"at least we're living things. A gun is... just an object.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_17","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_17","text":"Hmm. Oh well.\nCommander, what do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_18","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_01_18","text":"Nikkes are living beings.","jump":"d_ex_armory_01_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_19","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_01_19","text":"I'm not sure.","jump":"d_ex_armory_01_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_20","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_20",