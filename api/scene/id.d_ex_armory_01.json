y_01_28","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_28","text":"Hmm, most unexpected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_29","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_29","text":"I assumed your answer would be filled with confidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_30","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_01_30","text":"I believe this is something that cannot be easily defined.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_31","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_31","text":"Right...\nNowadays, nearly everyone relies on machines to live in some capacity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_32","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_32","text":"Humans have machines inside them, and vice versa with Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_33","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_33","text":"How little separation must there be before the definition of \"life\" must be changed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_01_34","type":"Speech","speaker":"emma","key":"Locale_SuddenStory:d_ex_armory_01_34","text":"I'm still not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"b