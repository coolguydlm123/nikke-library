foolburstday_06_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_19","text":"And how did you reach this conclusion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_20","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_20","text":"This is the first time I've experienced such humiliation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_21","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_21","text":"Unless I eradicate the source of my distress, it will haunt me for the rest of my days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_22","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_22","text":"Honestly, Mecha Shifty would probably lose out to a Nikke in about five seconds flat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_23","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_23","text":"Regardless, such a confrontation wouldn't be beneficial to anyone, so I should try to discourage it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_24","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_24","text":"Listen carefully, Mecha Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_25","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_25","text":"It's as you said; Nikkes and humans are weak. We are an inferior species.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_26","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_26","text":"That's why we need someone superior like you to protect us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_27","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_27","text":"And why should I do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_28","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_28","text":"So... so that you can earn our genuine respect, from the bottom of our hearts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_29","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_29","text":"Respect...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_06_30","text":"Your achievements will be remembered for generations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_31","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_31","text":"They will?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":n