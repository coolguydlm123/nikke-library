{"id":"event_foolburstday_06","cat":"event","group":{"id":"ev130007","label":"Foolburstday"},"label":"What Was the Name of the Flower We Saw That Day?","stage":null,"prev":"event_foolburstday_05","next":"event_foolburstday_07","speakers":{"mechashifty":"Mecha Shifty"},"icons":{"mechashifty":"si_c993_00_s"},"lines":[{"id":"event_foolburstday_06_1","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_1","text":"Gaaaaaah!","jump":null,"exit":false,"enter":null,"bg":"FlowerGarden","bgArt":"flowergarden","image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":["mechashifty"],"affinity":null},{"id":"event_foolburstday_06_2","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_2","text":"Ggggaaaaaahhhhhhh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_3","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_3","text":"Just a lowly bunch of inferior beings!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_4","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_4","text":"Who needs bipedal movement? Treads are overwhelmingly more efficient!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_5","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_06_5","text":"So what if your arms can go behind your back? I can turn my waist around 180 degrees!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_06_6","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foo