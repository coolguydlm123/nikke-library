{"id":"d_Counseling_elegg_boomandshock_05","cat":"counsel","group":{"id":"char5146","label":"Elegg: Boom and Shock"},"label":"Advising Elegg: Boom and Shock: 05","stage":null,"prev":"d_Counseling_elegg_boomandshock_04","next":"d_Counseling_elegg_boomandshock_06","speakers":{"elegg_s":"Elegg"},"icons":{"elegg_s":"si_c502_00_s"},"lines":[{"id":"d_Counseling_elegg_boomandshock_05_01","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_05_01","text":"Wanna know something interesting?","jump":null,"exit":false,"enter":null,"bg":"Deck_d","bgArt":"deck_d","image":null,"bgm":"bgm_story_summermood","movie":null,"shown":["elegg_s"],"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_05_02","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_05_02","text":"There's an old movie that has a weapon just like the BOOMbastic Fantasm Gun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_05_03","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_05_03","text":"They even made a video game adaptation. You know what I'm talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_05_04","type":"Choice","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_05_04","text":"I heard the game is just as fun as BOOM.","jump":"d_Counseling_elegg_boomandshock_05_06","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_Counseling_elegg_boomandshock_05_05","type":"Choice","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_05_05","text":"There's another video game with a similar weapon.","jump":"d_Counseling_elegg_boomandshock_