{"id":"d_counseling_mihara_06","cat":"counsel","group":{"id":"char3006","label":"Mihara"},"label":"Advising Mihara: 06","stage":null,"prev":"d_counseling_mihara_05","next":"d_counseling_mihara_07","speakers":{"mihara":"Mihara"},"icons":{"mihara":"si_c161_00_s"},"lines":[{"id":"d_counseling_mihara_06_1","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_06_1","text":"The line between pain and pleasure is so, so thin.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mihara"],"affinity":"_0"},{"id":"d_counseling_mihara_06_2","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_06_2","text":"Sometimes you're being crushed by pain you can barely take,\nand the next moment it crosses the line into intense pleasure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_06_3","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_06_3","text":"Doesn't it make you curious, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_06_4","text":"Not one bit.","jump":"d_counseling_mihara_06_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mihara_06_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_06_5","text":"I'm curious, but it kind of scares me.","jump":"d_counseling_mihara_06_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mihara_06_6","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_06_6","text":"Hm... really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_06_7","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_06_7","text":"I thought you'd at least be somewhat interested. I guess I was wrong.","jump":"d_counseling_mihara_06_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_06_8","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_06_8","text":"Ha ha. New things are always a bit intimidating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_06_9","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_06_9","text":"Don't be scared. We can take it one step at a time. I'll show you everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_06_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_06_10","text":"I watch a video of painful parkour fails with Mihara.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}