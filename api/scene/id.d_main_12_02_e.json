2_02_e_13","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_12_02_e_13","text":"What's the big idea sneaking up on us like that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_groundfall","movie":null,"shown":null,"affinity":null},{"id":"d_main_12_02_e_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_12_02_e_14","text":"Haha. It's your fault for not realizing when we were this close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12_02_e_15","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_12_02_e_15","text":"Shifty-","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12_02_e_16","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_12_02_e_16","text":"Erm... sorry. They were actually so close that I couldn't identify the signal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty","emma","eunhwa","vesti"],"affinity":null},{"id":"d_main_12_02_e_17","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_12_02_e_17","text":"That stunt you all pulled back there didn't do you any good. You haven't gotten anywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12_02_e_18","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_12_02_e_18","text":"No kidding, we could have taken our time getting here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12_02_e_19","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_12_02_e_19","text":"Isn't a 'thank you' in order? We cleared the wa