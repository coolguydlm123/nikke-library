,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_09_35","type":"Speech","speaker":"pepper","key":"Locale_SuddenStory:d_ex_hospital_09_35","text":"so it's not that simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_09_36","type":"Speech","speaker":"pepper","key":"Locale_SuddenStory:d_ex_hospital_09_36","text":"Also, some of them aren't well enough to join in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_09_37","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_09_37","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_09_38","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_hospital_09_38","text":"If I were you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_09_39","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_hospital_09_39","text":"I'd start by checking if you're watering them enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_09_40","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_09_40","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_09_41","type":"Speech","speaker":"pepper","key":"Locale_SuddenStory:d_ex_hospital_09_41","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affini