{"id":"d_nikke_anis_03","cat":"bond","group":{"id":"char3005","label":"Anis"},"label":"Unofficial Social Classes","stage":null,"prev":"d_nikke_anis_02","next":"d_nikke_anis_04","speakers":{"anis":"Anis","Self":"Commander","staff":"Clerk","Monologue":"Monologue"},"icons":{"anis":"si_c012_00_s","staff":"si_c912_00_s"},"lines":[{"id":"d_nikke_anis_03_1","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_1","text":"This is Royal Road.","jump":null,"exit":false,"enter":null,"bg":"RoyalRoad","bgArt":"royalroad","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_anis_03_2","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_2","text":"It doesn't seem different from downtown, does it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_3","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_3","text":"But it's actually entirely different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_4","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_4","text":"It's so quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_5","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_5","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_6","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_6","text":"Despite all the people wandering around, it's eerily quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_7","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_7","text":"This is where the chosen citizens, Sovereigns, spend their money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_8","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_8","text":"Sovereigns?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_9","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_9","text":"Before I tell you about Sovereigns, let me explain the social classes of Ark citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_10","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_10","text":"Basically, all Ark citizens are implanted with identification chips to live.","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":["adultman","adultwoman"],"affinity":null},{"id":"d_nikke_anis_03_11","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_11","text":"The chip could be in the arm, ear, or some other place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_12","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_12","text":"But usually it's in the neck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_13","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_13","text":"Only people with identification chips are seen as Ark citizens","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_14","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_14","text":"and can use the various facilities in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_15","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_15","text":"Non-citizens can't do that.","jump":null,"exit":false,"enter":null,"bg":"RoyalRoad","bgArt":"royalroad","image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_anis_03_16","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_16","text":"Since every citizen has to get one,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_17","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_17","text":"the identification chips are basically free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_18","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_18","text":"But! What is human nature?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_19","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_19","text":"Humans always want a higher status over their peers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_20","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_20","text":"So people started to spend their money on identification chips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_21","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_21","text":"The functionalities of the chips are the same, so people started changing the material or design.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_22","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_22","text":"This is not a joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_23","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_23","text":"You can have a famous designer, or use natural materials, all kinds of things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_24","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_24","text":"An identification chip like that could be worth several billion credits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_25","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_25","text":"... Billion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_26","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_26","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_27","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_27","text":"What a way to satisfy oneself, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_28","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_28","text":"Then an interesting thing happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_29","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_29","text":"According to the chip's worth, people created classes,","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":["burningum","adultman"],"affinity":null},{"id":"d_nikke_anis_03_30","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_30","text":"and the Sovereign and Quotidian class appeared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_31","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_31","text":"Sovereigns are the rich and wealth, while Quotidians are, well, the rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_32","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_32","text":"Only Sovereigns have expensive chips, while Quotidians settle for free or reasonably priced chips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_33","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_33","text":"That's not hard to understand, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_34","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_34","text":"That's so...","jump":null,"exit":false,"enter":null,"bg":"RoyalRoad","bgArt":"royalroad","image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_anis_03_35","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_35","text":"Ridiculous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_36","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_36","text":"Well either way, that's how things have shaken out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_37","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_37","text":"It brought more convenience to the Sovereigns and some ordinary perks for Quotidians as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_38","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_38","text":"Meanwhile, many people were against such an idea, and the Central Government also strongly discouraged the classification.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_39","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_39","text":"Now let's think: what kind of people are Sovereigns?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_40","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_40","text":"They're rich. So rich that they don't even know how to spend it all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_41","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_41","text":"There were massive protests, but no one could do a thing about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_42","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_42","text":"Then it became a rule in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_43","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_43","text":"Quotidians were fiercely against the classification because they couldn't accept being deprived of privileges.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_44","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_44","text":"Later, the Central Government appointed an area exclusively for Sovereigns to reside in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_45","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_45","text":"That must be this Royal Road.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_46","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_46","text":"Mmhm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_47","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_47","text":"Now it's only a luxury shopping street, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_48","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_48","text":"Why's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_49","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_49","text":"What's the fun of living around your peers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_50","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_50","text":"I'm rich, and you're rich. Everyone who lives here is rich.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_51","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_51","text":"That's boring. They couldn't get the sense of superiority over others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_52","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_52","text":"So the Sovereigns spread out and started to live in various places in the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_53","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_53","text":"leaving this street empty with luxury stores targeted towards them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_54","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_54","text":"Since then, preferential policies for Sovereigns have been banned, and Sovereigns must share the same level facilities as Quotidians.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_55","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_55","text":"Anything that violates that rule is considered a crime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_56","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_56","text":"So Sovereigns and Quotidians are no longer a thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_57","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_57","text":"It was never a thing in the first place. The rich made it up and tried to make it a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_58","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_58","text":"But there are some people that still hold on to that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_59","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_03_59","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_03_60","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_03_60","te