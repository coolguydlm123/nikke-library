{"id":"d_counseling_sugar_18","cat":"counsel","group":{"id":"char5002","label":"Sugar"},"label":"Advising Sugar: 18","stage":null,"prev":"d_counseling_sugar_17","next":"d_counseling_sugar_19","speakers":{"sugar":"Sugar"},"icons":{"sugar":"si_c140_00_s"},"lines":[{"id":"d_counseling_sugar_18_1","type":"Speech","speaker":"sugar","key":"Locale_Counseling:d_counseling_sugar_18_1","text":"You wear a helmet whenever you ride a motorcycle, don't you?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sugar"],"affinity":"_0"},{"id":"d_counseling_sugar_18_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sugar_18_2","text":"Of course.","jump":"d_counseling_sugar_18_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sugar_18_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sugar_18_3","text":"You don't wear one though, isn't that right?","jump":"d_counseling_sugar_18_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sugar_18_4","type":"Speech","speaker":"sugar","key":"Locale_Counseling:d_counseling_sugar_18_4","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sugar_18_5","type":"Speech","speaker":"sugar","key":"Locale_Counseling:d_counseling_sugar_18_5","text":"It's okay for me not to since I'm a Nikke, but it's a must for you.","jump":"d_counseling_sugar_18_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sugar_18_6","type":"Speech","speaker":"sugar","key":"Locale_Counseling:d_counseling_sugar_18_6","text":"I'm a Nikke.","jump":null,"exit":false,"enter":nu