 existence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_7","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_7","text":"That's because it is a tower meant for special Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_8","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_8","text":"It's a place to collect data from Nikkes who are not directly under the Ark's management, as well as where incipient technology is perfected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_9","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_overspectower_01_9","text":"In other words, you can get a glimpse at Nikkes here who are out of the ordinary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_10","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_10","text":"I supposed that's a good way of putting it, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_11","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_11","text":"They include Nikkes classified as Pilgrims, who wander the surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_12","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_12","text":"as well as those who are specially managed by certain companies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_13","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_13","text":"Since their data differs from that seen in regular Nikkes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_14","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_14","text":"their combat data is collected and utilized in a separate tower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_15","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_15","text":"It should go without saying that this tower's existence and the data inside it are strictly confidential.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_16","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_16","text":"I'm the only person with access to this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_17","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_overspectower_01_17","text":"The passage to this tower is hidden in order to ensure its existence remains a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_overspectower_01_18","type":"Speech","speaker":"a