{"id":"d_counseling_guilty_mightybunny_10","cat":"counsel","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Advising Guilty: Mighty Bunny: 10","stage":null,"prev":"d_counseling_guilty_mightybunny_09","next":"d_counseling_guilty_mightybunny_11","speakers":{"guilty_b":"Guilty"},"icons":{"guilty_b":"si_c404_00_s"},"lines":[{"id":"d_counseling_guilty_mightybunny_10_1","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_10_1","text":"You know, I've realized something lately... I get really happy when I eat good food!","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty_b"],"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_10_2","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_10_2","text":"What kind of food do you like, Counselor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_10_3","text":"Tasty, appetizing food.","jump":"d_counseling_guilty_mightybunny_10_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_mightybunny_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_10_4","text":"Quick and easy food.","jump":"d_counseling_guilty_mightybunny_10_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_mightybunny_10_5","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_10_5","text":"Right? Earlier I had some steak... grilled vegetables... a drink... and dessert, too!","jump