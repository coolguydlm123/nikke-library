{"id":"msg_m_ex_ein_01","cat":"messenger","group":{"id":"room_ein","label":"Ein · Nikke"},"label":"1. Hiya, Teacher!","stage":null,"prev":null,"next":"msg_m_ex_ein_02","speakers":{"ein":"Ein"},"icons":{"ein":"si_c391_00_s"},"lines":[{"id":"m_ex_ein_01_1","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_1","text":"Hiya, Teacher!","jump":null},{"id":"m_ex_ein_01_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ein_01_2","text":"Hiya?","jump":null},{"id":"m_ex_ein_01_3","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_3","text":"Hehe,","jump":null},{"id":"m_ex_ein_01_4","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_4","text":"I'm Ein.","jump":null},{"id":"m_ex_ein_01_5","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_5","text":"I'm from the School Circle Squad,","jump":null},{"id":"m_ex_ein_01_6","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_6","text":"Class P.","jump":null},{"id":"m_ex_ein_01_7","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_7","text":"Actually,","jump":null},{"id":"m_ex_ein_01_8","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_8","text":"I bet you already knew all that.","jump":null},{"id":"m_ex_ein_01_9","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_9","text":"I think this is the first time","jump":null},{"id":"m_ex_ein_01_10","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_10","text":"I've ever sent you a message.","jump":null},{"id":"m_ex_ein_01_11","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_11","text":"It all feels so unfamiliar.","jump":null},{"id":"m_ex_ein_01_12","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ein_01_12","text":"It sure is.","jump":"m_ex_ein_01_14"},{"id":"m_ex_ein_01_13","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ein_01_13","text":"You really feel all that?","jump":"m_ex_ein_01_15"},{"id":"m_ex_ein_01_14","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_14","text":"Mhmm!","jump":"m_ex_ein_01_16"},{"id":"m_ex_ein_01_15","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_15","text":"I sure do!","jump":"m_ex_ein_01_16"},{"id":"m_ex_ein_01_16","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_16","text":"I'm really not used to","jump":null},{"id":"m_ex_ein_01_17","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_17","text":"texting you like this.","jump":null},{"id":"m_ex_ein_01_18","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_18","text":"Maybe I'll get used to it as we go along.","jump":null},{"id":"m_ex_ein_01_19","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_19","text":"Anyway,","jump":null},{"id":"m_ex_ein_01_20","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_20","text":"when are you coming back to our school again?","jump":null},{"id":"m_ex_ein_01_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ein_01_21","text":"Not sure, why?","jump":null},{"id":"m_ex_ein_01_22","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_22","text":"Why else?","jump":null},{"id":"m_ex_ein_01_23","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_23","text":"Because I want to spend time with you!","jump":null},{"id":"m_ex_ein_01_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ein_01_24","text":"You do?","jump":null},{"id":"m_ex_ein_01_25","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_25","text":"Of course!","jump":null},{"id":"m_ex_ein_01_26","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_26","text":"I always have a blast hanging out with you.","jump":null},{"id":"m_ex_ein_01_27","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_27","text":"And even if they don't say it explicitly,","jump":null},{"id":"m_ex_ein_01_28","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_28","text":"Rei,  Zwei,","jump":null},{"id":"m_ex_ein_01_29","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_29","text":"and even Miss Marciana","jump":null},{"id":"m_ex_ein_01_30","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_30","text":"all look forward to","jump":null},{"id":"m_ex_ein_01_31","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_31","text":"you coming back.","jump":null},{"id":"m_ex_ein_01_32","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_32","text":"They get a lot out of spending time with you as well.","jump":null},{"id":"m_ex_ein_01_33","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_33","text":"So,","jump":null},{"id":"m_ex_ein_01_34","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_34","text":"you really ought to set a date for your next visit.","jump":null},{"id":"m_ex_ein_01_35","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_35","text":"How about today?","jump":null},{"id":"m_ex_ein_01_36","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_36","text":"I'm free after school is out.","jump":null},{"id":"m_ex_ein_01_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ein_01_37","text":"Today?","jump":null},{"id":"m_ex_ein_01_38","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_38","text":"Yeah!","jump":null},{"id":"m_ex_ein_01_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ein_01_39","text":"I should be free by the time you finish school.","jump":null},{"id":"m_ex_ein_01_40","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_40","text":"Yessssss! So you're coming today?","jump":null},{"id":"m_ex_ein_01_41","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_41","text":"No takebacks!","jump":null},{"id":"m_ex_ein_01_42","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_42","text":"I'll be waiting for you!","jump":null},{"id":"m_ex_ein_01_43","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_ein_01_43","text":"I'm gonna go tell the others!","jump":null}],"chat":true}