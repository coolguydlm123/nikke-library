hwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_03_143","text":"Never mind that, half-witted junior,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_03_144","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_03_144","text":"are you awake now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_03_145","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eunhwa_03_145","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_03_146","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_03_146","text":"Did you think I was having a chat with an idiot like you because I wanted to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_03_147","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_03_147","text":"I did it to wake you up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_03_148","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_03_148","text":"If you make a mistake now because of being tired, they will all die tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_03_149","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_03_149","text":"Are you conscious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_03_150","type":"Choic