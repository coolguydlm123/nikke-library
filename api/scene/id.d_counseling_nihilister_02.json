{"id":"d_counseling_nihilister_02","cat":"counsel","group":{"id":"char5056","label":"Nihilister"},"label":"Advising Nihilister: 02","stage":null,"prev":"d_counseling_nihilister_01","next":"d_counseling_nihilister_03","speakers":{"nihilister":"Nihilister"},"icons":{"nihilister":"si_c261_00_s"},"lines":[{"id":"d_counseling_nihilister_02_1","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_02_1","text":"How strong would you say you are?","jump":null,"exit":false,"enter":null,"bg":"Volcano_03","bgArt":"volcano_03","image":null,"bgm":"bgm_volcanicnest","movie":null,"shown":["nihilister"],"affinity":"_0"},{"id":"d_counseling_nihilister_02_2","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_2","text":"Do you really have to ask?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_3","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_3","text":"You should know better than most. You've fought against me before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_4","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_4","text":"Let me throw that question back at you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_5","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_5","text":"How strong do I look to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_02_6","text":"Um... your strength is beyond compare.","jump":"d_counseling_nihilister_02_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nihilister_02_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_02_7","text":"You've got a clear weakness, so I don't feel you're all that strong.","jump":"d_counseling_nihilister_02_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nihilister_02_8","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_8","text":"I should have expected as much from a weakling like yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_9","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_9","text":"Or is this just tiresome flattery?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_10","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_10","text":"Now, it goes without saying that I blow you and your compadres out of the water,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_11","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_11","text":"but so long as my cohorts and the Queen exist, I don't want any brown-nosing from you.","jump":"d_counseling_nihilister_02_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_12","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_12","text":"You have no idea how much that hurts coming from a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_13","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_13","text":"What's worse... it's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_14","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_14","text":"I'm working on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_15","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_02_15","text":"One day, I will personally take care of everyone who ever had any doubts about my strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_02_16","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_02_16","text":"I share a short conversation with Nihilister.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}