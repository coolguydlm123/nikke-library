{"id":"d_counseling_bready_08","cat":"counsel","group":{"id":"char5135","label":"Bready"},"label":"Advising Bready: 08","stage":null,"prev":"d_counseling_bready_07","next":"d_counseling_bready_09","speakers":{"bready":"Bready"},"icons":{"bready":"si_c520_00_s"},"lines":[{"id":"d_counseling_bready_08_1","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_08_1","text":"I'm really sorry, Bonne Bouche,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["bready"],"affinity":"_0"},{"id":"d_counseling_bready_08_2","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_08_2","text":"but is it okay if I eat something first before our session?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_08_3","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_08_3","text":"Crust is too busy today to make me a meal, so I'll get a bit hungry during the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_08_4","text":"I'm feeling somewhat peckish myself. Why don't we eat together?","jump":"d_counseling_bready_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_bready_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_08_5","text":"No, let's finish the session first.","jump":"d_counseling_bready_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_bready_08_6","type":"Speech","speaker":"bready","key":"Locale_Co