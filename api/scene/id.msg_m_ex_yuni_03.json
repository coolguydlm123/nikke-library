{"id":"msg_m_ex_yuni_03","cat":"messenger","group":{"id":"room_yuni","label":"Yuni · Nikke"},"label":"3. Commander,","stage":null,"prev":"msg_m_ex_yuni_02","next":null,"speakers":{"yuni":"Yuni"},"icons":{"yuni":"si_c160_00_s"},"lines":[{"id":"m_ex_yuni_03_1","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_1","text":"Commander,","jump":null},{"id":"m_ex_yuni_03_2","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_2","text":"have you seen Mihara?","jump":null},{"id":"m_ex_yuni_03_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_3","text":"Nope, I've not.","jump":null},{"id":"m_ex_yuni_03_4","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_4","text":"What should I do?","jump":null},{"id":"m_ex_yuni_03_5","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_5","text":"We had fun all day yesterday,","jump":null},{"id":"m_ex_yuni_03_6","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_6","text":"but now I can't find her,","jump":null},{"id":"m_ex_yuni_03_7","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_7","text":"no matter where I look.","jump":null},{"id":"m_ex_yuni_03_8","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_8","text":"Perhaps you took things a little too far?","jump":"m_ex_yuni_03_10"},{"id":"m_ex_yuni_03_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_9","text":"Maybe her preferences have changed since.","jump":"m_ex_yuni_03_13"},{"id":"m_ex_yuni_03_10","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_10","text":"That may be so,","jump":null},{"id":"m_ex_yuni_03_11","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_11","text":"but Mihara was enjoying herself as well.","jump":null},{"id":"m_ex_yuni_03_12","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_12","text":"I'm sure of that.","jump":"m_ex_yuni_03_17"},{"id":"m_ex_yuni_03_13","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_13","text":"Commander,","jump":null},{"id":"m_ex_yuni_03_14","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_14","text":"I'm being serious.","jump":null},{"id":"m_ex_yuni_03_15","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_15","text":"I would appreciate it if you could take this seriously as well.","jump":null},{"id":"m_ex_yuni_03_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_16","text":"Sorry.","jump":null},{"id":"m_ex_yuni_03_17","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_17","text":"Come to think of it,","jump":null},{"id":"m_ex_yuni_03_18","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_18","text":"we were playing with a new toy yesterday.","jump":null},{"id":"m_ex_yuni_03_19","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_19","text":"Perhaps she didn't like it?","jump":null},{"id":"m_ex_yuni_03_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_20","text":"What kind of toy was it?","jump":null},{"id":"m_ex_yuni_03_21","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_21","text":"It was red, long and sticky.","jump":null},{"id":"m_ex_yuni_03_22","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_22","text":"It was barbed as well, and...","jump":null},{"id":"m_ex_yuni_03_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_23","text":"That's enough, thank you.","jump":null},{"id":"m_ex_yuni_03_24","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_24","text":"If you say so.","jump":null},{"id":"m_ex_yuni_03_25","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_25","text":"Anyways,","jump":null},{"id":"m_ex_yuni_03_26","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_26","text":"I don't think it was enough to satisfy her.","jump":null},{"id":"m_ex_yuni_03_27","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_27","text":"I'll have to work harder from now on.","jump":null},{"id":"m_ex_yuni_03_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_28","text":"I don't think that's necessary.","jump":null},{"id":"m_ex_yuni_03_29","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_29","text":"I have research to do.","jump":null},{"id":"m_ex_yuni_03_30","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_30","text":"I have to find a toy Mihara will enjoy when she returns.","jump":null},{"id":"m_ex_yuni_03_31","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_31","text":"If I find one,","jump":null},{"id":"m_ex_yuni_03_32","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_32","text":"you should come to play with us as well.","jump":null},{"id":"m_ex_yuni_03_33","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_33","text":"The more the merrier.","jump":null},{"id":"m_ex_yuni_03_34","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_34","text":"Sure, will do.","jump":"m_ex_yuni_03_36"},{"id":"m_ex_yuni_03_35","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_yuni_03_35","text":"Um... maybe later.","jump":"m_ex_yuni_03_37"},{"id":"m_ex_yuni_03_36","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_36","text":"Okay.","jump":null},{"id":"m_ex_yuni_03_37","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_37","text":"Pinky swear.","jump":null},{"id":"m_ex_yuni_03_38","type":"Speech","speaker":"yuni","key":"Locale_SuddenMessage:m_ex_yuni_03_38","text":"See you soon.","jump":null}],"chat":true}