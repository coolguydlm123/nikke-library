{"id":"msg_m_ex_miranda_02","cat":"messenger","group":{"id":"room_miranda","label":"Miranda · Nikke"},"label":"2. Commander!","stage":null,"prev":"msg_m_ex_miranda_01","next":"msg_m_ex_miranda_03","speakers":{"miranda":"Miranda"},"icons":{"miranda":"si_c032_00_s"},"lines":[{"id":"m_ex_miranda_02_1","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_1","text":"Commander!","jump":null},{"id":"m_ex_miranda_02_2","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_2","text":"I need to tell you something.","jump":null},{"id":"m_ex_miranda_02_3","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_3","text":"Lend me your ear, will you?","jump":null},{"id":"m_ex_miranda_02_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_4","text":"Sure, go ahead!","jump":null},{"id":"m_ex_miranda_02_5","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_5","text":"I'm at a cafe buying some coffee.","jump":null},{"id":"m_ex_miranda_02_6","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_6","text":"Since I'm here, I was thinking of buying one for Poli as well, but","jump":null},{"id":"m_ex_miranda_02_7","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_7","text":"I'm not sure what to get her.","jump":null},{"id":"m_ex_miranda_02_8","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_8","text":"I asked Poli but I haven't gotten a response.","jump":null},{"id":"m_ex_miranda_02_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_9","text":"Sweet chocolate latte.","jump":"m_ex_miranda_02_11"},{"id":"m_ex_miranda_02_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_10","text":"Iced Americano.","jump":"m_ex_miranda_02_15"},{"id":"m_ex_miranda_02_11","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_11","text":"!!","jump":null},{"id":"m_ex_miranda_02_12","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_12","text":"Chocolate? No way jose!","jump":null},{"id":"m_ex_miranda_02_13","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_13","text":"If I gave that to Poli, it'd be a disaster!","jump":null},{"id":"m_ex_miranda_02_14","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_14","text":"I think the iced americano is the way to go.","jump":"m_ex_miranda_02_17"},{"id":"m_ex_miranda_02_15","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_15","text":"!!","jump":null},{"id":"m_ex_miranda_02_16","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_16","text":"Iced americano... That should work.","jump":"m_ex_miranda_02_17"},{"id":"m_ex_miranda_02_17","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_17","text":"Come to think of it, Poli is always yawning","jump":null},{"id":"m_ex_miranda_02_18","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_18","text":"and saying how tired she is.","jump":null},{"id":"m_ex_miranda_02_19","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_19","text":"I think some caffeine will be a nice shot in the arm for her!","jump":null},{"id":"m_ex_miranda_02_20","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_20","text":"Problem solved! Thanks, Commander!","jump":null},{"id":"m_ex_miranda_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_21","text":"Did you order?","jump":null},{"id":"m_ex_miranda_02_22","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_22","text":"Yep, just placed my order.","jump":null},{"id":"m_ex_miranda_02_23","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_23","text":"But we've got another problem.","jump":null},{"id":"m_ex_miranda_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_24","text":"What is it?","jump":null},{"id":"m_ex_miranda_02_25","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_25","text":"I just received a reply from Poli, and","jump":null},{"id":"m_ex_miranda_02_26","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_26","text":"she said she wants a","jump":null},{"id":"m_ex_miranda_02_27","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_27","text":"sweet potato latte!","jump":null},{"id":"m_ex_miranda_02_28","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_28","text":"This is a disaster!","jump":null},{"id":"m_ex_miranda_02_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_29","text":"Just go and change your order.","jump":null},{"id":"m_ex_miranda_02_30","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_30","text":"Excuse me, have you already processed my order?","jump":null},{"id":"m_ex_miranda_02_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_31","text":"??","jump":null},{"id":"m_ex_miranda_02_32","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_32","text":"Agh, sorry Commander!","jump":null},{"id":"m_ex_miranda_02_33","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_33","text":"I meant to send that to the shop assistant, not you!","jump":null},{"id":"m_ex_miranda_02_34","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_34","text":"I can't multitask! I'm freaking out right now!","jump":null},{"id":"m_ex_miranda_02_35","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_02_35","text":"I'll talk to you later!","jump":null},{"id":"m_ex_miranda_02_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_02_36","text":"Okay.","jump":null}],"chat":true}