{"id":"d_counseling_maiden_04","cat":"counsel","group":{"id":"char5032","label":"Maiden"},"label":"Advising Maiden: 04","stage":null,"prev":"d_counseling_maiden_03","next":"d_counseling_maiden_05","speakers":{"maiden":"Maiden"},"icons":{"maiden":"si_c181_00_s"},"lines":[{"id":"d_counseling_maiden_04_1","type":"Speech","speaker":"maiden","key":"Locale_Counseling:d_counseling_maiden_04_1","text":"Sometimes, I hear Nikkes talk about Guillotine and me like we're urban legends or something.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["maiden"],"affinity":"_0"},{"id":"d_counseling_maiden_04_2","type":"Speech","speaker":"maiden","key":"Locale_Counseling:d_counseling_maiden_04_2","text":"They say that if they become Irregulars, the Grim reaper will come and take them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maiden_04_3","type":"Speech","speaker":"maiden","key":"Locale_Counseling:d_counseling_maiden_04_3","text":"I don't know what to do with these rumors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maiden_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_maiden_04_4","text":"That is difficult.","jump":"d_counseling_maiden_04_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_maiden_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_maiden_04_5","text":"Don't worry. Just be you.","jump":"d_counseling_maiden_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_maiden_04_6","type":"Speech","speaker":"maiden","key":"Locale_Counseling:d_cou