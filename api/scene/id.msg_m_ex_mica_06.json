{"id":"msg_m_ex_mica_06","cat":"messenger","group":{"id":"room_mica","label":"Mica · Nikke"},"label":"6. Old-Timer!","stage":null,"prev":"msg_m_ex_mica_05","next":"msg_m_ex_mica_snowbuddy_01","speakers":{"mica":"Mica"},"icons":{"mica":"si_c061_00_s"},"lines":[{"id":"m_ex_mica_06_1","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_1","text":"Old-Timer!","jump":null},{"id":"m_ex_mica_06_2","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_2","text":"I heard that you were looking for me?","jump":null},{"id":"m_ex_mica_06_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_3","text":"I was.","jump":null},{"id":"m_ex_mica_06_4","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_4","text":"Wow, no kidding?","jump":null},{"id":"m_ex_mica_06_5","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_5","text":"I never thought you'd be the one looking for me.","jump":null},{"id":"m_ex_mica_06_6","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_6","text":"I was worried about you.","jump":"m_ex_mica_06_8"},{"id":"m_ex_mica_06_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_7","text":"It's because I like you.","jump":"m_ex_mica_06_10"},{"id":"m_ex_mica_06_8","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_8","text":"You don't have to worry about me,","jump":null},{"id":"m_ex_mica_06_9","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_9","text":"but I appreciate your concern nonetheless.","jump":"m_ex_mica_06_12"},{"id":"m_ex_mica_06_10","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_10","text":"Aw, thanks!","jump":null},{"id":"m_ex_mica_06_11","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_11","text":"I like you and Belorta too.","jump":"m_ex_mica_06_12"},{"id":"m_ex_mica_06_12","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_12","text":"So,","jump":null},{"id":"m_ex_mica_06_13","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_13","text":"was there anything you wanted to ask me?","jump":null},{"id":"m_ex_mica_06_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_14","text":"Have you and Belorta been getting along lately?","jump":null},{"id":"m_ex_mica_06_15","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_15","text":"Of course!","jump":null},{"id":"m_ex_mica_06_16","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_16","text":"Only yesterday, she gave me some food that I've never seen before.","jump":null},{"id":"m_ex_mica_06_17","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_17","text":"Apparently it's really popular.","jump":null},{"id":"m_ex_mica_06_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_18","text":"What was it?","jump":null},{"id":"m_ex_mica_06_19","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_19","text":"Just a sec.","jump":null},{"id":"m_ex_mica_06_20","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_20","text":"I was saving it, so I put it in the fridge, hehe.","jump":null},{"id":"m_ex_mica_06_21","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_21","text":"Hmm...","jump":null},{"id":"m_ex_mica_06_22","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_22","text":"I'm not sure, but it's squishy.","jump":null},{"id":"m_ex_mica_06_23","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_23","text":"It's fairly large,","jump":null},{"id":"m_ex_mica_06_24","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_24","text":"and there are tiny leg-like appendages attached to it.","jump":null},{"id":"m_ex_mica_06_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_25","text":"??","jump":null},{"id":"m_ex_mica_06_26","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_26","text":"And there are several pairs of eyes on its back.","jump":null},{"id":"m_ex_mica_06_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_27","text":"Wait!","jump":null},{"id":"m_ex_mica_06_28","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_28","text":"Should I try it, since I have it out?","jump":null},{"id":"m_ex_mica_06_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_29","text":"No!","jump":null},{"id":"m_ex_mica_06_30","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_30","text":"No?","jump":null},{"id":"m_ex_mica_06_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_31","text":"Eat it with me later.","jump":null},{"id":"m_ex_mica_06_32","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_32","text":"Oh, okay!","jump":null},{"id":"m_ex_mica_06_33","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_33","text":"That'd be fun.","jump":null},{"id":"m_ex_mica_06_34","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_34","text":"I'll just put this back in the fridge then.","jump":null},{"id":"m_ex_mica_06_35","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_06_35","text":"But you need to come quick.","jump":null},{"id":"m_ex_mica_06_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_36","text":"Okay, got it.","jump":null},{"id":"m_ex_mica_06_37","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_06_37","text":"I've got to visit Mica as soon as I have some spare time.","jump":null}],"chat":true}