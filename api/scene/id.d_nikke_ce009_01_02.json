ng to have a real problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_75","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_75","text":"He's definitely going to end up in a shelter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_76","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_76","text":"Wh-what do we do...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_77","type":"Speech","speaker":"admi","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_77","text":"We'll try to buy you some time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_78","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_78","text":"Yeah, that's the best plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_79","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_79","text":"We'll stall her. Get out of here while you can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_80","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_80","text":"Will that really be okay? I don't want to inconvenience anyone...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_81","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_81","text":"Just consider it my way of saying thanks for showing us the cat...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_82","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_82","text":"No, more importantly, for letting Admi pet him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_83","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_83","text":"Thanks to you, I got to see that cute look on her face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_84","type":"Speech","speaker":"admi","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_84","text":"Y-Yulha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_85","type":"Speech","speaker":"privaty","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_85","text":"Anyway, leave it to us and get going before Leona comes any closer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_86","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_86","text":"... Thank you. I'll leave it to you, then!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_87","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_87","text":"See ya, Admi!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_02_88","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce009_01_02_88","text":"With the Triangle Squad covering her back, Makoto runs in the opposite direction from Leona.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}