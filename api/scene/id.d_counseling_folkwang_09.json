seling_folkwang_09_6","text":"Exactly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_09_7","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_09_7","text":"When you run forward, the cool wind hits your face!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_09_8","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_09_8","text":"The air feels really good on my legs, too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_09_9","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_09_9","text":"You know me best of all!","jump":"d_counseling_folkwang_09_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_09_10","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_09_10","text":"You really think so, Coach?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_09_11","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_09_11","text":"I can't believe it. I thought you'd understand me..","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_09_12","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_09_12","text":"I feel a little sad now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"