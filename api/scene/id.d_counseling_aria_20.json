{"id":"d_counseling_aria_20","cat":"counsel","group":{"id":"char5070","label":"Aria"},"label":"Advising Aria: 20","stage":null,"prev":"d_counseling_aria_19","next":null,"speakers":{"aria":"Aria"},"icons":{"aria":"si_c432_00_s"},"lines":[{"id":"d_counseling_aria_20_1","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_1","text":"Let's say you're an opera composer,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["aria"],"affinity":"_0"},{"id":"d_counseling_aria_20_2","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_2","text":"and your tastes are directly opposed to what the public wants to see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_3","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_3","text":"In the end, who would you compose for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_20_4","text":"For myself.","jump":"d_counseling_aria_20_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_aria_20_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_20_5","text":"For the public.","jump":"d_counseling_aria_20_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_aria_20_6","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_6","text":"... I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_7","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_7","text":"If you work at it hard enough, you'll eventually reach the top of your respective field.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_8","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_8","text":"The question is, when you reach the top, did you get there by being true to yourself or by appealing to the masses?","jump":"d_counseling_aria_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_9","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_9","text":"... That's an old-fashioned answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_10","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_10","text":"That's a treacherous path as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_11","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_20_11","text":"Even the most talented of artists struggle trying to capture what audiences want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_20_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_aria_20_12","text":"I continued to discuss the arduous life of an artist with Aria.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}