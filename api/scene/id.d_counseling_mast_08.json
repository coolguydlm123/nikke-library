ull,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_08_7","type":"Speech","speaker":"mast","key":"Locale_Counseling:d_counseling_mast_08_7","text":"It's more like he's playing with me!","jump":"d_counseling_mast_08_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_08_8","type":"Speech","speaker":"mast","key":"Locale_Counseling:d_counseling_mast_08_8","text":"Hey, come on, Captain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_08_9","type":"Speech","speaker":"mast","key":"Locale_Counseling:d_counseling_mast_08_9","text":"I would never steal a bird's food, no matter how hungry I am!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_08_10","type":"Speech","speaker":"mast","key":"Locale_Counseling:d_counseling_mast_08_10","text":"But, I may have snuck a taste of his jello when I was drunk on rum...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_08_11","type":"Speech","speaker":"morgan","key":"Locale_Counseling:d_counseling_mast_08_11","text":"Best snack with alcohol! Best snack with alcohol!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_08_12","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_mast_08_12","text":"How many times did you do that for him to learn that phrase?","jump":"d_counseling_mast_08_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_08_13"