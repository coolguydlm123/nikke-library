{"id":"d_main_27_03_s","cat":"main","group":{"id":"ch27","label":"Chapter 27 · Exploration"},"label":"Circumstances All Their Own: A","stage":"27-12 STAGE · Start","prev":"d_main_27_02","next":"d_main_27_03_e","speakers":{"shifty":"Shifty","liveryn":"Liveryn","neon":"Neon","anis":"Anis","hammering":"Hammering","elegg":"Elegg","rapi":"Rapi"},"icons":{"shifty":"si_c907_00_s","liveryn":"si_c480_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","hammering":"si_c490_00_s","elegg":"si_c500_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_27_03_s_1","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_27_03_s_1","text":"According to the map, the area with the crystals is not too far from here.","jump":null,"exit":false,"enter":null,"bg":"Desert_05","bgArt":"desert_05","image":null,"bgm":"bgm_aztec_a","movie":null,"shown":["anis","neon","rapi","hammering","liveryn","elegg","shifty"],"affinity":null},{"id":"d_main_27_03_s_2","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_27_03_s_2","text":"That doesn't mean, however, that it's necessarily close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_3","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_27_03_s_3","text":"Liveryn will determine the route and guide you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_4","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_4","text":"Calling it a route is a bit generous. We'll just be doing some light walking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_s_5","text":"I have a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_s_6","text":"When we're up on the surface, aren't we typically part of a squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_7","text":"Yeah, usually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_s_8","text":"But you came up all alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_9","text":"Hey, you're right. That is a bit unusual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_10","text":"Is there any special reason for that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_11","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_11","text":"My colleague, Drilley, is currently working a long-term gig.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_12","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_12","text":"It's part-time, but the pay is out of this world, which you don't see every day, so she can't up and quit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_13","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_13","text":"If she requested to take time off, she might not be able to come back to that job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_14","text":"You're telling me a part-time job is more important than this mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_15","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_15","text":"Yep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_16","text":"... I don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_s_17","text":"What about you, Elegg? Why did you come alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_18","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_18","text":"The Electric Shock Squad isn't really a tight-knit group.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_19","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_19","text":"All of our areas of expertise are different, and none of us have particularly good social skills.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_20","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_20","text":"So we operate alone whenever possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_21","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_21","text":"If we were to attempt to move together, it would only become more chaotic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_22","text":"I can understand where you're coming from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_s_23","text":"It was total pandemonium whenever I used to move around with both Matis and Absolute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_24","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_s_24","text":"They were always talking, talking, talking. So much that I had to set them straight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_25","text":"That's rich, coming from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_26","text":"Anyway, what about you, Liveryn?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_27","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_27","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_28","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_28","text":"Sorry to disappoint, but I'd rather not say. It's rather personal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_29","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_29","text":"I hope you don't mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_30","text":"That's fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_31","text":"You don't need to share anything you're not comfortable with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_27_03_s_32","text":"Did all three of you volunteer for this job?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_33","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_33","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_34","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_34","text":"We talked a lot on the way here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_35","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_35","text":"I don't remember all the details, but suffice to say that the going is getting tough for every one of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_36","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_36","text":"One small misstep, and we might be headed straight to the scrap heap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_27_03_s_37","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_38","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_38","text":"There's no work to go around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_39","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_03_s_39","text":"... The Hammer & Drill Squad specializes in mining.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_40","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_40","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_41","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_41","text":"The only thing is that all the available ore veins nearby and natural resources have been extracted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_42","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_42","text":"Groups like Mighty Tools focus on construction, so they're fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_43","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_43","text":"There are always old buildings that need to be demolished and rebuilt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_44","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_44","text":"But the same can't be said for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_45","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_45","text":"Once a mine has been tapped, that's the end of the story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_46","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_46","text":"In fact, there was a time our squad didn't have a single task for an entire month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_47","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_47","text":"We could disappear into thin air and it wouldn't make a difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_48","text":"So that's why the part-time gig is so important to Drilley.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_49","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_49","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_50","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_s_50","text":"So you volunteered for this because you needed a job?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_51","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_51","text":"Correct again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_52","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_52","text":"New lands mean new work opportunities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_53","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_53","text":"On top of that, a region which is rich in crystals is a place where a mining expert like me could really flourish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_54","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_54","text":"I'll be able to eat the finest food and buy the latest power tool models.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_55","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_55","text":"That's why I volunteered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_56","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_56","text":"It's always stressful when work dries up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_57","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_s_57","text":"Have you also had times when work was hard to come by?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_58","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_58","text":"Me? Oh yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_59","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_59","text":"We're a transportation squad. But in truth, we're little more than glorified delivery drivers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_60","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_60","text":"These days, that work falls to delivery robots and drones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_61","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_61","text":"They don't make any human errors, and they do it safely and quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_62","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_62","text":"There's no reason to continue using us, where there's the chance of an occasional slipup. Not to mention that we tend to be much slower than them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_63","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_63","text":"Everyone always talks about how machines are going to take our jobs away, but I never expected it to happen to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_64","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_64","text":"Then again, we're machines too, so I guess it's machines taking away another machine's job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_65","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_65","text":"Hehe, all the same, you seem to be doing pretty well for yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_66","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_66","text":"Are you kidding?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_67","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_67","text":"You'd be hard-pressed to find as penurious a Nikke as me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_68","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_68","text":"But your scooter seems to be maintained pretty well, and you're always wearing the latest fashions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_69","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_69","text":"You're decked out head to toe in clothing that's both fashionable and serves a purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_70","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_s_70","text":"Hey, you're right. Isn't that a new top from Octopus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_71","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_71","text":"Consider it a business investment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_72","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_72","text":"If we dressed like bums, we'd get even fewer delivery jobs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_73","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_73","text":"So where do you get the money for this \"investment\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_74","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_74","text":"There are still some people who don't want to entrust their deliveries to robots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_75","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_75","text":"Loyal customers of mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_76","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_76","text":"I don't get it. Why use you when robots are objectively better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_77","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_s_77","text":"Uh... well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_78","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_s_78","text":"It doesn't make any sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_s_79","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d