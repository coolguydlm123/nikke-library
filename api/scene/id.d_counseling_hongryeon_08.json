{"id":"d_counseling_hongryeon_08","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 08","stage":null,"prev":"d_counseling_hongryeon_07","next":"d_counseling_hongryeon_09","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_08_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_08_1","text":"Hic... well met, my Lord!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_08_2","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_08_2","text":"Fancy a drop or two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_08_3","text":"Sure, I'll have a drink.","jump":"d_counseling_hongryeon_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_08_4","text":"I think you've had enough for tonight.","jump":"d_counseling_hongryeon_08_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_08_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_08_5","text":"Hic... excellent! As a good Lord should!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_08_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_08_6","text":"Looks like you know how to have a little fun after all!","jump":"d_counseling_hongryeon_08_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_08_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_08_7","text":"Don't say that! I haven't drunk that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_08_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_08_8","text":"My Lord knows how to be a spoilsport, it seems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_08_9","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_08_9","text":"I have a cheerful time with Scarlet.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}