{"id":"memorial_102002","cat":"memorial","group":{"id":"memorial102000","label":"Memoirs · Doomsday Book"},"label":"An Apostle is Born","stage":null,"prev":"memorial_102001","next":"memorial_102003","speakers":{},"icons":{},"lines":[{"id":"memorial_102002_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"Man is foolish and disputes the final judgment."},{"id":"memorial_102002_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"He takes the Lamb of God for granted,"},{"id":"memorial_102002_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"leaving traces of evil in his wake."},{"id":"memorial_102002_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"Yet God is tolerant and kind."},{"id":"memorial_102002_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"New flesh is bestowed."},{"id":"memorial_102002_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"Man's evil, God's child."},{"id":"memorial_102002_7","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"The new apostle of God arises."},{"id":"memorial_102002_8","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_02_description","text":"Thy Kingdom comes, Thy will be done."}]}