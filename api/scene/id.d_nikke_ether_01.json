_ether_01_27","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_27","text":"I really want to tell her to take a bath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_28","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_28","text":"Ugh, whatever. I'll just stay like this. I can handle a little itch...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_29","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ether_01_29","text":"Go... take a shower...","jump":"d_nikke_ether_01_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_30","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ether_01_30","text":"Stop... scratching...","jump":"d_nikke_ether_01_32","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_31","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_31","text":"Ugh, no... Too much work...","jump":"d_nikke_ether_01_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_32","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_32","text":"No, I need to scratch it, or I'll go crazy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_33","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_33","text":"Oh? You're up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"af