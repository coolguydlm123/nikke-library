Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_41","text":"*Cough cough* What's going on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_42","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_42","text":"I thought your cough would be gone by now, but that doesn't seem to be the case...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_43","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_43","text":"Checkup's done. Here you go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_44","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_44","text":"Ether hands over a cup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_45","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_45","text":"Have some water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_46","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_46","text":"*Cough* Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_47","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_47","text":"I take a sip of the water Ether handed me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_48","type":"Self","speaker"