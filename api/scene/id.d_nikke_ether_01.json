"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_62","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_62","text":"Hmm, the symptoms are pretty similar to a cold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_63","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_63","text":"So it's not a cold?","jump":"d_nikke_ether_01_67","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_64","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_64","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_65","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_65","text":"I won't rule it out, but it doesn't seem to be an incurable disease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_66","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_66","text":"What is it then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_67","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_67","text":"I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_68","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_68","text":"You don't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_69","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_69","text":"Judging by the morphology and structure of the virus cell, it's very similar to the cold virus, and the symptoms are alike as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_70","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_70","text":"However, we won't call it a cold","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_71","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_71","text":"because no one in the Ark has ever had this disease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_72","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_72","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_73","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_73","text":"You're the first person to get infected by this virus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_74","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_74","text":"If that's the case, the cure...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_75","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_75","text":"Doesn't exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_76","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_76","text":"Do you understand why you're here in M.M.R. now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_77","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_77","text":"That's because we need to develop the cure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_78","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_78","text":"Bingo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_79","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_79","text":"*Yawn* So, I don't need to explain any further, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_80","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_80","text":"Ether slumps back down into the chair next to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_81","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_81","text":"Ether, shouldn't you stay away from me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_82","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_82","text":"Me? Why? Do you not like me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_83","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_83","text":"Am I that bad you want to replace me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_84","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_84","text":"What if I end up passing it to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_85","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_85","text":"Ah, so that's what you're on about...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_86","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_86","text":"There's no way a human could ever pass a virus to a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_87","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_87","text":"Apart from the brain, the makeup of humans and Nikkes is totally different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_88","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_88","text":"Unless the virus is specifically modified for Nikkes and injected directly with a syringe or something along those lines,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_89","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_89","text":"we won't catch the same diseases humans do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_90","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_90","text":"That's a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_91","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_91","text":"Yeah, that's right. I'm glad I won't be replaced either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_92","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_92","text":"After all, I've stayed up late for this for a few nights... *Yawn*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_93","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_93","text":"Thanks for everything... *Cough cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_94","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_94","text":"Right, I totally forgot to give you the pill. This is why you shouldn't be asking questions while I'm working.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_95","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_95","text":"Ether takes out the pill from the medicine bottle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_96","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_96","text":"What's this...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_97","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_97","text":"Quit staring and just take it with the water already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_98","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_98","text":"Didn't you say there's no cure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_99","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_99","text":"Yes, it's still under development.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_100","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_100","text":"This is the medicine that's being developed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_101","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_101","text":"Is it okay to eat this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_102","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_102","text":"Don't worry. Even though I'm a researcher, I'm just an ordinary office worker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_103","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_103","text":"You're not a criminal sent to the Rehabilitation Center,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_104","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_104","text":"nor a volunteer test subject.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_105","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_105","text":"I don't have permission to test the medicine on you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_106","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_106","text":"so just trust me and take it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_107","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_107","text":"... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_108","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_108","text":"Yeah, you should be very grateful. I didn't even get to wash up yesterday because I was busy testing that stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_109","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_109","text":"Not because it was a bother?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_110","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_110","text":"That's too much. How could you say that to someone who pulled an all-nighter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_111","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_111","text":"*Yawn* Hurry up and take it. I've got a ton of stuff to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_112","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_112","text":"I take the pill given by Ether.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_113","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_113","text":"All right. I've seen you take the pill. No. 7, what you're gonna do is to...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_114","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_114","text":"Ether holds out a tablet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_115","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_115","text":"What's this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_116","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_116","text":"A letter of consent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_117","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_117","text":"Until a cure is found for the new virus in M.M.R., you must store all personal belongings here and fully cooperate with the research.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_118","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_118","text":"You're not to disclose anything you see, hear, or experience inside the lab, even after you leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_119","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_119","text":"If you violate the agreement, you're agreeing to accept any and all consequences.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_120","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_120","text":"Go on. Take your time, read it carefully, and sign.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_121","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_121","text":"Do I really have to sign it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_122","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_122","text":"If you don't want treatment, then don't. You'll just be left to rot in an isolation room until you die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_123","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_123","text":"But who knows? You might just recover and survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_124","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_124","text":"Oh, and just so you know, if you don't sign it, you won't get any food either. Providing meals is part of the treatment, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_125","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_125","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_126","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_01_126","text":"You're not going to put me through some weird experiment, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_127","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_127","text":"Like I said before, I don't have the permission to use you as a test subject.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_128","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_01_128","text":"Either you sign this or you're going to the Rehabilitation Center. So stop making a fuss and just sign.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":nul