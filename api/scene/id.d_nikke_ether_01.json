":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_14","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_14","text":"I can feel the heat rising all the way to the top of my head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_15","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_ether_01_15","text":"We've gotta get to the hospital NOW!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_16","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_ether_01_16","text":"No, contact M.M.R.!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_17","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_17","text":"My consciousness is fading.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_18","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_ether_01_18","text":"*Beep beep beep beep*","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_19","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_19","text":"A consistent sound from a machine fills the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_01_20","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_01_20","text":"The acrid scent of disinfectant and...