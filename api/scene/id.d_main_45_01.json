{"id":"d_main_45_01","cat":"main","group":{"id":"ch45","label":"Chapter 45 · The Price of Sin"},"label":"Healthy Body, Strong Weapon","stage":"45-1 STAGE · End","prev":null,"next":"d_main_45_02","speakers":{"snowwhite_h":"Snow White","cecil":"Cecil","papillon":"Papillon","johan":"Johan","ingrid":"Ingrid","neon_v":"Neon","anis_i":"Anis","rapi_red":"Rapi","neon_v_w":"Neon"},"icons":{"snowwhite_h":"si_c471_00_s","cecil":"si_c929_00_s","papillon":"si_c890_00_s","johan":"si_c925_00_s","ingrid":"si_c900_00_s","neon_v":"si_c018_00_s","anis_i":"si_c017_00_s","rapi_red":"si_c016_00_s","neon_v_w":"si_c018_00_s"},"lines":[{"id":"d_main_45_01_1","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_1","text":"... You heard from Nayuta?","jump":null,"exit":false,"enter":null,"bg":"EdenIndoor","bgArt":"edenindoor","image":null,"bgm":"event_bgm_goddessfall_tearsofeden","movie":null,"shown":["snowwhite_h","cecil","papillon","johan"],"affinity":null},{"id":"d_main_45_01_2","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_2","text":"Yes. She said something is bothering her, and proposed a joint investigation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_3","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_3","text":"All right. What's the location?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_4","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_4","text":"That's what has me a bit concerned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_5","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_5","text":"It's the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_6","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_6","text":"... The Lift?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_7","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_7","text":"I suppose it's more accurate to say the route leading to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_8","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_8","text":"Unlike the area immediately surrounding the Lift, there shouldn't be too many Raptures there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_9","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_9","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_10","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_10","text":"Are you afraid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_11","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_11","text":"Of course not. Do you have the coordinates?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_12","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_12","text":"Nayuta gave us a rendezvous point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_13","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_13","text":"She wants you to wait for her there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_14","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_14","text":"Wait, you're really going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_15","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_15","text":"Don't worry, I won't ask you to come. Just focus on your training.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_16","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_16","text":"Oh, I wasn't worried about that. I never expected you to take me along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_17","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_17","text":"But if you go, this place will be completely empty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_18","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_18","text":"... What if there's another attack?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_19","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_19","text":"Then fight them off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_20","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_20","text":"Do you think we'd be having this conversation if I thought I could do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_21","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_21","text":"It'll be fine. Go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_22","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_22","text":"Care to explain what you mean by \"fine\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_23","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_23","text":"You-know-who said he'd send reinforcements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_24","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_24","text":"Oh? Honey's sending reinforcements? From the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_25","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_25","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_26","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_26","text":"Then from where?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_27","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_27","text":"Hm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_28","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_28","text":"You'll have to see for yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_29","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_29","text":"To be honest, I still can't really believe it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_30","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_30","text":"I doubt I'll be completely convinced until it actually happens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_31","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_31","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_32","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_32","text":"Regardless, we should be able to hold out until they arrive, even if they get delayed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_33","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_33","text":"Indeed. We've expanded the range of our optical camouflage and refined Eden's Spear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_34","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_34","text":"We can hold out for several days, barring a visit from the Queen herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_35","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_45_01_35","text":"Should that happen... we won't last half a day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_36","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_36","text":"It sounds like you're telling me not to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_37","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_37","text":"Quite the opposite. We're saying you can go without worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_38","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_38","text":"It's critical that we gather more intel, especially now, when we don't know what the Queen intends to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_39","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_39","text":"Go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_40","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_41","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_45_01_41","text":"All right. I'll be off, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_45_01_42","text":"Snow White walks away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_43","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_44","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_44","text":"When do you think we'll be able to produce Nikkes? Has Honey contacted you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_45","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_45_01_45","text":"That technology is as classified as it gets. We won't get our hands on it overnight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_46","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_46","text":"Hm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_47","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_45_01_47","text":"I hope he's all right...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_48","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_48","text":"...","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":null,"movie":null,"shown":["anis_i","ingrid","neon_v","rapi_red"],"affinity":null},{"id":"d_main_45_01_49","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_51","text":"In the CEO's office at Elysion...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_52","text":"We've come to meet Ingrid, but her silence is so imposing that none of us can bring ourselves to speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_53","text":"She sighs as she looks over Neon's new body, then furrows her brow, then opens her mouth as if to scold her before closing it again and falling back into thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_54","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_54","text":"She repeats this over and over for a full ten minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_55","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_56","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_57","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_57","text":"Tactics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_58","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_58","text":"Entertainment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_59","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_59","text":"Wh-what...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_theruinedcity","movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_60","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_60","text":"It was so quiet, I thought someone should say something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_61","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_61","text":"Yeah, the silence was killing me too...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_62","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_63","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_63","text":"Technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_64","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_64","text":"You're an Elysion Nikke! Don't say the Missilis slogan!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_65","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_65","text":"I mean, you were just staring at me without saying anything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_66","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_66","text":"*Sigh...*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_67","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_67","text":"This is the first time an Elysion Nikke has ever transferred into a Missilis body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_68","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_68","text":"Frankly, I have no clue what to do about it, let alone what to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_69","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_69","text":"Really? I figured you'd say something like, \"This calls for a tactical approach!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_70","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_70","text":"You can't use that word for just anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_71","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_71","text":"Says the one who uses it for everything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_72","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_72","text":"I spoke with the representative from M.M.R.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_73","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_73","text":"They've agreed that your affiliation is to remain with Elysion, and we will continue to take full responsibility for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_74","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_74","text":"The issue is that your specifications are rather singular.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_75","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_75","text":"Of course they are. I'm special! Completely one of a kind!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_76","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_76","text":"That means that every time you need repairs, you'll have to go to Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_77","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_77","text":"... Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_78","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_78","text":"All your parts, as well as their implementation, are proprietary. On top of that, they're too advanced for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_79","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_79","text":"Regrettably, Elysion in its current state cannot fully comprehend all of the technology in your body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_80","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_80","text":"They say you're immune to E2 Crystals, Dark Matter... even corruption, at least in theory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_81","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_81","text":"It's absurd... Such convenient technology is far removed from what it means to be tactical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_82","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_82","text":"Overcoming weakness through strategy is the very essence of tactics...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_83","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_83","text":"In any case, only Missilis is capable of engineering bodies with such technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_84","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_84","text":"Which is to say, you'll have to go to them every time an issue arises.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_85","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_85","text":"Ugh, that sounds like a pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_86","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_86","text":"You brought this upon yourself by running off and getting yourself a new body from someone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_87","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_87","text":"My bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_88","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_88","text":"*Sigh...* Elysion managing a Missilis-made body...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_89","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_89","text":"Life's never short on surprises.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_90","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_90","text":"That's what I hear from people who're super old.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_91","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_92","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_92","text":"Uh, sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_93","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_93","text":"We're short on time, so we'll iron out the details as we go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_94","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_94","text":"Ingrid presses a button on her desk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_95","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_95","text":"Bring it in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_96","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_96","text":"Hmm? Bring what in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_97","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_97","text":"Ooh, I bet it's a birthday cake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_98","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_98","text":"Wait, whose birthday is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_99","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_99","text":"She probably means for you, to commemorate your new life in this body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_100","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_100","text":"Our CEO may seem stone-cold serious on the outside, but we all know she's a softy on the inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_101","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_101","text":"Aw, that's so sweet... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_102","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_102","text":"... I don't even know how to respond to any of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_103","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_103","text":"... I apologize for their behavior.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_104","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_45_01_104","text":"*Clank, clank*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soldiereg","redowl"],"affinity":null},{"id":"d_main_45_01_105","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_45_01_105","text":"*Thud*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_106","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_106","text":"Two mass-produced Nikkes, visibly straining, bring in a large container and set it down on the floor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_107","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_107","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_108","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_108","text":"The mass-produced Nikkes salute and withdraw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_109","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_109","text":"Wow, that's huge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_110","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_110","text":"... Is it a coffin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_111","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_111","text":"Unbelievable. She makes one small mistake and you're ready to bury her six feet under?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_112","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_112","text":"{AccountData.NickName}, could you please instruct your squad to be quiet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_113","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_113","text":"If you want to keep me quiet, you'll have to use your mouth, Commander! Mwa mwa!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_114","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_114","text":"Mwa...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_115","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_115","text":"Mm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_116","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_116","text":"Err...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_117","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_117","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_118","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_118","text":"Did you just get embarrassed by your own joke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_119","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_119","text":"This is why you need to develop a habit of thinking before making a joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_120","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_120","text":"Ahaha...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_121","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_121","text":"You all are really something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_122","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_122","text":"Anyway, open it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_123","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_123","text":"I step toward the container and reach for the button to open it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_124","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_124","text":"Given the circumstances, shouldn't Neon be the one opening it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_125","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_125","text":"I, uh... thought I saw some gunk on the button and was gonna wipe it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_126","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_126","text":"Interesting that you just assume you should take the lead, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_127","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_127","text":"Yeah, pretty presumptuous of you to waltz up there like you're the leader.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_128","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_128","text":"But... I am the leader...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_129","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_129","text":"Could you all shush? I'm pretty sure I'm the main character this time around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_130","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_130","text":"Neon strides forward confidently and presses the button.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_131","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_45_01_131","text":"*Pshhhhh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_132","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_01_132","text":"The container opens, revealing something large and beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_133","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_133","text":"... What is that, a steel sleeping bag?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_134","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_134","text":"It looks like a tool. Maybe you're getting reassigned to Mighty Tools.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_135","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_135","text":"What?! Am I being sent to Missilis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_136","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_01_136","text":"... It's a gun. That's definitely a gun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_137","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_137","text":"I'm glad at least one of you could tell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_138","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_138","text":"It's... a gun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_139","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_139","text":"Pick it up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_140","type":"Speech","speaker":"neon_v","key":"Locale_MainScenario:d_main_45_01_140","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon_v_w"],"affinity":null},{"id":"d_main_45_01_141","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_45_01_141","text":"It's... it's like firepower incarnate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_142","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_142","text":"It's a monster of a weapon, loaded with every technology available to Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_143","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_143","text":"We could never resolve the issue of the power source, so it never passed the concept phase.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_144","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_144","text":"We were finally able to complete it thanks to a power unit provided by Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_145","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_45_01_145","text":"Ahh, so that's why both the Elysion and Missilis logos are on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_146","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_146","text":"Yes. Naturally, we take copyrights seriously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_147","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_147","text":"Now, when you fire the weapon, its power source will resonate with your body, generating golden particles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_148","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_148","text":"Those particles will apparently affect both the gun itself and the bullets, but as to what effect they'll have, we still don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_149","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_149","text":"Once we obtain battle data, we can begin proper research.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_150","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_150","text":"For any other details, you may refer to the manual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_151","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_45_01_151","text":"Wow... This thing looks like you could shoot lasers out of it. Pew pew!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_152","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_152","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_153","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_153","text":"The only things permitted to be shot from that barrel are bullets and shells! It cannot and will not ever be a laser weapon!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_154","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_154","text":"Commit this to memory! Only weapons that use live ammunition are tactical! Anything else is heresy! A sham! Understood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_155","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_45_01_155","text":"Yes, ma'am! Understood! Long live live ammunition!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_156","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_156","text":"Whew... Much better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_157","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_45_01_157","text":"How is it even all that different? It still needs a power source to function...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_158","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_158","text":"Take it. It was made just for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_159","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_45_01_159","text":"Thanks. I'll put it to good use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_160","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_160","text":"Make sure to capture Sixo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_161","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_161","text":"I've received a message from Mustang. He says not to keep you too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_162","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_162","text":"You should head over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_163","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_163","text":"Instructor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_164","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_164","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_165","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_165","text":"Do you have anything for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_166","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_166","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_167","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_45_01_167","text":"That's cold...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_168","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_45_01_168","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_169","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_169","text":"What is it now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_170","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_45_01_170","text":"Thank you. For everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_171","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_171","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_01_172","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_45_01_172","text":"... You better get going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}