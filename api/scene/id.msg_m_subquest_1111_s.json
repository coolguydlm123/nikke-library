{"id":"msg_m_subquest_1111_s","cat":"messenger","group":{"id":"room_grandpa","label":"Old Man · Quest"},"label":"1. Hello, Commander.","stage":null,"prev":null,"next":"msg_m_subquest_1111_e","speakers":{"grandpa":"Old Man"},"icons":{},"lines":[{"id":"m_subquest_1111_s_1","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_1","text":"Hello, Commander.","jump":null},{"id":"m_subquest_1111_s_2","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_2","text":"I know how much you're all going through trying to reclaim the surface,","jump":null},{"id":"m_subquest_1111_s_3","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_3","text":"but I'd like to ask you for a favor before I pass on.","jump":null},{"id":"m_subquest_1111_s_4","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1111_s_4","text":"Before you pass on?","jump":null},{"id":"m_subquest_1111_s_5","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_5","text":"That's right.","jump":null},{"id":"m_subquest_1111_s_6","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_6","text":"I thought I would give up on life as I got older,","jump":null},{"id":"m_subquest_1111_s_7","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_7","text":"but it's quite the opposite.","jump":null},{"id":"m_subquest_1111_s_8","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_8","text":"We, humans, are peculiar creatures, aren't we?","jump":null},{"id":"m_subquest_1111_s_9","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1111_s_9","text":"What do you need?","jump":null},{"id":"m_subquest_1111_s_10","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_10","text":"I had a house.","jump":null},{"id":"m_subquest_1111_s_11","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_11","text":"A nice house, a peaceful life, and a normal family.","jump":null},{"id":"m_subquest_1111_s_12","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_12","text":"Can you make a trip there?","jump":null},{"id":"m_subquest_1111_s_13","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1111_s_13","text":"And then what?","jump":null},{"id":"m_subquest_1111_s_14","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_14","text":"Bring something back that I could have as a memento.","jump":null},{"id":"m_subquest_1111_s_15","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_15","text":"If you don't find anything,","jump":null},{"id":"m_subquest_1111_s_16","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_16","text":"then just consider it a pointless request from a doddering old man,","jump":null},{"id":"m_subquest_1111_s_17","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_17","text":"and come back safe.","jump":null},{"id":"m_subquest_1111_s_18","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1111_s_18","text":"All right, we'll go check.","jump":null},{"id":"m_subquest_1111_s_19","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_19","text":"I'll send you the location later.","jump":null},{"id":"m_subquest_1111_s_20","type":"Speech","speaker":"grandpa","key":"Locale_SubScenario:m_subquest_1111_s_20","text":"Thank you.","jump":null}],"chat":true}