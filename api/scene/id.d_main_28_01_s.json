{"id":"d_main_28_01_s","cat":"main","group":{"id":"ch28","label":"Chapter 28 · The Unknown"},"label":"Eroded City: A","stage":"28-3 STAGE · Start","prev":null,"next":"d_main_28_01_e","speakers":{"elegg":"Elegg","liveryn":"Liveryn","hammering":"Hammering","shifty":"Shifty","rapi":"Rapi"},"icons":{"elegg":"si_c500_00_s","liveryn":"si_c480_00_s","hammering":"si_c490_00_s","shifty":"si_c907_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_28_01_s_1","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_1","text":"Oh my gosh...","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":"bgm_destroyingcalamity_a","movie":null,"shown":["elegg","liveryn","hammering"],"affinity":null},{"id":"d_main_28_01_s_2","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_2","text":"This is like a crystal field.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_3","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_3","text":"If you take out the danger aspect, it looks quite beautiful, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_4","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_01_s_4","text":"You're right. It's pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_5","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_5","text":"Something tells me the map won't be of much use here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_6","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_6","text":"With all these crystals sprouting everywhere, the pathways are completely different from what's on the map.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_7","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_01_s_7","text":"Isn't that what we've got you for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_8","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_8","text":"That's true, but I'm only good at applying what I've memorized.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_9","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_9","text":"I'm not so great at forging completely new paths.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_10","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_10","text":"What? Are you serious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_11","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_11","text":"... Nope. Hehe. I'm actually quite good at that too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_12","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_12","text":"There's a reason they sent me as Pathfinder's representative.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_13","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_13","text":"Ha, you got me good!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_14","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_14","text":"Still, though, why are there so many crystals here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_15","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_15","text":"This was originally a moderate-sized city, right? It must be teeming with energy that could serve as nutrients for these crystals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_16","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_16","text":"And look over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_17","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_28_01_s_17","text":"I look in the direction Elegg is pointing.","jump":null,"exit":false,"enter":null,"bg":"Crystalchunk","bgArt":"crystalchunk","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_28_01_s_18","text":"It's a giant, circular crystal, with light shining from it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_28_01_s_19","text":"Although the view of it is partially blocked by buildings and other crystals, its size is still formidable enough to remain intimidating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_20","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_20","text":"That crystal is lighting up a city of this size all on its own.","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_21","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_21","text":"I bet you can feel the heat emanating from it if you get close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_22","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_22","text":"It must be giving off a tremendous amount of energy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_23","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_23","text":"I'm not entirely sure, but I'm willing to bet that thing is the source of all the other crystals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_24","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_24","text":"Or something important like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_25","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_25","text":"If everyone else agrees, I say we make our way towards it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_26","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_26","text":"Wow, you're really raring to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_27","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_27","text":"I've been that way from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_28","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_28","text":"If I didn't feel inspired after seeing it with my own eyes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_29","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_29","text":"I could hardly call myself someone with a thirst for knowledge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_30","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_30","text":"Interesting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_31","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_31","text":"I'll leave it to you to mark the map, Ms. Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_28_01_s_32","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_32","text":"Even if we don't know where we're going, we'll need to keep track of where we came from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_33","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_01_s_33","text":"Already on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_34","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_01_s_34","text":"However, the Alva Particle concentration here is stunningly low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_35","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_01_s_35","text":"This is the first time I've seen levels this low on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_36","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_01_s_36","text":"We can investigate that later if we have time. There might be some connection between the Alva Particles and the crystals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_37","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_01_s_37","text":"Fair enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_38","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_01_s_38","text":"So, which way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_28_01_s_39","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_39","text":"Just go straight for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_40","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_01_s_40","text":"There should be a fork in the road up ahead. I'll guide you once you get there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_41","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_01_s_41","text":"Okay. Then I'll take the lead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_01_s_42","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_28_01_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}