ype":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_02_s_6","text":"Y-you use a sword?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_7","text":"Scarlet also uses swords.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_8","text":"Hers doesn't transform into a hair clip though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_9","text":"How does that work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_10","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_10","text":"I'm not familiar with the mechanics of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_11","text":"If that's possible, do you think you could get a pair of glasses to turn into a gun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_12","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_12","text":"I'm not sure about glasses, but we do have drones that transform into weapons as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_13","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_14","type":"Speech","speaker":"soundonly_a","key":"Locale_MainScenario:event_ce006_1_02_s_14","text":"Now it's our turn to show you something cool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soundonly_l"],"affinity":null},{"id":"event_ce006_1_02_s_15","type":"Speech","speaker":"soundonly_l","key":"Locale_MainScenario:event_ce006_1_02_s_15","text":"Show 'em, EVE.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_02_s_16","text":"Gah! What the... where did you come from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_17","type":"Speech","speaker":"soundonly_l","key":"Locale_MainScenario:event_ce006_1_02_s_17","text":"That drone EVE has is also outfitted with a communication function,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_18","type":"Speech","speaker":"soundonly_l","key":"Locale_MainScenario:event_ce006_1_02_s_18","text":"and that's not all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_1_02_s_19","text":"As EVE stretches her hand forward, the drone floating beside her moves accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_20","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_1_02_s_20","text":"With a mechanical whirring, the drone transforms into a gun and attaches itself to EVE's arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_21","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_21","text":"Such... Such firepower!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_22","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_22","text":"... Very impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_23","type":"Speech","speaker":"soundonly_l","key":"Locale_MainScenario:event_ce006_1_02_s_23","text":"I made it myself! I call it the Artemis Cannon, aka Drone 2.0!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soundonly_l"],"affinity":null},{"id":"event_ce006_1_02_s_24","type":"Speech","speaker":"soundonly_l","key":"Locale_MainScenario:event_ce006_1_02_s_24","text":"It's compatible with five different ammo types.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_25","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_25","text":"Can you make a pair of glasses for me that could turn into a gun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_26","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_26","text":"Oooh, and have it be compatible with twenty types of ammo!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_27","type":"Speech","speaker":"soundonly_l","key":"Locale_MainScenario:event_ce006_1_02_s_27","text":"Uh... I'll try my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_02_s_28","text":"You can ignore half of what she says, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_29","text":"So you use a sword for close combat, and firearms for ranged combat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_30","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_30","text":"Pretty much, though it can change depending on the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_32","text":"EVE.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_33","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_33","text":"I mean no offense, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_34","text":"Whenever people say that, they're totally about to say something offensive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_35","text":"It might be best not to use your sword.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_36","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_36","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_37","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_38","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_38","text":"Very well. I won't use it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_39","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_39","text":"Your primary offensive strategy is engaging in long-range combat using firearms. All of your established tactics and formations are based around that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_40","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_40","text":"If I were to start using a sword, it would throw everything off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_41","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_41","text":"Precisely. Thank you for understanding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_42","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_s_42","text":"Not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_02_s_43","text":"Wow, so friendly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_44","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_02_s_44","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_s_45","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_s_45","text":"There's a scrap heap further up ahead. We should be able to find the parts we need there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}