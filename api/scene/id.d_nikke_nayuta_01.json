null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_01_62","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_01_62","text":"Ha! Is it so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_01_63","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_01_63","text":"'Tis true, as our acquaintance is yet in its tenderest infancy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_01_64","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_01_64","text":"Nayuta rises from her seat","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_01_65","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_01_65","text":"and stretches out an arm as though to guide the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_01_66","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_01_66","text":"Wilt thou walk a while with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_01_67","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_01_67","text":"There be a few inquiries I would fain put to thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_01_68","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_01_68","text":"... I'll lead the way.","jump":null,"exit":false,"enter":null,"bg"