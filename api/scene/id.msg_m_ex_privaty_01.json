xt":"Too late!","jump":null},{"id":"m_ex_privaty_01_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_13","text":"What's the matter?","jump":null},{"id":"m_ex_privaty_01_14","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_14","text":"Save it! I don't want to talk to you.","jump":null},{"id":"m_ex_privaty_01_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_15","text":"Okay.","jump":null},{"id":"m_ex_privaty_01_16","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_16","text":"Huh?","jump":null},{"id":"m_ex_privaty_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_17","text":"You said you would not talk to me?","jump":null},{"id":"m_ex_privaty_01_18","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_18","text":"Um.","jump":null},{"id":"m_ex_privaty_01_19","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_19","text":"When having done something wrong,","jump":null},{"id":"m_ex_privaty_01_20","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_20","text":"even a child knows to say sorry, right?","jump":null},{"id":"m_ex_privaty_01_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_21","text":"No.","jump":null},{"id":"m_ex_privaty_01_22","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_22","text":"What?","jump":null},{"id":"m_ex_privaty_01_23","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_23","text":"What do you mean?","jump":null},{"id":"m_ex_privaty_01_24","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_24","text":"Ugh, Commander!","jump":null},{"id":"m_ex_privaty_01_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_25","text":"I'm sorry.","jump":null},{"id":"m_ex_privaty_01_26","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_26","text":"What?","jump":null},{"id":"m_ex_privaty_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_27","text":"Will you come up here today?","jump":null},{"id":"m_ex_privaty_01_28","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_28","text":"Um... well...","jump":null},{"id":"m_ex_privaty_01_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_29","text":"I know you're texting me about that.","jump":null},{"id":"m_ex_privaty_01_30","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_30","text":"That's right.","jump":null},{"id":"m_ex_privaty_01_31","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_31","text":"... Seems that you are ignoring what you did.","jump":null},{"id":"m_ex_privaty_01_32","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_32","text":"But yes.","jump":null},{"id":"m_ex_privaty_01_33","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_33","text":"I was contacted to be up in the Outpost.","jump":null},{"id":"m_ex_privaty_01_34","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_34","text":"That's why I sent a message to you.","jump":null},{"id":"m_ex_privaty_01_35","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_35","text":"Hmm! So if that's the case,","jump":null},{"id":"m_ex_privaty_01_36","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_36","text":"let's get along well.","jump":null},{"id":"m_ex_privaty_01_37","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_37","text":"If you get in trouble on missions, it's OK to ask me for help, you know?","jump":null},{"id":"m_ex_privaty_01_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_01_38","text":"Looking forward to it.","jump":null},{"id":"m_ex_privaty_01_39","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_39","text":"Well, in that case...","jump":null},{"id":"m_ex_privaty_01_40","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_40","text":"I'm also","jump":null},{"id":"m_ex_privaty_01_41","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_01_41","text":"looking forward to working with you.","jump":null}],"chat":true}