ll,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_15","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_15","text":"you can stop the act.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_16","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_16","text":"Huh? Wh-what are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_17","text":"Are you trying to make yourself look weak so I'll lower my guard and give you what you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_18","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_18","text":"If that's the case, you can give up now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_19","text":"I'm not letting my guard down for anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_20","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_21","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_21","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_22","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_22","text":"You're nothing if not perspicacious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_23","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_23","text":"That's because I pay more attention than most.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_24","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_24","text":"Good. Now, tell me what you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_25","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_25","text":"What does Eden want from the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_26","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_26","text":"We want our own broadcast channel inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_27","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_27","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_28","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_28","text":"You heard me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_29","type":"Speech","speaker":"burningum","