ovie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_36","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_36","text":"I could give you a peripheral channel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_37","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_37","text":"That will suffice for the time being.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_38","text":"I'll hand over materials detailing how we do our metal processing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_39","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_39","text":"Not all Goddesiums are the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_40","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_40","text":"... Good. I'll accept that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_41","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_41","text":"What would you want the Ark to do for you in the future?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_42","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_42","text":"Give us one more channel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_43","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_44","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_44","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_45","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_45","text":"Are you planning on making Eden seem like some kind of utopia to foment insurrection in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_46","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_46","text":"It'll only be on a peripheral channel, like you said. What are you worried about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_47","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_47","text":"I guess the Ark is weaker than I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_48","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_48","text":"... I'll think about it, but only after we've received the materials pertaining to metal processing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_49","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_49","text":"Fine by me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_50","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_50","text":"If that's everything, I'm heading out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_51","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_51","text":"Where are you going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_52","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_52","text":"I assume you'll need some time to ruminate on your decision, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_53","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_53","text":"I know you won't be the only one involved in the decision-making process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_54","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_54","text":"... Fine. I'll provide you with somewhere in the Ark where you can stay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_55","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_26_9_55","text":"Just be aware that you're being watched around the clock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_9_56","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_9_56","text":"Duly noted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image"