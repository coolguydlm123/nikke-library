esti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_11","text":"that I can't hold it in any longer!","jump":null},{"id":"m_ex_vesti_tactical_01_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_12","text":"What is it?","jump":null},{"id":"m_ex_vesti_tactical_01_13","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_13","text":"Commander,","jump":null},{"id":"m_ex_vesti_tactical_01_14","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_14","text":"how do I look","jump":null},{"id":"m_ex_vesti_tactical_01_15","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_15","text":"after my tactical upgrade?","jump":null},{"id":"m_ex_vesti_tactical_01_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_16","text":"What do you mean?","jump":null},{"id":"m_ex_vesti_tactical_01_17","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_17","text":"What I mean is...","jump":null},{"id":"m_ex_vesti_tactical_01_18","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_18","text":"Um...","jump":null},{"id":"m_ex_vesti_tactical_01_19","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_19","text":"Do I look stronger? Cooler? Or something like that?","jump":null},{"id":"m_ex_vesti_tactical_01_20","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_20","text":"I'm kinda curious what you think.","jump":null},{"id":"m_ex_vesti_tactical_01_21","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_21","text":"You looked so strong that it even scared me.","jump":"m_ex_vesti_tactical_01_23"},{"id":"m_ex_vesti_tactical_01_22","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_22","text":"You looked so cool that I felt like I might fall for you.","jump":"m_ex_vesti_tactical_01_29"},{"id":"m_ex_vesti_tactical_01_23","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_23","text":"Oh...","jump":null},{"id":"m_ex_vesti_tactical_01_24","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_24","text":"You're scared of me? T_T","jump":null},{"id":"m_ex_vesti_tactical_01_25","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_25","text":"Do you think I'm like a monster or something?","jump":null},{"id":"m_ex_vesti_tactical_01_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_26","text":"No, that's not it. I was just saying you look strong.","jump":null},{"id":"m_ex_vesti_tactical_01_27","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_27","text":"Oh, I see.","jump":null},{"id":"m_ex_vesti_tactical_01_28","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_28","text":"That's a relief. >.<","jump":"m_ex_vesti_tactical_01_34"},{"id":"m_ex_vesti_tactical_01_29","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_29","text":"Really?","jump":null},{"id":"m_ex_vesti_tactical_01_30","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_30","text":">////<","jump":null},{"id":"m_ex_vesti_tactical_01_31","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_31","text":"Do I really look that cool?","jump":null},{"id":"m_ex_vesti_tactical_01_32","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_32","text":"That's fantastic!","jump":null},{"id":"m_ex_vesti_tactical_01_33","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_33","text":"Thanks, Commander!","jump":"m_ex_vesti_tactical_01_34"},{"id":"m_ex_vesti_tactical_01_34","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_34","text":"I'll do my best","jump":null},{"id":"m_ex_vesti_tactical_01_35","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_35","text":"to get even better feedback from you!","jump":null},{"id":"m_ex_vesti_tactical_01_36","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_36","text":"So... please keep watching over me from now on, okay?","jump":null},{"id":"m_ex_vesti_tactical_01_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_37","text":"Of course. Keep it up.","jump":null},{"id":"m_ex_vesti_tactical_01_38","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_38","text":"Hehe, it's really nice to have you cheering me on, Commander.","jump":null},{"id":"m_ex_vesti_tactical_01_39","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_39","text":"Thanks!","jump":null},{"id":"m_ex_vesti_tactical_01_40","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_40","text":"I'll do my best!","jump":null},{"id":"m_ex_vesti_tactical_01_41","type":"Speech","speaker":"vesti_t","key":"Locale_SuddenMessage:m_ex_vesti_tactical_01_41","text":"The same goes for you, Commander!","jump":null}],"chat":true}