eech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_58","text":"Non, non! C'est très différent!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_59","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_59","text":"I don't want disorder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_60","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_60","text":"Why us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_61","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_61","text":"There are other ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_62","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_62","text":"You could ask any one of your cronies to take over the world of organized crime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_63","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_63","text":"Why ask the three of us to do it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_64","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_64","text":"Why make it so complicated?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_65","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_65","text":"Only those who have known darkness will not fall victim to its temptations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_66","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_66","text":"Besides, don't you all see the outlaws as des humains?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_67","type":"Speech","speaker":"moran","key":"Locale_SubScenario:event_cherryblossom_intermission_01_67","text":"What are you blabbering about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_68","type":"Speech","speaker":"moran","key":"Locale_SubScenario:event_cherryblossom_intermission_01_68","text":"What else should we see them as? They're humans, duh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_69","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_69","text":"Oui! C'est correct. They are in fact humains. That is obvious, to be sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_70","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_70","text":"However, as you are well aware, there are many who do not regard them as such.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_71","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_71","text":"Many don't treat them humanely due to the fact","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_72","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_72","text":"they have no money or a place to live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_73","type":"Speech","speaker":"moran","key":"Locale_SubScenario:event_cherryblossom_intermission_01_73","text":"Well... That's true, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_74","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_74","text":"Humans who have never lived in darkness could never comprendre where the darkness comes from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_75","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_75","text":"Who knows what things they would end up doing for their own gain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_76","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_76","text":"This is not what I'm after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_77","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_77","text":"That is why I chose you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_78","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_78","text":"You understand both the Outer Rim and the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_79","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_79","text":"and you have experienced your fair share of darkness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_80","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_80","text":"What is your game here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_81","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_81","text":"What's a CEO of the Big Three doing bending over backwards to help the Outer Rim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_82","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_82","text":"Oh la la, whatever do you mean by \"help\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_83","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_83","text":"The reason I want you isn't for the good of the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_84","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_84","text":"Nor is it out of any love for humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_85","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_85","text":"It is to restore peace in the Ark, where society has become tres polarized.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_86","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_86","text":"There is mutual enmity between those who are excluded, and those who are not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_87","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_87","text":"War continuer to rage on long after people have begun to forget why it commencer in the first place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_88","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_88","text":"Should this situation continue, the Ark will crumble.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_89","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_89","text":"I cannot allow l'humanité to fall by the wayside so frivolously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_90","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_90","text":"The protecteurs of my choosing must have a certain affection for l'humanité.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_91","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_91","text":"To merely exist is not enough, non!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_92","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_92","text":"Entterrtaaainnment!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_93","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_93","text":"This is the manner in which they should live their lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_94","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_94","text":"Otherwise, life has no meaning, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_95","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_95","text":"La race humaine must band together and prouver that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_96","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_96","text":"my Goddesses did not risk their lives in battle in vain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_97","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_97","text":"If that means we must fight violence with violence, then c'est la vie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_98","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_cherryblossom_intermission_01_98","text":"You're giving us carte blanche to use force in order to combat violence?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_99","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_cherryblossom_intermission_01_99","text":"You don't even know for sure how far we'll take it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_100","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_cherryblossom_intermission_01_100","text":"Don't you need to put us on a leash like Exotic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_101","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_101","text":"Non. C'est a hard no,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_102","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_102","text":"No respectable Queen would ever be seen with a leash around her neck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_103","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_cherryblossom_intermission_01_103","text":"What if we decide to turn on you? What then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_104","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_104","text":"Sacré bleu!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_105","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_105","text":"I welcome ze challenge!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_106","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_106","text":"By all means, take a potshot at the back of my head at your leisure!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_107","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_107","text":"If you can, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_108","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_cherryblossom_intermission_01_108","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_109","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_109","text":"However.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_110","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_110","text":"Above all else, I will not tolerate the breaking of your oath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_lastbullet","movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_111","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_111","text":"Absolument not under any circumstance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_112","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_112","text":"If you do not follow the pledge in any way, shape or form,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_113","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_113","text":"and for any reason...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_114","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherryblossom_intermission_01_114","text":"There will be a price to pay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_115","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_intermission_01_115","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_116","type":"Speech","speaker":"moran","key":"Locale_SubScenario:event_cherryblossom_intermission_01_116","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_117","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_cherryblossom_intermission_01_117","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_intermission_01_118","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_cherrybl