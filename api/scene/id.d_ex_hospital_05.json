ie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_14","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_14","text":"You don't have psychic abilities, do you?!","jump":"d_ex_hospital_05_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_15","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_15","text":"I was just stopping by.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_16","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_16","text":"Ah, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_17","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_17","text":"What are you doing here, Biscuit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_18","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_18","text":"I was asking Mary for advice on how not to be afraid of hospitals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_19","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_19","text":"A few days from now, Max and other puppers are coming in for a checkup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_20","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_20","text":"The only thing is, they keeps freaking out whenever I so much as mention the word \"hospital\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_21","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_21","text":"Only yesterday, I said it while talking with Nero,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_22","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_22","text":"and she ran for cover as soon as he heard it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_23","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_23","text":"So I came to ask Mary for some advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_24","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_24","text":"But this isn't an animal hospital...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_25","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_25","text":"Sure, but Mary is still a doctor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_26","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_26","text":"... All right then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_27","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_27","text":"Well, did you make any headway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_28","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_28","text":"Not yet. We just started discussing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_29","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_29","text":"Do you have any suggestions, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_30","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_30","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_31","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_31","text":"How about blindfolding them before setting out?","jump":"d_ex_hospital_05_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_32","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_32","text":"How about putting them inside a carrier cage beforehand?","jump":"d_ex_hospital_05_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_33","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_33","text":"I doubt doggos would appreciate being blindfolded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_34","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_34","text":"Besides, not being able to see would only make them more nervous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_35","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_35","text":"Then how about putting them inside a carrier cage?","jump":"d_ex_hospital_05_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_36","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_36","text":"It makes sense on paper, but","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_37","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_37","text":"the instant I take out the cage, they just tear it to shreds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_38","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_39","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_39","text":"Sounds to me like our only option is repetitive training.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_40","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_40","text":"We need to get them to develop positive memories of hospitals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_41","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_41","text":"Repetitive training?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_42","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_42","text":"Precisely. Dogs tend to associate hospitals with bad memories, so they naturally don't want to return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_43","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_43","text":"So, how about every time you come to the hospital, you give them a treat or some kind of reward?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_44","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_44","text":"That way, they'll start to associate going to the hospital with positive feelings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_45","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_45","text":"We do the same thing with children who are reluctant about hospital visits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_46","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_46","text":"At first, they cry and protest about how they don't want to come, but once we show them a fun cartoon or give them some candy,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_47","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_47","text":"they don't mind coming to the hospital so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_48","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_48","text":"But I don't have time to take doggos to the vet every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_49","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_49","text":"How about using our hospital?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_50","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_50","text":"Come by this way whenever you're taking him for a walk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_51","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_51","text":"Slowly break him into it by letting him smell the hospital and get used to its atmosphere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_52","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_52","text":"Are you sure I can do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_53","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_05_53","text":"It's okay as long as you don't let them run wild in the hospital rooms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_54","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_54","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_55","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_55","text":"Kind of like a trial run!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_56","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_05_56","text":"Why don't you try it out now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_57","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_57","text":"Are you sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_58","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_58","text":"Actually, I just took Max for a walk, and he is already waiting outside...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_59","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_59","text":"All right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_60","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_hospital_05_60","text":"Let's give it a shot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_05_61","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_