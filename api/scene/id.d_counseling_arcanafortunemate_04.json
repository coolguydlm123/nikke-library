afortunemate_04_06","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_arcanafortunemate_04_06","text":"That way, I could see you in a bathing suit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_04_07","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_04_07","text":"Oh, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_04_08","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_04_08","text":"That doesn't have to be just a summer thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_04_09","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_04_09","text":"Just ask, and I'll show you any time of the year!","jump":"d_counseling_arcanafortunemate_04_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_04_10","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_04_10","text":"Yeah, I think winter is better, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_04_11","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_04_11","text":"I would blow on my hands,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_04_12","type":"Speech","speaker":"arcana_s","key":"Loc