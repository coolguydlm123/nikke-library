ll,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_5","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_5","text":"Yeah, sounds like the bellyaching of a sore loser.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_6","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_7","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_7","text":"Allow me to reiterate. I did not lose to thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_8","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_8","text":"So, you want to establish a pecking order, huh? Then what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_9","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_9","text":"You trying to gain the upper hand so you can order us around and thumb your nose at us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_10","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_10","text":"Are you expecting us to run around serving you drinks, or what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_11","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_11","text":"Nay, I merely seek to fathom","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_12","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_12","text":"where my physical prowess stand amidst this squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_13","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_13","text":"Why are you so obsessed with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_14","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_14","text":"Because I must always be improving myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_15","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_15","text":"Very well, then let me give you my verdict.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_16","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_16","text":"You're strong. Super strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":nul