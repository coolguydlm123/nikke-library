eech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_23","text":"First time I've seen someone wield a sword while asking for a favor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_24","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_24","text":"She's quick to throw a punch, that's for sure. It must be in her blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_25","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_25","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_26","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_26","text":"So be it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_27","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_27","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_28","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_28","text":"What? Seriously?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_29","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_29","text":"You're serious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_30","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_30","text":"I'll give you a chance to challenge every member of the Goddess Squad one on one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_31","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_31","text":"But only on one condition:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_32","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_32","text":"The type of duels will be decided by us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_33","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_33","text":"No qualms here. I, as the challenger, have come to inconvenience you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_34","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_34","text":"Very well, then first up will be Rapunzel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_02_35","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_02_35","text":"Huh? Me?","jump":null,"exit":false,"enter":n