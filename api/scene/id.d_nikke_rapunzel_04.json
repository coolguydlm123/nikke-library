{"id":"d_nikke_rapunzel_04","cat":"bond","group":{"id":"char5040","label":"Rapunzel"},"label":"That Place, That Time","stage":null,"prev":"d_nikke_rapunzel_03","next":"d_nikke_rapunzel_05","speakers":{"rapunzel":"Rapunzel","Self":"Commander","Monologue":"Monologue"},"icons":{"rapunzel":"si_c221_00_s"},"lines":[{"id":"d_nikke_rapunzel_04_1","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_1","text":"There are a few Nikkes, myself included, who have unique brain structures.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"bgm_distress","movie":null,"shown":["rapunzel"],"affinity":null},{"id":"d_nikke_rapunzel_04_2","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_2","text":"For every new memory we create, a previous one is lost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_3","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_3","text":"Our total memory capacity is limited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_4","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_4","text":"And it will continue to decrease as our brain ages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_5","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_5","text":"As you know, some of us witnessed the First Rapture Invasion.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":null,"movie":null,"shown":["snowwhite"],"affinity":null},{"id":"d_nikke_rapunzel_04_6","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_6","text":"Time has taken its toll on us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_rapunzel_04_7","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_7","text":"We are continuously creating new memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_8","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_8","text":"When our brain gets to the breaking point...","jump":null,"exit":false,"enter":null,"bg":"White","bgArt":"white","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_9","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_9","text":"To avoid a memory overload, we will automatically experience the so-called Mind Switch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_10","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_10","text":"I thought Mind Switch was brought on by emotional shock.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":null,"movie":null,"shown":["rapunzel"],"affinity":null},{"id":"d_nikke_rapunzel_04_11","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_11","text":"For most, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_12","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_12","text":"But not for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_13","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_13","text":"Perhaps there are some abnormalities in the NIMPH... I am unsure of the details.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_14","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_14","text":"Have you ever experienced a Mind Switch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_15","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_15","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_16","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_16","text":"Never.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_17","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_17","text":"To prevent my memory from overloading, I only retain part of my memories, and delete the rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_18","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_18","text":"As a result, I can only remember events that occurred during the prior year.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_19","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_19","text":"Tomorrow, I'll forget everything that happened one year ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_20","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_20","text":"So, I must not delay in laying my sisters to rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_21","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_21","text":"If I do not seize the opportunity when the memory is still fresh in my mind, I am certain to forget it in time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_22","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_22","text":"... I see. Let's put them to rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_23","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_23","text":"Thank you for understanding...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_24","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_25","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_25","text":"You truly are exceptional.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_26","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_26","text":"Every time I look at you, I feel at ease, and this sense of peace washes over me. I cannot fully describe it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_27","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_27","text":"It feels as if I... miss the old days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_28","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_28","text":"Did...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_29","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_29","text":"We ever met in the past?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_30","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_30","text":"I don't think so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_31","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_31","text":"It can't be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_32","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_32","text":"We must have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_33","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_33","text":"You knew full well that I would forget everything a year later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_34","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_34","text":"So, you forced me to succumb to your will!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_35","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_35","text":"My mind may have forgotten, but my body tells me otherwise, loud and clear!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_36","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_36","text":"How else would I have this sense of nostalgia?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_37","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_37","text":"You beast! How could you do such a vile thing to me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_38","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_38","text":"That's it! Right there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_39","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_39","text":"... Other than the past year...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_40","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_40","text":"You said you also have memories of the distant past?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_41","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_41","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_42","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_42","text":"I remember that which was recent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_43","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_43","text":"And I also remember events from long, long ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_44","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_44","text":"Nothing in between.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_45","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_45","text":"However, time stops for no man or Nikke, and the gap between these two points in time is widening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_46","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_46","text":"I'd love to listen to your stories about what happened during the First Rapture Invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_47","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_47","text":"Hmm... I'm sure they'd just bore you to tears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_48","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_48","text":"Please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_49","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_49","text":"If you insist...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_50","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_50","text":"It was a peaceful day, as usual.","jump":null,"exit":false,"enter":null,"bg":"Havester","bgArt":"havester","image":null,"bgm":null,"movie":null,"shown":["hongryeon","snowwhite"],"affinity":null},{"id":"d_nikke_rapunzel_04_51","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_51","text":"Then hordes of Raptures plummeted from the sky.\nThey were completely alien to us at the time. We had no way of communicating with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_risk","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_52","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_52","text":"It seemed their entire purpose was to eradicate mankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_53","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_53","text":"Their sole aim was to wipe our entire civilization off the map.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_54","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_54","text":"Even the most powerful military forces were powerless against them. Thus, we were doomed to suffer.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_55","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_55","text":"Several years later, campaigns were launched all over the world in search of Suiters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_56","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_56","text":"These so-called Suiters would fight against the Raptures. They were deemed to be mankind's last hope.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_57","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_57","text":"In the end, I was one of the several individuals selected to be a Suiter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_58","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_58","text":"Not long after, we were reborn as Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_59","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_59","text":"We started to fight back against the Raptures that had driven mankind to the brink of extinction.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_60","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_60","text":"We were referred to as Goddesses. It all seems a bit childish when you think about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_61","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_61","text":"Who were your teammates?","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":null,"movie":null,"shown":["rapunzel"],"affinity":null},{"id":"d_nikke_rapunzel_04_62","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_62","text":"Snow White, Scarlet, Dorothy, Red Hood...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_63","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_63","text":"... And Lilith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_64","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_64","text":"Despite all the pain and misery we endured...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_65","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_65","text":"We were happy together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_66","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_66","text":"We trusted each other. Relied on one another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_67","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_67","text":"We all shared the same sense of purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_68","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_68","text":"Yes... whenever I look back on those days, I miss them terribly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_69","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_69","text":"Did you have a leader?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_70","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_70","text":"Yes, Lilith. She was like a big sister to us all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_04_71","type":"Speech","speaker":"rapunzel","key":"Locale_NikkeEpisode:d_nikke_rapunzel_04_71","text":"She'd always ride us hard.","jump":null,"exit":false,"