77","text":"Wait... why is that my severance pay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_78","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_50_af_11_78","text":"The value of that core cannot be measured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_79","type":"Speech","speaker":"papillon_a_w","key":"Locale_MainScenario:d_main_50_af_11_79","text":"But... I want something that can be measured!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_80","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_50_af_11_80","text":"It's proof of our alliance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_81","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_50_af_11_81","text":"They said this one is a twin to the core in the Ark. If one breaks, the other will too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_82","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_50_af_11_82","text":"It's pretty bold of them to give this to us as a sign of friendship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_83","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_50_af_11_83","text":"Almost like we each hold the other's life in our hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_84","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_50_af_11_84","text":"I think they just decided to put two dangerous things in the two safest places they can be. Why're you overthinking it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_85","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_50_af_11_85","text":"I'm just being cautious. They shouldn't think we're allies after a single joint operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_86","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_50_af_11_86","text":"It must be exhausting inside your head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_87","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_50_af_11_87","text":"Ugh, what's with all the yapping? Just be quiet. How're we supposed to sleep?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":["leviathan","behemoth","ziz","bahamut"],"affinity":null},{"id":"d_main_50_af_11_88","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_50_af_11_88","text":"We fought really hard out there, you know. Keep it down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_89","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_50_af_11_89","text":"Ugh... There is zero soundproofing in these rooms... Can you go talk outside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_90","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_50_af_11_90","text":"Everyone be quiet. You're making it difficult to read.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_91","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_50_af_11_91","text":"Do you really think you have the right to tell me to quiet down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_92","type":"Speech","speaker":"noah_i","key":"Locale_MainScenario:d_main_50_af_11_92","text":"Yeah, show some respect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_93","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_50_af_11_93","text":"... You little squirt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_94","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_50_af_11_94","text":"Hehehe... It's so funny hearing you say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_95","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_50_af_11_95","text":"What did you just say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_96","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_50_af_11_96","text":"N-nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_11_97","type":"Speech","sp