{"id":"event_ce006_2_02_e","cat":"event","group":{"id":"ev40080","label":"MEMORIES TELLER · Part 2"},"label":"Art's Sepulcher: B","stage":null,"prev":"event_ce006_2_02_s","next":"event_ce006_2_03_s","speakers":{"hermin":"Hermin","anis":"Anis","rapi":"Rapi","machinesound":"Mechanical voice","elegg":"Elegg"},"icons":{"hermin":"si_c998_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","machinesound":"si_c999_00_s","elegg":"si_c500_00_s"},"lines":[{"id":"event_ce006_2_02_e_1","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_1","text":"... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":"bunkerofartist","bgArt":"bunkerofartist","image":null,"bgm":"none","movie":null,"shown":["neon","elegg","rapi","anis","hermin"],"affinity":null},{"id":"event_ce006_2_02_e_2","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_2","text":"My emotions got the best of me. I must be a disgraceful sight...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_3","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_02_e_3","text":"Don't worry about that. Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_4","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_4","text":"Yes. I've calmed down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_5","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_02_e_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_6","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_6","text":"...","jump":null,"exit":false,"enter":null,"bg":"artcity_d","bgArt":"artcity_d","image":null,"bgm":"collab_bgm_sb_landscapeofthepast","movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_7","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_7","text":"This was a city made up of artists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_8","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_8","text":"The residents here were free to let their creativity flow and to share their works amongst themselves and the public. As a result, this place was a popular tourist destination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_9","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_9","text":"It was revered as a sacred space where art lovers from all around could gather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_10","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_10","text":"After the Rapture invasion, most of the residents were scattered every which way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_11","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_11","text":"But a few who were determined to pass on their work to future generations fought against the Raptures and tried to protect the artwork here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_12","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_12","text":"I was one of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_13","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_13","text":"After moving all the artwork into the bunker I made, we fought with the Raptures for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_14","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_14","text":"I sustained serious injuries in the fighting, and subsequently had to rely on these machines to live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_15","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_15","text":"Some Nikkes, moved by our cause, joined us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_16","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_16","text":"The United Forces of Humanity used this city for their propaganda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_17","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_17","text":"They hailed us as artists who had taken up arms, and used our story to boost morale. In return for our cooperation, they offered us support.","jump":null,"exit":false,"enter":null,"bg":"bunkerofartist","bgArt":"bunkerofartist","image":null,"bgm":null,"movie":null,"shown":["neon","rapi","anis","hermin"],"affinity":null},{"id":"event_ce006_2_02_e_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_18","text":"A fat lot of good that did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_19","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_19","text":"One day, the UFH abruptly revoked all their support.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_20","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_20","text":"It became impossible to transport all the physical art pieces to the bunker,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_21","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_21","text":"so we began backing them up digitally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_22","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_22","text":"People scanned blueprints and high-resolution images, made backups of programs, and more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_23","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_02_e_23","text":"Then all these black machines must be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_24","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_24","text":"Massive storage terminals containing all that data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_25","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_25","text":"They hold digital records of all the art ever created in this city.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_26","text":"And you've been here watching over them this whole time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_27","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_27","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_28","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_28","text":"I hoped that one day, rescue would come, but it never did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_29","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_29","text":"And I wasn't exactly in a position to be venturing out either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_30","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_02_e_30","text":"So you've been here for over a century...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_31","text":"What about the other humans that fought alongside you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_32","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_32","text":"At first, they stayed here with me, but they all either died or left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_33","text":"What happened to the three Nikkes outside? What's the story behind that welded door?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_34","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_35","text":"Why did you try to ram into one of these storage terminals?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_36","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_37","text":"Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_38","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["elegg"],"affinity":null},{"id":"event_ce006_2_02_e_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_39","text":"Whoa, hey!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_40","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_02_e_40","text":"He's fainted!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_41","type":"Speech","speaker":"machinesound","key":"Locale_MainScenario:event_ce006_2_02_e_41","text":"Physical condition severely compromised. Rest immediately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_e_42","text":"Let's try and move him somewhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_43","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_02_e_43","text":"Lay him down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_44","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_44","text":"I-it's okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_45","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_45","text":"I just need to rest for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_46","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_46","text":"I'm sorry, but I think we'll have to pick this conversation up later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_47","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_47","text":"You're free to take a look around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_e_48","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_e_48","text":"Just don't break anything, please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}