id":"event_coinsinrush2_06_e_71","type":"Speech","speaker":"rouge_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_71","text":"So, I'd say the actual impact is much greater than anything we've done before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_72","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_06_e_72","text":"Précisément!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_73","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_06_e_73","text":"So please, don't be timide, and acceptez your prizes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_74","type":"Speech","speaker":"ade_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_74","text":"In that case...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_75","type":"Speech","speaker":"ade_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_75","text":"Hehe, thank you. This will really improve things at the Maid Cafe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_76","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_76","text":"Holy moly, we hit pay dirt!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_77","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_77","text":"You know how many jobs I'd have to take to earn this much?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_78","type":"Speech","speaker":"bay_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_78","text":"I should call Clay right away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_79","type":"Speech","speaker":"exia_b_op_r","key":"Locale_MainScenario:event_coinsinrush2_06_e_79","text":"I'd like a bank transfer, please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_80","type":"Speech","speaker":"rouge_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_80","text":"How do you intend on using your credits, Highroller?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_81","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinsinrush2_06_e_81","text":"Hmm... Not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_82","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinsinrush2_06_e_82","text":"I have the feeling a lot of it will go toward presents for you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_83","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinsinrush2_06_e_83","text":"As I say that, I glance around...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_84","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinsinrush2_06_e_84","text":"and my eyes land on Velvet, who has stepped offstage and is talking with Mustang.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mustang"],"affinity":null},{"id":"event_coinsinrush2_06_e_85","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinsinrush2_06_e_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["exia_b_op_r"],"affinity":null},{"id":"event_coinsinrush2_06_e_86","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_86","text":"Would you get a load of that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_87","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_87","text":"I knew something was up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_88","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinsinrush2_06_e_88","text":"... At least, we know we were used.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_89","type":"Speech","speaker":"rouge_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_89","text":"Still, I don't think he meant any harm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_90","type":"Speech","speaker":"rouge_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_90","text":"... After all, this is Boss we're talking about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":n