2_06_e_97","text":"Hmph, forget it. I got 100 million in hush money out of it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_98","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_98","text":"... and hell, it was way more fun than I thought it'd be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_99","type":"Speech","speaker":"ade_b","key":"Locale_MainScenario:event_coinsinrush2_06_e_99","text":"Yes, I had a lovely time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_100","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinsinrush2_06_e_100","text":"... Yeah, same here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_101","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_06_e_101","text":"All right! Before we commencer the main événement,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_102","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_06_e_102","text":"we're presenting a wild card to les winners of le chase événement!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_e_103","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_06_e_103","text":"Guests, don't you wanna see what your champs will pull off next?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt