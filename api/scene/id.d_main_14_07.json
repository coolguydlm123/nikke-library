,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_07_29","type":"Speech","speaker":"k","key":"Locale_MainScenario:d_main_14_07_29","text":"Good job. Just like that.","jump":"d_main_14_07_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_07_30","type":"Speech","speaker":"k","key":"Locale_MainScenario:d_main_14_07_30","text":"Are you screwing with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_07_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_07_31","text":"... Perilous Siege.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_07_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_07_32","text":"I suppose we have you to thank for all those traps?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_07_33","type":"Speech","speaker":"k","key":"Locale_MainScenario:d_main_14_07_33","text":"Bingo.\nIt's not really my style, but it's perfect for tripping you all up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_07_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_14_07_34","text":"What are you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_07_35","type":"Speech","speaker":"k","key":"Locale_MainScenario:d_main_14_07_35","text":"Can't you tell?\nWe have your Commander at gunpoint and we're threatening him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":n