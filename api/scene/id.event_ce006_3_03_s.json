d for me, you hunk of junk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_03_s_98","type":"Speech","speaker":"ce006_02","key":"Locale_MainScenario:event_ce006_3_03_s_98","text":"No one else can feel your pain for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_03_s_99","type":"Speech","speaker":"ce006_02","key":"Locale_MainScenario:event_ce006_3_03_s_99","text":"Only you can ease your own pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_03_s_100","type":"Speech","speaker":"ce006_02","key":"Locale_MainScenario:event_ce006_3_03_s_100","text":"And you know better than anyone what you have to do to carry on the memory of those you care about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_03_s_101","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_03_s_101","text":"But doing that will not quell the rage inside me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_03_s_102","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_03_s_102","text":"I still yearn for vengeance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_03_s_103","type":"Speech","speaker":"ce006_02","key":"Locale_MainScenario:event_ce006_3_03_s_103","text":"Then use your own will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_03_s_104","type":"Speech