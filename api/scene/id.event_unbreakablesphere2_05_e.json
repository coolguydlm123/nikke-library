ablesphere2_05_e_75","text":"There's no way I can lodge these crystals into Gluttony's core either, not with my pathetic strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_05_e_76","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere2_05_e_76","text":"I'm just a useless Nikke with nothing but this body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_05_e_77","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere2_05_e_77","text":"An incompetent member of the Incubator Squad who's about to be scrapped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_05_e_78","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere2_05_e_78","text":"I can't make a single impact in this filthy, cruel world!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_05_e_79","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere2_05_e_79","text":"I know that! *Sob*... I know that... but!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_05_e_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_unbreakablesphere2_05_e_80","text":"Mori stares straight at Little Mermaid with tear-filled eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_05_e_81","type":"Speech","speaker":"mori","key":"Locale_Mai