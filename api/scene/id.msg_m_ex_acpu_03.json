"No worries, I'll go get you.","jump":null},{"id":"m_ex_acpu_03_64","type":"Speech","speaker":"quiry","key":"Locale_SuddenMessage:m_ex_acpu_03_64","text":"You're the best, Poli!","jump":null},{"id":"m_ex_acpu_03_65","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_03_65","text":"So, let's meet up later as planned.","jump":null},{"id":"m_ex_acpu_03_66","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_03_66","text":"Okay, got it!","jump":null},{"id":"m_ex_acpu_03_67","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_acpu_03_67","text":"Sure thing.","jump":null}],"chat":true}