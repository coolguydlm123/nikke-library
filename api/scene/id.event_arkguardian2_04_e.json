{"id":"event_arkguardian2_04_e","cat":"event","group":{"id":"ev40098","label":"ARK GUARDIAN · Part 1"},"label":"The Beginning of the End: B","stage":null,"prev":"event_arkguardian2_04_s","next":"event_arkguardian2_05_s","speakers":{"commander_op_r":"Commander","hongryeon_op_l":"Scarlet","snowwhite_o":"Snow White","rapunzel_op_c":"Rapunzel","liliweiss":"Liliweiss","commander":"Commander","rapunzel_op_r":"Rapunzel","dorothy_op_r":"Dorothy","liliweiss_op_l":"Liliweiss"},"icons":{"commander_op_r":"si_c942_00_s","hongryeon_op_l":"si_c222_00_s","snowwhite_o":"si_c224_00_s","rapunzel_op_c":"si_c221_00_s","liliweiss":"si_c943_00_s","commander":"si_c942_00_s","rapunzel_op_r":"si_c221_00_s","dorothy_op_r":"si_c233_00_s","liliweiss_op_l":"si_c943_00_s"},"lines":[{"id":"event_arkguardian2_04_e_1","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_1","text":"How'd you manage to steal something that big?","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":"event_bgm_wm_riverside","movie":null,"shown":["commander_op_r","snowwhite_o","hongryeon_op_l","rapunzel_op_c"],"affinity":null},{"id":"event_arkguardian2_04_e_2","type":"Speech","speaker":"hongryeon_op_l","key":"Locale_MainScenario:event_arkguardian2_04_e_2","text":"She did possess a firearm. Mayhap it made the task a simple one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_3","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_04_e_3","text":"Huh? Didn't the Commander give a heads-up in advance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_4","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_4","text":"Ownership's split fifty-fifty between V.T.C. and the Central Government,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_5","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_5","text":"so it wouldn't have mattered how I plead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_6","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_04_e_6","text":"Well... they just let me into the cockpit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_7","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_8","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_8","text":"A heist of this magnitude requires teamwork. That means they're on our side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_9","type":"Speech","speaker":"rapunzel_op_c","key":"Locale_MainScenario:event_arkguardian2_04_e_9","text":"Are you flying that thing all by yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_10","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_10","text":"You didn't know? Snow White played a significant role in designing the aircraft.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_11","type":"Speech","speaker":"rapunzel_op_c","key":"Locale_MainScenario:event_arkguardian2_04_e_11","text":"What? Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_12","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_12","text":"Yup. So flying that bird is second nature to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_13","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_04_e_13","text":"Actually, I have some mass-produced Nikkes with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_14","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_04_e_14","text":"I can't operate the aircraft by myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_15","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_15","text":"Oh, my bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_16","type":"Speech","speaker":"rapunzel_op_c","key":"Locale_MainScenario:event_arkguardian2_04_e_16","text":"You speak as if you know everything, yet you are mistaken about every single thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_17","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_17","text":"How many are onboard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_18","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_04_e_18","text":"There are about 20 of us, myself included.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_19","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_19","text":"All right then, your mission is to take down 100 of those Raptures each.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_20","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_04_e_20","text":"Roger that! We'll do our best!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_21","text":"As the Wings of Victory joins the battle, the tide begins to change.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_22","text":"High-altitude aerial strikes rain down upon the battlefield, sending great swathes of Raptures flying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liliweiss"],"affinity":null},{"id":"event_arkguardian2_04_e_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_23","text":"Liliweiss is finally able to catch her breath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_24","text":"Her hands shake. Her vision blurs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_25","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_25","text":"... This is happening faster than expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_26","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_26","text":"Lilith, fall back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_arkguardian_arkguardian","movie":null,"shown":["commander_op_r"],"affinity":null},{"id":"event_arkguardian2_04_e_27","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_27","text":"Not yet. Just a little more!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_28","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_28","text":"If you don't rest now, you won't get another chance. Snow White has helped turn the tide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_29","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_e_29","text":"Hurry back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_30","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_30","text":"... All right. Just a little more, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_31","text":"Liliweiss stands beside the Commander.","jump":null,"exit":false,"enter":null,"bg":"ArkGate_Far_d","bgArt":"arkgate_far_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_32","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_32","text":"I see you still prefer to command outdoors. Though on a day like this, it might be wiser to do so indoors, especially in the tower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["commander"],"affinity":null},{"id":"event_arkguardian2_04_e_33","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_33","text":"Not my style. Where's the fun in that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_34","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_34","text":"That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_35","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_35","text":"Here, clean yourself up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_36","text":"The Commander hands her a towel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_37","text":"Liliweiss takes it and wipes her face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_e_38","text":"Thick globules of blood stick to the towel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_39","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_40","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_40","text":"Rest a bit more before you go. Need some water?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_41","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_41","text":"No, I'm all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_42","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_42","text":"You're one to talk. You've got a hole in your side, yet you're playing it off like it's nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_43","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_44","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_44","text":"... Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_45","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_45","text":"Why are you so pale? And why are you sweating so much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_46","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_46","text":"Had a bit too much to drink last night.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_47","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_47","text":"You never drink before a mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_48","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_48","text":"Felt like letting loose for once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_49","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_49","text":"You're not fully healed, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_50","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_50","text":"I'm all healed, I swear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_51","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_51","text":"You'll end up killing yourself doing this, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_52","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_52","text":"You planning to die with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_53","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_54","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_04_e_54","text":"Wouldn't be the worst way to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_55","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_e_55","text":"The girls need someone to lead them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_e_56",