:d_main_43_06_14","text":"A few more days go by...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["princess"],"affinity":null},{"id":"d_main_43_06_15","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_15","text":"At this rate... I'm going to die...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_16","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_06_16","text":"*Cough, cough* Have you eaten?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_17","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_17","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_18","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_06_18","text":"Wanna eat together? It's on me today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_19","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_19","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_20","text":"With unfocused eyes, Princess hungrily devours her meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_21","text":"Then she lies down on the floor and promptly falls asleep, snoring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_22","text":"A few more days go by...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["princess"],"affinity":null},{"id":"d_main_43_06_23","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_23","text":"Ugh... This is exhausting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_24","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_06_24","text":"*Cough* How was your day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_25","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_25","text":"Same as always. Why do you keep asking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_26","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_06_26","text":"Have you eaten?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_27","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_27","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_28","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_06_28","text":"Let's eat together then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_29","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_29","text":"... It's on me today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_30","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_06_30","text":"Ooh, sounds like you're finally starting to realize how much it means when someone gives you food for nothing in return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_31","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_06_31","text":"Now that you've worked, you get it, don't you? It's the same as laboring for someone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_32","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_33","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_33","text":"I think I'm starting to understand a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_34","text":"After a simple meal, the two lie down side by side and fall asleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_35","text":"A few weeks later...","jump":null,"exit":false,"enter":null,"bg":"BadDreamAlley","bgArt":"baddreamalley","image":null,"bgm":"bgm_chapter43_field_password","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_36","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_36","text":"Big Madam, can you not count? You gave me more money than you should have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_37","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_37","text":"Here's the excess. Consider yourself lucky I have a conscience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_38","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_38","text":"Take it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_39","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_39","text":"It's yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_40","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_40","text":"... What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_41","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_41","text":"You've earned yourself a raise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_42","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_42","text":"You've been working hard without cutting corners.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_43","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_43","text":"When it comes to hacking or electronics, you're better than most adults.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_44","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_45","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_45","text":"I used to think your story would end with you dead in some back alley, but you're holding out better than I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_46","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_46","text":"How's life treating you? Good?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_47","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_47","text":"... Okay, I guess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_48","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_48","text":"Did anyone contact me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_49","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_49","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_50","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_50","text":"Then I'd like to reach out to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_51","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_51","text":"Very funny. One wrong message to the Ark and bodies will start dropping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_52","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_52","text":"Mostly them, but us as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_53","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_53","text":"That's why people use secure lines or go through brokers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_54","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_54","text":"Unfortunately, Heavenly Ascension's been getting too aggressive lately, making even that difficult. Security's tighter than ever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_55","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_55","text":"Still... if you want to contact her on your own, I won't stop you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_56","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_56","text":"But you're going to need both the tech to do so, and money—a lot of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_57","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_58","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_58","text":"Isn't it about time you accept reality?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_59","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_59","text":"You've been abandoned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_60","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_60","text":"That's not possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_61","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_61","text":"Don't deny it. It happens all the time out here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_62","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_62","text":"The Outer Rim itself was abandoned, which is why all those who've been discarded gather here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_63","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_63","text":"Any hope of ever going back is nothing more than a joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_64","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_06_64","text":"I'm going back. No matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_65","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_65","text":"Heh, sure you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_66","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_06_66","text":"I guess in a place as humorless as this, even a sad joke like that helps you get through the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_67","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_67","text":"Princess trudges through the underground tunnel,","jump":null,"exit":false,"enter":null,"bg":"UndergroundTunnel","bgArt":"undergroundtunnel","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_68","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_68","text":"glancing around as she walks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_69","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_06_69","text":"Two and a half years have passed since she arrived at the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_06_70","type":"Narration","speaker":null,"key"