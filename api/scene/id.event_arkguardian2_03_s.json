{"id":"event_arkguardian2_03_s","cat":"event","group":{"id":"ev40098","label":"ARK GUARDIAN · Part 1"},"label":"A Depiction of Hope: A","stage":null,"prev":"event_arkguardian2_02_e","next":"event_arkguardian2_03_e","speakers":{"liliweiss":"Liliweiss","commander":"Commander","hongryeon_o":"Scarlet","rapunzel_o":"Rapunzel","dorothy":"Dorothy","snowwhite_o":"Snow White"},"icons":{"liliweiss":"si_c943_00_s","commander":"si_c942_00_s","hongryeon_o":"si_c225_00_s","rapunzel_o":"si_c966_00_s","dorothy":"si_c233_00_s","snowwhite_o":"si_c224_00_s"},"lines":[{"id":"event_arkguardian2_03_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_03_s_1","text":"The Ark's entrance.","jump":null,"exit":false,"enter":null,"bg":"ArkGate_Far_d","bgArt":"arkgate_far_d","image":null,"bgm":"event_bgm_redash_dearsnowwhite","movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_03_s_2","text":"Goddess Squad. In the Commander's Room.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":null,"movie":null,"shown":["commander","liliweiss"],"affinity":null},{"id":"event_arkguardian2_03_s_3","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_3","text":"Is that for real?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_4","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_4","text":"Do you really think I would make this up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_5","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_5","text":"I knew you weren't ordinary, but I never imagined your blood held such a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_6","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_6","text":"Right? I feel like some kind of legendary hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_7","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_7","text":"I had my suspicions, but for the V.T.C. to kidnap the Commander of the Goddess Squad is awfully audacious of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_8","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_8","text":"It's not just audacious, it's downright insane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_9","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_9","text":"They've always been pulling crazy stunts like this. This time, we're the lucky victims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_10","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_10","text":"Should we turn the place upside down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_11","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_11","text":"It's not worth our time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_12","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_12","text":"We both know this won't be the end of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_13","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_13","text":"We'll be fine. Everyone here is sane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_14","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_14","text":"Not even the most fanatical V.T.C. devotee would dream of messing with us here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_15","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_15","text":"And frankly, I don't have the mental capacity to deal with them right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_16","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_16","text":"They abducted you under the guise of treatment, only to turn you into their test subject.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_17","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_17","text":"Any idea on what they're up to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_18","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_18","text":"If they lay a finger on me or anyone here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_19","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_19","text":"it will be the end of V.T.C., physically.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_20","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_21","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_21","text":"Talking about this is giving me a headache. This conversation's over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_22","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_22","text":"Let's discuss what actually matters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_23","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_23","text":"You mean the fact that Phase 3 is going to be the final phase?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_24","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_24","text":"Yeah. Neither the Central Government nor V.T.C. intends to let the sealing process get to Phase 5.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_25","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_25","text":"The twisted priestess had a lousy way of putting it, but it's not the most outlandish course of action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_26","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_26","text":"We're spent, but the Raptures are showing no signs of letting up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_27","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_27","text":"Even Raptures that cause corruption are on the rampage, and morale has hit an all time low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_28","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_28","text":"And in the midst of all that, we've got mass-produced Heretics showing up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_29","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_29","text":"The Raptures are rolling out some new units. Things are looking pretty serious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_30","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_30","text":"They're probably the next generation of weaponry, and there will be many more to come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_31","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_31","text":"If we drag this out any longer, the Ark itself will be at risk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_32","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_32","text":"This time, we've got to seal it for good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_33","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_34","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_34","text":"So what do we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_35","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_35","text":"Whatever you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_36","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_36","text":"And we'll let the girls do whatever they want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_37","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_37","text":"I already know what I want to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_38","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_38","text":"But I can't say for sure they feel the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_39","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_39","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_40","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_40","text":"You and I raised them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_41","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_41","text":"Why wouldn't they feel the same way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_42","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_03_s_42","text":"So it shall be... Phase 3 marketh the end.","jump":null,"exit":false,"enter":null,"bg":"BriefingRoom","bgArt":"briefingroom","image":null,"bgm":null,"movie":null,"shown":["dorothy","hongryeon_o","rapunzel_o","snowwhite_o"],"affinity":null},{"id":"event_arkguardian2_03_s_43","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_43","text":"And here I thought five phases wouldn't be enough, but they're cutting it even shorter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_44","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_44","text":"Then... what about the others who thought it would end at Phase 5?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_45","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_45","text":"Was there an official announcement?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_46","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_46","text":"They probably won't be making one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_47","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_48","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_48","text":"So when do we enter the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_49","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_49","text":"We go in together during Phase 3.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_50","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_50","text":"If that's what you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_51","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_51","text":"You speak as if we have a choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_52","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_52","text":"We always do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_53","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_53","text":"That's how we've always rolled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_54","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_54","text":"We do whatever we want, and we give 'em killer results.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_55","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_03_s_55","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_56","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_56","text":"A choice, you say...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_57","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_57","text":"If that's the case...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_58","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_58","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_59","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_59","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_60","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_60","text":"What is it, Snow White?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_61","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_03_s_61","text":"Snow White locks eyes with everyone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_03_s_62","text":"gauging the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_63","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_03_s_63","text":"Then, it hits her","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_64","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_03_s_64","text":"that everyone feels the same as she does.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_65","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_65","text":"You have something to say, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_66","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_66","text":"I think we should stay on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_67","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_67","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_68","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_68","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_69","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_69","text":"After Phase 3, there will still be people finding their way to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_70","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_70","text":"We'll stay here and protect them,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_71","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_71","text":"until they're safely inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_72","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_72","text":"For the rest of our lives?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_73","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_73","text":"If no one comes for two weeks, we'll go down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_74","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_74","text":"Then what if one person shows up every 13 days?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_75","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_75","text":"Then we stay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_76","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_76","text":"After Phase 3, the Ark will be sealed completely. How will the people get in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_77","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_77","text":"We'll keep them safe and bring them with us when we descend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_78","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_78","text":"What if thousands show up? What's your plan then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_79","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_79","text":"We'll protect everyone and go down together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_80","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_80","text":"And if they refuse to let us in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_81","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_03_s_81","text":"Do not be preposterous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_82","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_03_s_82","text":"We are the Goddess Squad. Though it feels strange for me to utter such, we are nigh unto myth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_83","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_03_s_83","text":"Assuredly, they shall be amenable to opening the gates for us at least once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_84","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_84","text":"When that happens, I'll need the two of you to step up and guarantee our safety.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_85","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_85","text":"So, in summary:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_86","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_86","text":"We're not going down during Phase 3.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_87","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_87","text":"We'll stay here, hold our position, and wait, protecting any latecomers—humans and Nikkes alike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_88","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_88","text":"If no one comes after two weeks, we'll escort those under our protection down to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_89","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_89","text":"The entrance to the Ark will be opened only at that specific time. Lilith and I will prepare everything in advance for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_90","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_90","text":"Did I miss anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_91","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_91","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_92","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_92","text":"It was perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_93","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_93","text":"A stellar summary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_94","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_03_s_94","text":"He ought to be proficient at that, at the very least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_95","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_95","text":"It's an insane plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_96","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_96","text":"The logistics alone are a nightmare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_97","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_97","text":"It'll require every last ounce of our strength, mentally and physically.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_98","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_99","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_99","text":"But we're also the only ones who can carry it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_100","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_03_s_100","text":"Everyone nods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_101","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_101","text":"All right. We stay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_102","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_102","text":"Let's see this through to the end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_103","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_103","text":"Could you promise me one thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_104","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_104","text":"What now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_105","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_105","text":"When we return to the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_106","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_106","text":"please make sure we're well compensated for all of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_107","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_107","text":"In whatever form it may be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_108","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_108","text":"Sure, I'll do everything in my power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_109","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_109","text":"No, I promise!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_110","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_110","text":"They'll reward each of us palaces and enough money to last a lifetime!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_111","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_111","text":"Our story will be turned into a novel! Adapted into movies and games!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_112","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_112","text":"Heck, they may even start a religion in our name!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_113","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_113","text":"Oh my.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_114","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_114","text":"We'll make a splashy debut in politics!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_115","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_115","text":"Ooh...","jump":null,"exit":false,