ch","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_122","text":"Drink for days with beauties in both arms...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_123","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_03_s_123","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_124","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_124","text":"And then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_125","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_03_s_125","text":"You'll be hailed as the Goddesses of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_126","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_03_s_126","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_127","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_03_s_127","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_128","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_03_s_128","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_03_s_129","type":"Speech","speake