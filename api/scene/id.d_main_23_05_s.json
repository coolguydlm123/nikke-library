r":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_05_s_15","text":"Rapi runs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_16","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_s_16","text":"Oh, so that's how it is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_05_s_17","text":"*Shaaaaaaaa*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_05_s_18","text":"Tendrils of fire spew from the walls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_19","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_s_19","text":"Are you gonna stay put, like a good girl, or am I going to have to torch you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_20","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_s_20","text":"And just so you know, this torches Nikkes just as well as it does humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_05_s_21","text":"I see you're nothing if not well-prepared.","jump":null,"exit":false,"enter":null,"bg":null,