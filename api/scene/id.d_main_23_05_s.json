MainScenario:d_main_23_05_s_28","text":"What are you planning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_29","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_s_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_30","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_s_30","text":"Do you really want to know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_31","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_s_31","text":"Then follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_32","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_s_32","text":"I'll take you to meet Crow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_33","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_05_s_33","text":"Viper walks through the tunnel, with Rapi and I following close behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_34","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_05_s_34","text":"She doesn't appear to be armed, but we still need to keep our wits about us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_s_35","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_05_s_35","text":"When you're