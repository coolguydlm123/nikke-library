{"id":"d_main_36_08_e","cat":"main","group":{"id":"ch36","label":"Chapter 36 · Betrayal"},"label":"Inspection Unit: B","stage":"36-34 STAGE · End","prev":"d_main_36_08_s","next":"d_main_36_09_s","speakers":{"eyeri":"Eyeri","avistar":"Avistar","anis":"Anis","neon":"Neon"},"icons":{"eyeri":"si_c440_00_s","avistar":"si_c441_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_36_08_e_1","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_1","text":"Hmm? It's completely clean.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":["avistar","eyeri","anis","neon"],"affinity":null},{"id":"d_main_36_08_e_2","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_2","text":"Not a single credit unaccounted for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_3","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_3","text":"I've never seen anything kept in such immaculate order. It's quite admirable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_4","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_e_4","text":"The company's cash flow is impeccable, as are all its other operations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_5","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_e_5","text":"We even conducted interviews with some of the staff, but there was nothing suspicious at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_e_6","text":"See? I knew it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_e_7","text":"Why are you acting so smug, Anis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_e_8","text":"Because I knew that the Boss was clean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_e_9","text":"But it also means the operation was a complete waste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_e_10","text":"Dang it, you're right. Why does the Boss have to be so squeaky clean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_e_11","text":"He could have at least been courteous and done one dishonest thing for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_12","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_12","text":"This operation is a bust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_13","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_13","text":"We were planning on barging in and airing out their dirty laundry, but there's nothing we can use against them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_14","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_14","text":"Don't be too disappointed, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_e_15","text":"Oh. Is there another method?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_16","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_16","text":"No. There isn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_e_17","text":"Then why wouldn't we be disappointed?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_18","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_18","text":"We should all be happy that one of the largest corporations in the Ark is such an honest enterprise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_19","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_e_19","text":"Yeah yeah, I'm happy. You've got a point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_20","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_e_20","text":"We'll have to come up with another way to approach them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_21","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_e_21","text":"We might need to look into suppliers for Tetra Line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_22","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_e_22","text":"If we're going to go down that route, though, we'll need some more assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_23","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_e_23","text":"We'd be essentially auditing one of the Big Three.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_24","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_e_24","text":"So what should we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_25","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_e_25","text":"Let's see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_e_26","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_e_26","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":