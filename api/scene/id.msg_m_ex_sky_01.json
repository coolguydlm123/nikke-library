{"id":"msg_m_ex_sky_01","cat":"messenger","group":{"id":"room_sky","label":"Sky · Nikke"},"label":"1. Um...","stage":null,"prev":null,"next":null,"speakers":{"sky":"Sky"},"icons":{"sky":"si_c530_00_s"},"lines":[{"id":"m_ex_sky_01_1","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_1","text":"Um...","jump":null},{"id":"m_ex_sky_01_2","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_2","text":"Captain?","jump":null},{"id":"m_ex_sky_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sky_01_3","text":"?","jump":null},{"id":"m_ex_sky_01_4","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_4","text":"Oh, this is Sky.","jump":null},{"id":"m_ex_sky_01_5","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_5","text":"I thought I'd reach out since we're going to be working together.","jump":null},{"id":"m_ex_sky_01_6","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_6","text":"Would you mind if I dropped you a message from time to time?","jump":null},{"id":"m_ex_sky_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sky_01_7","text":"Yup, of course.","jump":null},{"id":"m_ex_sky_01_8","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_8","text":"Thank you!","jump":null},{"id":"m_ex_sky_01_9","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_9","text":"That reminds me!","jump":null},{"id":"m_ex_sky_01_10","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_10","text":"Do you look up at the sky often?","jump":null},{"id":"m_ex_sky_01_11","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_sky_01_11","text":"Yeah, it's a habit of mine.","jump":"m_ex_sky_01_13"},{"id":"m_ex_sky_01_12","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_sky_01_12","text":"Not really.","jump":"m_ex_sky_01_19"},{"id":"m_ex_sky_01_13","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_13","text":"Ooh, really?","jump":null},{"id":"m_ex_sky_01_14","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_14","text":"I look up at the sky pretty often, too.","jump":null},{"id":"m_ex_sky_01_15","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_15","text":"Partly because of my job,","jump":null},{"id":"m_ex_sky_01_16","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_16","text":"but I also just have a habit of gazing up at the sky.","jump":null},{"id":"m_ex_sky_01_17","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_17","text":"I can't believe you have the same habit!","jump":null},{"id":"m_ex_sky_01_18","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_18","text":"... It feels nice knowing that.","jump":"m_ex_sky_01_24"},{"id":"m_ex_sky_01_19","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_19","text":"That's understandable.","jump":null},{"id":"m_ex_sky_01_20","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_20","text":"Everyone's busy these days.","jump":null},{"id":"m_ex_sky_01_21","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_21","text":"There's almost no time to look up at the sky.","jump":null},{"id":"m_ex_sky_01_22","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_22","text":"Looks like you don't have much time to do so, too...","jump":null},{"id":"m_ex_sky_01_23","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_23","text":"That's a shame...","jump":"m_ex_sky_01_24"},{"id":"m_ex_sky_01_24","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_sky_01_24","text":"Sky doesn't reply for a while.","jump":null},{"id":"m_ex_sky_01_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sky_01_25","text":"Sky?","jump":null},{"id":"m_ex_sky_01_26","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_26","text":"Oh...","jump":null},{"id":"m_ex_sky_01_27","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_27","text":"I was looking up at the sky since we were talking about it.","jump":null},{"id":"m_ex_sky_01_28","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_28","text":"The sky is particularly clear today.","jump":null},{"id":"m_ex_sky_01_29","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_29","text":"I must've spaced out.","jump":null},{"id":"m_ex_sky_01_30","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_30","text":"You should take a look at the sky too, if you have the time.","jump":null},{"id":"m_ex_sky_01_31","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_31","text":"Take a deep breath while you're at it.","jump":null},{"id":"m_ex_sky_01_32","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_32","text":"Who knows?","jump":null},{"id":"m_ex_sky_01_33","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_33","text":"It might lift a weight off your chest.","jump":null},{"id":"m_ex_sky_01_34","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_34","text":"Oh, I should get going now.","jump":null},{"id":"m_ex_sky_01_35","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_35","text":"It's time for aircraft maintenance.","jump":null},{"id":"m_ex_sky_01_36","type":"Speech","speaker":"sky","key":"Locale_SuddenMessage:m_ex_sky_01_36","text":"Talk to you later!","jump":null},{"id":"m_ex_sky_01_37","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_sky_01_37","text":"Maybe I should spend some time looking up at the sky today.","jump":null}],"chat":true}