y":null},{"id":"d_ex_trainstation_11_53","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_53","text":"Just make sure to pick me ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_54","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_54","text":"I was already impressed that you came here so late for work,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_55","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_55","text":"but to promote your job outside of your workplace...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_56","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_56","text":"You really must be passionate about what you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_57","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_57","text":"Hahaha... You won't find many people more passionate about their job than me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_58","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_58","text":"I imagine you must also feel a great sense of responsibility toward your work, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_59","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstatio