_66","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_11_66","text":"Am I the only one who feels like you two aren't on the same page right now...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_67","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_67","text":"What do you mean? I think we're on the same page.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_68","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_68","text":"We are talking about work, aren't we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_69","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_69","text":"That's right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_70","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_70","text":"This conversation is strictly about *work*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_71","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_71","text":"So tell me, Velvet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_72","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_72","text":"Are you fairly meticulous in your work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_73","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_73","text":"People sometimes tell me that I go overboard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_74","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_74","text":"Isn't doing too much better than not enough, though?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_75","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_75","text":"There's nothing wrong with being thorough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_76","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_76","text":"After all, you have to be absolutely certain you've finished the job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_77","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_77","text":"If you leave anything undone, it could come back to bite you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_78","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_78","text":"That's why it's especially important to tie up loose ends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_79","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_79","text":"I agree. You must ensure nothing is left undone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_80","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_80","text":"Only then can you perform your next responsibility without issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_81","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_81","text":"No one besides the Commander has ever seen eye to eye with me like this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_82","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_82","text":"I'm glad to have met someone who thinks like I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_83","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_83","text":"If I may ask another question...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_84","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_84","text":"What do you do when someone tries to talk to you while you are focused on your work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_85","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_85","text":"Although it is never my intention,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_86","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_86","text":"I find that when my full attention is on whatever I am doing, I sometimes don't answer if someone tries to speak to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_87","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_87","text":"Oh, you should definitely ignore them. Intentionally, even.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_88","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_88","text":"When you're doing something important, you can't afford to be distracted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_89","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_89","text":"If you miss your target because you're talking to someone else,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_90","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_90","text":"that person's not going to take responsibility for it. Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_91","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_92","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_92","text":"The world really is vast...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_93","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_93","text":"I didn't think there was anyone who took their job more seriously than me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_94","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_94","text":"I never imagined someone else would prioritize work to this extent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_95","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_95","text":"Oh, I'm always serious in everything I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_96","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_96","text":"I may look like I'm playing around, but in reality I'm always doing my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_97","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_11_97","text":"I look at Velvet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_98","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_11_98","text":"... You've known this whole time that the two of you are talking about different things, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_99","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_99","text":"What are you talking about, Master?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_100","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_100","text":"We're discussing *work*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_101","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_101","text":"Or more precisely, our attitude toward work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_102","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_102","text":"We weren't talking about different things at all. We're on the same page, remember? ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_103","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_11_103","text":"Have you not felt like something's off, Brid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_104","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_104","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_105","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_105","text":"No, not in the slighest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_106","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_106","text":"Actually, I'd like to talk even more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_107","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_107","text":"If you don't mind, Velvet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_108","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_108","text":"I know it is late, but could I have a bit more of your time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_109","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_109","text":"I'd like to continue our conversation back in the station office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_110","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_110","text":"This is the first time I've ever met someone with whom I can speak so freely...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_111","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_111","text":"Hmm... Decisions, decisions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_112","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_112","text":"If you promise to come to the Maid Cafe sometime later, I might consider it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_113","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_113","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_114","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_114","text":"I often go to the Maid Cafe for coffee anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_115","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_115","text":"Well then, if you promise to order the omurice, then I promise to answer your questions even more sincerely ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_116","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_116","text":"Advertising for your workplace even in the middle of a conversation... Your professional commitment is truly remarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_117","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_117","text":"Understood. I will order the omurice and even a dessert as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_118","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_118","text":"Haha! Thank you ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_119","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_11_119","text":"And so, Velvet and Brid talk all through the night until it's time for the first morning train to depart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_120","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_11_120","text":"I also stay with them to make sure Velvet doesn't try to pull anything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}