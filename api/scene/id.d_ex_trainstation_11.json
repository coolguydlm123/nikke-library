_SuddenStory:d_ex_trainstation_11_26","text":"I wouldn't be doing what I do if I didn't like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_27","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_27","text":"By the way...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_28","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_28","text":"I'd heard rumors,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_29","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_29","text":"but is this the newest maid at the Maid Cafe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_30","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_30","text":"The name's Velvet, and I'm currently the most popular maid at the cafe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_31","type":"Speech","speaker":"velvet_m","key":"Locale_SuddenStory:d_ex_trainstation_11_31","text":"Haha, it feels kind of embarrassing when I say it ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_11_32","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_11_32","text":"I see. May I ask what you're doing here at the station?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affini