{"id":"d_main_31_01_e","cat":"main","group":{"id":"ch31","label":"Chapter 31 · Mabeast"},"label":"Memories of the Past: B","stage":"31-3 STAGE · End","prev":"d_main_31_01_s","next":"d_main_31_02_s","speakers":{"mana":"Mana","anis":"Anis","rapi":"Rapi","neon":"Neon"},"icons":{"mana":"si_c290_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_31_01_e_1","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_1","text":"Hey there.","jump":null,"exit":false,"enter":null,"bg":"HarmonyCube","bgArt":"harmonycube","image":null,"bgm":"bgm_inark","movie":null,"shown":["neon","anis","mana","rapi"],"affinity":null},{"id":"d_main_31_01_e_2","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_01_e_2","text":"How are things going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_3","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_3","text":"Better than expected. Things are progressing quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_4","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_4","text":"We're keeping the Harmony Cube in check, and once the A Pillar arrives, we'll be able to start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_5","text":"What about Absolute?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_6","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_6","text":"There were Raptures armed with anti-air artillery nearby, so they went to deal with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_7","text":"Just the three of them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_8","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_8","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_31_01_e_9","text":"Commander, we should join them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_01_e_10","text":"Agreed. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_01_e_11","text":"I have something to confess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_01_e_12","text":"I... fell asleep during the mission briefing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_01_e_13","text":"I haven't got a clue what Mana is doing here, what the stakes are, and what's going on with Absolute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_14","text":"You're shouting it like you're proud of the fact you know nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_01_e_15","text":"Naturally! I always hold my head high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_17","text":"If you hadn't nodded off, you'd know that Absolute is harnessing the Harmony Cube in order to destroy the crystal. Isn't that right, Mana?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_18","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_18","text":"Not even a little bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_19","text":"... Did I at least get some keywords right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_01_e_20","text":"Sorry, Mana, but can you explain it to us again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_21","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_21","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_22","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_22","text":"Based on the investigation the Central Government conducted on the E2 Crystals,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_discussion","movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_23","text":"Man, you all love these kind of names, don't you? First \"Material H\", now \"E2 Crystals\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_24","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_24","text":"This substance was deemed highly dangerous to the Ark and classified as risk level SS.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_25","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_25","text":"At the same time, as it was determined that it didn't have any positive effect on the surface's ecosystem,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_26","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_26","text":"any further research would serve no purpose, and the decision was made to eradicate the material.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_27","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_27","text":"For some perspective, Heretics were designated as risk level S.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_28","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_28","text":"These E2 Crystals, meanwhile, are one level above even that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_29","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_29","text":"The Harmony Cube located here is outdated and not well maintained,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_30","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_30","text":"but it is still capable of running calculations pertaining to the construction of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_31","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_31","text":"By setting this Harmony Cube loose on the nearby infested E2 Crystals,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_32","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_32","text":"we will \"overwrite\" the basic structures of the Ark here, which are known as Lost Sectors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_33","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_33","text":"The structures generated by this Harmony Cube are composed of glass, which makes them perfect for dealing with E2 Crystals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_34","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_34","text":"Our strategy is to fill the area with these glass structures and push back the E2 Crystals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_01_e_35","text":"And this place will be the epicenter of that operation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_36","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_36","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_01_e_37","text":"Oh. Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_39","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_01_e_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_41","text":"Care to elaborate?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_42","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_42","text":"We intend to use an A Pillar which will act as a \"stake\" of sorts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_43","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_43","text":"We will insert this A Pillar into the most densely-packed area of the Crystal Region, from which the basic structures will expand outwards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_44","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_44","text":"By repeating this process multiple times, we'll eventually fill the area with these structures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_45","text":"I wonder how that's going to look...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_46","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_46","text":"What you need to do now is join up with Absolute and proceed with the mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_47","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_47","text":"They've been fully briefed on this operation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_48","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_48","text":"and have even completed a simulation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_49","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_01_e_49","text":"Alright, no issues on my end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_01_e_50","text":"Anything else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_51","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_51","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_52","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_01_e_52","text":"What about Grave?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_53","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_01_e_53","text":"I haven't seen any sight of her yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_01_e_54","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_01_e_55","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_01_e_55","text":"Alright, let's go and meet up with Absolute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}