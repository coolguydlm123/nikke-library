{"id":"d_counseling_neon_16","cat":"counsel","group":{"id":"char3002","label":"Neon"},"label":"Advising Neon: 16","stage":null,"prev":"d_counseling_neon_15","next":"d_counseling_neon_17","speakers":{"neon":"Neon"},"icons":{"neon":"si_c011_00_s"},"lines":[{"id":"d_counseling_neon_16_1","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_1","text":"I have a question.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["neon"],"affinity":"_0"},{"id":"d_counseling_neon_16_2","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_2","text":"Where do you think I can find the fabled blacksmith of legend, who can craft a legendary firearm for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_16_3","text":"Inside your own heart","jump":"d_counseling_neon_16_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_neon_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_16_4","text":"This so-called \"legendary blacksmith\" is simply the fire and brimstone in your heart.","jump":"d_counseling_neon_16_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_neon_16_5","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_5","text":"No way, the only thing my heart is filled with is fire and brimstone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_6","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_6","text":"Did my question rub you the wrong way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_7","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_7","text":"Otherwise, why would you give me that kind of answer...","jump":"d_counseling_neon_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_8","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_8","text":"You mean to say...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_9","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_9","text":"All that fire and brimstone are the key to creating the legendary firearm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_10","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_10","text":"I can't thank you enough, Master. You always guide me to the right path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_11","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_16_11","text":"If you'd just said to look inside my own heart and nothing more, I'd have thought you were brushing me off!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_16_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_neon_16_12","text":"Neon and I talk about the so-called \"legendary blacksmith\"","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}