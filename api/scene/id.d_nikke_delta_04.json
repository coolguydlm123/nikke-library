{"id":"d_nikke_delta_04","cat":"bond","group":{"id":"char3003","label":"Delta"},"label":"Raid! The Outer Rim","stage":null,"prev":"d_nikke_delta_03","next":"d_nikke_delta_05","speakers":{"crow":"Crow","delta":"Delta","trafficker":"Information Broker","youngman":"Young Man"},"icons":{"crow":"si_c110_00_s","delta":"si_c020_00_s","trafficker":"si_c999_00_s","youngman":"si_c999_00_s"},"lines":[{"id":"d_nikke_delta_04_1","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_1","text":"Some time later, in front of the gate to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_2","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_2","text":"So...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow","delta"],"affinity":null},{"id":"d_nikke_delta_04_3","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_3","text":"You're planning to track down the terrorist who killed you when you were human,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_4","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_4","text":"by doing your own legwork here in the Outer Rim to gather intel on him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_5","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_5","text":"That's an accurate summary, Crow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_6","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_6","text":"... Good grief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_7","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_7","text":"Your overzealousness is on the verge of ruining everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_8","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_8","text":"Did I hear you correctly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_9","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_9","text":"Doesn't feel right saying this myself, but... think about it logically.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_10","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_10","text":"A fully armed soldier like you—someone clearly decked out in Central Government gear—suddenly shows up poking around here and there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_11","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_11","text":"Just imagine how fast rumors would spread in a neighborhood as closed-off as this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_12","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_12","text":"I didn't... take that part into account.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_13","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_13","text":"This place is an outlaw's den.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_14","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_14","text":"I assumed someone with my appearance could just blend in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_15","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_15","text":"Are you joking? Being armed is not always enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_16","text":"Is there anything we can do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_17","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_17","text":"It's not totally hopeless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_18","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_18","text":"Just make them believe the armor isn't originally yours, but that you took it from a Central Government soldier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_19","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_19","text":"You mean... you want me to act as an outlaw?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_20","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_20","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_21","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_21","text":"If you can pull that off, you can head to the intel exchange in the city center and get your revenge easily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_22","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_22","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_23","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_23","text":"I can't even pass as a regular citizen. I'm not sure I can convincingly act like a thug.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_24","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_24","text":"Think of the training assistants at the training camp.","jump":"d_nikke_delta_04_26","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_25","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_25","text":"Think of Ingrid, whose anger meter has been maxed out.","jump":"d_nikke_delta_04_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_26","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_26","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_27","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_27","text":"Understood. That reference will be noted.","jump":"d_nikke_delta_04_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_28","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_28","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_29","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_29","text":"I'm certain now what attitude to go for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_30","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_30","text":"If I just mix in a little cursing... Hmm, that should be perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_31","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_31","text":"Thank you for the hint, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_32","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_32","text":"Some time later, at a suspicious back alley in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"Backstreet_n","bgArt":"backstreet_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_33","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_33","text":"As far as I know, the one involved in that terrorist attack some years back","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow","delta"],"affinity":null},{"id":"d_nikke_delta_04_34","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_34","text":"was an old man who collected corpses indiscriminately—whether from the Ark or the Outer Rim—to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_35","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_35","text":"Back then, he pulled off a gutsy scheme, smuggling large quantities of citizenship chips through shady means.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_36","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_36","text":"He kept at it until just before A.C.P.U. caught him. After that, it seems he quietly went back to his hometown and kept his head down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_37","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_37","text":"I see... Thank you for providing such important information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_38","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_38","text":"But Crow, are you sure this is okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_39","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_39","text":"Helping us like this with no compensation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_40","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_40","text":"Don't worry. Your Commander's gonna pay up, no doubt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_41","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_41","text":"...","jump":"d_nikke_delta_04_43","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_42","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_42","text":"That's right.","jump":"d_nikke_delta_04_43","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_43","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_43","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_44","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_44","text":"I will never forget this favor, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_45","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_45","text":"Then, Crow, lead me to the intel exchange you mentioned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_46","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_46","text":"Soon after, at the Outer Rim's largest intel exchange.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_47","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_47","text":"... Commander. Are you ready to enter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_48","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_48","text":"I was born ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_49","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_49","text":"Good, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_50","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_50","text":"*Creak*","jump":null,"exit":false,"enter":null,"bg":"Bar","bgArt":"bar","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_51","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_51","text":"... What? Customers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_52","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_52","text":"Yeah, dude.","jump":"d_nikke_delta_04_54","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_53","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_53","text":"You know it, man.","jump":"d_nikke_delta_04_54","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_54","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_54","text":"... Oh, come on. You call yourselves customers when you're dressed like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_55","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_55","text":"What the hell were those standing guard doing, letting a bunch of shady punks like you through?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_56","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_56","text":"Hold up, man! That uniform, no way...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_57","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_57","text":"You're one of the Central Government's dogs, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_58","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_58","text":"What? If that's true, we need to catch 'em and beat the hell out of 'em.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_59","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_59","text":"*Ptooey* Who the hell do those outsiders think they are, crawling in here...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_60","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_60","text":"... I'm not an outsider.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tuffguys","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_61","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_61","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_62","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_62","text":"Anyone here ever robbed a Central Government soldier? This stuff's pure loot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_63","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_63","text":"Wow. What the hell are you saying right now?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_64","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_64","text":"Look, if you've got any sense at all, think about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_65","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_65","text":"What kinda crazy Central Government soldier would be strolling through the Outer Rim dressed like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_66","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_66","text":"My friend's right.","jump":"d_nikke_delta_04_68","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_67","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_67","text":"That's right, you punks.","jump":"d_nikke_delta_04_68","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_68","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_68","text":"I mean, you're not wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_69","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_69","text":"But I've never seen you guys around here before...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_70","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_70","text":"What kind of crap are you spittin' now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_71","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_71","text":"It's been over 30 years since I last ran a big job on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_72","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_72","text":"If anyone cared about me, M.M.R. would've pulled me into their labs ages ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_73","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_73","text":"Why the hell would I be stuck wastin' away in some dump like this if that were true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_74","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_74","text":"A-a-a collector with 30 years of experience?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_75","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_75","text":"But you look way too young for that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_76","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_76","text":"These days, there's pretty much a drug for everything.","jump":"d_nikke_delta_04_78","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_77","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_77","text":"With Rapture technology, nothing's impossible.","jump":"d_nikke_delta_04_78","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_78","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_78","text":"... Buddy, I think these guys are kinda off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_79","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_79","text":"... Yeah, I'm with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_80","type":"Speech","speaker":"youngman","key":"Locale_NikkeEpisode:d_nikke_delta_04_80","text":"Let's just accept their deal, man. We're avoiding this 'cause it's messy, not because we're afraid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_81","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_81","text":"Right, right... This neighborhood's crawling with nutjobs like that anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_82","type":"Speech","speaker":"trafficker","key":"Locale_NikkeEpisode:d_nikke_delta_04_82","text":"... So, what kind of info you after?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_83","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_83","text":"... That was fast. Mission a success, then?","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_delta_04_84","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_84","text":"Yes, it succeeded without complications.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["delta"],"affinity":null},{"id":"d_nikke_delta_04_85","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_85","text":"You've got great acting skills.","jump":"d_nikke_delta_04_87","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_86","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_86","text":"You've got great swearing skills.","jump":"d_nikke_delta_04_87","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_87","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_87","text":"Oh, that... I've seen and heard a great deal during training.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_88","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_88","text":"Whatever it may be, it's all thanks to your hint, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_89","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_89","text":"In any case, we obtained information on the culprit faster than expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_90","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_90","text":"Let's keep pushing forward at this pace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_91","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_91","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":"Backstreet_n","bgArt":"backstreet_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_92","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_92","text":"... This is the location of the culprit obtained from the exchange.","jump":null,"exit":false,"enter":null,"bg":nu