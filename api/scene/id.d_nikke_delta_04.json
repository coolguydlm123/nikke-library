 down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_100","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_100","text":"But since you guys have stepped up to deal with them, well... that works out perfectly for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_101","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_04_101","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_102","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_102","text":"Well, don't get me wrong. I didn't plan on using you from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_103","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_103","text":"It just so happened that we have the same enemy. That's all. Pure coincidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_104","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_104","text":"What you should really be worrying about is the operation ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_105","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_105","text":"The place we need to infiltrate is notorious for its high security, even in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_106","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_106","text":"Some say it was a hideout for a large criminal organization in the past or maybe the bunker for a paranoid veteran.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_107","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_107","text":"There are tons of rumors, but nobody really knows for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_108","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_delta_04_108","text":"They've probably got everything from infrared sensors to booby traps set up inside. So, you still set on getting your revenge?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_109","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_109","text":"... Yes. Now that I've come this far, I will see the mission through no matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_110","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_110","text":"Besides, breaking through traps and tactically infiltrating enemy lines","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_04_111","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_04_111","text":"is my specialty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}