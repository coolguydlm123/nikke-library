{"id":"msg_m_ex_brid_silenttrack_02","cat":"messenger","group":{"id":"room_brid","label":"Brid · Nikke"},"label":"8. Commander,","stage":null,"prev":"msg_m_ex_brid_silenttrack_01","next":"msg_m_ex_brid_silenttrack_03","speakers":{"brid_w":"Brid"},"icons":{"brid_w":"si_c073_00_s"},"lines":[{"id":"m_ex_brid_silenttrack_02_1","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_1","text":"Commander,","jump":null},{"id":"m_ex_brid_silenttrack_02_2","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_2","text":"I have something I'd like to ask you.","jump":null},{"id":"m_ex_brid_silenttrack_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_3","text":"What is it?","jump":null},{"id":"m_ex_brid_silenttrack_02_4","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_4","text":"May I ask if you have ever visited the Maid Cafe?","jump":null},{"id":"m_ex_brid_silenttrack_02_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_5","text":"Yeah, I've been there.","jump":null},{"id":"m_ex_brid_silenttrack_02_6","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_6","text":"I'm a regular.","jump":"m_ex_brid_silenttrack_02_8"},{"id":"m_ex_brid_silenttrack_02_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_7","text":"But only when work calls for it.","jump":"m_ex_brid_silenttrack_02_8"},{"id":"m_ex_brid_silenttrack_02_8","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_8","text":"As I expected,","jump":null},{"id":"m_ex_brid_silenttrack_02_9","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_9","text":"I thought you might have visited before.","jump":null},{"id":"m_ex_brid_silenttrack_02_10","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_10","text":"Then,","jump":null},{"id":"m_ex_brid_silenttrack_02_11","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_11","text":"have you had a chance to try their coffee?","jump":null},{"id":"m_ex_brid_silenttrack_02_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_12","text":"Yeah, I have.","jump":null},{"id":"m_ex_brid_silenttrack_02_13","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_13","text":"How was it?","jump":null},{"id":"m_ex_brid_silenttrack_02_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_14","text":"It was good.","jump":"m_ex_brid_silenttrack_02_16"},{"id":"m_ex_brid_silenttrack_02_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_15","text":"It didn't suit my taste.","jump":"m_ex_brid_silenttrack_02_18"},{"id":"m_ex_brid_silenttrack_02_16","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_16","text":"I see.","jump":null},{"id":"m_ex_brid_silenttrack_02_17","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_17","text":"In that case, I can rest assured.","jump":"m_ex_brid_silenttrack_02_23"},{"id":"m_ex_brid_silenttrack_02_18","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_18","text":"!","jump":null},{"id":"m_ex_brid_silenttrack_02_19","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_19","text":"May I ask what didn't suit your taste?","jump":null},{"id":"m_ex_brid_silenttrack_02_20","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_20","text":"Was it perhaps too sweet?","jump":null},{"id":"m_ex_brid_silenttrack_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_21","text":"Yeah, a little.","jump":null},{"id":"m_ex_brid_silenttrack_02_22","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_22","text":"As I anticipated.","jump":"m_ex_brid_silenttrack_02_23"},{"id":"m_ex_brid_silenttrack_02_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_23","text":"Why're you asking me that all of a sudden?","jump":null},{"id":"m_ex_brid_silenttrack_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_24","text":"Did something happen?","jump":null},{"id":"m_ex_brid_silenttrack_02_25","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_25","text":"Not long ago, Soline told me","jump":null},{"id":"m_ex_brid_silenttrack_02_26","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_26","text":"about a coffee place she knew well.","jump":null},{"id":"m_ex_brid_silenttrack_02_27","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_27","text":"I asked where it was,","jump":null},{"id":"m_ex_brid_silenttrack_02_28","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_28","text":"she said it was the Maid Cafe","jump":null},{"id":"m_ex_brid_silenttrack_02_29","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_29","text":"and that she even knew their coffee recipe.","jump":null},{"id":"m_ex_brid_silenttrack_02_30","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_30","text":"The Soline I know doesn't like coffee,","jump":null},{"id":"m_ex_brid_silenttrack_02_31","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_31","text":"so I was curious about the one she recommended.","jump":null},{"id":"m_ex_brid_silenttrack_02_32","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_32","text":"I asked her to make me a cup","jump":null},{"id":"m_ex_brid_silenttrack_02_33","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_33","text":"and even gave it a try.","jump":null},{"id":"m_ex_brid_silenttrack_02_34","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_34","text":"In the end,","jump":null},{"id":"m_ex_brid_silenttrack_02_35","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_35","text":"that coffee was sweeter than I could have ever imagined,","jump":null},{"id":"m_ex_brid_silenttrack_02_36","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_36","text":"and I couldn't bring myself to take a second sip.","jump":null},{"id":"m_ex_brid_silenttrack_02_37","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_37","text":"That's why I wanted to check with you, just to be sure.","jump":null},{"id":"m_ex_brid_silenttrack_02_38","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_38","text":"After all, Diesel, Soline, and I","jump":null},{"id":"m_ex_brid_silenttrack_02_39","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_39","text":"are planning to visit the Maid Cafe next week.","jump":null},{"id":"m_ex_brid_silenttrack_02_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_40","text":"If that's what you're worried about, you don't have to.","jump":null},{"id":"m_ex_brid_silenttrack_02_41","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_41","text":"Pardon?","jump":null},{"id":"m_ex_brid_silenttrack_02_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_42","text":"Just tell them what type of coffee you want, and they'll make it exactly how you like it.","jump":null},{"id":"m_ex_brid_silenttrack_02_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_43","text":"That's the kind of place it is.","jump":null},{"id":"m_ex_brid_silenttrack_02_44","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_44","text":"!","jump":null},{"id":"m_ex_brid_silenttrack_02_45","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_45","text":"I see.","jump":null},{"id":"m_ex_brid_silenttrack_02_46","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_46","text":"All right, then I'll do as you advised.","jump":null},{"id":"m_ex_brid_silenttrack_02_47","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_02_47","text":"Thank you, Commander.","jump":null}],"chat":true}