ilion","key":"Locale_MainScenario:d_main_40_05_62","text":"What will you do once you apprehend them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_63","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_05_63","text":"Ask them a few questions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_64","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_05_64","text":"But if they're looking for a fight, we'll give them one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_65","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_65","text":"They don't seem like bad kids to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_66","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_66","text":"Are you sure you can't talk things out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_67","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_05_67","text":"Of course, that is our plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_68","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_05_68","text":"But I'm not sure if they have the same intentions of doing so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_69","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_05_69","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_70","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_70","text":"Pinocchio, what's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_71","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_05_71","text":"I don't like those guys who hurt you. They make me mad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_72","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_72","text":"I'm fine. I didn't get hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_73","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_73","text":"I'm sorry to bother you, my friend, but is there any way you could look after Pinocchio for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_74","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_74","text":"I have to go find Levi and Ziz with the others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_75","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_05_75","text":"I do object. Thou shouldst remain here with Pinocchio, Harmonizer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_76","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_05_76","text":"A battle shall likely ensue. At that time, I shall not be able to offer thee protection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_77","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_05_77","text":"The adversaries are Heretics, and not one, but two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_78","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_78","text":"I'm telling you, I'll be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_79","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_05_79","text":"Me too. I want to go with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_80","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_81","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_81","text":"Now that I think about it, it might be best for Pinocchio and me to stay here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_82","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_05_82","text":"But, Uncle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_83","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_83","text":"I'll leave the rest in your hands, my friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_84","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_40_05_84","text":"Come, Pinocchio. Let's go inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_85","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_05_85","text":"Raptilion and Pinocchio go inside the house.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_86","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_05_86","text":"They wouldn't sneak off after us, would they?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_87","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_05_87","text":"Such a thing shall not come to pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_88","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_05_88","text":"Harmonizer doth care deeply for Pinocchio, as well as her safety.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_89","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_05_89","text":"Then, depart ye shall. I shall guide thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_05_90","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_05_90","text":"Why do you keep insisting on guiding us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}