{"id":"msg_m_ex_vesti_04","cat":"messenger","group":{"id":"room_vesti","label":"Vesti · Nikke"},"label":"4. Commander,","stage":null,"prev":"msg_m_ex_vesti_03","next":"msg_m_ex_vesti_05","speakers":{"vesti":"Vesti"},"icons":{"vesti":"si_c091_00_s"},"lines":[{"id":"m_ex_vesti_04_1","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_1","text":"Commander,","jump":null},{"id":"m_ex_vesti_04_2","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_2","text":"are you busy?","jump":null},{"id":"m_ex_vesti_04_3","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_3","text":"Hmm... You probably are.","jump":null},{"id":"m_ex_vesti_04_4","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_4","text":"Sorry! T_T","jump":null},{"id":"m_ex_vesti_04_5","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_5","text":"I heard you barely even have time to sleep these days,","jump":null},{"id":"m_ex_vesti_04_6","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_6","text":"and here I am pestering you.","jump":null},{"id":"m_ex_vesti_04_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_7","text":"Sorry, I just saw your message.","jump":"m_ex_vesti_04_9"},{"id":"m_ex_vesti_04_8","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_8","text":"I may be busy, but I always have time to message you, Vesti.","jump":"m_ex_vesti_04_12"},{"id":"m_ex_vesti_04_9","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_9","text":"Oh, okay!","jump":null},{"id":"m_ex_vesti_04_10","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_10","text":"I thought I was bothering you while you were busy","jump":null},{"id":"m_ex_vesti_04_11","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_11","text":"and you were upset with me somehow.","jump":"m_ex_vesti_04_14"},{"id":"m_ex_vesti_04_12","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_12","text":"Wow, really?","jump":null},{"id":"m_ex_vesti_04_13","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_13","text":"That makes me so happy! ^__^","jump":"m_ex_vesti_04_14"},{"id":"m_ex_vesti_04_14","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_14","text":"To be honest,","jump":null},{"id":"m_ex_vesti_04_15","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_15","text":"I'd love to send you messages every day,","jump":null},{"id":"m_ex_vesti_04_16","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_16","text":"but I never know","jump":null},{"id":"m_ex_vesti_04_17","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_17","text":"what to say T_T","jump":null},{"id":"m_ex_vesti_04_18","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_18","text":"I wanna have fun conversations with you","jump":null},{"id":"m_ex_vesti_04_19","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_19","text":"like Anis and Neon do.","jump":null},{"id":"m_ex_vesti_04_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_20","text":"I think you're overthinking this.","jump":null},{"id":"m_ex_vesti_04_21","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_21","text":"Am I? >_<","jump":null},{"id":"m_ex_vesti_04_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_22","text":"You can just tell me about your day.","jump":null},{"id":"m_ex_vesti_04_23","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_23","text":"My day?","jump":null},{"id":"m_ex_vesti_04_24","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_24","text":"Like, from when I woke up all the way","jump":null},{"id":"m_ex_vesti_04_25","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_25","text":"to when I fell asleep?","jump":null},{"id":"m_ex_vesti_04_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_26","text":"Let's focus on the things that you remember.","jump":null},{"id":"m_ex_vesti_04_27","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_27","text":"Hmm...","jump":null},{"id":"m_ex_vesti_04_28","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_28","text":"Hmmmmm...","jump":null},{"id":"m_ex_vesti_04_29","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_29","text":"How about your happiest moments?","jump":"m_ex_vesti_04_34"},{"id":"m_ex_vesti_04_30","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_30","text":"How about your saddest moments?","jump":"m_ex_vesti_04_31"},{"id":"m_ex_vesti_04_31","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_31","text":"Eunhwa gave me another dressing-down today.","jump":null},{"id":"m_ex_vesti_04_32","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_32","text":"She told me to stop trying to be a one-man band when it comes to killing Raptures.","jump":null},{"id":"m_ex_vesti_04_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_33","text":"And what was your happiest moment today?","jump":"m_ex_vesti_04_34"},{"id":"m_ex_vesti_04_34","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_34","text":"I encountered a horde of Lord-class Raptures","jump":null},{"id":"m_ex_vesti_04_35","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_35","text":"and was able to destroy them all","jump":null},{"id":"m_ex_vesti_04_36","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_36","text":"before Emma and Eunhwa got there.","jump":null},{"id":"m_ex_vesti_04_37","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_37","text":"As I was looking over the heap of bodies,","jump":null},{"id":"m_ex_vesti_04_38","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_38","text":"I felt extremely satisfied.","jump":null},{"id":"m_ex_vesti_04_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_39","text":"Wow, you're so cool!","jump":null},{"id":"m_ex_vesti_04_40","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_40","text":"Wha... No, I'm not...","jump":null},{"id":"m_ex_vesti_04_41","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_41","text":"Anyway, what's your happiest moment today, Commander?","jump":null},{"id":"m_ex_vesti_04_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_42","text":"Right now since I'm talking to you.","jump":null},{"id":"m_ex_vesti_04_43","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_43","text":">///<","jump":null},{"id":"m_ex_vesti_04_44","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_44","text":"Really?","jump":null},{"id":"m_ex_vesti_04_45","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_45","text":"How about the second-happiest moment?","jump":null},{"id":"m_ex_vesti_04_46","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_46","text":"Ah!","jump":null},{"id":"m_ex_vesti_04_47","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_47","text":"I think I'm getting more natural at","jump":null},{"id":"m_ex_vesti_04_48","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_48","text":"chatting with you!","jump":null},{"id":"m_ex_vesti_04_49","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_49","text":"You see? Nothing to it.","jump":null},{"id":"m_ex_vesti_04_50","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_50","text":"Really...","jump":null},{"id":"m_ex_vesti_04_51","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_51","text":"And it's all thanks to you.","jump":null},{"id":"m_ex_vesti_04_52","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_04_52","text":"Let's keep it casual like this the next time we message each other.","jump":null},{"id":"m_ex_vesti_04_53","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_53","text":"Sure thing!","jump":null},{"id":"m_ex_vesti_04_54","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_04_54","text":"I can't wait!","jump":null}],"chat":true}