{"id":"d_counseling_dorothy_02","cat":"counsel","group":{"id":"char5061","label":"Dorothy"},"label":"Advising Dorothy: 02","stage":null,"prev":"d_counseling_dorothy_01","next":"d_counseling_dorothy_03","speakers":{"dorothy":"Dorothy"},"icons":{"dorothy":"si_c233_00_s"},"lines":[{"id":"d_counseling_dorothy_02_1","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_1","text":"I heard you spent a fair amount of time on the surface.","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"bgm_story_edenin","movie":null,"shown":["dorothy"],"affinity":"_0"},{"id":"d_counseling_dorothy_02_2","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_2","text":"Have you ever tried your hand at skinning a deer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_02_3","text":"No, but I have an idea of how it's done.","jump":"d_counseling_dorothy_02_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_dorothy_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_02_4","text":"Actually, I've never even come across a deer.","jump":"d_counseling_dorothy_02_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_dorothy_02_5","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_5","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_6","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_6","text":"If you ever get the chance to try it, you'll be surprised at how easy it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_7","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_7","text":"A deer has a lot of meat, which is great for sharing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_8","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_8","text":"You can share it with... your comrades.","jump":"d_counseling_dorothy_02_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_9","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_9","text":"That's understandable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_10","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_10","text":"Living beings are a rare sight on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_11","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_02_11","text":"Perhaps you'll have a chance to see one in the future.","jump":"d_counseling_dorothy_02_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_02_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_02_12","text":"Dorothy shares some insights about deer with me.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","ima