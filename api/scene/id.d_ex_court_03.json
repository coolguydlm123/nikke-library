{"id":"d_ex_court_03","cat":"outpost","group":{"id":"outpost11601","label":"Courthouse"},"label":"The Culprit!","stage":null,"prev":"d_ex_court_01","next":"d_ex_court_02","speakers":{"privaty":"Privaty","yulha":"Yulha"},"icons":{"privaty":"si_c170_00_s","yulha":"si_c171_00_s"},"notes":["Unlock: Yulha · Privaty","Featuring Privaty · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_court_03_1","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_1","text":"*Bang*","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_2","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_2","text":"Yulha, hear me out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["privaty","yulha"],"affinity":null},{"id":"d_ex_court_03_3","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_3","text":"I can scarcely believe it myself,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_4","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_4","text":"but the Commander has been lying to me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_5","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_5","text":"How could you do this to me, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_6","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_6","text":"Doing this to other people would be one thing, but lying straight to my face? I trusted you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_7","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_7","text":"I've done nothing of the sort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_8","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_8","text":"What on earth is all the commotion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_9","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_9","text":"The Commander borrowed some credits from me and never paid me back!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_10","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_10","text":"What? Why would someone of your stature need to borrow money from Privaty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_11","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_11","text":"I've never once borrowed money from anyone in my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_12","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_12","text":"Sigh... all right, tell me everything that happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_13","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_13","text":"Okay! About an hour ago, the Commander came to me","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_14","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_14","text":"going on about how there was \"urgent business\" and asking if I could spare a few credits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_15","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_15","text":"Apparently the Commander had a litany of problems and was in a hurry. Broken cell phone, lost wallet... you name it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_16","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_16","text":"So I figured as long as I got paid back once the cell phone was repaired, it was no big deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_17","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_17","text":"So you lent the Commander all the money in one go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_18","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_18","text":"Yeah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_19","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_19","text":"Why did you do that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_20","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_20","text":"Huh? Why wouldn't I? Be-because I trusted the Commander, that's why!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_21","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_21","text":"... Fine. Go on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_22","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_22","text":"So, later, I went to the Commander's Room to get my credit back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_23","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_23","text":"I figured the cell phone should have been repaired by then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_24","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_24","text":"So I went to the Commander's Room to try and get my credit back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_25","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_25","text":"But the Commander played dumb and denied ever borrowing money from me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_26","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_26","text":"Which is a bald-faced lie, because I still have the message the Commander sent me on my phone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_27","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_27","text":"I never sent you any messages!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_28","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_28","text":"Stop lying!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_29","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_29","text":"The chat history is right here on my phone, clear as day!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_30","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_30","text":"All right, let me see it then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_31","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_31","text":"Sure, see for yourself!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_32","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_32","text":"Privaty gives her cell phone to Yulha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_33","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_33","text":"... This isn't Newbie's number.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_34","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_34","text":"I figured the Commander had borrowed someone else's cell phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_35","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_35","text":"When you transferred the credits, did you check to see who was receiving the payment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_36","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_36","text":"Well... apparently it was urgent... so... no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_37","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_37","text":"*Bang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_38","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_38","text":"Yulha tosses Privaty's phone onto the table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_39","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_39","text":"What's the matter with you?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_40","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_40","text":"Sending money to an unfamiliar number without even double-checking the name...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_41","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_41","text":"There's nothing here that actually points to the Commander being the person on the other end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_42","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_42","text":"All you did was give the message a quick glance before sending the money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_43","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_43","text":"But... they sounded like the Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_44","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_44","text":"Are you out of your mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_45","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_45","text":"This is the oldest trick in the book for scammers!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_46","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_46","text":"A... a scammer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_47","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_47","text":"So that wasn't the Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_48","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_48","text":"What we've got here is a classic phone scammer case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_49","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_49","text":"How you ever made it to Central Government, I'll never know...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_50","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_50","text":"Er... so what should I do now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_51","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_51","text":"First, I think you owe Newbie an apology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_52","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_52","text":"What for?! It was all just a misunderstanding, it could happen to anyone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_53","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_53","text":"I'll sue you for defamation!","jump":"d_ex_court_03_55","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_54","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_54","text":"Since we've cleared things up, let's just move on.","jump":"d_ex_court_03_56","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_55","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_55","text":"Gah! It's not that big a deal, is it?!","jump":"d_ex_court_03_56","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_56","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_56","text":"I'll let you two sort out the rest yourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_57","type":"Speech","speaker":"privaty","key":"Locale_SuddenStory:d_ex_court_03_57","text":"But Yulha... What about my credit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_58","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_58","text":"Oh, that's long gone. If you want, you could try filing a report with the police.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_59","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_03_59","text":"*Yawn* as for now, consider this case closed. Now get out of here, both of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_03_60","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_03_60","text":"We were both kicked out of the courthouse. As we leave, Privaty frets over how to potentially get her lost credits back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}