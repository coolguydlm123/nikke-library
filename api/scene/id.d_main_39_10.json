{"id":"d_main_39_10","cat":"main","group":{"id":"ch39","label":"Chapter 39 · Gene"},"label":"Out of the Ordinary","stage":"39-33 STAGE · Start","prev":"d_main_39_09","next":"d_main_39_11","speakers":{"maxwell_p":"Maxwell","nayuta_n":"Nayuta","rapi_red":"Rapi","drake_p":"Drake","laplace_p":"Laplace"},"icons":{"maxwell_p":"si_c105_00_s","nayuta_n":"si_c9008_00_s","rapi_red":"si_c016_00_s","drake_p":"si_c104_00_s","laplace_p":"si_c103_00_s"},"lines":[{"id":"d_main_39_10_1","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_1","text":"Hey! Where are you going?","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_chapter39_field_gliding","movie":null,"shown":["nayuta_n","maxwell_p"],"affinity":null},{"id":"d_main_39_10_2","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_2","text":"I was following thee. How is it that thou art over there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_3","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_3","text":"You're the one who keeps wandering off! You were supposed to just follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_4","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_4","text":"Verily, the geomantic energies here are in disarray, so I am bereft of all sense of direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_5","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_5","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_6","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_10_6","text":"Nayuta, why aren't you moving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_red"],"affinity":null},{"id":"d_main_39_10_7","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_7","text":"Ah, I was but now beholding this rust shaped like a butterfly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_8","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_8","text":"Pray, behold, doth it not appear as though some hand had crafted it thus on purpose? Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_9","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_9","text":"Nature is indeed a realm most wondrous and mysterious, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_10","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_10_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_11","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_10_11","text":"Hey! Wake up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["drake_p","laplace_p"],"affinity":null},{"id":"d_main_39_10_12","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_12","text":"Ah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_13","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_10_13","text":"Are you okay? You just blacked out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_14","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_14","text":"Ah, my apologies. The sunlight was so pleasant that I succumbed to slumber.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_15","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_15","text":"Ye must be weary as well. What say ye that we rest awhile ere we press onward?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_16","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_10_16","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_17","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_10_17","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_10_18","text":"Nayuta, what are you doing sitting on the ground?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_19","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_19","text":"Behold this place. Long hath the sun shone upon it, bestowing warmth. Verily, a warm seat doth nurture the health of the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_10_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_10_21","text":"After many stops and starts, we finally reach the fin area that Nayuta mentioned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["maxwell_p","rapi_red","drake_p","laplace_p"],"affinity":null},{"id":"d_main_39_10_22","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_22","text":"Oh ho, thou art indeed a true finder of paths.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_23","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_23","text":"It would have taken me three days' journey to arrive here. Pray, didst thou employ some manner of instant travel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_24","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_10_24","text":"... So, where do we go now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_25","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_25","text":"There ought to be a lift hereabouts that doth lead to the other side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_26","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_26","text":"Hmmm... I am certain it was near, yet find it I cannot. 'Tis a matter that would cause even spirits to wail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_27","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_27","text":"I think you're standing on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_28","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_28","text":"Oh! Do you, perchance, possess clairvoyance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_29","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_29","text":"This is seriously unreal... Are all Pilgrims like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_30","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_10_30","text":"Yeah. Most of them, at least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_31","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_31","text":"Maybe it's because they've been up on the surface too long...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_32","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_10_32","text":"Commander, I'm going to activate the lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_10_33","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_34","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_34","text":"Pray, wait but a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_35","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_35","text":"No. You've held us up long enough, and we can't afford any more distractions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_chapter39_field_gliding_b","movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_36","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_36","text":"Look yonder, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_37","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_10_37","text":"We look toward the direction Nayuta pointed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_38","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_10_38","text":"A swarm of flying Raptures is heading our way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_39","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_10_39","text":"I'm detecting a Lord Class amongst them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_40","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_41","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_41","text":"Pray, let us forbear and observe but for a mo—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_10_42","text":"*Swooosh!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_43","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_43","text":"They dost attack?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_44","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_44","text":"How curious. Those who rideth the White Giant art ever gentle, and ne'er do they strike first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_45","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_45","text":"Methinks some misfortune hath befallen the Harmonizer, or mayhap the White Giant itself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_46","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_46","text":"'Tis no time to tarry, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_10_47","text":"Pretty sure no one else was relaxing but you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_10_48","text":"*Swooosh!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_49","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_10_49","text":"Engaging!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_50","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_10_50","text":"Laplace! Drake! Time to put those upgrades of yours to good use!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_51","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_10_51","text":"You bet! Ultimate Hero, moving out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_52","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_10_52","text":"Oh no, you don't! I'll show you the power of the great villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_53","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_53","text":"Forgive me, Great Hero. May this humble one witness this battle?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_10_54","text":"Sure, go ahead. But why do you want to watch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_55","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_55","text":"Verily, I desire to behold thy strength, as well as that of these fair ladies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_56","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_10_56","text":"Fine by me. Sit back and let us handle this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_57","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_10_57","text":"I give you my thanks, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_10_58","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_10_58","text":"Affirmative. Engaging enemy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}