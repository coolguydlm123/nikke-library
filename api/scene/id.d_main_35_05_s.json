{"id":"d_main_35_05_s","cat":"main","group":{"id":"ch35","label":"Chapter 35 · Conversation"},"label":"Bubble: A","stage":"35-18 STAGE · Start","prev":"d_main_35_04","next":"d_main_35_05_e","speakers":{"rapi_red":"Rapi","cinderella":"Cinderella","maxwell":"Maxwell","laplace":"Laplace","drake":"Drake","grave_p":"Grave"},"icons":{"rapi_red":"si_c016_00_s","cinderella":"si_c511_00_s","maxwell":"si_c102_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s","grave_p":"si_c514_00_s"},"lines":[{"id":"d_main_35_05_s_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_1","text":"I don't think we can cross this.","jump":null,"exit":false,"enter":null,"bg":"BlackSeaJungle","bgArt":"blackseajungle","image":null,"bgm":"bgm_chapter35_field_swamp_b","movie":null,"shown":["rapi_red","cinderella","grave_p","maxwell","drake","laplace"],"affinity":null},{"id":"d_main_35_05_s_2","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_2","text":"Me neither. It's too far across.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_3","text":"As we continue exploring, an exceedingly wide river appears before us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_4","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_4","text":"Far on the other side, we can see land.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_5","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_5","text":"I just had a look from above, and there's no other way around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_6","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_6","text":"We'll have to find a way to ford it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_7","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_7","text":"What a pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_8","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_8","text":"Cinderella, could you carry us over one by one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_9","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_9","text":"It's too dangerous. If we were to be intercepted midair, it'd all be over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_10","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_10","text":"We have no idea what's lurking beneath that water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_11","text":"Can't you fly as well, Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_12","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_12","text":"It's possible, but carrying a Nikke would throw off my balance and make it difficult to maneuver.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_13","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_13","text":"Now that I think about it though, that could be feasible in the future. I'll have to practice it whenever I have time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_14","text":"Could you carry me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_15","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_15","text":"It's possible. You're much lighter compared to a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_16","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_16","text":"But if I were to accelerate too quickly or make any sudden changes in direction,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_17","text":"you'd be liable to break your neck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_19","text":"Then again, perhaps you'd be able to recover from that. You've gotten impaled through the stomach and lived to tell the tale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_20","text":"I don't think I'd make it out of that one alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_21","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_21","text":"That was a joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_22","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_05_s_22","text":"There's no other choice. I'll have to throw each person across.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_23","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_23","text":"You fool! What if someone gets hurt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_24","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_24","text":"I say we swim across.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_25","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_05_s_25","text":"That's a brilliant idea! You're a genius!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_26","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_26","text":"There's no way that'd work. We'd sink straight away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_27","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_27","text":"How about you offer some solutions instead of just standing there and complaining?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_28","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_28","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_29","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_29","text":"The last thing we need is someone who only criticizes instead of helping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_30","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_30","text":"I'm going in. Stand back and watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_31","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_31","text":"Drake, wait!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_32","text":"*Splash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_33","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_33","text":"Gah! Help me! I just remembered I can't swim!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_34","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_34","text":"Maybe we should leave her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_35","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_35","text":"... I'll go fetch her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_36","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_36","text":"Cinderella floats over and pulls Drake out of the river.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["drake"],"affinity":null},{"id":"d_main_35_05_s_37","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_37","text":"Ugh... being saved by a hero? How humiliating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_38","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_38","text":"I'm not a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_39","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_39","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_40","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_40","text":"Cinderella pauses in mid-air while carrying Drake,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_41","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_41","text":"her eyes widening as she stares at something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_42","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_43","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_05_s_43","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_05_s_44","text":"Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_45","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_45","text":"Oh, sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_46","text":"Cinderella flies back and puts Drake down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["laplace"],"affinity":null},{"id":"d_main_35_05_s_47","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_47","text":"Man, I nearly bought the farm back there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_48","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_48","text":"You moron!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_49","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_49","text":"Hey, don't yell at me! I'm suffering the most out of anyone here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_50","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_50","text":"Urgh, you make me want to pull my hair out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_51","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_51","text":"What if that Dark Matter has some sort of detection function that notifies Leviathan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_52","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_52","text":"We've tried so hard to keep away from the Dark Matter, and here you go and...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_53","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_53","text":"I can't do this. I'm only getting more angry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_54","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_05_s_54","text":"Calm yourself, you fool. You mustn't allow your emotions to get the best of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_55","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_05_s_55","text":"Argh, why don't you just die?! Die and come back as someone better!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_56","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_05_s_56","text":"Cinderella, what did you see a moment ago?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_57","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_05_s_57","text":"Everyone. Look over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_58","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_58","text":"I look at where Cinderella is pointing.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_35_02","bgArt":"eventscene_chap_35_02","image":null,"bgm":"bgm_story_empathize","movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_59","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_59","text":"On top of the pitch-black water,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_60","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35_05_s_60","text":"something is floating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_05_s_61","type":"Monologue","speaker":null,"key"