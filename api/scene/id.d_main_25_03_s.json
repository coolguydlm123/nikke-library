":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_03_s_35","text":"I'd love to tell you, but I don't know much about it myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_03_s_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_03_s_36","text":"It beats me why Rapi is able to unleash such remarkable strength,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_03_s_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_03_s_37","text":"and this was the first time that I'd seen that scarf.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_03_s_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_03_s_38","text":"Have you ever heard of Red Hood, by any chance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_03_s_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_03_s_39","text":"Can't say I have. First time hearing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_03_s_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_03_s_40","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_03_s_41","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_03_s_41","text":"I've also got a question, if I may.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_0