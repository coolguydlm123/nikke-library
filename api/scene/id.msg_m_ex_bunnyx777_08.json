pe":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_08_24","text":"Then I have to share my luck with you.","jump":null},{"id":"m_ex_bunnyx777_08_25","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_bunnyx777_08_25","text":"When did you learn to be such a smooth talker?","jump":null},{"id":"m_ex_bunnyx777_08_26","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_bunnyx777_08_26","text":"Does flattery value go hand in hand with how lucky you are?","jump":null},{"id":"m_ex_bunnyx777_08_27","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_bunnyx777_08_27","text":"Fine.","jump":null},{"id":"m_ex_bunnyx777_08_28","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_bunnyx777_08_28","text":"I'm a bit far away right now, but...","jump":null},{"id":"m_ex_bunnyx777_08_29","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_bunnyx777_08_29","text":"...","jump":null},{"id":"m_ex_bunnyx777_08_30","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_bunnyx777_08_30","text":"I'll catch you later.","jump":null},{"id":"m_ex_bunnyx777_08_31","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_bunnyx777_08_31","text":"Don't forget to have some soda ready for me in your room.","jump":null},{"id":"m_ex_bunnyx777_08_32","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_08_32","text":"It really does feel like my luck has turned lately.","jump":null}],"chat":true}