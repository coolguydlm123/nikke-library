e_19","text":"And... I look forward to working with all of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_20","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_04_e_20","text":"Mhm, likewise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_21","type":"Speech","speaker":"prika","key":"Locale_MainScenario:event_staranis1_04_e_21","text":"No need to be all polite. We're the same age, aren't we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_22","type":"Speech","speaker":"riss","key":"Locale_MainScenario:event_staranis1_04_e_22","text":"Oh... Uh, sure? Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_23","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_e_23","text":"... Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_24","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_e_24","text":"Sorry to ask this right as soon as you arrive, but our schedule management is a bit of a mess right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_25","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_e_25","text":"I'd really appreciate it if you could take charge of sorting it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_26","type":"Speech","speaker":"riss","key":"Locale_MainScenario:event_staranis1_04_e_26","text":"Y-yes. I actually saw people talking about it on the forums already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_27","type":"Speech","speaker":"riss","key":"Locale_MainScenario:event_staranis1_04_e_27","text":"I'll take care of it, so please don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_28","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_e_28","text":"That's good to hear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_29","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_e_29","text":"All right, let's get going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_e_30","text":"Title: T.T. STAR's on a roll","jump":null,"exit":false,"enter":null,"bg":"EventScene_staranis_02","bgArt":"eventscene_staranis_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_e_31","text":"Finally, their schedules aren't a mess. No more no-shows, and the performance quality has really improved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_e_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_e_32","text":"Loo