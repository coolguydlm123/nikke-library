lla_01_7","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_7","text":"What a surprise. I didn't expect you to come to see me.","jump":null,"exit":false,"enter":null,"bg":"Cafe","bgArt":"cafe","image":null,"bgm":"bgm_story_epicjazzymoods","movie":null,"shown":["dolla"],"affinity":null},{"id":"d_nikke_dolla_01_8","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_8","text":"So, what's the matter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_9","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_9","text":"It's impossible for someone as busy as you to come over for coffee just because you felt like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_10","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_10","text":"I came to talk to you.","jump":"d_nikke_dolla_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_11","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_11","text":"Your boss asked me to come.","jump":"d_nikke_dolla_01_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_12","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_12","text":"Talk...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_13","type":"Monologue","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_13","text":"Dolla looks a little disappointed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_14","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_14","text":"... Oh, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_15","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_15","text":"Is this the quality check that must be done on Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_16","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_16","text":"It doesn't matter. Let's get this over with.","jump":"d_nikke_dolla_01_21","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_17","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_17","text":"Boss? Mr. Mustang?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_18","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_18","text":"... Hah. What a bother. TETRA's aesthetics are a real pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_19","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_19","text":"You're a busy man, too. Let's talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_20","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_20","text":"You can ask me whatever you want to, but, again, I only have ten minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_20_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_04_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_21","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_21","text":"How are things between you and your Nikke colleagues?","jump":"d_nikke_dolla_01_23","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_22","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_22","text":"Let's talk about the Dark Net.","jump":"d_nikke_dolla_01_38","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_23","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_23","text":"We're professional. We work and we do tasks together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_24","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_24","text":"We don't cross the line or want any more out of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_25","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_25","text":"... Were you expecting something else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_26","type":"Self","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_26","text":"Don't you want to be friendly with them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_27","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_27","text":"Yan always goes against my way of doing things, and Rupee prefers to pay more attention to her mall than to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["yan","rupee"],"affinity":null},{"id":"d_nikke_dolla_01_28","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_28","text":"Do you think it's easy to be \"friendly\" with them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_29","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_29","text":"I'd rather you give me a kitten or a puppy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["dolla"],"affinity":null},{"id":"d_nikke_dolla_01_30","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_30","text":"If I was interested in being friendlier with anyone, it'd be you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_31","type":"Monologue","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_31","text":"Dolla looks at me analytically.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_32","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_32","text":"Quite interested, in fact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_33","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_33","text":"The other Commanders I know don't care about Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_34","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_34","text":"After all, what most humans think is that Nikkes just have to be able to fight. Doesn't matter if they get along well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_35","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_35","text":"But you personally came here to ask about my personal relationships.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_36","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_36","text":"Why did you do that? What do you really want to know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_37","type":"Self","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_37","text":"Let's talk about the Dark Net.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_38","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_38","text":"... What? It looks like Mr. Mustang has been spouting nonsense again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_39","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_39","text":"To be honest with you, I have nothing to do with the Dark Net.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_40","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_40","text":"There are so many legitimate websites that can sell our products already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_41","type":"Monologue","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_41","text":"Dolla doesn't seem to want to admit that she had anything to do with the Dark Net.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_42","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_42","text":"I have evidence.","jump":"d_nikke_dolla_01_44","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_43","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_43","text":"...","jump":"d_nikke_dolla_01_50","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_44","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_44","text":"... Show me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_45","type":"Self","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_45","text":"Not now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_46","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_46","text":"Then drop it. It's really offensive to accuse someone without evidence, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_47","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_47","text":"And, Commander, I really hate people who pry into my affairs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_48","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_48","text":"Even if it's you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_49","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_49","text":"Do you understand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_50","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_50","text":"I've had enough of this. Just look at this instead. This is our company's newly-launched tablet. It sold out within a one-day pre-sale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_51","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_51","text":"It looks so expensive...","jump":"d_nikke_dolla_01_53","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_52","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_01_52","text":"It's very attractive.","jump":"d_nikke_dolla_01_54","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_53","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_53","text":"Of course. After all, it's high-performance.","jump":"d_nikke_dolla_01_55","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_54","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_54","text":"Of course. This is our company's flagship product.","jump":"d_nikke_dolla_01_55","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_55","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_55","text":"7th generation Biotablet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_56","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_56","text":"It can receive users' brain waves, so ordinary tasks can be done just by thinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_57","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_57","text":"Not only that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_58","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_58","text":"it can also monitor users' physical condition in real-time. Once the danger is found, it immediately signals the user.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_01_59","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_01_59","text":"This will lessen the mortality rat