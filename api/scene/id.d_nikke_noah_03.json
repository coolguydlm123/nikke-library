wn":null,"affinity":null},{"id":"d_nikke_noah_03_63","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_63","text":"Pfft. You didn't think I would leave you behind, did you?","jump":"d_nikke_noah_03_67","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_64","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_64","text":"And what do you mean by \"back\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_65","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_65","text":"I didn't even leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_66","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_66","text":"... You didn't think I would be pissed over such a little thing and leave you behind, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_67","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_67","text":"I know you were afraid, but don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_68","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_68","text":"Even if it's only for myself, I'm not leaving you alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_69","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_69","text":"... You didn't forget, right? You are here to make me stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_70","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_03_70","text":"... Thanks for coming back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_71","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_71","text":"Wh-what are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_72","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_72","text":"I'm here for my own reasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_73","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_73","text":"I'm a magnificent Pilgrim. It's not that I'm worried about you or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_74","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_03_74","text":"Why do you sound so uncomfortable?","jump":"d_nikke_noah_03_76","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_75","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_03_75","text":"Why so startled?","jump":"d_nikke_noah_03_76","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_76","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_76","text":"Ah, I can't hear you. Anyway, you should get ready. We are