l,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_14","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_03_14","text":"Oh?","jump":"d_nikke_noah_03_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_15","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_15","text":"... Nonsense. Even if they give me that title, I won't accept it.","jump":"d_nikke_noah_03_18","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_16","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_16","text":"... What's that look on your face?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_17","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_17","text":"I'd never accept such a lousy title.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_18","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_19","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_19","text":"... But I need to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_20","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_20","text":"Why do you live your life in such a foolish way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_21","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_03_21","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_22","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_22","text":"Why risk your own life to save that kid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_23","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_03_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_24","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_24","text":"Tell me, is it because you think she will be useful to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_25","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_25","text":"Or do you think she will repay you for rescuing her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_26","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_03_26","text":"Not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_27","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_27","text":"So, why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_28","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_28","text":"Why do this nonsense when you get nothing in return?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_29","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_03_29","text":"...\n...","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_30","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_30","text":"When I was abandoned, I was even younger than her and I survived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_31","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_31","text":"I set up an almost shattered shield on the ground, hid behind it, and counted sheep endlessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_32","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_32","text":"Then a few years later, a true Commander told me, “You look useful.” He recruited me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_33","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_33","text":"In this crazy land, I survived just by my unyielding pride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_34","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_03_34","text":"When you were first abandoned in the wild, you were probably just like her.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"bgm_story_impression","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_35","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_35","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_36","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_36","text":"Come on, you Imposter! You really want to compare me to her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_37","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_37","text":"... Whew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_38","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_38","text":"There. Her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_39","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_39","text":"I don't know what you saw in her, but we are not the same at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_40","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_40","text":"Her rescue doesn't change what happened to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_41","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_41","text":"The people who turned a blind eye won't regret what they did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_42","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_42","text":"So why trouble yourself for such a ridiculous reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_43","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_03_43","text":"Call me a Imposter all you want, but I'm still your Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_44","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_44","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_45","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_45","text":"Unbelievable... This logic is ridiculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_46","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_46","text":"... You know you really look like a joke, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_47","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_47","text":"Any Rapture that passes by can kill you with a touch. You can't even save yourself, let alone save others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_48","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_48","text":"You are so block-headed. I can't understand you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_49","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_49","text":"And I don't want to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_50","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_03_50","text":"... I'm leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_51","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_noah_03_51","text":"*Slam*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_52","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_03_52","text":"... Noah leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_53","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_03_53","text":"... *Cough cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_54","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_03_54","text":"Did she leave us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_03_55","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_03_55","text":"Maybe.","jump":"d_nikke_noah_03_57","exit":false,"enter":null,"bg":null,"bg