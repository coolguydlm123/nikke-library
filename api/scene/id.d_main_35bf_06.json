{"id":"d_main_35bf_06","cat":"main","group":{"id":"ch35","label":"Chapter 35 · Conversation"},"label":"Several Mistakes","stage":null,"prev":"d_main_35bf_05","next":"d_main_35bf_07","speakers":{"ingrid":"Ingrid","rapi_red":"Rapi"},"icons":{"ingrid":"si_c900_00_s","rapi_red":"si_c016_00_s"},"lines":[{"id":"d_main_35bf_06_1","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_1","text":"I have some bad news for you.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["ingrid","rapi_red"],"affinity":null},{"id":"d_main_35bf_06_2","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_2","text":"It didn't go well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_3","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_4","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_4","text":"We did find some leftover first-generation Rapture cores, and went to work straight away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_5","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_5","text":"However, there were several mistakes during the process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_6","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_6","text":"We've never done this before, so we're not familiar with it yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_7","text":"In other words, you were unable to craft any Vapaus ammunition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_8","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_8","text":"It's okay. I didn't expect it to work right away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_9","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_9","text":"It's unfortunate, but we can try again in two months.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_10","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_10","text":"Actually, we might be able to manufacture a single round.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_11","text":"Oh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_12","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_12","text":"I heard Eden managed to make two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_13","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_13","text":"Tsk... It's been a while since I've been frustrated by technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_14","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_14","text":"Anyway, we'll send it up as soon as it's ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_15","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_15","text":"In a week at the earliest, and no longer than 10 days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_16","text":"To be able to successfully make this ammunition on your first attempt is remarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_17","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_17","text":"We haven't made it yet, and even if we do, I'd hardly call us \"remarkable\". In fact, I'm a bit humiliated by this entire affair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_18","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_18","text":"With how limited this ammunition is, the difference between one and two rounds is like a precision tactical strike versus a lumbering brawl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_19","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_19","text":"One Vapaus round still equals one dead Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_20","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_21","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_21","text":"That's a good way of thinking about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_22","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_22","text":"You're right. I should be proud of what we've accomplished at Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_06_23","text":"I knew you'd be able to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_24","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_24","text":"... I don't see Anis and Neon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_25","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_06_25","text":"They had some personal business to attend to, and won't be joining us on this operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_26","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_26","text":"... Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_27","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_27","text":"Very well. I'll choose to interpret this positively.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_28","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_28","text":"But since you seem to have forgotten, allow me to remind you of something:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_29","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_29","text":"Neon is a spy that I've planted in your ranks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_30","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_06_30","text":"Ah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_31","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_31","text":"Ah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_32","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_32","text":"I can't trust a spy that goes rogue like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_33","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_33","text":"Anyway, I'll take care of the rest as far as the Vapaus is concerned, so get ready to go up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_34","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_34","text":"The support forces that Andersen prepared should be waiting for you in front of the elevator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_35","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_06_35","text":"Join up with them, and then head out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_06_36","text":"Okay. Once again, good work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_06_37","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_06_37","text":"See you again, Instructor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}