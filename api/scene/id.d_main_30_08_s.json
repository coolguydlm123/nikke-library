ee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_79","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_08_s_79","text":"Taking her to the Ark isn't feasible, so we're heading to Reclamation Site 01.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_80","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_08_s_80","text":"Can we expect any support in terms of personnel or equipment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_81","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_30_08_s_81","text":"I'll put in a request, but I'm not sure what it'll amount to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_82","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_08_s_82","text":"Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_83","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_30_08_s_83","text":"A-are we heading back now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_84","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_30_08_s_84","text":"Yes, we've accomplished our goal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_85","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_30_08_s_85","text":"All right, I'll lead the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_86","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_30_08_s_86","text":"Fortunately, the crystals aren't expanding like they were before, so we should be able to return safely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_87","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_30_08_s_87","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_88","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_30_08_s_88","text":"The only question is how do we get back up the tunnel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_89","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_30_08_s_89","text":"Things at the Ark have calmed down, so transportation robots will be provided.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_90","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_08_s_90","text":"I also set up ropes and footsteps in the tunnel as we came down.\nIt'll be a bit of a challenge, but we should be able to climb up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_91","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_30_08_s_91","text":"Nicely done, Drilley!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_92","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_30_08_s_92","text":"You think of everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_93","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_30_08_s_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_94","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_30_08_s_94","text":"Let's get going. Fragile, you're up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_95","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_30_08_s_95","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}