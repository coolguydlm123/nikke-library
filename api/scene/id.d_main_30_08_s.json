ch","speaker":"drilley","key":"Locale_MainScenario:d_main_30_08_s_64","text":"In other words, you can't walk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_65","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_30_08_s_65","text":"No, look at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_66","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_30_08_s_66","text":"*Crack crack*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_67","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_30_08_s_67","text":"It sounds a bit strange when I walk, and my movements are a bit choppy like in an old video game, but at least I'm mobile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_68","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_08_s_68","text":"Please stop saying this nonsense!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_69","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_08_s_69","text":"Here you are, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_70","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_08_s_70","text":"You fixed it? Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_08_s_71","type":"Speech","speaker":"elegg","key