{"id":"event_marian1_03_e","cat":"event","group":{"id":"ev40124","label":"MARIA-n · Part 1"},"label":"A Proposal Without a Choice: B","stage":null,"prev":"event_marian1_03_s","next":"event_marian1_intermission_01","speakers":{"doctormaria":"Doctor Maria","enikk_op_l":"Enikk","maria-311":"Maria-311"},"icons":{"doctormaria":"si_c9041_00_s","enikk_op_l":"si_c904_00_s","maria-311":"si_c013_00_s"},"lines":[{"id":"event_marian1_03_e_1","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_1","text":"You shut up...!","jump":null,"exit":false,"enter":null,"bg":"SilverGun_LAB","bgArt":"silvergun_lab","image":null,"bgm":"event_bgm_maria-n_daughter","movie":null,"shown":["doctormaria","enikk_op_l"],"affinity":null},{"id":"event_marian1_03_e_2","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_2","text":"She didn't make the Queen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_3","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_3","text":"She was the one who created the cause that led to the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_4","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_4","text":"That was an accident!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_5","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_5","text":"An accident born of arrogance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_6","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_6","text":"Which resulted in humanity being driven to the brink of extinction before fleeing underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_7","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_7","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_8","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_8","text":"Of course, I do recognize that it would be unreasonable to place the blame solely on Doctor Alva.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_9","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_9","text":"However, there is no question that she is the one who brought about the cause of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_10","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_10","text":"That's... not true...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_11","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_11","text":"Doctor Maria, do you wish to clear your mother's name?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_12","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_12","text":"As her daughter, are you trying to restore the surface that she brought to ruin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_13","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_14","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_14","text":"... Yeah. That's the plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_15","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_15","text":"And for that, you're willing to make this a hellish place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_16","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_16","text":"It is uncharacteristic of me to say such a thing, but where you are right now, life and death have lost all meaning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_17","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_17","text":"Were I an entity with emotions, I would feel revulsion and fear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_18","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_18","text":"... How did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_19","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_19","text":"How did you know I was doing this here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_20","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_20","text":"That is not important. What is important is the proposal I am about to make.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_21","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_22","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_22","text":"You call that a proposal? It's a threat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_23","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_23","text":"I will state the proposal verbally once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_24","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_24","text":"Should you fail to produce visible results within the next month,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_25","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_25","text":"you are to dispose of everything pertaining to this project.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_26","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_26","text":"Should you refuse, I will dispose of it myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_27","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_27","text":"Who do you think you are? You're an AI. You think you can give orders to a human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_28","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_28","text":"I am the AI who oversees the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_29","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_29","text":"I remove every element that poses a threat to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_30","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_30","text":"Your project is dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_31","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_31","text":"Should even the smallest piece of that technology make its way into the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_32","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_32","text":"the Ark would change irrevocably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_33","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_33","text":"All life would be treated lightly and become expendable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_34","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_34","text":"Only a small number of extraordinary individuals would be allowed to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_35","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_35","text":"But we could win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_36","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_36","text":"That may be so. However...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_37","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_37","text":"could you truly call what survives \"humanity\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_38","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_39","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_39","text":"Still, I cannot deny that the odds of victory would be high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_40","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_40","text":"For that reason, I shall limit the project's scope to the Maria model and confirm its results.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_41","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_41","text":"I will not allow more than the one type of Nikke to be used. The risk is too great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_42","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_42","text":"What risk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_43","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_43","text":"Your project has continued for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_44","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_44","text":"Should its scale grow or its duration extend, the probability of discovery rises accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_45","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_45","text":"Introducing more Nikke types into the project increases that probability even further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_46","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_46","text":"I calculate the minimum time until someone in the Ark becomes aware of your project to be one month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_47","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_47","text":"Therefore, you must produce results within that timeframe, or prepare to dispose of the project.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_48","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_48","text":"... What exactly do you mean by results?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_49","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_49","text":"30% of Liliweiss's combat power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_50","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_50","text":"Should your model reach that level, I will consider the danger to be worth accepting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_51","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_51","text":"30%... What standard are we using to judge?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_52","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_52","text":"I shall be the judge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_53","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_53","text":"... You've got to be joking. It sounds like you've already decided to scrap the project.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_54","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_54","text":"You have no other option.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_55","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_e_55","text":"I will speak with you in one month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_03_e_56","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_57","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_e_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_e_58","type":"Speech","speaker"