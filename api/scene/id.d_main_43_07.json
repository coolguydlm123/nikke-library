{"id":"d_main_43_07","cat":"main","group":{"id":"ch43","label":"Chapter 43 · Key"},"label":"Stall III","stage":"43-19 STAGE · Start","prev":"d_main_43_06","next":"d_main_43_08","speakers":{"stall3rd":"Stall III"},"icons":{"stall3rd":"si_c9019_00_s"},"lines":[{"id":"d_main_43_07_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_07_1","text":"Stall III stirs awake.","jump":null,"exit":false,"enter":null,"bg":"UndergroundTunnel","bgArt":"undergroundtunnel","image":null,"bgm":"bgm_story_monochrome","movie":null,"shown":["stall3rd"],"affinity":null},{"id":"d_main_43_07_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_07_2","text":"After glancing at Princess snoring beside her, she takes a plain Splendamin bar from her bag and places it near Princess's head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_07_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_07_3","text":"She gets up and walks out, offering the guard a quick greeting as she heads to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_07_4","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_07_4","text":"Stall III's job is cleaning the red-light district.","jump":null,"exit":false,"enter":null,"bg":"BadDreamAlley","bgArt":"baddreamalley","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_07_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_07_5","text":"She picks up any trash she sees while making her rounds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_07_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_07_6","text":"She opens the first door