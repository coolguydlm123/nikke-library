,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_11_82","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_fullfoolday_11_82","text":"As I made a quick escape, it took everything I had not to drag my tired body along the floor.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}