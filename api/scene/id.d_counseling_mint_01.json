{"id":"d_counseling_mint_01","cat":"counsel","group":{"id":"char5172","label":"Mint"},"label":"Advising Mint: 01","stage":null,"prev":null,"next":"d_counseling_mint_02","speakers":{"mint_i":"Mint"},"icons":{"mint_i":"si_c600_00_s"},"lines":[{"id":"d_counseling_mint_01_1","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_01_1","text":"Lately, Prika's been so focused on songwriting that she's been neglecting her skincare.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mint_i"],"affinity":"_0"},{"id":"d_counseling_mint_01_2","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_01_2","text":"For a pop star, taking care of your skin is the absolute bare minimum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mint_01_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mint_01_3","text":"If she's that busy, there's probably not much she can do about it.","jump":"d_counseling_mint_01_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mint_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mint_01_4","text":"Then you should take care of her, Mint.","jump":"d_counseling_mint_01_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mint_01_5","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_01_5","text":"I'm just as busy, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mint_01_6","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_01_6","text"