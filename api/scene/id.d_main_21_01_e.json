{"id":"d_main_21_01_e","cat":"main","group":{"id":"ch21","label":"Chapter 21 · Giant Whale"},"label":"Whale in the Sky: B","stage":"21-1 STAGE · End","prev":"d_main_21_01_s","next":"d_main_21_02_s","speakers":{"Self":"Commander","cecil":"Cecil"},"icons":{"cecil":"si_c929_00_s"},"lines":[{"id":"d_main_21_01_e_1","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_1","text":"Mother Whale?","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"bgm_story_cecil","movie":null,"shown":["cecil"],"affinity":null},{"id":"d_main_21_01_e_2","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_2","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_3","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_3","text":"What does that have to do with the Vapaus bullet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_4","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_4","text":"I did some experiments with the Vapaus components found in your blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_5","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_5","text":"I wanted to determine if it could be implemented into offensive weapons, including bullets, or defensive equipment like armor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_6","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_6","text":"Unfortunately, every attempt resulted in failure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_7","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_7","text":"The components that make up Vapaus disintegrate once they're synthesized with metal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_8","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_8","text":"They simply do not mix, and I can't ascertain the exact reason since the sample was so small.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_9","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_9","text":"It's incompatible with Goddesium as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_10","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_10","text":"I even tried combining it with Rapture parts, but everything ended in failure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_11","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_11","text":"The only thing I was able to produce were bullets that contained your blood, but not the Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_12","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_12","text":"It's like something out of a bad horror novel. The only thing they'd be good for is putting a hex on someone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_13","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_13","text":"Does that mean you can't incorporate Vapaus into a bullet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_14","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_14","text":"That's exactly what I'm saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_15","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_15","text":"At the very least, it can't be combined with any commonly used metals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_16","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_16","text":"But the Vapaus bullet I obtained before","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_17","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_17","text":"look like an ordinary bullet. At least it did from the outside...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_18","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_18","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_19","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_19","text":"I assume you used the military scanner on it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_20","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_20","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_21","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_21","text":"Those scanners only pick up materials used by the military.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_22","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_22","text":"The main component of that Vapaus bullet is","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_23","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_23","text":"something not used by the military. In fact, it's something you can't necessarily \"use\" in the strictest sense of the word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_24","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_25","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_26","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_26","text":"Human cells.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_27","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_27","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_28","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_28","text":"The Vapaus is flowing in your bloodstream.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_29","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_29","text":"To test my theory, I attempted to synthesize the Vapaus with human cells.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_30","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_30","text":"The result? I ended up with something that could be considered a bullet, in the broadest sense of that word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_31","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_31","text":"Wait... where did you get human cells?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_32","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_32","text":"If you must know, I used some of mine. Would you like me to tell you where I extracted them from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_33","text":"... No, that's okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_34","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_34","text":"Anyway, the Vapaus Bullet I ended up with is unfortunately a bullet in name only.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_35","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_35","text":"It's not nearly as durable as metal, so it can't withstand the initial explosion when being fired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_36","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_36","text":"You wouldn't make a dent in the body of a Heretic, or even an ordinary Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_37","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_37","text":"You could use reinforced plastic or several other new materials instead,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_38","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_38","text":"but that won't make much of a difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_39","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_39","text":"That's where Mother Whale comes in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_40","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_40","text":"Could you elaborate?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_41","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_42","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_42","text":"During the First Rapture Invasion, the Raptures didn't have a semi-permanent power source like they do now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_43","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_43","text":"The power source they did have had to be continually charged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_44","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_44","text":"What do you think they used to accomplish that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_45","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_e_45","text":"You don't mean...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_46","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_46","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_e_47","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_e_47","text":"Living things. Humans and animals, to be precise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}