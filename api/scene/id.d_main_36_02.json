,"shown":null,"affinity":null},{"id":"d_main_36_02_20","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_02_20","text":"That makes this all even more remarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_21","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_02_21","text":"We're dealing with a Heretic, the sworn enemy of all humankind,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_22","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_02_22","text":"and he's still giving her a chance to redeem herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_23","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_36_02_23","text":"... You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_24","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_02_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_25","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_02_25","text":"Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_26","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_02_26","text":"Are you going to ask her about Siren?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_27","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_36_02_27","text":"Yes... but not right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_28","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_36_02_28","text":"I don't want to rock the boat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_29","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_02_29","text":"Very well. I'll wait as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_30","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_36_02_30","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_31","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_02_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_red","leviathan","laplace","drake","maxwell"],"affinity":null},{"id":"d_main_36_02_32","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_36_02_32","text":"So, what's the story with all that liquid covering your body? Does it change shape?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_33","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_36_02_33","text":"Does that mean you can transform? Can I give it a spin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_34","type":"Speech","speaker":"leviatha