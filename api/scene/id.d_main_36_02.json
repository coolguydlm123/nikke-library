nter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_48","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_36_02_48","text":"And I'm Maxwell too, so answer mine!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_49","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_02_49","text":"Both of you, be quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_50","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_02_50","text":"I take it you're Maxwell?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_51","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_02_51","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_52","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_02_52","text":"Okay then, what do you want to know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_53","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_02_53","text":"You're actually going to answer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_02_54","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_02_54","text":"I have to if I want you all to help me get what I want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null