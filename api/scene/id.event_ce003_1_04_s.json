e_003_02","key":"Locale_SubScenario:event_ce003_1_04_s_25","text":"They're so shiny... and all of these shops as well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_04_s_26","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_04_s_26","text":"This is the Ark's main street.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_04_s_27","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_04_s_27","text":"This is the center of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_04_s_28","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_04_s_28","text":"It definitely looks like the center as it's bustling with people... wait a minute...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_04_s_29","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_04_s_29","text":"Miss Emila, do you see that square-shaped area over there? Those people milling about seem to be trapped in it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_04_s_30","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_04_s_30","text":"What do you reckon it's made of?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_04_s_31","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_04_s_31","text":"Meta-what? And you say people are trapped? Where?","jump":null,"exit":false,"ent