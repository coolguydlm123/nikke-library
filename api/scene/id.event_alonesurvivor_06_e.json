"shown":null,"affinity":null},{"id":"event_alonesurvivor_06_e_104","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_06_e_104","text":"It's overwhelming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_06_e_105","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_06_e_105","text":"A feeling that you can't put into words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_06_e_106","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_06_e_106","text":"What do you think, Tove?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_06_e_107","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_06_e_107","text":"Do you think you're cut out for this business?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_06_e_108","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_06_e_108","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_06_e_109","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_06_e_109","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_06_e_110","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_06_e_110","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null