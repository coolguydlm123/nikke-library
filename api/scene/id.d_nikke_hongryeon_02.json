{"id":"d_nikke_hongryeon_02","cat":"bond","group":{"id":"char5041","label":"Scarlet"},"label":"Beautiful Landscape","stage":null,"prev":"d_nikke_hongryeon_01","next":"d_nikke_hongryeon_03","speakers":{"hongryeon":"Scarlet","Monologue":"Monologue"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_nikke_hongryeon_02_1","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_1","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_2","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_2","text":"What didst she say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_02_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_3","text":"She'll be right up as soon as she's ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_4","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_4","text":"Well, that's a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_5","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_6","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_6","text":"Allow me to apologize once more, for I was out of line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_7","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_7","text":"It hath been many moons since I hast last met anyone I share a drink with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_8","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_8","text":"I hast forgotten entirely of the situation I am currently in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_9","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_9","text":"It's all right. We've had fun as well.","jump":"d_nikke_hongryeon_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_10","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_10","text":"It's our fault for letting our guards down.","jump":"d_nikke_hongryeon_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_11","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_12","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_12","text":"Gramercy, my Lord, for saying that.","jump":"d_nikke_hongryeon_02_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_13","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_13","text":"No, no. The fault lies in me for I hast intruded upon thy daily lives,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_14","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_14","text":"in hopes that none shall hast to face the consequences.","jump":"d_nikke_hongryeon_02_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_15","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_15","text":"Fortunately, I was able to make contact with my Lord's colleagues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_16","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_16","text":"Hearing that they shall be up soon makes meself feel as though a weight hath been lifted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_17","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_17","text":"All right, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_18","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_18","text":"To stand hither and dally in the meantime seems something wasteful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_19","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_19","text":"So, shall thou offer me a helping hand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_20","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_20","text":"Thou shall be, of course, handsomely compensated, i assure thou.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_21","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_22","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_22","text":"Thou are unable to make heads or tails of what i speak of, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_23","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_23","text":"What use would it be for me to repeat mine words a hundred times? Come, follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_24","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_24","text":"There, look ahead.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_25","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_25","text":"What doth thine eyes see?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_26","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_26","text":"I can see Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_27","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_27","text":"Well, well. I suppose thou should'st see thy foe first since thou hast done battle with so many Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_28","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_28","text":"The Raptures are of no import. Take a look at thy surroundings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_29","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_29","text":"... The cows?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_30","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_30","text":"Oho! So thou are familiar with our bovine brethren. Thou truly are smarter than the average underground simpleton.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_31","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_31","text":"Correct, those cows are what we're after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_32","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_32","text":"Are you in need of meat?","jump":"d_nikke_hongryeon_02_34","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_33","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_33","text":"Are you in need of milk?","jump":"d_nikke_hongryeon_02_34","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_34","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_34","text":"Thou shall know in due time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_35","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_35","text":"So, my Lord, please lure those Raptures away henceforth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_36","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_36","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_37","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_37","text":"Haven't i told thou earlier? We want those cows!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_38","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_38","text":"Slaying a Rapture is the most minute of trivialities, yet should'st the cows perish in the struggle... Nay, that shall not doth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_39","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_39","text":"For that reason, I require thou to lure 'em far away, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_40","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_40","text":"... Raptures have long-range weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_41","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_41","text":"Yes, indeed they doth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_42","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_42","text":"Alas, I won't have 'em use it on thou.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_43","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_43","text":"After all, a human at their most swift can never dream of outrunning a Rapture at hunt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_44","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_44","text":"Whenever a human is spotted, they shall rush in and try to capture their prey alive, keeping it as intact as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_45","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_45","text":"So long as a human doth not display any signs of aggression, the Raptures shall respond in kind... well, relatively speaking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_46","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_46","text":"Why dost thou regard this is so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_47","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_47","text":"In many ways, they regard humans as the most valuable assets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_48","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_49","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_49","text":"On the contrary, should'st they lay eyes upon a Nikke such as myself, they shall not hesitate to pounce.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_50","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_50","text":"As such, I would hast an urge to whip out all mine weaponry to destroy it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_51","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_51","text":"Thus, thou should'st be able to understand mine hesitation to step out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_52","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_52","text":"At this rate, our bovine brethren would almost certainly perish in the crossfire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_53","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_53","text":"Does this all ring true to thee? If so, then move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_54","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_54","text":"It's far too dangerous!","jump":"d_nikke_hongryeon_02_56","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_55","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_55","text":"Let's give it a try first.","jump":"d_nikke_hongryeon_02_58","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_56","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_56","text":"One consumed with fear, shall soon become consumed by perpetual wink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_57","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_57","text":"Fret not, for there is no danger. All that is required of thou, is to run.","jump":"d_nikke_hongryeon_02_59","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_58","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_58","text":"Lovely, just what I want to hear.","jump":"d_nikke_hongryeon_02_59","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_59","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_59","text":"Now, allow us to make haste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_60","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_60","text":"I'll run.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_61","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_61","text":"With that, you run with all your might.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_62","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_62","text":"As expected, the Raptures have detected your sudden movements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_63","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_63","text":"From behind you, a cacophony of vibrations and deafening noises resound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_64","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_64","text":"*Clomp clomp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_65","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_65","text":"The Raptures begin to follow you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_66","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_66","text":"*Clomp clomp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_67","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_67","text":"Nervousness and fatigue soon set in, making you short of breath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_68","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_68","text":"Much to your astonishment, the vibration and sounds are closing in!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_69","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_69","text":"This shall suffice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_70","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_71","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_71","text":"All of a sudden, dead silence settles over you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_72","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_72","text":"Turning back, you spot Scarlet standing before the motionless Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_02_73","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_73","text":"... You've eliminated them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_74","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_74","text":"Hast I not told thou? Felling a Rapture is but a trifle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_recognition_a","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_75","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_75","text":"Alas, were an explosion to occur, that shall be quite the thorn in mine side. That is why I had to dispose of 'em quietly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_76","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_76","text":"Though it may not be mine way of doing things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_77","text":"Why would have known that you'd use a sword to eliminate Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_78","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_78","text":"I suppose so. Thy guidelines dictate that Raptures are to be dealt with mid range weaponry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_79","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_79","text":"Why dost thou regard this is so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_80","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_80","text":"Perhaps, they are still unenlightened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_81","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_81","text":"None knows how Raptures fare up close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_82","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_82","text":"In days past, a Melee Squad was sent out to ascertain more about this. Yet, it turned out to be a fruitless attempt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_83","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_83","text":"They were all wiped out entirely before they could figure out much of anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_84","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_84","text":"Except for one Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_85","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_85","text":"So you're...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_86","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_86","text":"It's all ancient history. Nothing more than a faded remembrance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_87","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_87","text":"I know not what became of the project in the years that followed. Yet, seeing how the other Nikkes all use firearms,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_88","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_88","text":"it seems they hath concluded that close quarters combat is ineffective against Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_89","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_89","text":"Now I am unfettered from mine former restraints, and for that many thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_90","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_90","text":"Unfettered?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_91","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_91","text":"Raptures are evolving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_92","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_92","text":"They are evolving in response to the weaponry used against 'em.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_93","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_93","text":"If thou compare current Rapture weaponry with that of the past, thou shall find that they hath made incredible strides.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_94","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_94","text":"In contrast, there hast been no developments made in close-quarters weaponry whatsoever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_95","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_95","text":"As for me, I shall continue doing what I always hast done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_96","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_96","text":"Even so, wielding a sword seems rather dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_97","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_97","text":"An astute observation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_98","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_98","text":"Between guns and swords, none can determine which one poses a higher risk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_99","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_99","text":"Nevertheless, I am partial to the blade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_100","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_100","text":"Because it's a promise. No... It is a curse?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_101","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_101","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_102","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_102","text":"Now that we hast rid ourself of these obstructions, allow us to make our way to see the cows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_103","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_103","text":"The cows are grazing leisurely in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_104","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_104","text":"What should I do now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_105","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_105","text":"It is most simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_106","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_106","text":"Gather all these cow muck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_107","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_107","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_108","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_108","text":"Mine apologies. Was I too forward in mine speech?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_109","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_109","text":"All thou hast to do is gather all these manure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_110","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_110","text":"Wait, no. Why...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_111","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_111","text":"Waste not, want not. All things in nature hath a purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_112","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_112","text":"Now, still thy tongue and doth as I say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_113","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_113","text":"Let me see... We shall use this wooden board","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_114","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_114","text":"and I shall be on the lookout for Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_02_115","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_02_115","text":"Why can't I be on the lookout?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},