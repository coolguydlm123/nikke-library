{"id":"d_main_10_02","cat":"main","group":{"id":"ch10","label":"Chapter 10 · Comrade"},"label":"Who is Stronger?","stage":"10-4 STAGE · Start","prev":"d_main_10_01","next":"d_main_10_03_s","speakers":{"shifty":"Shifty","rapi":"Rapi","eunhwa":"Eunhwa","anis":"Anis","emma":"Emma","vesti":"Vesti","Narration":"Narration","neon":"Neon"},"icons":{"shifty":"si_c907_00_s","rapi":"si_c010_00_s","eunhwa":"si_c092_00_s","anis":"si_c012_00_s","emma":"si_c090_00_s","vesti":"si_c091_00_s","Narration":"si_c999_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_10_02_1","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_1","text":"The goal of this operation is to collect what we're referring to as Heretic fragments.","jump":null,"exit":false,"enter":null,"bg":"Desert_01","bgArt":"desert_01","image":null,"bgm":"bgm_areah_a","movie":null,"shown":["shifty","rapi","eunhwa","anis","emma"],"affinity":null},{"id":"d_main_10_02_2","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_2","text":"In the past, Absolute and Matis fought together against the Heretics and were victorious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_3","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_3","text":"However, a large explosion caused by the Heretics being shot down devastated the whole area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_4","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_4","text":"The explosion ended up creating a massive crater. The immediate area surrounding it burned for 3 months.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_5","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_5","text":"The route to the center of the crater was blocked off, and that's where we think the Heretic fragments are located.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_6","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_6","text":"Recently, the flames have died down, so entry is now possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_7","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_7","text":"To summarize, the objective of this joint operation is to enter the center of the crater, collect the Heretic fragments, and bring them back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_10_02_8","text":"Why did the flames subside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_9","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_9","text":"It is believed that all the natural gas underground has been exhausted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_10","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_10","text":"Mark the routes and target points.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_11","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_11","text":"Affirmative. Marking complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_12","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_12","text":"Considering how long the fires lasted, Alva particle concentration should be low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_13","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_10_02_13","text":"Uh... Yes. That's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_14","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_14","text":"So there's no need for a purification sequence. Let's get this over with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_15","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_15","text":"I don't want to spend any more time with these amateurs than I have to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_16","text":"How was it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_17","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_17","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_18","text":"The Heretics. How was it fighting them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_19","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_19","text":"Need-to-know basis. And you don't need to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_20","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_10_02_20","text":"Absolute and Matis were nearly obliterated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_21","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_22","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_10_02_22","text":"Luck was on our side. If the lightning hadn't hit that spot when it did,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_23","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_10_02_23","text":"we would have all died.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_24","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_24","text":"Enough of that drivel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_25","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_10_02_25","text":"I won't put our teammates at risk by feeding them false information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_26","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_26","text":"Teammates? No, these bums aren't my teammates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_27","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_10_02_27","text":"Need I remind how you they also went up against a Heretic and lived to tell the tale?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_28","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_28","text":"... Nothing but dumb luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_29","text":"Yeah, same as you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_30","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_30","text":"Don't even think about trying to compare yourselves to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_31","text":"Didn't I just hear you all nearly got wiped out? We fared better than that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_32","text":"And we didn't have the Matis squad helping us out either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_33","text":"Come to think of it, sounds to me like we're stronger than you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_34","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_34","text":"Maybe they let you off easy because they knew you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["vesti"],"affinity":null},{"id":"d_main_10_02_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_35","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_36","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_36","text":"The Heretic. I heard you guys worked together on a few missions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_37","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_37","text":"Perhaps she felt sorry for you, and went easy on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_38","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_38","text":"Tell me, how does it feel when an old friend becomes a traitor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_39","text":"... You.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_40","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_10_02_40","text":"That's enough, Eunhwa.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_41","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_41","text":"No! You don't get to say my name, traitor!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_42","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_10_02_42","text":"Uh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_43","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_10_02_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_44","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_10_02_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_45","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_45","text":"... Damn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_46","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_10_02_46","text":"Damn you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_47","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_10_02_47","text":"Eunhwa walks off alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon"],"affinity":null},{"id":"d_main_10_02_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_48","text":"She needs to check the attitude at the door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_49","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_10_02_49","text":"I think it's because you got to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_50","text":"What do you mean? I was just trying to make nice and all I get is attitude from her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_51","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_10_02_51","text":"Hey... Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_52","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_53","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_10_02_53","text":"C-can you teach me how to talk back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_10_02_54","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_10_02_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown"