l,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_08_e_28","text":"That's why you enjoy being by her side, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_29","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_29","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_08_e_30","text":"You're a bit rough around the edges.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_31","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_32","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_32","text":"I didn't choose to be this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_33","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_33","text":"We had to survive somehow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_34","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_34","text":"If I had just kept laughing it off whenever others took advantage of her,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_35","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_35","text":"we never would have made it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_36","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_36","text":"That's why I am the way I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_08_e_37","text":"Sounds like you've been through a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_38","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_38","text":"It wasn't that tough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_39","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_39","text":"Usually, the type of people who approach caring people with the aim of exploiting them aren't too bright themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_40","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_40","text":"They also tend to be sloppy. And weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_41","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_41","text":"That's why they feel they have to take advantage of those with a big heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_42","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_42","text":"They're unable to appeal to those who are more cynical,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_43","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_43","text":"and so they prey on people they think are \"gullible\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_44","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_44","text":"If you take a step back,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_45","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_08_e_45","text":"these people really aren't all that difficult to deal with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_08_e_46","text":"Hammering said you couldn't come here because you had to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_08_e_47","text":"What kind of work could you possibly have been doing that took precedence over a search mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_08_e_48","type":"Speech","speaker":"drilley","key":"Locale_MainSc