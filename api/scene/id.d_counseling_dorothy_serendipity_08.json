{"id":"d_counseling_dorothy_serendipity_08","cat":"counsel","group":{"id":"char5145","label":"Dorothy: Serendipity"},"label":"Advising Dorothy: Serendipity: 08","stage":null,"prev":"d_counseling_dorothy_serendipity_07","next":"d_counseling_dorothy_serendipity_09","speakers":{"dorothy_s":"Dorothy"},"icons":{"dorothy_s":"si_c234_00_s"},"lines":[{"id":"d_counseling_dorothy_serendipity_08_1","type":"Speech","speaker":"dorothy_s","key":"Locale_Counseling:d_counseling_dorothy_serendipity_08_1","text":"What does a \"friend\" mean to you?","jump":null,"exit":false,"enter":null,"bg":"Deck_n","bgArt":"deck_n","image":null,"bgm":"bgm_story_milkyway","movie":null,"shown":["dorothy_s"],"affinity":"_0"},{"id":"d_counseling_dorothy_serendipity_08_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_serendipity_08_2","text":"Someone who is happy for you when you're up, and supports you when you're down.","jump":"d_counseling_dorothy_serendipity_08_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_dorothy_serendipity_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_serendipity_08_3","text":"Someone who you're close to. What else?","jump":"d_counseling_dorothy_serendipity_08_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_dorothy_serendipity_08_4","type":"Speech","speaker":"dorothy_s","key":"Locale_Counseling:d_counseling_dorothy_serendipity_08_4","text":"That's a simple, but beautiful, way of putting it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_serendipity_08_5","type":"Speech","speaker":"dorothy_s","key":"Locale_Counseling:d_counseling_dorothy_serendipity_08_5","text":"I suppose that is what friendship is.","jump":null,"exit":f