{"id":"d_counseling_chime_02","cat":"counsel","group":{"id":"char5157","label":"Chime"},"label":"Advising Chime: 02","stage":null,"prev":"d_counseling_chime_01","next":"d_counseling_chime_03","speakers":{"chime":"Chime"},"icons":{"chime":"si_c331_00_s"},"lines":[{"id":"d_counseling_chime_02_1","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_1","text":"Truly, the more I behold Her Highness, the more splendid she seemeth.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["chime"],"affinity":"_0"},{"id":"d_counseling_chime_02_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_02_2","text":"You mean the way she protects you?","jump":"d_counseling_chime_02_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_chime_02_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_02_3","text":"You mean the way she craves food?","jump":"d_counseling_chime_02_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_chime_02_4","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_4","text":"Aye, 'tis exactly so!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_5","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_5","text":"When Her Highness doth stand afore me, shielding me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_6","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_6","text":"Knowest thou how magnificently she doth shine, how steadfastly my heart is eased?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_7","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_7","text":"Nay, \"magnificently\" doth scarce suffice!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_8","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_8","text":"She is naught but the light itself!","jump":"d_counseling_chime_02_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_9","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_9","text":"R-Rapscallion!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_10","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_10","text":"How dare thou speak such blasphemy?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_11","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_11","text":"Her Highness doth not covet food!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_12","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_02_12","text":"She... doth merely relish it!","jump":"d_counseling_chime_02_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_02_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_chime_02_13","text":"Chime and I talk about when Crown looks most magnificent.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}