null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_label_17_13","type":"Speech","speaker":"label","key":"Locale_Counseling:d_counseling_label_17_13","text":"Hehe... Hehehehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_label_17_14","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_label_17_14","text":"I talk with Label about what sort of weather we prefer for dates.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}