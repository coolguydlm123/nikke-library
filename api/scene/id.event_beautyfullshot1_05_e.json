utyfullshot1_05_e_12","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_12","text":"Okay, good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_13","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_13","text":"These kinds of toxins are no joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_14","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_14","text":"If you were to get stung by that or something like a sea urchin,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_15","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_15","text":"the treatment process would be very long and very painful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_16","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_17","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_17","text":"Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_18","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_18","text":"Is Jackal doing okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bg