,"type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_25","text":"Oh, right. Have you ventured into the jungle yet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_26","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_26","text":"We found it while out exploring and saw an absolutely massive flower there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_27","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_27","text":"I haven't been there yet, but I was planning on going soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_28","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_28","text":"You should go and take some photos there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_29","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_29","text":"Anis and Rapi should be there as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_30","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_30","text":"Speaking of which, would you like your photo taken?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_31","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_31","text":"I'm okay, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_32","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_32","text":"Last summer was the best summer of my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_33","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_33","text":"I already know that nothing will surpass that, so instead of trying to replace those memories, I'm content holding onto them as is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_34","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_34","text":"That seems oddly sad to me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_35","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_35","text":"Hehe, then you guys will have to hurry and reclaim the surface! I think that's the only thing that would be an improvement over last year.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_36","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_36","text":"... Okay. I'll do my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_37","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_37","text":"Well, see you at dinner time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_38","text":"In the jungle.","jump":null,"exit":false,"enter":null,"bg":"UninhabitedIsland_d","bgArt":"uninhabitedisland_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_39","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_39","text":"Gaaaaaaah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_s"],"affinity":null},{"id":"event_beautyfullshot1_05_e_40","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_40","text":"Anis! Don't move!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_41","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_41","text":"I'm... staying... perfectly still!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_42","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_42","text":"What's going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_43","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_43","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_44","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_44","text":"Anis...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_45","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_45","text":"She's being eaten by a flower!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_46","text":"In front of us, Anis has been half-swallowed by a Rafflesia flower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_47","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_47","text":"How did this even happen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_48","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_48","text":"She said something in the flower's mouth was moving, and when she leaned in for a closer look...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_49","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_49","text":"Blech! It's so slippery and slimy in here, and there are dead bugs everywhere!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_50","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_50","text":"Get me outta here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_51","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_51","text":"You heard her. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_52","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_52","text":"Okay, I'll provide cover while Sakura opens fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_53","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_53","text":"It's just a flower. I don't think we need to do all that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_54","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_54","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_55","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_55","text":"That... was horrible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis_s"],"affinity":null},{"id":"event_beautyfullshot1_05_e_56","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_56","text":"I nearly lost my lunch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_57","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_57","text":"All the slime... and the bugs... and that horrible stench...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_58","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_58","text":"Ugh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_59","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_59","text":"I'm going to collect a sample. This stuff might be poisonous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_60","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot1_05_e_60","text":"Sakura scrapes off some of the secretions from Anis's body into a small bottle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_61","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_61","text":"Hmm. Seems okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_62","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_62","text":"How do you know? Are you some kind of ninja who knows poisons?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_05_e_63","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot1_05_e_63","text":"As a matter of fact, yes.","jump":null,"e