null,"affinity":null},{"id":"d_nikke_anis_04_6","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_6","text":"... Are you sure about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_anis_04_7","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_7","text":"Yes, I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_8","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_8","text":"This is crazy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_9","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_9","text":"Like I said, don't blame me for whatever happens in there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_10","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_10","text":"Got it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_11","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_anis_04_11","text":"An Hour Ago","jump":null,"exit":false,"enter":null,"bg":"ShoppingMall","bgArt":"shoppingmall","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_12","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_12","text":"I want to see the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_anis_04_13","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_13","text":"... I thought so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_14","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_14","text":"Commander,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_15","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_15","text":"The Outer Rim is an area of anomie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_16","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_16","text":"The place is filthy, and all kinds of criminals are there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_17","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_17","text":"Most importantly, there's no law.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_18","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_18","text":"Even the Central Government gave up on managing the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_19","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_19","text":"Once you go in there, there's no guarantee that you'll come back safely,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_20","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_20","text":"not even for a soldier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_21","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_21","text":"I still want to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_22","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_22","text":"... Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_23","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_23","text":"I want to see everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_24","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_25","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_25","text":"At the very least, you can't see those people in agony and decide to sacrifice yourself to save them. Deal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_26","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_26","text":"... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_27","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_27","text":"I can take you there, but you must follow the rules.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_28","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_28","text":"Don't look around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_29","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_29","text":"Don't talk loudly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_30","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_30","text":"Don't look at anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_31","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_31","text":"Don't give or take anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_32","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_32","text":"And lastly,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_33","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_33","text":"follow me closely at all times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_34","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_34","text":"Got it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_35","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_35","text":"This is the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_36","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_36","text":"There are no buildings left intact here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_37","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_37","text":"or anything that could be called a facility. Can't even get electricity running here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_38","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_38","text":"There's an indescribable stink in the air, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_39","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_39","text":"See those people over there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_40","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_anis_04_40","text":"Anis points at a group of people. They are sitting around a fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_41","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_41","text":"They don't care about us at all,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_42","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_42","text":"so we can explore this area for a bit before leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_43","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_43","text":"Why would such a place exist?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_44","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_44","text":"... I don't know the details.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_45","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_45","text":"I only know that people used to dump waste here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_46","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_46","text":"They couldn't dump it inside the Ark, so they chose the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_47","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_47","text":"People without identification chips can't stay in the Ark, so they gradually gather here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_48","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_48","text":"Then more and more people joined in, and now here we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_49","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_49","text":"Why don't they have chips?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_50","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_50","text":"Because they committed crimes before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_51","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_51","text":"Once you commit a crime, you lose the identification chip.","jump":null,"exit":false,"enter":null,"bg":"Backstreet","bgArt":"backstreet","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_52","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_52","text":"Without the chip, you can't live normally in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_53","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_53","text":"So people who got tired of that kind of life came to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_54","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_54","text":"Then the people here started to have kids as the group grew bigger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_55","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_55","text":"And of course, those kids were born without identification chips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_56","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_56","text":"And the group keeps growing bigger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_anis_04_57","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_57","text":"Most people want to get into the Ark because of the dreadful living conditions here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_58","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_58","text":"I heard there are often cases of people buying illegal chips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_59","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_59","text":"How is that possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_60","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_60","text":"There are ways to buy unofficially authorized identification chips","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_61","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_61","text":"or to forcibly remove identification chips from a body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_62","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anis_04_62","text":"Forcibly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_63","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_63","text":"... Didn't I tell you where the chips are planted?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_64","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_64","text":"Chips are usually implanted in arms or ears,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_65","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_65","text":"so the outlaws will sneak into the Ark and cut off the whole body part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_66","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_66","text":"Just removing the chip requires high technology, so they just cut the whole body part off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_67","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_67","text":"But if the chip is on the neck, the person may die if you can't cut the chip out properly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_04_68","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_anis_04_68","text":"Th