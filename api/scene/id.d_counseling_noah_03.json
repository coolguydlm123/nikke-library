{"id":"d_counseling_noah_03","cat":"counsel","group":{"id":"char5043","label":"Noah"},"label":"Advising Noah: 03","stage":null,"prev":"d_counseling_noah_02","next":"d_counseling_noah_04","speakers":{"noah":"Noah"},"icons":{"noah":"si_c232_00_s"},"lines":[{"id":"d_counseling_noah_03_1","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_03_1","text":"Tell me, Imposter. How is a weakling like you even alive?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["noah"],"affinity":"_0"},{"id":"d_counseling_noah_03_2","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_03_2","text":"You're nothing like a real Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_03_3","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_03_3","text":"A real Commander stands strong, even in the face of Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_noah_03_4","text":"It all comes down to having different equipment.","jump":"d_counseling_noah_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_noah_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_noah_03_5","text":"It's not necessarily the commander's duty to be strong.","jump":"d_counseling_noah_03_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_noah_03_6","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_03_6","text":"Equipment is an important