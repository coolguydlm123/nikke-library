_14","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_14","text":"Master, look at this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_15","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_15","text":"It's the latest grip from Elysion. I got it from the Armory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_16","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_16","text":"With this recoil suppression, my firepower is bound to improve even more!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_17","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_clay_04_17","text":"... I realize that we've now encountered true masters of relaxation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_18","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_18","text":"Oh? You brought a guest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_19","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_19","text":"Hello!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["clay"],"affinity":null},{"id":"d_nikke_clay_04_20","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_20","text":"Hey, Clay! How have you been?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_21","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_21","text":"Long time no see!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_22","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_22","text":"Hi, Anis, Neon! I'm good, hehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_23","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_23","text":"Are you here for a counselling session?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_24","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_24","text":"Actually, Coach said we should take a break in the Commander's Room for a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_25","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_25","text":"... Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_26","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_26","text":"Oh my gosh! Are you finally going to unleash your secret weapon on her, Master?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_clay_04_27","text":"No! That's not what's going on here...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_28","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_28","text":"He said I just need to relax and take it in stride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_29","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_29","text":"A-are you crazy!? In broad daylight?! In the Commander's Room?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_30","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_30","text":"Wow! I wonder how many rounds Master has in the chamber?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_31","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_clay_04_31","text":"Everyone just calm down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_32","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_clay_04_32","text":"I explain everything to the overexcited Anis and Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_33","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_33","text":"So you're trying to teach Clay how to relax?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_34","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_clay_04_34","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_35","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_35","text":"Yep, that's right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_36","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_36","text":"Well shoot, you've come to the right place! We're experts in relaxation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_37","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_37","text":"I am? I thought I'm an expert in firepower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_38","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_38","text":"Yeah, you've got firepower in the brain and not much else. I think you're missing a bit up top.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_39","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_39","text":"A bit up top? But I'm not going bald...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_40","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_40","text":"... Anyway. What do you usually do to relax, Clay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_41","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_41","text":"Review my old performances, practice choreography, and work on improving my stamina...","jump":null,"