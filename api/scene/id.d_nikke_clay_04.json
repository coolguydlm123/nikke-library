:false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_49","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_49","text":"Yeesh, you're stiff as a board!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_50","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_50","text":"If you want to get comfy, you've got to loosen up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_51","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_clay_04_51","text":"Anis grabs Clay's rigid legs and moves them around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_52","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_52","text":"C-careful, Anis! My skirt might roll up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_53","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_53","text":"Hey, just relax and stay still.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_54","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_54","text":"When you're in bed, anything goes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_55","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_clay_04_55","text":"... Ahem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_56","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_56","text":"Oh, right. Can you bring us some snacks, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_57","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_57","text":"Oh, let me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_58","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_58","text":"Don't you dare!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_59","type":"Speech","speaker":"clay","key":"Locale_NikkeEpisode:d_nikke_clay_04_59","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_60","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_60","text":"Whenever you're lying down, you've got to stay in one spot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_61","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_clay_04_61","text":"This is another immutable truth of relaxation, so get that in your head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_clay_04_62","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_clay_04_62","text":"This is my first time hearing a lecture on becoming a lazybones...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image