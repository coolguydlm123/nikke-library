{"id":"memorial_101603","cat":"memorial","group":{"id":"memorial101600","label":"Memoirs · A Doctor's Memoir"},"label":"October 15, XX.","stage":null,"prev":"memorial_101602","next":"memorial_101604","speakers":{},"icons":{},"lines":[{"id":"memorial_101603_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_16_03_description","text":"Haven't seen Nurse Kim for several days."},{"id":"memorial_101603_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_16_03_description","text":"I can't say I'm surprised as I anticipated as much."},{"id":"memorial_101603_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_16_03_description","text":"I just hope she made it to the Ark safely."},{"id":"memorial_101603_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_16_03_description","text":"More patients arrived today, and they had been hiding somewhere outside."},{"id":"memorial_101603_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_16_03_description","text":"I will not leave this place until I have tended to every patient."}]}