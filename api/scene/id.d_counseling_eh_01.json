{"id":"d_counseling_eh_01","cat":"counsel","group":{"id":"char5166","label":"E.H."},"label":"Advising E.H.: 01","stage":null,"prev":null,"next":"d_counseling_eh_02","speakers":{"eh_n":"E.H."},"icons":{"eh_n":"si_c113_00_s"},"lines":[{"id":"d_counseling_eh_01_1","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_1","text":"I had a dream last night that's still fresh in my mind.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":"bgm_story_eh","movie":null,"shown":["eh_n"],"affinity":"_0"},{"id":"d_counseling_eh_01_2","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_2","text":"There was a hole in the sky, and Raptures came pouring out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_3","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_3","text":"In this dream, I wasn't myself. I was a citizen of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_4","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_eh_01_4","text":"That was a terrible day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_5","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_5","text":"Fear and helplessness weighed me down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_6","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_6","text":"All I could do was run away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eh_01_7","text":"Don't forget that feeling.","jump":"d_counseling_eh_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_eh_01_8","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eh_01_8","text":"Dreams are just that—dreams.","jump":"d_counseling_eh_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eh_01_9","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_9","text":"... You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_10","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_10","text":"I'll have to etch it into my memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_11","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_11","text":"Granted, I doubt it compares to what the people who were there actually went through...","jump":"d_counseling_eh_01_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_12","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_12","text":"You could look at it that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_13","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_13","text":"But I felt it so vividly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_14","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_01_14","text":"It was the feeling of having your daily life stripped from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_01_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_eh_01_15","text":"I talk with E.H. about her dream.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}