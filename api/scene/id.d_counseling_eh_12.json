{"id":"d_counseling_eh_12","cat":"counsel","group":{"id":"char5166","label":"E.H."},"label":"Advising E.H.: 12","stage":null,"prev":"d_counseling_eh_11","next":"d_counseling_eh_13","speakers":{"eh_n":"E.H."},"icons":{"eh_n":"si_c113_00_s"},"lines":[{"id":"d_counseling_eh_12_1","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_1","text":"As a commander, you've probably had to make countless decisions.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":"bgm_story_eh","movie":null,"shown":["eh_n"],"affinity":"_0"},{"id":"d_counseling_eh_12_2","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_2","text":"I'm sure you've made a lot of good choices, but the opposite must be true too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_3","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_3","text":"What do you do when that happens?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eh_12_4","text":"I just avoid having to make wrong choices to begin with.","jump":"d_counseling_eh_12_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eh_12_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eh_12_5","text":"I work until I'm able to make up for my bad choices.","jump":"d_counseling_eh_12_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_eh_12_6","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_6","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_7","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_7","text":"In other words, if you have to make such a choice, then you've already missed the mark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_8","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_8","text":"All right. From now on, I'll try to ensure I'm always in a position to make good decisions.","jump":"d_counseling_eh_12_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_9","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_9","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_10","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_10","text":"In other words, you continue to take responsibility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_11","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_12_11","text":"I'd really like to emulate that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_12_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_eh_12_12","text":"E.H. and I talk about what to do if you make a wrong choice.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}