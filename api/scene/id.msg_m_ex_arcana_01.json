{"id":"msg_m_ex_arcana_01","cat":"messenger","group":{"id":"room_arcana","label":"Arcana · Nikke"},"label":"1. Hello {AccountData.NickName}.","stage":null,"prev":null,"next":"msg_m_ex_arcana_02","speakers":{"arcana":"Arcana"},"icons":{"arcana":"si_c581_00_s"},"lines":[{"id":"m_ex_arcana_01_1","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_1","text":"Hello {AccountData.NickName}.","jump":null},{"id":"m_ex_arcana_01_2","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_2","text":"It's Arcana. Did Phantom get in touch with you?","jump":null},{"id":"m_ex_arcana_01_3","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_3","text":"She did. Hello.","jump":"m_ex_arcana_01_10"},{"id":"m_ex_arcana_01_4","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_4","text":"This feels like some kind of blind date.","jump":"m_ex_arcana_01_5"},{"id":"m_ex_arcana_01_5","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_5","text":"Oooh, I always wanted to try that!","jump":null},{"id":"m_ex_arcana_01_6","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_6","text":"Let's pretend that Phantom set us up.","jump":null},{"id":"m_ex_arcana_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_7","text":"Okay.","jump":null},{"id":"m_ex_arcana_01_8","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_8","text":"Did Phantom get in touch with you?","jump":null},{"id":"m_ex_arcana_01_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_9","text":"She did. Hello.","jump":"m_ex_arcana_01_10"},{"id":"m_ex_arcana_01_10","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_10","text":"I'm sorry to ask,","jump":null},{"id":"m_ex_arcana_01_11","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_11","text":"but Phantom never sent me a photo of you.","jump":null},{"id":"m_ex_arcana_01_12","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_12","text":"Would you mind sending one now?","jump":null},{"id":"m_ex_arcana_01_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_13","text":"I'm sorry, but my line of work means I can't send photos of myself on open channels.","jump":null},{"id":"m_ex_arcana_01_14","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_14","text":"Oh!","jump":null},{"id":"m_ex_arcana_01_15","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_15","text":"Do you work for the government?","jump":null},{"id":"m_ex_arcana_01_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_16","text":"Something like that.","jump":null},{"id":"m_ex_arcana_01_17","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_17","text":"Then...","jump":null},{"id":"m_ex_arcana_01_18","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_18","text":"Hmm.","jump":null},{"id":"m_ex_arcana_01_19","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_19","text":"This isn't as fun","jump":null},{"id":"m_ex_arcana_01_20","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_20","text":"as I thought it'd be.","jump":null},{"id":"m_ex_arcana_01_21","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_21","text":"I imagined butterflies in my stomach and fluttering hearts all around.","jump":null},{"id":"m_ex_arcana_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_22","text":"Haha.","jump":null},{"id":"m_ex_arcana_01_23","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_23","text":"Are first meetings","jump":null},{"id":"m_ex_arcana_01_24","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_24","text":"always like this?","jump":null},{"id":"m_ex_arcana_01_25","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_25","text":"Maybe because","jump":null},{"id":"m_ex_arcana_01_26","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_26","text":"it's a blind date?","jump":null},{"id":"m_ex_arcana_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_27","text":"You're right. It does feel oddly awkward for some reason.","jump":null},{"id":"m_ex_arcana_01_28","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_28","text":"Next time,","jump":null},{"id":"m_ex_arcana_01_29","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_29","text":"we can act out something else.","jump":null},{"id":"m_ex_arcana_01_30","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_30","text":"At any rate, I'll stick to the work I'm assigned to do, okay?","jump":null},{"id":"m_ex_arcana_01_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_31","text":"All right.","jump":null},{"id":"m_ex_arcana_01_32","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_32","text":"From here on out, at last officially speaking,","jump":null},{"id":"m_ex_arcana_01_33","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_33","text":"I'm now a Nikke under your command.","jump":null},{"id":"m_ex_arcana_01_34","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_34","text":"That does make things a little awkward for me with regard to the Forbidden Library, though.","jump":null},{"id":"m_ex_arcana_01_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_35","text":"Don't worry. Just keep doing what you've been doing.","jump":null},{"id":"m_ex_arcana_01_36","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_36","text":"But if I do that,","jump":null},{"id":"m_ex_arcana_01_37","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_37","text":"it'll make me a bit sad.","jump":null},{"id":"m_ex_arcana_01_38","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_38","text":"I guess you prefer the tragic story of a girl who perpetually loses her memory.","jump":null},{"id":"m_ex_arcana_01_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_39","text":"I'm simply saying that you can work like usual.","jump":null},{"id":"m_ex_arcana_01_40","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_40","text":"Okay.","jump":null},{"id":"m_ex_arcana_01_41","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_41","text":"Anyway,","jump":null},{"id":"m_ex_arcana_01_42","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_42","text":"do you remember the other thing we talked about?","jump":null},{"id":"m_ex_arcana_01_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_arcana_01_43","text":"You mean our collaboration?","jump":null},{"id":"m_ex_arcana_01_44","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_44","text":"Yup!","jump":null},{"id":"m_ex_arcana_01_45","type":"Speech","speaker":"arcana","key":"Locale_SuddenMessage:m_ex_arcana_01_45","text":"I'm super excited for it.","jump":null}],"chat":true}