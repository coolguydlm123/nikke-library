hive_03_s_32","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_32","text":"the cause of which was","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_33","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_33","text":"excessively frequent memory wipes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_03_s_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_35","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_35","text":"When repeatedly exposed to certain stimuli, the brain adapts and becomes accustomed to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_36","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_36","text":"NIMPH functions in the same fashion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_37","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_37","text":"The NIMPH mistakenly registers an absence of memory as the default state. As normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_38","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_38","text":"It subsequently independently begins to erase memories that it shouldn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_39","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_39","text":"In other words, it becomes accustomed to the absence of memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_40","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_03_s_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_41","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_41","text":"While I don't think it will go to the extent of shutting down your essential survival functions,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_42","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_42","text":"if this keeps up, you will almost certainly lose all of your memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_43","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_43","text":"Permanently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_44","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_03_s_44","text":"This sounds a lot like...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"