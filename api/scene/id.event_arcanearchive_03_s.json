{"id":"event_arcanearchive_03_s","cat":"event","group":{"id":"ev40077","label":"ARCANE ARCHIVE"},"label":"Following the Memories: A","stage":null,"prev":"event_arcanearchive_02_e","next":"event_arcanearchive_03_e","speakers":{"mary":"Mary","arcana":"Arcana"},"icons":{"mary":"si_c130_00_s","arcana":"si_c581_00_s"},"lines":[{"id":"event_arcanearchive_03_s_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_03_s_1","text":"Despite Arcana grumbling about how she is fine, I insist on taking her to the hospital.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"bgm_inark","movie":null,"shown":["mary","arcana"],"affinity":null},{"id":"event_arcanearchive_03_s_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_03_s_2","text":"After having her go through a medical examination, I head into the consultation room to hear the results from Mary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_3","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_03_s_3","text":"How'd it go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_4","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_4","text":"You say you're potentially suffering permanent memory loss due to repeated memory wipes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_5","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_03_s_5","text":"That's what we think, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_6","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_6","text":"There is a high chance that your memories will return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_7","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_7","text":"Wouldn't you say that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_8","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_8","text":"you remember more now than you did when you first regained consciousness?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_9","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_03_s_9","text":"I think so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_10","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_03_s_10","text":"Some stuff about tarot is also coming back to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_11","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_03_s_11","text":"All right. Now, if I could direct your attention to this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_03_s_12","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_03_s_12","text":"Mary points at the monitor.","jump":null,"exit":fa