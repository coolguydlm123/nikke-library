ic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_13","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_05_13","text":"Objection!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["vesti_c"],"affinity":null},{"id":"d_contents_dungeon_run_05_14","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_05_14","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_15","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_05_15","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_16","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_05_16","text":"If I find there to be no grounds for an objection, I'll hold you in contempt of court!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_17","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_dungeon_run_05_17","text":"... Shouldn't that be my line?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_18","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_05_18","text":"Whatever!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_19","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_05_19","text":"First off,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_20","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_05_20","text":"you're saying that you stopped the monster with ice magic,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_21","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_05_21","text":"but you also froze us!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_22","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_05_22","text":"Then you ran off and left us to contend with the Rapture on our own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_23","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_05_23","text":"I could level plenty of criticisms against you as well, Vesti!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_24","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_05_24","text":"You kept uselessly lobbing explosion spells all over the place and obscured our vision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_05_25","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_05_25","text":"It wasn't useless!","jump":null,"exit":false,"enter":null,"bg":