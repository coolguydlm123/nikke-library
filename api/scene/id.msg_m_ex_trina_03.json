{"id":"msg_m_ex_trina_03","cat":"messenger","group":{"id":"room_trina","label":"Trina · Nikke"},"label":"3. Hmm...","stage":null,"prev":"msg_m_ex_trina_02","next":null,"speakers":{"trina":"Trina"},"icons":{"trina":"si_c412_00_s"},"lines":[{"id":"m_ex_trina_03_1","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_1","text":"Hmm...","jump":null},{"id":"m_ex_trina_03_2","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_2","text":"I've been feeling a bit sluggish lately.","jump":null},{"id":"m_ex_trina_03_3","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_3","text":":(","jump":null},{"id":"m_ex_trina_03_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_4","text":"Is something wrong?","jump":null},{"id":"m_ex_trina_03_5","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_5","text":"Not really.","jump":null},{"id":"m_ex_trina_03_6","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_6","text":"I've just felt","jump":null},{"id":"m_ex_trina_03_7","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_7","text":"super lethargic.","jump":null},{"id":"m_ex_trina_03_8","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_8","text":"Same goes for the little ones above my head.","jump":null},{"id":"m_ex_trina_03_9","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_9","text":"All they've done lately is sleep.","jump":null},{"id":"m_ex_trina_03_10","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_10","text":"Anyway, how are you doing, Sun?","jump":null},{"id":"m_ex_trina_03_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_11","text":"I've been pretty busy for the past few days.","jump":null},{"id":"m_ex_trina_03_12","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_12","text":"Hm.","jump":null},{"id":"m_ex_trina_03_13","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_13","text":"I see.","jump":null},{"id":"m_ex_trina_03_14","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_14","text":"I was thinking of","jump":null},{"id":"m_ex_trina_03_15","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_15","text":"heading to the Commander's Room to cheer myself up,","jump":null},{"id":"m_ex_trina_03_16","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_16","text":"but I guess now's not a good time.","jump":null},{"id":"m_ex_trina_03_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_17","text":"No, you can come over.","jump":null},{"id":"m_ex_trina_03_18","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_18","text":"Really?","jump":null},{"id":"m_ex_trina_03_19","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_19","text":"You seem to have a lot on your plate.","jump":null},{"id":"m_ex_trina_03_20","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_20","text":"You don't have to","jump":null},{"id":"m_ex_trina_03_21","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_21","text":"stretch yourself thin on my account.","jump":null},{"id":"m_ex_trina_03_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_22","text":"It's fine. I should be finished with everything by tomorrow.","jump":null},{"id":"m_ex_trina_03_23","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_23","text":"So you'll be free then?","jump":null},{"id":"m_ex_trina_03_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_24","text":"I believe so, yes.","jump":null},{"id":"m_ex_trina_03_25","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_25","text":"All right!","jump":null},{"id":"m_ex_trina_03_26","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_26","text":"Thank you so much, Sun!","jump":null},{"id":"m_ex_trina_03_27","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_27","text":"Seeing you will put a pep in the little ones' step as well, I'm sure!","jump":null},{"id":"m_ex_trina_03_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_28","text":"Haha, glad to hear that.","jump":null},{"id":"m_ex_trina_03_29","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_29","text":"I'll let them know about our plans!","jump":null},{"id":"m_ex_trina_03_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_30","text":"Sounds good.","jump":null},{"id":"m_ex_trina_03_31","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_31","text":"I should","jump":null},{"id":"m_ex_trina_03_32","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_32","text":"buy some snacks too for tomorrow.","jump":null},{"id":"m_ex_trina_03_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_33","text":"Sure, sure.","jump":null},{"id":"m_ex_trina_03_34","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_34","text":"I will","jump":null},{"id":"m_ex_trina_03_35","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_35","text":"leave my clothes","jump":null},{"id":"m_ex_trina_03_36","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_36","text":"in the arboretum as well.","jump":null},{"id":"m_ex_trina_03_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_37","text":"Come again?","jump":null},{"id":"m_ex_trina_03_38","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_38","text":"Hmm?","jump":null},{"id":"m_ex_trina_03_39","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_39","text":"I want to take you in as much as possible.","jump":null},{"id":"m_ex_trina_03_40","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_40","text":"In order to do that, I shouldn't cover up my body.","jump":null},{"id":"m_ex_trina_03_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_41","text":"Don't you think you should cover up just a little?","jump":null},{"id":"m_ex_trina_03_42","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_42","text":"Hehe, fine.","jump":null},{"id":"m_ex_trina_03_43","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_43","text":"If you insist, I'll consider it.","jump":null},{"id":"m_ex_trina_03_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_44","text":"I'd appreciate it.","jump":null},{"id":"m_ex_trina_03_45","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_45","text":"Hehe.","jump":null},{"id":"m_ex_trina_03_46","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_46","text":"Just let me know when you're ready.","jump":null},{"id":"m_ex_trina_03_47","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_03_47","text":"I'll be waiting to hear from you!","jump":null},{"id":"m_ex_trina_03_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_03_48","text":"Okay.","jump":null}],"chat":true}