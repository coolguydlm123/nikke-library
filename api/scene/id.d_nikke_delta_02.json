ll,"affinity":null},{"id":"d_nikke_delta_02_47","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_47","text":"Yes, I'm giving it my all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_48","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_48","text":"Was it... strange?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_49","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_49","text":"Yep. You could've been doing triple flips and still looked like a soldier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_50","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_51","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_51","text":"... Well, it was your first time. Just keep at it, and you're bound to get better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_52","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_02_52","text":"Some time later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_53","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_53","text":"... Sorry, it seems I'm not qualified for this task.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_54","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_54","text":"... I have no excuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_55","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_55","text":"I couldn't even properly complete such a simple conversation mission, so how could I even go undercover?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_56","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_56","text":"This goal is clearly beyond my capabilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_57","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_58","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_58","text":"... Commander, Anis, thank you for your help today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_59","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_59","text":"I don't mean to be presumptuous, but I believe I should give up on trying to appear normal at this point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_60","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_60","text":"I'll be going now.","jump":null,"exit":f