h job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_7","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_7","text":"Anis, I've been told you're the unrivaled expert in this field.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_8","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_8","text":"If you succeed, I'll get you cultured meat or anything else you want. Will you assist me with my training?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_9","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_9","text":"I'll give it a shot for the cultured meat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_10","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_10","text":"The problem is, where do I even start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_11","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_11","text":"From the way you talk to how you carry yourself, down to the little habits—there's not a single normal thing about you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_12","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_12","text":"You're exactly like a soldier who just got out of the battlefield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_13","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_02_13","text":"An accurate analysis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_14","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_14","text":"So accurate it hurts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_15","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_15","text":"So what? You can work on it from now on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_16","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_16","text":"Now, how about we start with the basics?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_17","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_17","text":"The basics...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_18","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_18","text":"I'm talkin' about everyday stuff, y'know? Like how the weather is today, or what you're doing this weekend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_19","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_19","text":"'Cause behavior comes from the heart, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_20","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_20","text":"So if you can pull off a normal conversation, maybe—just maybe—your behavior will start to change too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_21","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_21","text":"Indeed. That is a reasonable hypothesis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_22","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_22","text":"Right? Then let's get started right now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_23","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_02_23","text":"Some time later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_24","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_24","text":"Go ahead and ask me anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_25","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_25","text":"I'll respond in the most normal way possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_26","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_26","text":"Okay then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_27","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_27","text":"What are you going to eat tonight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_28","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_28","text":"Tonight's dinner will be combat rations issued by Elysion Headquarters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tuffguys","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_29","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_29","text":"... Oh yeah? You're way more organized than I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_30","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_delta_02_30","text":"I was just gonna make do with the sweet-potato-flavored Splendamin in the freezer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_31","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_31","text":"... Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_32","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_02_32","text":"I consider Splendamin a highly effective combat ration, given that it can be consumed in under 5 minutes regardless of the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_02_33","type"