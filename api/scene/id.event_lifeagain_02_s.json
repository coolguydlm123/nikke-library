},{"id":"event_lifeagain_02_s_102","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_102","text":"There's not a single thing I like about you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_103","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_02_s_103","text":"I feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_104","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_104","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_105","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_02_s_105","text":"Why don't we stop arguing and try and do an activity, since we're here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_106","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_106","text":"I'm not interested. Unless we're commencing the therapy, I'm going home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_107","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_107","text":"What could I even do here anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_108","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_108","text":"About all I can do is sit here and watch others have a good time.","jump":null,"exit":