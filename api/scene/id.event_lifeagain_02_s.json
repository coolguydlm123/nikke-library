:"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_82","text":"making fun of the girl in the wheelchair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_83","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_02_s_83","text":"Not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_84","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_02_s_84","text":"Gym Rat, do you get the feeling that I'm making fun of her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_85","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_lifeagain_02_s_85","text":"... I can see where she'd get that impression.","jump":"event_lifeagain_02_s_87","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_86","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_lifeagain_02_s_86","text":"... No.","jump":"event_lifeagain_02_s_89","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_87","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_87","text":"See? Even he thinks it looks like you're making fun of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_02_s_88","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_02_s_88","text":"Why are you the only one who doesn't get it?","jump":"event_lifeagain_02_s_91","exit":false,"enter":null,"bg":null,"bgArt":