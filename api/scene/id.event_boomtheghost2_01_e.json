ffinity":null},{"id":"event_boomtheghost2_01_e_5","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_5","text":"The merchant, Sellsy, overlooks all of the shops and their merchandise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_6","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_6","text":"The safety management officer, Detaily, handles safety onboard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_7","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_8","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_e_8","text":"The names sound a bit childish, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_9","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_9","text":"Simple names appeal to both children and adults, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_10","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_10","text":"These high-tier holograms each oversee numerous lower-tier ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_11","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_11","text":"But now that all the high-tier AI systems are broken, the regular ones are acting on their own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_12","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_12","text":"This entire situation is due to the fact the high-tier holograms are not properly directing the others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_13","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_13","text":"Can't you tell the high-tier holograms what to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_14","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_14","text":"Normally, yes, but remote access is currently disabled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_15","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_15","text":"That's not good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_16","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_16","text":"Is there any other way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_17","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_17","text":"If we physically connect my hologram emitter to their emitters,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_18","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_18","text":"I will be able to return them to normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_19","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_19","text":"Go figure. It always comes down to having to do things manually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_20","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_20","text":"All right,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_21","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_21","text":"we'll take your emitter and connect it to the high-tier holograms' emitters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_22","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_22","text":"Once we do that, you'll be able to fix them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_23","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_23","text":"Absolutely, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_24","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_24","text":"Er... Elegg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_25","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_25","text":"Now that we know the ghosts are holograms, can't we just ignore them and carry on with the mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_26","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_26","text":"We came here to conduct research for my book... uh, I mean, to investigate the ship's power source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_27","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_27","text":"We can't do that. If the ship isn't functioning properly, any investigation would be meaningless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_28","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_28","text":"That's right. This is an important mission, so we need to be extra cautious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_29","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_29","text":"Y-yeah, totally! I just said that as a test, to make sure no one was getting sidetracked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_30","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_30","text":"... Anyway, it feels like we've jumped out of a ghost story and into sci-fi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_31","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_e_31","text":"I'm just glad that we're not dealing with the supernatural.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_32","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_32","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_33","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_33","text":"There's no such thing as ghosts, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_34","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_34","text":"Only those with weak minds believe in such things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_35","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_e_35","text":"You changed your tune awfully quick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_36","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_36","text":"There's no time to waste. Let's move out. I'll take point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_37","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_37","text":"If we run into anything, ghosts or otherwise, tell them to come my way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_38","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_38","text":"Nothing can stop me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_39","type":"Speech","speaker":"yan_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_39","text":"Whatever you say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_e_40","text":"Utopia ship kitchen.","jump":null,"exit":false,"enter":null,"bg":"Kitchen","bgArt":"kitchen","image":null,"bgm":"none","movie":null,"shown":["chefghost"],"affinity":null},{"id":"event_boomtheghost2_01_e_41","type":"Speech","speaker":"chefghost","key":"Locale_MainScenario:event_boomtheghost2_01_e_41","text":"Cooking the food, sizzle sizzle!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_42","type":"Speech","speaker":"chefghost","key":"Locale_MainScenario:event_boomtheghost2_01_e_42","text":"Scrumpdiddlyumptious!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_43","type":"Speech","speaker":"chefghost","key":"Locale_MainScenario:event_boomtheghost2_01_e_43","text":"Fresh and hot, sizzle sizzle!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_44","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_44","text":"I take it that's the chef, Sizzly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_45","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_45","text":"Doesn't look too intimidating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_spookaboo","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_46","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_e_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_47","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_47","text":"Let's get in there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_48","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_48","text":"There's a bunch of other holograms nearby, so a fight is inevitable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_49","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_49","text":"But with the BFG, we've got nothing to fear!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_50","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_e_50","text":"Approaching it will be easy enough. The question is, what do we do after?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_e_51","text":"A hologram pops out from the disk Rapi is holding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["alfred"],"affinity":null},{"id":"event_boomtheghost2_01_e_52","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_52","text":"Sizzly's hologram emitter should be in the center of the kitchen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_53","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_53","text":"If you establish a wired connection between it and my own emitter,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_54","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_e_54","text":"I will be able to restore Sizzly to normal in no time, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_e_55","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_e_55","text":"Okay, I'm going in!","jump":null,"e