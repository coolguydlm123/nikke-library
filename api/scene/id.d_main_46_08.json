":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_46_08_41","text":"I await the magnificent moment my profound knowledge and Eden's converge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_42","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_42","text":"Are we seriously taking her with us? I'd say a fight's liable to break out before long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_43","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_43","text":"We have to bring her. What choice do we have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_44","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_44","text":"But what's taking those two so long?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_45","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_45","text":"Yeah, they're running pretty late today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_08_46","text":"*Swooooosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_08_47","text":"*Thud*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["onlyone_c","ziz"],"affinity":null},{"id":"d_main_46_08_