d_main_46_08_6","text":"What book?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_7","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_46_08_7","text":"Don't you know? Books are nourishment for the mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_8","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_46_08_8","text":"No matter where one goes, books are an absolute necessity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_9","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_9","text":"Uh... Bahamut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_10","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_10","text":"... Why are you always reading books?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_11","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_46_08_11","text":"Knowledge is a weapon, Levi. One must always keep it sharp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_12","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_12","text":"Your knowledge is a weapon, all right. Something you swing around that leaves people dazed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_13","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_46_08_13","text":"Precisely. It's gratifying to be surrounded by fellows who truly understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_14","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_14","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_15","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_15","text":"I'm surprised you actually agreed to help the Young Man.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_16","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_17","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_17","text":"I promised him I would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_18","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_18","text":"And from what I hear, something major happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_19","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_19","text":"Come to think of it, you've visited Eden before, right? So you're already familiar with the place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_20","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_20","text":"Sure, I've been there before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_21","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_21","text":"But I doubt they'll welcome me with open arms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_22","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_22","text":"... What did you do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_23","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_23","text":"Let's just say we got off to a rocky start...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_24","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_24","text":"We're doomed. We'll be lucky if we don't get intercepted along the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_25","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_46_08_25","text":"Well, the Young Man probably gave Eden a heads-up already. We should be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_26","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_46_08_26","text":"Yeah, I guess it'll be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_08_27","type":"Speech","