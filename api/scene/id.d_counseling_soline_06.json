{"id":"d_counseling_soline_06","cat":"counsel","group":{"id":"char5019","label":"Soline"},"label":"Advising Soline: 06","stage":null,"prev":"d_counseling_soline_05","next":"d_counseling_soline_07","speakers":{"soline":"Soline"},"icons":{"soline":"si_c071_00_s"},"lines":[{"id":"d_counseling_soline_06_1","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_1","text":"These days, when Diesel and Brid see me,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["soline"],"affinity":"_0"},{"id":"d_counseling_soline_06_2","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_2","text":"they keep patting my head and saying I'm cute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_3","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_3","text":"I think it's because they've never seen me at my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_4","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_4","text":"They don't know how competent and charismatic I am!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_5","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_5","text":"What do I have to do for them to stop seeing me as cute?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_soline_06_6","text":"Say \"stop seeing me as cute\" with your charisma.","jump":"d_counseling_soline_06_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_soline_06_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_soline_06_7","text":"Chug a cup of bitter coffee in front of them.","jump":"d_counseling_soline_06_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_soline_06_8","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_8","text":"How do I talk with charisma?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_9","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_9","text":"Also, I already tried that before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_10","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_10","text":"But it doesn't get through. Instead, they pat my head even more.","jump":"d_counseling_soline_06_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_11","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_11","text":"Chug a bitter cup of coffee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_12","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_12","text":"Hmm... I guess if they see me drinking bitter coffee without flinching, then their impressions will be changed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_13","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_13","text":"Okay, might as well give it a try! Since I'm an adult and all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_14","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_06_14","text":"That's good advice. Thanks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_06_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_soline_06_15","text":"I discuss how to not look cute with Soline.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}