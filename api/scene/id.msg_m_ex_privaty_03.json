{"id":"msg_m_ex_privaty_03","cat":"messenger","group":{"id":"room_privaty","label":"Privaty · Nikke"},"label":"3. Um...","stage":null,"prev":"msg_m_ex_privaty_02","next":"msg_m_ex_privaty_04","speakers":{"privaty":"Privaty"},"icons":{"privaty":"si_c170_00_s"},"lines":[{"id":"m_ex_privaty_03_1","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_1","text":"Um...","jump":null},{"id":"m_ex_privaty_03_2","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_2","text":"Commander.","jump":null},{"id":"m_ex_privaty_03_3","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_3","text":"I'm a nervous wreck.","jump":null},{"id":"m_ex_privaty_03_4","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_4","text":"Can you talk for a minute and calm me down?","jump":null},{"id":"m_ex_privaty_03_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_5","text":"What's the matter?","jump":null},{"id":"m_ex_privaty_03_6","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_6","text":"Well...","jump":null},{"id":"m_ex_privaty_03_7","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_7","text":"I'm going to be reporting to Deputy Chief Andersen","jump":null},{"id":"m_ex_privaty_03_8","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_8","text":"regarding the crackdown on protests in the Ark.","jump":null},{"id":"m_ex_privaty_03_9","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_9","text":"He's just a bit...","jump":null},{"id":"m_ex_privaty_03_10","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_10","text":"a bit...","jump":null},{"id":"m_ex_privaty_03_11","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_11","text":"you know what I mean?","jump":null},{"id":"m_ex_privaty_03_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_12","text":"No, I don't.","jump":null},{"id":"m_ex_privaty_03_13","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_13","text":"How can you not know?","jump":null},{"id":"m_ex_privaty_03_14","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_14","text":"You work directly under him!","jump":null},{"id":"m_ex_privaty_03_15","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_15","text":"Bah, you're impossible to talk to!","jump":null},{"id":"m_ex_privaty_03_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_16","text":"All right, conversation over then.","jump":null},{"id":"m_ex_privaty_03_17","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_17","text":"Hey, c'mon! There's no need to go overboard.","jump":null},{"id":"m_ex_privaty_03_18","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_18","text":"What I wanted to say was","jump":null},{"id":"m_ex_privaty_03_19","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_19","text":"that he's not easy to deal with.","jump":null},{"id":"m_ex_privaty_03_20","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_20","text":"Typically,","jump":null},{"id":"m_ex_privaty_03_21","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_21","text":"whenever I'm reporting to my other superiors,","jump":null},{"id":"m_ex_privaty_03_22","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_22","text":"they'll let me off if I've made a small mistake.","jump":null},{"id":"m_ex_privaty_03_23","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_23","text":"But Deputy Chief Andersen...","jump":null},{"id":"m_ex_privaty_03_24","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_24","text":"He doesn't let anything slide.","jump":"m_ex_privaty_03_26"},{"id":"m_ex_privaty_03_25","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_25","text":"He's strictly by the book.","jump":"m_ex_privaty_03_26"},{"id":"m_ex_privaty_03_26","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_26","text":"Right!","jump":null},{"id":"m_ex_privaty_03_27","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_27","text":"Exactly!","jump":null},{"id":"m_ex_privaty_03_28","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_28","text":"So if I don't follow everything to the letter,","jump":null},{"id":"m_ex_privaty_03_29","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_29","text":"he'll have this sour look on his face.","jump":null},{"id":"m_ex_privaty_03_30","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_30","text":"Gulp...","jump":null},{"id":"m_ex_privaty_03_31","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_31","text":"Just imagining it makes me nervous.","jump":null},{"id":"m_ex_privaty_03_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_32","text":"You don't have to be so nervous.","jump":null},{"id":"m_ex_privaty_03_33","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_33","text":"What?","jump":null},{"id":"m_ex_privaty_03_34","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_34","text":"So long as his subordinates make an effort, he won't criticize them unduly.","jump":"m_ex_privaty_03_36"},{"id":"m_ex_privaty_03_35","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_privaty_03_35","text":"I can't see you making any major mistakes.","jump":"m_ex_privaty_03_38"},{"id":"m_ex_privaty_03_36","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_36","text":"Are you sure?","jump":null},{"id":"m_ex_privaty_03_37","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_37","text":"But how would you...","jump":"m_ex_privaty_03_41"},{"id":"m_ex_privaty_03_38","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_38","text":"Hmmm...","jump":null},{"id":"m_ex_privaty_03_39","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_39","text":"That's true,","jump":null},{"id":"m_ex_privaty_03_40","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_40","text":"but...","jump":null},{"id":"m_ex_privaty_03_41","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_41","text":"Eek!","jump":null},{"id":"m_ex_privaty_03_42","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_42","text":"His secretary just called me!","jump":null},{"id":"m_ex_privaty_03_43","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_43","text":"I'll talk to you later","jump":null},{"id":"m_ex_privaty_03_44","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_44","text":"and...","jump":null},{"id":"m_ex_privaty_03_45","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_45","text":"thank you","jump":null},{"id":"m_ex_privaty_03_46","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_privaty_03_46","text":"for putting my mind at ease.","jump":null}],"chat":true}