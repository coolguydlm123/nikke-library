er":"ludmilla","key":"Locale_MainScenario:d_main_06_04_35","text":"That miracle being for someone else to come around and return their brains to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_36","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_06_04_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_37","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_37","text":"And that's exactly what we do here at Unlimited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_38","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_06_04_38","text":"You've found their brains?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_39","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_39","text":"Of course. We've saved dozens of Nikkes this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_40","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_40","text":"Unfortunately, since their brains have been separated from their bodies for so long, we've seen a few instances of asynchronization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_41","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_41","text":"We've seen mental breakdowns and amnesia as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_42","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_42","text":"But they all survived in the end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_43","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_43","text":"They survived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_44","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_44","text":"And that's good enough for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_45","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_06_04_45","text":"You've been through a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_46","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_46","text":"It's worth it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_47","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_47","text":"But I didn't originally intend on showing you all of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_48","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_48","text":"Seeing the worst-case scenario is sure to make you uneasy about the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06