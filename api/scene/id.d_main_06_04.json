:"ludmilla","key":"Locale_MainScenario:d_main_06_04_21","text":"Now that you mention it, I could go for a glass of milk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_22","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_06_04_22","text":"Right away, my Queen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_23","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_06_04_23","text":"Alice runs away with a smile on her face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_24","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_06_04_25","text":"Are these the Nikkes on the surface you \"rescued\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_26","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_26","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_06_04_27","text":"Aren't they all dead? Why did you collect the bodies?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_04_28","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_04_28","text":"They're not 