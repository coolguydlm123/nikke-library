{"id":"d_counseling_helm_20","cat":"counsel","group":{"id":"char5066","label":"Helm"},"label":"Advising Helm: 20","stage":null,"prev":"d_counseling_helm_19","next":null,"speakers":{"helm":"Helm"},"icons":{"helm":"si_c352_00_s"},"lines":[{"id":"d_counseling_helm_20_1","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_1","text":"What do you think about noble causes that are doomed to fail?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["helm"],"affinity":"_0"},{"id":"d_counseling_helm_20_2","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_2","text":"Is it a meaningless feat","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_3","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_3","text":"or something we should beseech everyone to do, regardless?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_helm_20_4","text":"Fighting for a just cause should be respected, no matter what form it takes.","jump":"d_counseling_helm_20_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_helm_20_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_helm_20_5","text":"If a cause is bound to fail, then it is meaningless.","jump":"d_counseling_helm_20_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_helm_20_6","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_6","text":"That's how I feel as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_7","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_7","text":"Power comes in all forms, not just material or physical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_8","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_8","text":"Depending on what you're fighting for, justice itself can become a form of power.","jump":"d_counseling_helm_20_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_9","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_9","text":"I suppose that has an element of truth to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_10","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_10","text":"But if that's the case,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_11","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_11","text":"justice will become something reserved solely for those with power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_12","type":"Speech","speaker":"helm","key":"Locale_Counseling:d_counseling_helm_20_12","text":"Meanwhile, there won't be any justice for the powerless.","jump":"d_counseling_helm_20_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_helm_20_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_helm_20_13","text":"Helm and I have a heated discussion about justice.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}