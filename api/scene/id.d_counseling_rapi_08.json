{"id":"d_counseling_rapi_08","cat":"counsel","group":{"id":"char3001","label":"Rapi"},"label":"Advising Rapi: 08","stage":null,"prev":"d_counseling_rapi_07","next":"d_counseling_rapi_09","speakers":{"rapi":"Rapi"},"icons":{"rapi":"si_c010_00_s"},"lines":[{"id":"d_counseling_rapi_08_1","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_08_1","text":"A while ago, Neon lost a shell. She stayed up all night and looked for it everywhere.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rapi"],"affinity":"_0"},{"id":"d_counseling_rapi_08_2","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_08_2","text":"I helped her, and we were eventually able to find it, but... I was jealous of Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_08_3","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_08_3","text":"I was jealous that she had something that mattered so much to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_08_4","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_08_4","text":"I wonder... will I ever find something that means that much to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_08_5","text":"We can take our time finding it. Together.","jump":"d_counseling_rapi_08_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rapi_08_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_08_6","text":"What about me?","jump":"d_counseling_rapi_08_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rapi_08_7","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_08_7","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_08_8","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_08_8","text":"I do hope we find something.","jump":"d_counseling_rapi_08_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_08_9","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_08_9","text":"... I'm not sure about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_08_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_08_10","text":"Rapi and I discuss the things we hold dear.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}