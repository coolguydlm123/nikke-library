_nikke_delta_03_61","text":"Y-yes! I'm actually a victim too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_62","type":"Speech","speaker":"suspect","key":"Locale_NikkeEpisode:d_nikke_delta_03_62","text":"So, please... can you forgive me just this once? I'm begging you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_63","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_delta_03_63","text":"Do you know anything about that person?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_64","type":"Speech","speaker":"suspect","key":"Locale_NikkeEpisode:d_nikke_delta_03_64","text":"No way! That was ages ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_65","type":"Speech","speaker":"suspect","key":"Locale_NikkeEpisode:d_nikke_delta_03_65","text":"Besides, he only ever contacted me through a pay phone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_66","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_66","text":"Then you're no longer of any use. Die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_67","type":"Speech","speaker":"suspect","key":"Locale_NikkeEpisode:d_nikke_delta_03_67","text":"Wait, wait, wait!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_68","type":"Speech","speaker":"suspect","key":"Locale_NikkeEpisode:d_nikke_delta_03_68","text":"There's one thing I know for sure. That guy... was an outlaw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_69","type":"Speech","speaker":"suspect","key":"Locale_NikkeEpisode:d_nikke_delta_03_69","text":"When I was talking to him, I could faintly hear the announcement from the Outer Rim entrance gate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_70","type":"Speech","speaker":"suspect","key":"Locale_NikkeEpisode:d_nikke_delta_03_70","text":"But if he wasn't an outlaw, why would he enter a lawless place like the Outer Rim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_71","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_71","text":"... The Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_72","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_72","text":"If that's true, this investigation... might have hit a dead end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_73","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_73","text":"The Outer Rim is the Ark's outer perimeter where outlaws gather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_74","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_74","text":"It's nearly impossible for anyone to move around there without a guide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_75","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_delta_03_75","text":"I know someone who might do that. I have connections.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_76","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_76","text":"... You said what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_77","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_delta_03_77","text":"I should reach out to my contact at the Outer Rim and ask for their help with the investigation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_78","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_78","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_79","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_79","text":"As expected. Your extensive connections are awe-inspiring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_80","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_03_80","text":"It's not that amazing.","jump":"d_nikke_delta_03_82","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_81","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_03_81","text":"My aggressive networking seems to have paid off.","jump":"d_nikke_delta_03_83","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_82","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_82","text":"You're even humble. A textbook example of an outstanding Commander.","jump":"d_nikke_delta_03_86","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_83","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_83","text":"Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_84","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_84","text":"... No, don't bother explaining further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_85","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_85","text":"I want to keep my respect and awe for you intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_03_86","type":"Speech","speaker":"delta","key":"Locale_NikkeEpisode:d_nikke_delta_03_86","text":"Then... there's little time left before our meeting. Let's move quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}