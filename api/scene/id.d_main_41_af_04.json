{"id":"d_main_41_af_04","cat":"main","group":{"id":"ch41","label":"Chapter 41 · Birth"},"label":"Glasses and Keys","stage":null,"prev":"d_main_41_af_03","next":"d_main_41_af_05","speakers":{"jien":"Jien","neon":"Neon","ether":"Ether"},"icons":{"jien":"si_c973_00_s","neon":"si_c011_00_s","ether":"si_c291_00_s"},"lines":[{"id":"d_main_41_af_04_1","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_1","text":"Drink. It's good tea.","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":"event_bgm_ubsphere_jien","movie":null,"shown":["neon","jien","ether"],"affinity":null},{"id":"d_main_41_af_04_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_2","text":"Ah... Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_3","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_3","text":"What a surprise. I never expected to see you here, Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_4","text":"I didn't think I'd run into you here, too, Ether.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_5","text":"I also didn't expect to see Syuen's sister here either...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_6","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_6","text":"I hear my dear sister owes a lot to the Counters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_7","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_7","text":"Are you still getting on well these days?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_8","text":"Of course. We're still close. Always have been.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_9","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_9","text":"... Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_10","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_10","text":"Now then, shall we get down business?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_11","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_11","text":"First question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_12","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_12","text":"How did you end up here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_13","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_13","text":"This isn't a place you come across by chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_14","text":"I already told Jien this earlier. My glasses showed me the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_15","text":"It led me all the way here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_16","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_16","text":"All right. Second question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_17","text":"Hey, I've got plenty of questions too. Isn't it polite to take turns asking each other?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_18","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_18","text":"Do you know what this place is, Neon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_19","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_19","text":"Oooh! That was actually gonna be my first question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_20","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_20","text":"This is the Deep Sector of M.M.R.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_21","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_21","text":"The deepest of the deep. Even coming down here twice a year is considered a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_22","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_22","text":"No one comes down here unless a major incident is occurring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_23","text":"I guess that means me being here is a major incident?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_24","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_24","text":"That's right. This place is as highly classified as you can get.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_25","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_25","text":"Even those with real pull in the Central Government need to clear dozens of procedures to set foot here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_26","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_26","text":"And yet, here you are, despite all of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_27","text":"Sounds like your security is a bit lax.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_28","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_28","text":"That corridor you just passed through is meant to eliminate anyone without authorization. Through electrocution, immolation and poison gas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_29","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_29","text":"Yet you passed through unimpeded. That means you received authorization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_30","text":"Wow, maybe I was the Ark's commander in chief in a past life?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_31","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_31","text":"What it really means is that I could kill you where you stand, and nobody would know about it, Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_32","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_32","text":"I don't intend to. It won't happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_33","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_34","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_34","text":"I hope you realize how exceptional this place is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_35","text":"Hmm... I've really gotta get back, since people are waiting for me, but I guess that's not going to be possible, huh? Since this is an exceptional place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_36","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_36","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_37","text":"So what then? Do I have to live here forever?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_38","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_38","text":"Of course not. You can leave here as long as you cooperate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_39","text":"Hmm... Can't say I fully trust you, but fine. Guess I don't have much choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_40","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_40","text":"Back to my second question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_41","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_41","text":"Where did you get those glasses?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_42","text":"I've had them with me ever since I became a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_43","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_43","text":"Don't lie to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_44","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_44","text":"It's the truth. You can ask President Ingrid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_45","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_45","text":"Do you know what they are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_46","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_46","text":"They're all-purpose glasses with a built-in light, heat source tracking, and BOOM is even installed on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_47","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_47","text":"That's not what it is, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_48","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_48","text":"Oh, I forgot the most important thing! It completes my character.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_49","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_49","text":"Wrong again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_50","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_51","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_51","text":"Ether, did you find anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_52","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_52","text":"No. She's clean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_53","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_53","text":"*Sigh* Who is this kid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_54","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_54","text":"Hang on, did you run a background check on me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_55","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_55","text":"Yes. I did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_56","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_56","text":"Prior to your becoming a Nikke...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_57","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_57","text":"There are no records of your life as a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_58","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_58","text":"Usually, there's at least something, but this time, there isn't a shred of information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_59","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_59","text":"Do you remember anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_60","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_60","text":"Nope. I don't cling to the past. I'm too cool for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_61","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_61","text":"*Sigh* What a headache.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_62","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_62","text":"Are we going to have to open her up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_63","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_63","text":"A member of the Commando Unit? Are you crazy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_64","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_64","text":"I'm not saying I'll actually do it. I'm merely illustrating how curious I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_65","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_65","text":"Who were those people I saw earlier?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_66","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_66","text":"Oh, you saw them? I figured you hadn't seen anything because it was so dark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_67","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_67","text":"They even spoke. They kept saying something about a key.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_68","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_68","text":"So you heard and saw everything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_69","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_69","text":"Ether. What should we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_70","type":"Speech","speaker":"ether","key":"Locale_MainScenario:d_main_41_af_04_70","text":"Silencing her would be impossible. She's too well-known.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_71","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_71","text":"Right? This is quickly becoming irritating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_72","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_af_04_72","text":"Jien straightens up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_73","type":"Speech","speaker":"jien","key":"Locale_MainScenario:d_main_41_af_04_73","text":"Fine. Neon, how about we make a deal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_74","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_41_af_04_74","text":"I don't like making deals with Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_04_75","type":"Speech","speaker":"jien","key":"L