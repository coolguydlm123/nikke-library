{"id":"event_foolmetalpanic_10","cat":"event","group":{"id":"ev130010","label":"Foolmetalpanic"},"label":"Is the Order a \"Mecha Shifty\"?","stage":null,"prev":"event_foolmetalpanic_09_e","next":"event_foolmetalpanic_11","speakers":{"mechashifty":"Mecha Shifty","cocoa":"Cocoa"},"icons":{"mechashifty":"si_c993_00_s","cocoa":"si_c311_00_s"},"lines":[{"id":"event_foolmetalpanic_10_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_1","text":"After returning to the Outpost,","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_2","text":"I hear that the four infuriated Nikkes have left and expanded their search area to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_3","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_3","text":"What a relief. It may all be just a misunderstanding, but I'm still terrified at the thought of explaining myself to them all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_4","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_5","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_5","text":"Anyway, after many twists and turns, it seems the day has finally come to an end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_6","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_6","text":"In order to comfort my exhausted body and mind,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_7","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_7","text":"I head to the Maid Cafe.","jump":null,"exit":false,"enter":null,"bg":"MaidCafe","bgArt":"maidcafe","image":null,"bgm":"none","movie":null,"shown":["mechashifty"],"affinity":null},{"id":"event_foolmetalpanic_10_8","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_8","text":"Welcome back. Inferior Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_9","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_9","text":"What would you like to order? Please choose something easy and convenient to make, Human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_10","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_10","text":"I'll have an o...mu...rice?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_11","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_11","text":"There is no item on the menu called \"o...mu...rice.\" Are you here to cause trouble?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_kneeldownfools","movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_12","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_12","text":"... Who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_13","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_13","text":"I am Mecha Maid Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_14","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_14","text":"You may call me Memash for short.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_15","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_15","text":"Didn't you die while fighting that giant amalga-whatever?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_16","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_16","text":"I have never tasted death, Human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_17","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_17","text":"While it is true that I was heavily damaged, I was able to repair myself thanks to the power of my super alloy ZZZ.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_18","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_18","text":"Afterward, I became sick of fighting and changed careers to become a maid. Now I spend my days stealing pocket change from inferior beings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_19","text":"If you were alive, why didn't you say anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_20","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_20","text":"Am I your subordinate? Do I report to you? Should I dust off my Death Arm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_21","text":"No, please don't. Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_22","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_22","text":"Honestly... Just let me live as a kindly maid. I've put my past behind me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_23","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_23","text":"I spent most of the day with Mekami Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_24","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_24","text":"It's too bad you didn't get to see her. She really wanted to see you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_25","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_25","text":"*Crash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_26","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_26","text":"The plate placed on top of Mecha Shifty's Gatling gun falls and shatters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_27","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_27","text":"... What did you just say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_28","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_10_28","text":"Hm...? I said I was just with Mekami Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_29","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_30","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolmetalpanic_10_30","text":"Tell me everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_10_31","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_foolmetalpanic_10_31","text":"Mecha Maid. No slacking off.","jump"