{"id":"d_counseling_mica_07","cat":"counsel","group":{"id":"char3008","label":"Mica"},"label":"Advising Mica: 07","stage":null,"prev":"d_counseling_mica_06","next":"d_counseling_mica_08","speakers":{"mica":"Mica"},"icons":{"mica":"si_c061_00_s"},"lines":[{"id":"d_counseling_mica_07_1","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_07_1","text":"Old-Timer, what do you do when you're sad?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mica"],"affinity":"_0"},{"id":"d_counseling_mica_07_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mica_07_2","text":"I cry like a little baby.","jump":"d_counseling_mica_07_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mica_07_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mica_07_3","text":"I shove it down deep inside.","jump":"d_counseling_mica_07_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mica_07_4","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_07_4","text":"Whoa! You're just like me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_07_5","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_07_5","text":"I just let the tears flow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_07_6","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_07_6","text":"Then, Belorta holds my hand and tells me everything is gonna be okay.","jump":"d_counseling_mica_07_10","exit":false,"enter":null,"bg":n