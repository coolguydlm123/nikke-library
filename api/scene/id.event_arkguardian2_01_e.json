{"id":"event_arkguardian2_01_e","cat":"event","group":{"id":"ev40098","label":"ARK GUARDIAN · Part 1"},"label":"Wounded Heroes: B","stage":null,"prev":"event_arkguardian2_01_s","next":"event_arkguardian2_02_s","speakers":{"snowwhite_o":"Snow White","dorothy":"Dorothy","hongryeon_o":"Scarlet","rapunzel_o":"Rapunzel","liliweiss":"Liliweiss"},"icons":{"snowwhite_o":"si_c224_00_s","dorothy":"si_c233_00_s","hongryeon_o":"si_c225_00_s","rapunzel_o":"si_c966_00_s","liliweiss":"si_c943_00_s"},"lines":[{"id":"event_arkguardian2_01_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_01_e_1","text":"*Whirr*","jump":null,"exit":false,"enter":null,"bg":"LivingRoom","bgArt":"livingroom","image":null,"bgm":"event_bgm_redash_dearsnowwhite","movie":null,"shown":["snowwhite_o","dorothy","hongryeon_o"],"affinity":null},{"id":"event_arkguardian2_01_e_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_01_e_2","text":"Snow White opens the door leading to the lobby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_01_e_3","text":"Dorothy, Scarlet, and Rapunzel look at her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapunzel_o"],"affinity":null},{"id":"event_arkguardian2_01_e_4","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_5","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_01_e_5","text":"You're up? How are you feeling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_6","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_6","text":"I'm okay... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_7","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_7","text":"'Tis fortunate it hath come to an end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_8","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_8","text":"'Twould seem more of those damnable abominations have sprung forth anew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_9","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_9","text":"How about you, Rapunzel? Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_10","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_10","text":"Yes, I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_11","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_11","text":"But your shoulder...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_12","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_12","text":"My parts are always in surplus, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_01_e_13","text":"It would be disastrous if Rapunzel were injured, so we always make sure to keep plenty of her spare parts on hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_14","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_14","text":"That's good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_15","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_15","text":"I appreciate your concern, Snow White.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_16","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_16","text":"And you two? Are you all right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_01_e_17","text":"Well enough, as you can see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_18","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_18","text":"I endured a direct blow from those infernal scoundrels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_19","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_19","text":"Mine frame was nigh unto dust, yet by some miracle, it was salvaged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_20","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_20","text":"Such is the strange grace bestowed upon we Nikkes; so long as the components be at hand, restoration shall ever be within our grasp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_01_e_21","text":"That might not be the most appropriate thing to say in front of people who were at death's door just a while ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_22","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_22","text":"Whatever hath transpired, we yet live. That is what truly matters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_23","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_01_e_23","text":"Fair point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_24","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_25","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_25","text":"And the Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_26","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_27","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_27","text":"The Commander was seriously injured, so he was transported to the V.T.C. hospital managed by Headquarters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_28","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_28","text":"They say his internal organs were severely damaged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_29","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_29","text":"But he'll be fine... right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_30","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_30","text":"He's made of tough stuff, so he's not in any mortal danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_31","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_31","text":"The V.T.C. personnel are tending to him personally, so there's no need to worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_32","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_32","text":"To survive with a fist lodged in one's side and yet still live... 'tis naught short of the supernatural.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_33","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_33","text":"He'll return as soon as he's been treated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_34","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_34","text":"We just need to wait a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_35","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_35","text":"Good to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_36","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_37","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_37","text":"How about Lilith?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian2_01_e_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_39","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_40","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian2_01_e_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_01_e_41","text":"*Whirr*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liliweiss"],"affinity":null},{"id":"event_arkguardian2_01_e_42","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_42","text":"Oh my.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_43","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_43","text":"Everyone seems to be doing fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_44","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_44","text":"Youth really is a blessing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_45","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_45","text":"Lilith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_46","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_46","text":"Yes? What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_47","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_01_e_47","text":"Thank you... for saving me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_48","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_48","text":"Don't mention it. That's what I'm here for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_49","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_49","text":"All right, everyone, just rest for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_50","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_50","text":"The second phase of the sealing process was successfully completed, so things should be quiet for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_51","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_51","text":"If you need to tend to any repairs, do so now. Understood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_52","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_52","text":"What knowledge hast thou gained of those black Heretics?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_53","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_53","text":"We're still looking into it. I'm sure we'll get answers soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_54","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_54","text":"If there's any silver lining to this, they don't appear to wield the same power as Anachiro.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_55","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_55","text":"Most likely due to a difference in body specs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_56","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian2_01_e_56","text":"'Tis a great relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_01_e_57","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_01_e_57","text":"Anyway, all we can do is wait for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"ima