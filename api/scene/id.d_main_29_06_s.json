{"id":"d_main_29_06_s","cat":"main","group":{"id":"ch29","label":"Chapter 29 · Rescue"},"label":"Tattered Clothes: A","stage":"29-21 STAGE · Start","prev":"d_main_29_05_e","next":"d_main_29_06_e","speakers":{"shifty":"Shifty","elegg":"Elegg","trony_op_r":"Trony","rapi":"Rapi","anis":"Anis","drilley":"Drilley"},"icons":{"shifty":"si_c907_00_s","elegg":"si_c500_00_s","trony_op_r":"si_c501_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","drilley":"si_c491_00_s"},"lines":[{"id":"d_main_29_06_s_1","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_1","text":"I've performed a cursory examination.","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":"bgm_chapter29_field_drifting","movie":null,"shown":["shifty","anis","rapi","elegg","drilley"],"affinity":null},{"id":"d_main_29_06_s_2","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_2","text":"Other than a slight decrease in your core power, there are no major issues present.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_3","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_3","text":"Thanks, doc.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_4","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_4","text":"You're welcome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_5","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_5","text":"Our phones are basically bricks out here since we're outside the service area, but your operation device seems to be working just fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_6","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_6","text":"Likewise for Ms. Trony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_7","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_7","text":"The operation device has a direct connection to the exclusive facilities in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_8","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_8","text":"The coverage area is rather extensive, so we rarely encounter connection issues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_9","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_29_06_s_9","text":"Yeah, I am using it at Reclamation Site 01.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["trony_op_r"],"affinity":null},{"id":"d_main_29_06_s_10","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_10","text":"Unless we're somewhere way off in the boonies, distance typically isn't an issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_06_s_11","text":"It's a bit strange...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_12","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_12","text":"I understand what you mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_13","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_13","text":"It's a bit awkward saying this in front of the Commander,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_14","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_14","text":"but this is an exceedingly good equipment to give to an officer of his rank.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_15","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_15","text":"We have a past commander by the code name of New Hope to thank for this device. He roamed the surface and had many commendable exploits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_16","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_16","text":"This device was originally made for him, but because of its superior quality and next to no maintenance required,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_17","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_17","text":"we're still using it today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_06_s_18","text":"Thanks to my predecessor, huh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_19","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_19","text":"Huh? What did you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_06_s_20","text":"Never mind. It's nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_21","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_21","text":"Anyway, even though this equipment is of superior quality, we are still dealing with something that was made in the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_22","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_22","text":"Therefore, it does have a downside, which is that it is susceptible to Alva particles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_23","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_23","text":"The concentration of Alva particles can make a significant difference in the signal quality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_24","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_24","text":"Replacing it with a new model would have been expensive, so we simply left it as is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_25","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_25","text":"Technology created in the past has become something of a lost art, which makes it very difficult to utilize in some aspects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_26","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_26","text":"Areas with high Alva particle concentrations are classified as danger zones, so unless it is a special case, operations are not carried out in these areas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_06_s_27","text":"The Commander is prone to wandering about, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_28","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_28","text":"I've put in a request for commanders to have an operation device,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_29","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_06_s_29","text":"but there has been no progress on that front.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_30","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_30","text":"It would at least be nice if we could get outfitted with better phones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_31","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_06_s_31","text":"If our search gets prolonged, would it be more likely to be approved?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_06_s_32","text":"Particularly since the search area will only continue to be further away from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_33","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_33","text":"Makes sense to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_34","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_34","text":"Or at the very least, they could provide operation devices to us Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_35","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_06_s_35","text":"How was Hammering the last time you saw her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_36","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_36","text":"She wasn't doing too hot because of the crystal in her arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_37","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_06_s_37","text":"We have no idea how fast the crystal grows, so it's not looking too pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_38","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_06_s_38","text":"... Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_06_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_06_s_39","text":"Let's hurry to where you ran into the Unknown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}