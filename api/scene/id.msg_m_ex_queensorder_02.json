{"id":"msg_m_ex_queensorder_02","cat":"messenger","group":{"id":"room_counters","label":"Counters · Group"},"label":"15. Agh!","stage":null,"prev":"msg_m_ex_queensorder_01","next":"msg_m_ex_counters_06","speakers":{"anis":"Anis","neon":"Neon","rapi":"Rapi"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"msg_m_ex_queensorder_02_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 101710108 · After Counters chat 14. Commander","key":null},{"id":"m_ex_queensorder_02_1","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_1","text":"Agh!","jump":null},{"id":"m_ex_queensorder_02_2","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_2","text":"Dear Commander.","jump":null},{"id":"m_ex_queensorder_02_3","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_3","text":"Please responddddddddd","jump":null},{"id":"m_ex_queensorder_02_4","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_4","text":"Pleaseeeeeeee","jump":null},{"id":"m_ex_queensorder_02_5","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_5","text":"What are you two doing?","jump":null},{"id":"m_ex_queensorder_02_6","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_6","text":"We're putting out a signal.","jump":null},{"id":"m_ex_queensorder_02_7","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_7","text":"That way, Master will receive our messages no matter where he is.","jump":null},{"id":"m_ex_queensorder_02_8","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_8","text":"That's right. Doing this will help our messages go through easier.","jump":null},{"id":"m_ex_queensorder_02_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_9","text":"Respondinggggggggg","jump":"m_ex_queensorder_02_12"},{"id":"m_ex_queensorder_02_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_10","text":"I'm fine.","jump":"m_ex_queensorder_02_12"},{"id":"m_ex_queensorder_02_11","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_11","text":"What if I'm not in the mood? Do I still have to respond?","jump":"m_ex_queensorder_02_14"},{"id":"m_ex_queensorder_02_12","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_12","text":"Whoa!","jump":null},{"id":"m_ex_queensorder_02_13","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_13","text":"It worked!","jump":"m_ex_queensorder_02_16"},{"id":"m_ex_queensorder_02_14","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_14","text":"Absolutely. Even if you're in a bad mood, you should respond.","jump":null},{"id":"m_ex_queensorder_02_15","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_15","text":"Master!!!!!!","jump":"m_ex_queensorder_02_16"},{"id":"m_ex_queensorder_02_16","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_16","text":"The longer the signal, the better!","jump":null},{"id":"m_ex_queensorder_02_17","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_17","text":"Commander.","jump":null},{"id":"m_ex_queensorder_02_18","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_18","text":"You're not hurt, are you?","jump":null},{"id":"m_ex_queensorder_02_19","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_19","text":"You're not hiding any more gunshots or anything from us,","jump":null},{"id":"m_ex_queensorder_02_20","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_20","text":"are you?","jump":null},{"id":"m_ex_queensorder_02_21","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_21","text":"You weren't throwing yourself,","jump":null},{"id":"m_ex_queensorder_02_22","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_22","text":"broken, battered and bruised into enemy lines","jump":null},{"id":"m_ex_queensorder_02_23","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_23","text":"while screaming \"firepower\" at the top of your lungs,","jump":null},{"id":"m_ex_queensorder_02_24","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_24","text":"were you?","jump":null},{"id":"m_ex_queensorder_02_25","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_25","text":"On what planet would that possibly happen?","jump":null},{"id":"m_ex_queensorder_02_26","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_26","text":"You're gonna give him bad luck saying weird stuff like that.","jump":null},{"id":"m_ex_queensorder_02_27","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_27","text":"Hey!","jump":null},{"id":"m_ex_queensorder_02_28","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_28","text":"You never know...","jump":null},{"id":"m_ex_queensorder_02_29","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_29","text":"I could see it happening,","jump":null},{"id":"m_ex_queensorder_02_30","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_30","text":"especially if it was all a ruse cooked up by Master","jump":null},{"id":"m_ex_queensorder_02_31","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_31","text":"to deceive the enemy.","jump":null},{"id":"m_ex_queensorder_02_32","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_32","text":"He could pretend to have captured Rosanna and bring her to them.","jump":null},{"id":"m_ex_queensorder_02_33","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_33","text":"It's totally possible.","jump":null},{"id":"m_ex_queensorder_02_34","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_34","text":"He would never do something so reckless!","jump":null},{"id":"m_ex_queensorder_02_35","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_35","text":"...","jump":null},{"id":"m_ex_queensorder_02_36","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_36","text":"Right, Commander?","jump":null},{"id":"m_ex_queensorder_02_37","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_37","text":"So, please,","jump":null},{"id":"m_ex_queensorder_02_38","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_38","text":"try and keep a low profile during your time with Underworld Queen.","jump":null},{"id":"m_ex_queensorder_02_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_39","text":"Well, it's just that...","jump":null},{"id":"m_ex_queensorder_02_40","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_40","text":"Just that what?","jump":null},{"id":"m_ex_queensorder_02_41","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_41","text":"What is it?","jump":null},{"id":"m_ex_queensorder_02_42","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_42","text":"OMG! You DID scream out \"firepower\", didn't you?","jump":null},{"id":"m_ex_queensorder_02_43","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_43","text":"I knew it!","jump":null},{"id":"m_ex_queensorder_02_44","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_44","text":"Respect!!","jump":null},{"id":"m_ex_queensorder_02_45","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_45","text":"Respect my ass!","jump":null},{"id":"m_ex_queensorder_02_46","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_46","text":"If the Commander did something like that, he might as well hand himself to the enemy on a silver platter.","jump":null},{"id":"m_ex_queensorder_02_47","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_47","text":"Is everything okay, Commander?","jump":null},{"id":"m_ex_queensorder_02_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_48","text":"Everything's fine, don't worry.","jump":null},{"id":"m_ex_queensorder_02_49","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_49","text":"Well, that's a bit reassuring I suppose.","jump":null},{"id":"m_ex_queensorder_02_50","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_50","text":"As long as you're okay.","jump":null},{"id":"m_ex_queensorder_02_51","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_51","text":"It's a bit of a letdown though, since I really do like firepower...","jump":null},{"id":"m_ex_queensorder_02_52","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_52","text":"Are you insane? We should be happy the Commander isn't doing the ridiculous things you've described!","jump":null},{"id":"m_ex_queensorder_02_53","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_53","text":"Commander, you don't have to be a hero.","jump":null},{"id":"m_ex_queensorder_02_54","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_54","text":"Don't worry about me. Really.","jump":null},{"id":"m_ex_queensorder_02_55","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_55","text":"All right, all right.","jump":null},{"id":"m_ex_queensorder_02_56","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_56","text":"I trust you, Commander.","jump":null},{"id":"m_ex_queensorder_02_57","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_57","text":"If it's not too much to ask,","jump":null},{"id":"m_ex_queensorder_02_58","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_58","text":"just send us an update every once in a while, like you've done.","jump":null},{"id":"m_ex_queensorder_02_59","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_queensorder_02_59","text":"Yeah, otherwise we'll be worried sick.","jump":null},{"id":"m_ex_queensorder_02_60","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_60","text":"Right, Master.","jump":null},{"id":"m_ex_queensorder_02_61","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_queensorder_02_61","text":"We're all waiting for you to return to the Commander's Room.","jump":null},{"id":"m_ex_queensorder_02_62","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_queensorder_02_62","text":"I'll stay in touch.","jump":null},{"id":"m_ex_queensorder_02_63","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_queensorder_02_63","text":"Ok, we'll be waiting.","jump":null}],"chat":true}