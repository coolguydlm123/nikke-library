":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_e_39","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_01_e_39","text":"Through the tiny window in the practice room door, Mint and Prika watch Anis practice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_e_40","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_01_e_40","text":"I wish today had gone a little better since it was our first performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_e_41","type":"Speech","speaker":"prika","key":"Locale_MainScenario:event_staranis1_01_e_41","text":"The sound was off, and the stage setup left a lot to be desired, but what disappointed me most was our performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_e_42","type":"Speech","speaker":"prika","key":"Locale_MainScenario:event_staranis1_01_e_42","text":"Honestly, it was terrible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_e_43","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_01_e_43","text":"Hey, don't be so harsh. We'll do better next time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_e_44","type":"Speech","speaker":"prika","key":"Locale_MainScenario:event_staranis1_01_e_44","text":"When's the next one, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_e_4