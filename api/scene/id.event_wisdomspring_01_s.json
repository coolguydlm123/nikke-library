gArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_14","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_14","text":"It's a chance for us to enhance our firepower!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_15","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_15","text":"And an opportunity to use a cutting-edge weapon developed by M.M.R.!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_16","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_16","text":"Let's go right away!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_17","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_01_s_17","text":"Er... apparently, they're only making one. For me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_18","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_18","text":"What the...?! How come?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_19","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_19","text":"You're practically superhuman at this point!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_20","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_20","text":"What are you blathering about now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_21","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_21","text":"I'm simply saying that Master has ascended to the realm of a Divine Master, beyond human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_22","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_22","text":"Don't you ever feel that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_23","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_23","text":"there are times when Master doesn't feel human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_24","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_24","text":"I wish I could say otherwise, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_25","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_25","text":"there have been times when I thought the Commander recovered unusually fast from injuries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_26","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_wisdomspring_01_s_26","text":"You're right... but surely it's better than taking ages to recover from injuries?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_27","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_01_s_27","text":"I appreciate the compliment... I think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_28","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_28","text":"No problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_29","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_01_s_29","text":"Still, I don't think there will be any new weapons for you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_30","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_30","text":"Darn... that's a bummer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_31","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_31","text":"Still,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_32","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_32","text":"you getting one is better than nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_33","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_wisdomspring_01_s_33","text":"While I agree that this sounds like a wonderful development,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_34","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_wisdomspring_01_s_34","text":"it does all feel rather sudden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_35","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_35","text":"That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_36","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_36","text":"Plus, we are talking about the M.M.R. research lab. There are all sorts of unsavory rumors about that place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_37","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_37","text":"Hmm... should I check in with some other squads","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_38","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_38","text":"and see if they've heard anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_39","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_01_s_39","text":"No. Mana was the one who got in touch with me, so everything should be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_40","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_40","text":"Fair point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_41","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_41","text":"It's not like Mana to lie about something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_42","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_01_s_42","text":"We owe Mana a lot for all her help so far, so I'll go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_43","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_wisdomspring_01_s_43","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_44","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_44","text":"Master!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_45","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_wisdomspring_01_s_45","text":"If you encounter a solid weapon meant for us Nikkes while you're at it, could you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_01_s_46","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_wisdomspring_01_s_46","text":"You idiot, what is the chance of that happening?","jump":null,"exit":false,"enter