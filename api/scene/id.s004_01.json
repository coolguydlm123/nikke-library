,"shown":null,"affinity":null},{"id":"s004_01_29","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_01_29","text":"And Dorothy went there just to watch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_01_30","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_01_30","text":"Please. Don't be absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_01_31","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_01_31","text":"Why not? Dorothy despises the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_01_32","type":"Speech","speaker":"noah","key":"Locale_SideStory:s004_01_32","text":"Bet she'd love to watch it crash and burn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_01_33","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_01_33","text":"She's not one to act on such simple impulses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_01_34","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_01_34","text":"... Her true goal is likely...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_01_35","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_01_35","text":"What? What's all this about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["papillon"],"affinity":null},{"id":"s004_01_36","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_01_36","text":"Dorothy's gone AWOL and there