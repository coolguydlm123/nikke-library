{"id":"d_counseling_hongryeon_goddeath_17","cat":"counsel","group":{"id":"char5186","label":"Scarlet: Goddeath"},"label":"Advising Scarlet: Goddeath: 17","stage":null,"prev":"d_counseling_hongryeon_goddeath_16","next":"d_counseling_hongryeon_goddeath_18","speakers":{"hongryeon_g":"Scarlet"},"icons":{"hongryeon_g":"si_c472_00_s"},"lines":[{"id":"d_counseling_hongryeon_goddeath_17_1","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_1","text":"If thou wert to see one who could find no place among the others, and was thus cast aside,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon_g"],"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_2","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_2","text":"what wouldst thou do, my Lord?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_3","text":"I'd help them feel included.","jump":"d_counseling_hongryeon_goddeath_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_goddeath_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_4","text":"I'd wait until they join in on their own.","jump":"d_counseling_hongryeon_goddeath_17_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_goddeath_17_5","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_5","text":"Indeed, such is the duty of one already counted amongst the company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_6","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_6","text":"Mayhap their disposition keepeth them from drawing nigh unto the others, thou knowest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_7","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_8","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_8","text":"I daresay it is thy warmth of heart that hath endeared thee to all.","jump":"d_counseling_hongryeon_goddeath_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_9","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_9","text":"... That may be one approach,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_10","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_10","text":"yet mayhap that soul hath simply not found their place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_11","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_11","text":"In such a case, methinks it best that one who hath already found their place should extend a hand first.","jump":"d_counseling_hongryeon_goddeath_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_17_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_17_12","text":"Scarlet and I ponder how to reach out first.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}