null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_68","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_68","text":"Hmm? What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_69","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_69","text":"Are you not feeling well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_70","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_70","text":"... I don't like them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_71","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_71","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_72","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_72","text":"I don't like a single one of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_kneeldownfools","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_73","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_73","text":"How is it that not one of them came purely because they want to be a hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_74","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_74","text":"Haha, no one like that exists in this day and age.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_75","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_75","text":"This is real life, not some superhero movie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_76","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_76","text":"Maybe back in the old days, when Raptures were slaughtering us up on the surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_77","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_77","text":"but there's not a single person in the Ark who doesn't know how a Nikke is made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_78","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_78","text":"We're in an era where everyone becomes a Nikke out of personal necessity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_79","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_79","text":"And on top of that, this is research into a new direction for Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_80","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_80","text":"It's pretty obvious how grueling it's going to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_81","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_81","text":"So people are either here chasing money or fame,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_82","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_82","text":"or they're dragged in here for someone else's benefit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_83","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_83","text":"So it's only going to be more of the same type of people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_84","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_84","text":"Well... there might be a diamond in the rough, but yeah, the vast majority will be the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_85","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_86","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_06_s_86","text":"Syuen rises from her seat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_87","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_87","text":"What? Why are you getting up? We've still got some interviews left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_88","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_88","text":"I'm leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_89","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_89","text":"You want to leave now? But we're not finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_90","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_90","text":"I don't care. I've got a headache. You pick them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_91","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_91","text":"But you're the one in charge. How am I supposed to do this without you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_92","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_06_s_92","text":"You said they're all the same anyway. Just pick whoever you like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_93","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_06_s_93","text":"Wait... Syuen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_06_s_94","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_06_s_94","text":"Syuen walks out of the interview room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}