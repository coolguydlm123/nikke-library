{"id":"d_nikke_helm_01","cat":"bond","group":{"id":"char5066","label":"Helm"},"label":"Boat Party","stage":null,"prev":null,"next":"d_nikke_helm_02","speakers":{"andersen":"Andersen","colorfulvip":"Extravagant Guest","burningum":"Burningum","solemnofficer":"Stern Officer","helm":"Helm","mast":"Mast","anchor":"Anchor"},"icons":{"andersen":"si_c903_00_s","colorfulvip":"si_c999_00_s","burningum":"si_c914_00_s","solemnofficer":"si_c999_00_s","helm":"si_c352_00_s","mast":"si_c350_00_s","anchor":"si_c351_00_s"},"lines":[{"id":"d_nikke_helm_01_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_1","text":"The lavish venue is filled with guests.","jump":null,"exit":false,"enter":null,"bg":"Restaurant","bgArt":"restaurant","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_2","text":"Men and women dressed in their finest mingle among the crowd, alongside soldiers proudly displaying their military decorations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_4","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_4","text":"Is this your first time at a reception like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["andersen"],"affinity":null},{"id":"d_nikke_helm_01_5","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_5","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_6","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_6","text":"You'd do well to get used to it. In times like these, there's more to being a soldier than fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_7","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_7","text":"I thought you'd find this at least somewhat enjoyable. What a shame. Had I known you'd react this way, I would have given the invitation to someone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_8","text":"I'm just not used to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_9","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_9","text":"I see. Well then, by all means, enjoy yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_10","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_10","text":"There's plenty of fine food and distinguished company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_11","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_11","text":"You might find it worthwhile to get acquainted with a few of the guests.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_12","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_12","text":"I'm not interested in socializing.","jump":"d_nikke_helm_01_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_13","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_13","text":"I'll give it a shot if I get the chance.","jump":"d_nikke_helm_01_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_14","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_14","text":"I thought as much. It was only a suggestion, so think nothing of it.","jump":"d_nikke_helm_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_15","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_15","text":"Well, that's interesting. I didn't take you for someone who'd be interested in that.","jump":"d_nikke_helm_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_16","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_16","text":"Well, I'd best be going. I have a meeting to attend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_17","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_17","text":"Andersen leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_18","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_18","text":"... I'm alone now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_19","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_19","text":"Just then, a murmur ripples through the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_20","type":"Speech","speaker":"colorfulvip","key":"Locale_NikkeEpisode:d_nikke_helm_01_20","text":"Oh! It looks like it's about to start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_21","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_21","text":"S-sorry to keep you waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["burningum"],"affinity":null},{"id":"d_nikke_helm_01_22","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_22","text":"Welcome, distinguished guests. Thank you all for coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_23","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_23","text":"I'm Burningum, y-your host for today's party aboard the Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_24","type":"Speech","speaker":"solemnofficer","key":"Locale_NikkeEpisode:d_nikke_helm_01_24","text":"Deputy Chief Burningum? No wonder this party is so grand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_25","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_25","text":"H-Helm, could you tell everyone a little about the Admire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_26","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_26","text":"Of course, sir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["helm"],"affinity":null},{"id":"d_nikke_helm_01_27","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_27","text":"The hall you're standing in is aboard the Admire,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_b","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_28","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_28","text":"the battleship operated by the Aegis Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_29","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_29","text":"Built specifically to combat Raptures,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_30","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_30","text":"the Admire is capable of taking on dozens of Tyrant-class Raptures single-handedly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_31","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_31","text":"What's more, her stability is remarkable, almost making it hard to believe she's afloat at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_32","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_32","text":"She is an invincible battleship, impervious to any attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_33","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_33","text":"At sea, the Aegis Squad and the Admire are an unstoppable force. I trust you'll remember that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_34","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_34","text":"So please, everyone, rest assured and enjoy the party.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_35","type":"Speech","speaker":"colorfulvip","key":"Locale_NikkeEpisode:d_nikke_helm_01_35","text":"But the Ark doesn't even have an ocean. What's the point of having such a big ship?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_36","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_36","text":"We intend to reclaim the surface, no matter what it takes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_37","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_37","text":"When that day comes, the Admire will rule the seas above.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_38","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_38","text":"I hope you'll see this as an investment in our preparations for that day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_39","type":"Speech","speaker":"colorfulvip","key":"Locale_NikkeEpisode:d_nikke_helm_01_39","text":"Well, that's certainly reassuring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_40","type":"Speech","speaker":"solemnofficer","key":"Locale_NikkeEpisode:d_nikke_helm_01_40","text":"Hahaha, that's certainly reassuring. Though I'd feel a lot more at ease if we were out at sea rather than in a swimming pool...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_41","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_42","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_42","text":"G-good work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_43","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_43","text":"It was nothing, sir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_44","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_44","text":"Now, now, everyone heard that, right? The Admire is perfectly safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_45","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_45","text":"So please, relax and enjoy the party.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_46","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_46","text":"*Clap, clap, clap, clap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_47","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_47","text":"A smattering of halfhearted applause fills the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_48","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_48","text":"The party soon gets underway in earnest,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_49","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_49","text":"but unable to fit in with the crowd, I decide to step outside for some fresh air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_50","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_50","text":"...","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":null,"movie":null,"shown":["helm"],"affinity":null},{"id":"d_nikke_helm_01_51","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_51","text":"*Sigh...*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_52","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_52","text":"Helm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_53","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_53","text":"... {AccountData.NickName}?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_54","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_54","text":"What are you doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_55","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_55","text":"I was invited.","jump":"d_nikke_helm_01_57","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_56","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_56","text":"I came to see you.","jump":"d_nikke_helm_01_60","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_57","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_57","text":"Oh, I see. So you have connections with the CEOs and Deputy Chief Andersen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_58","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_58","text":"Still, I'm surprised. I didn't know you were interested in this sort of thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_59","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_