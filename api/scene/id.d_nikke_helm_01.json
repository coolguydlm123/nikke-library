":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_66","text":"... I'm not sure what you made of it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_67","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_67","text":"but it was something that had to be done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_68","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_68","text":"I'd appreciate it if you refrained from making sarcastic remarks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_69","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_69","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_70","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_70","text":"The party should be wrapping up soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_71","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_71","text":"If you have some time to spare, I'd appreciate your help with the cleanup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_72","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_72","text":"Once everyone has left, the hall is a mess.","jump":null,"exit":false,"enter":null,"bg":"Restaurant","bgArt":"restaurant","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_7