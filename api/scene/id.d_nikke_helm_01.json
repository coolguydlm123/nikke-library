{"id":"d_nikke_helm_01","cat":"bond","group":{"id":"char5066","label":"Helm"},"label":"Boat Party","stage":null,"prev":null,"next":"d_nikke_helm_02","speakers":{"andersen":"Andersen","colorfulvip":"Extravagant Guest","burningum":"Burningum","solemnofficer":"Stern Officer","helm":"Helm","mast":"Mast","anchor":"Anchor"},"icons":{"andersen":"si_c903_00_s","colorfulvip":"si_c999_00_s","burningum":"si_c914_00_s","solemnofficer":"si_c999_00_s","helm":"si_c352_00_s","mast":"si_c350_00_s","anchor":"si_c351_00_s"},"lines":[{"id":"d_nikke_helm_01_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_1","text":"A sea of people move about inside the luxurious restaurant.","jump":null,"exit":false,"enter":null,"bg":"Restaurant","bgArt":"restaurant","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_2","text":"Many of the partygoers are dressed to the nines, including soldiers proudly displaying their military medals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_4","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_4","text":"First time attending this kind of event?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["andersen"],"affinity":null},{"id":"d_nikke_helm_01_5","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_5","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_6","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_6","text":"Getting used to it will do you some good. In this day and age, fighting isn't the only thing soldiers are meant to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_7","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_7","text":"I thought you would at least get some kind of a kick out of this. If I'd known this is how you'd react, I'd have given the invitation to someone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_8","text":"It's just that I'm not used to this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_9","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_9","text":"Don't worry, just relax and enjoy yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_10","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_10","text":"There's plenty of good food and nice people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_11","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_11","text":"If I were you, I'd consider trying to network.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_12","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_12","text":"I'm not interested in socializing.","jump":"d_nikke_helm_01_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_13","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_13","text":"If the opportunity presents itself.","jump":"d_nikke_helm_01_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_14","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_14","text":"I thought so.\nIt was just a suggestion, so don't worry about it.","jump":"d_nikke_helm_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_15","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_15","text":"Interesting, I figured you wouldn't have any interest in fraternizing with these people.","jump":"d_nikke_helm_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_16","type":"Speech","speaker":"andersen","key":"Locale_NikkeEpisode:d_nikke_helm_01_16","text":"At any rate, I have to get going. I've got a meeting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_17","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_17","text":"Andersen takes his leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_18","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_18","text":"It's just me now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_19","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_19","text":"Just then, a loud murmuring can be heard from the other end of the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_20","type":"Speech","speaker":"colorfulvip","key":"Locale_NikkeEpisode:d_nikke_helm_01_20","text":"Oh my. I think it's starting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_21","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_21","text":"Sorry to keep everyone waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["burningum"],"affinity":null},{"id":"d_nikke_helm_01_22","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_22","text":"Thank you all for coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_23","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_23","text":"My name's Burningum, and I arranged the festivities here today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_24","type":"Speech","speaker":"solemnofficer","key":"Locale_NikkeEpisode:d_nikke_helm_01_24","text":"Deputy Chief Burningum? No wonder this is such a big shindig.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_25","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_25","text":"Helm, would you care to tell everyone about the Admire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_26","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_26","text":"Of course, sir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["helm"],"affinity":null},{"id":"d_nikke_helm_01_27","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_27","text":"The ship you all are standing on is a battleship operated by Aegis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_b","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_28","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_28","text":"It is known as the Admire, and we are currently in the hall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_29","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_29","text":"The Admire was designed for engagements with Raptures,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_30","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_30","text":"and thus is capable of going up solo against dozens of Tyrant-class Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_31","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_31","text":"Its stabilization system is top-of-the-line as well, so there's no need to worry about motion sickness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_32","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_32","text":"It is the finest battleship out there, and is nearly invulnerable against any form of attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_33","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_33","text":"When out on the high seas, Aegis and the Admire are practically invincible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_34","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_34","text":"So please everyone, sit back, relax, and enjoy the party.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_35","type":"Speech","speaker":"colorfulvip","key":"Locale_NikkeEpisode:d_nikke_helm_01_35","text":"But there aren't any oceans in the Ark. Why do you need such a big boat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_36","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_36","text":"We intend to reclaim the surface, no matter what it takes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_37","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_37","text":"When that time comes, the Admire will rule the seas above.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_38","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_38","text":"We would appreciate it if you could consider all of this preparation for that day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_39","type":"Speech","speaker":"colorfulvip","key":"Locale_NikkeEpisode:d_nikke_helm_01_39","text":"I'm so relieved to hear that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_40","type":"Speech","speaker":"solemnofficer","key":"Locale_NikkeEpisode:d_nikke_helm_01_40","text":"Indeed. However, I'd feel better if the ship were actually in the ocean instead of a water tank...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_41","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_42","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_42","text":"Well done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_43","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_43","text":"No problem, sir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_44","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_44","text":"Did everyone hear that?\nThe Admire is safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_45","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_01_45","text":"Please relax, and enjoy yourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_46","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_46","text":"*Clap clap clap clap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_47","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_47","text":"There is the sound of polite clapping, keeping in line with the decorum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_48","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_48","text":"Afterward, the party was officially underway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_49","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_49","text":"Being someone who didn't quite fit in, I decided to go get some fresh air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_50","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_50","text":"...","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":null,"movie":null,"shown":["helm"],"affinity":null},{"id":"d_nikke_helm_01_51","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_01_51","text":"Sigh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_01_52","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_01_52","t