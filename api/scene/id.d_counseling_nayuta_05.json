{"id":"d_counseling_nayuta_05","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 05","stage":null,"prev":"d_counseling_nayuta_04","next":"d_counseling_nayuta_06","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_05_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_1","text":"Verily, White Snow consumeth all things, doth she not?","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_05_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_2","text":"Oft do I ponder if aught there be which she would not utterly devour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_05_3","text":"There's gotta be at least one thing she doesn't eat, right?","jump":"d_counseling_nayuta_05_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_05_4","text":"If she really wanted to, she could probably eat just about anything.","jump":"d_counseling_nayuta_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_05_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_5","text":"Hmm... Pray tell,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_6","text":"what thinkest thou it to be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_7","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_05_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_9","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_05_9","text":"Er... Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_10","text":"Ha! Verily, thou dost possess a most keen sense of humor, Great Hero.","jump":"d_counseling_nayuta_05_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_11","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_11","text":"In this matter,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_12","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_12","text":"thou and I are of one mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_13","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_13","text":"The mingling of centipedes and earthworms... 'Twas a spectacle most strange to mine eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_14","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_14","text":"At the first, I was sore amazed;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_15","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_05_15","text":"yet anon, I have grown accustomed thereto.","jump":"d_counseling_nayuta_05_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_05_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_05_16","text":"We talk about Snow White's peculiar taste in food.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}