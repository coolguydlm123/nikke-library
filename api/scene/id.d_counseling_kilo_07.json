{"id":"d_counseling_kilo_07","cat":"counsel","group":{"id":"char5053","label":"Kilo"},"label":"Advising Kilo: 07","stage":null,"prev":"d_counseling_kilo_06","next":"d_counseling_kilo_08","speakers":{"kilo":"Kilo"},"icons":{"kilo":"si_c977_00_s"},"lines":[{"id":"d_counseling_kilo_07_1","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_1","text":"An old colleague I used to work with was saying how she finds it annoying to address T.A.L.O.S. and me separately.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["kilo","talos"],"affinity":"_0"},{"id":"d_counseling_kilo_07_2","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_2","text":"She even suggested collectively referring to us as Kilos to make it easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_3","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_3","text":"I don't know why, but that makes me feel kinda weird...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_kilo_07_4","text":"You are both your own individual people.","jump":"d_counseling_kilo_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_kilo_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_kilo_07_5","text":"Kilos, huh? Has a nice ring to it.","jump":"d_counseling_kilo_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_kilo_07_6","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_6","text":"... Ah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_7","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_7","text":"Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_8","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_8","text":"You're the best, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_9","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_9","text":"That's exactly what I wanted to hear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_10","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_10","text":"Thank you.","jump":"d_counseling_kilo_07_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_11","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_11","text":"Wha... you think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_12","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_12","text":"I wasn't saying there was anything inherently wrong with the name.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_07_13","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_07_13","text"