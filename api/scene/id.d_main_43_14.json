ity":null},{"id":"d_main_43_14_22","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_43_14_22","text":"Understood. It's common to lose your memory when becoming a Nikke. Don't stress over it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_14_23","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_43_14_23","text":"Some memories return with time, so we'll just wait and see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_14_24","type":"Speech","speaker":"unknown","key":"Locale_MainScenario:d_main_43_14_24","text":"I see. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_14_25","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_43_14_25","text":"Now, about those glasses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_14_26","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_43_14_26","text":"There's a good chance they contain some sort of unknown technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_14_27","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_43_14_27","text":"I'd like to run a few tests on them, if you're willing to cooperate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_14_28","type":"Speech","speaker":"unknown","key":"Locale_MainScenario:d_main_43_14_28","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"sh