{"id":"event_unbreakablesphere2_01_s","cat":"event","group":{"id":"ev40076","label":"UNBREAKABLE SPHERE · Part 2"},"label":"To the Surface: A","stage":null,"prev":null,"next":"event_unbreakablesphere2_01_e","speakers":{"littlemermaid":"Little Mermaid","mori":"Mori","mana":"Mana"},"icons":{"littlemermaid":"si_c513_00_s","mori":"si_c590_00_s","mana":"si_c290_00_s"},"lines":[{"id":"event_unbreakablesphere2_01_s_1","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_1","text":"I remember when I first opened my eyes and found myself here.","jump":null,"exit":false,"enter":null,"bg":"DeepWater_02","bgArt":"deepwater_02","image":null,"bgm":"event_bgm_ubsphere_blackspace","movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_2","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_2","text":"An infinite black void.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_3","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_3","text":"All that stared back at me was cold seawater and endless bits and bobs from the surface which Gluttony had swallowed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_4","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_4","text":"as well as a red core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_5","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_5","text":"At first, I used my abilities to try every possible method of escape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_6","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_6","text":"I tried shooting bubbles at the core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_7","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_7","text":"I tried using my Kotodama.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_8","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_8","text":"None of it worked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_9","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_9","text":"Gluttony was different than ordinary Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_10","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_10","text":"It was moving by primal instinct alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_11","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_11","text":"The result was that my Kotodama had no effect on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_12","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_12","text":"Gluttony seemed to prioritize its urge to consume above all other instincts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_13","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_13","text":"When I'd exhausted all possible means of escape,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_14","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_14","text":"I started to become afraid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_15","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_15","text":"Was I going to die in this place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_16","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_16","text":"Once I was digested, what kind of attack would Gluttony unleash on the outside world?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_17","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_17","text":"What would happen if Gluttony found out about the nature of my bubbles?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_18","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_18","text":"Was I doomed to fail once again, without achieving anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_19","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_19","text":"It was at that moment that I remembered a promise I'd once made to a few friends.","jump":null,"exit":false,"enter":null,"bg":"SpaceElevator","bgArt":"spaceelevator","image":null,"bgm":null,"movie":null,"shown":["cinderella"],"affinity":null},{"id":"event_unbreakablesphere2_01_s_20","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_20","text":"She told me that from now on, our story was no longer one of failure, but a fairy tale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_21","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_21","text":"One with a happy ending.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_22","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_22","text":"I became determined not to give up.","jump":null,"exit":false,"enter":null,"bg":"TreeOfWater","bgArt":"treeofwater","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_23","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_23","text":"My friends were surely out there trying their best in order to keep that promise too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_24","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_24","text":"I couldn't give up. I had to struggle with all my might.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_25","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_25","text":"In order to keep myself alive, I had to create more bubbles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_26","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_26","text":"I expanded the protective bubble around myself in order not to be detected by Gluttony's core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_27","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_27","text":"I gathered surrounding remnants from the surface and created a space where I could live.","jump":null,"exit":false,"enter":null,"bg":"RestArea","bgArt":"restarea","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_28","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_28","text":"I crafted a tree out of bubbles, fabricated a bubble workshop,","jump":null,"exit":false,"enter":null,"bg":"BubbleMaker","bgArt":"bubblemaker","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_29","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_29","text":"and built all the places where I lived with you guys.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_30","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_30","text":"I also made dolls that resembled my friends","jump":null,"exit":false,"enter":null,"bg":"EventScene_unbreakablesphere_04","bgArt":"eventscene_unbreakablesphere_04","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_31","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_31","text":"and launched them up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_32","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_32","text":"I hoped that someday, perhaps my friends would encounter these doppelgangers","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_33","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_33","text":"and come looking for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_34","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_34","text":"I continued making the bubbles and launching them up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_35","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_35","text":"Again and again, I did this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_36","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_36","text":"I waited for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_37","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_37","text":"At times, the loneliness was excruciating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_38","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_38","text":"I considered giving up more than once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_39","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_39","text":"But even in the deepest depths of my despair, my longing to see my friends trumped all else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_40","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_40","text":"I wanted to uphold the promise I made on that day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_41","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_41","text":"And so I strengthened my resolve countless times, and pushed on.","jump":null,"exit":false,"enter":null,"bg":"TreeOfWater","bgArt":"treeofwater","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_42","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_42","text":"Then you guys came, swallowed whole by Gluttony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["yuni_n","mihara_b","mori"],"affinity":null},{"id":"event_unbreakablesphere2_01_s_43","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_43","text":"I was terribly worried for you all,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_44","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_44","text":"but paradoxically, I was also ecstatic to finally have company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["littlemermaid"],"affinity":null},{"id":"event_unbreakablesphere2_01_s_45","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_45","text":"During my time alone, I had learned how to control my Kotodama,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_46","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_46","text":"and being able to talk, laugh, and live with you all filled me with ineffable joy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_47","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_47","text":"That's how much you all mean to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_48","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_48","text":"Your presence here was a gift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_49","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_49","text":"I'm so glad I was able to meet you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_50","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_50","text":"... I'm not afraid of the end anymore.","jump":null,"exit":false,"enter":null,"bg":"TreeOfWater_r","bgArt":"treeofwater_r","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_51","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_51","text":"I'm no longer scared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere2_01_s_52","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere2_01_s_52","text":"I'm no longer lonely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreaka