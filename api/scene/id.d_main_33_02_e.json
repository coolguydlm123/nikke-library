kke you were.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_e_58","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_33_02_e_58","text":"But one thing is certain. You are our predecessor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_e_59","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_33_02_e_59","text":"Consider this a small token of my appreciation for you laying the scientific foundation which has allowed us Nikkes, and humanity, to advance to where we are today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_e_60","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_33_02_e_60","text":"It's the least I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_e_61","type":"Speech","speaker":"grave_no","key":"Locale_MainScenario:d_main_33_02_e_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_e_62","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_33_02_e_62","text":"Are you crying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_e_63","type":"Speech","speaker":"grave_no","key":"Locale_MainScenario:d_main_33_02_e_63","text":"No. I don't cry anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_e_64","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_33_02_e_64","text"