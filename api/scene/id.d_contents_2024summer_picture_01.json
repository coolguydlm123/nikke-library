{"id":"d_contents_2024summer_picture_01","cat":"event","group":{"id":"ev81401","label":"BEAUTY FULL SHOT"},"label":"Coral Island Adventure!","stage":null,"prev":null,"next":"d_contents_2024summer_fishing_01","speakers":{"neon_s":"Neon","rapi_s":"Rapi","anis_s":"Anis","mary_s":"Mary","viper_s":"Viper"},"icons":{"neon_s":"si_c014_00_s","rapi_s":"si_c010_02_s","anis_s":"si_c015_00_s","mary_s":"si_c132_00_s","viper_s":"si_c112_02_s"},"lines":[{"id":"d_contents_2024summer_picture_01_1","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_1","text":"So, let me get this straight.","jump":null,"exit":false,"enter":null,"bg":"CoralIslandInside_d","bgArt":"coralislandinside_d","image":null,"bgm":"event_bgm_beautyfullshot_seasidedance","movie":null,"shown":["neon_s","rapi_s","anis_s","mary_s"],"affinity":null},{"id":"d_contents_2024summer_picture_01_2","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_2","text":"You, Anis, Mary, and I are in charge of exploring this island, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_3","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_3","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_4","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_4","text":"So you're telling me while everyone else is having fun at the beach, we've got to go on a reconnaissance mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_5","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_5","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_6","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_6","text":"When everyone else is having the time of their lives, we've gotta schlep all over this island?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_7","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_8","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_8","text":"This is so unfair!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_9","type":"Speech","speaker":"anis_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_9","text":"Yeah, totally unfair!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_10","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_10","text":"We'll explore lightly, so there'll be plenty of free time during our exploration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_11","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_11","text":"But we can't head back without conducting any research.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_12","type":"Speech","speaker":"anis_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_12","text":"Ugh... I get where you're coming from, but that doesn't make this suck any less.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_13","type":"Speech","speaker":"mary_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_13","text":"Hehe. I understand how you feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_14","type":"Speech","speaker":"mary_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_14","text":"But wouldn't it be better for there to be many Ark candidates if things were to get nasty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_15","type":"Speech","speaker":"mary_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_15","text":"So, put our hearts into exploring the island and then take it easy together afterward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_16","type":"Speech","speaker":"anis_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_16","text":"... Fine. It's not like we have a choice, anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_17","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_17","text":"What exactly do we have to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_18","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_18","text":"We will wander around the island and jot down what we see,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_19","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_19","text":"such as unique flora and fauna, topographical features, and other things of that nature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_20","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_20","text":"We simply have to record as much as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_21","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_21","text":"Looks like it's time to unveil my hidden talent for drawing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_22","type":"Speech","speaker":"anis_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_22","text":"We can just take photos, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_23","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_23","text":"One shouldn't rely too much on technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_24","type":"Speech","speaker":"anis_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_24","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_25","type":"Speech","speaker":"viper_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_25","text":"Hey, could I ask you guys for a favor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["viper_s"],"affinity":null},{"id":"d_contents_2024summer_picture_01_26","type":"Speech","speaker":"rapi_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_26","text":"... What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_27","type":"Speech","speaker":"viper_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_27","text":"I love taking pictures,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_28","type":"Speech","speaker":"viper_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_28","text":"but it'd be kinda tough scouring the entire island for a good photo spot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_2024summer_picture_01_29","type":"Speech","speaker":"viper_s","key":"Locale_SubScenario:d_contents_2024summer_picture_01_29","text":"Can you mark any nice spots you come across","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"