{"id":"d_counseling_diesel_14","cat":"counsel","group":{"id":"char5020","label":"Diesel"},"label":"Advising Diesel: 14","stage":null,"prev":"d_counseling_diesel_13","next":"d_counseling_diesel_15","speakers":{"diesel":"Diesel"},"icons":{"diesel":"si_c072_00_s"},"lines":[{"id":"d_counseling_diesel_14_1","type":"Speech","speaker":"diesel","key":"Locale_Counseling:d_counseling_diesel_14_1","text":"Brid is always pounding down coffee while she's working... I'm actually a little worried.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["diesel"],"affinity":"_0"},{"id":"d_counseling_diesel_14_2","type":"Speech","speaker":"diesel","key":"Locale_Counseling:d_counseling_diesel_14_2","text":"Is there anything else I could get her to drink instead of coffee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_diesel_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_diesel_14_3","text":"Make her a sweet strawberry latte.","jump":"d_counseling_diesel_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_diesel_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_diesel_14_4","text":"Why change it? Nothing beats a good cup of joe while you're working.","jump":"d_counseling_diesel_14_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_diesel_14_5","type":"Speech","speaker":"diesel","key":"Locale_Counseling:d_counseling_diesel_14_5","text":"Sounds delicious! My mouth's watering just thinking about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_diesel_14_6","type