finity":null},{"id":"event_oldtales2_02_s_5","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_oldtales2_02_s_5","text":"That's rich coming from someone parading themselves around in a dress, prattling on about how they're a Goddess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_oldtales2_02_s_6","text":"Who in the world are you talking about? I know it's not me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_7","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_oldtales2_02_s_7","text":"Please, forgive her for her impropriety. I apologize on behalf of my colleague.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_8","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_oldtales2_02_s_8","text":"Yeah, you go ahead and apologize. Because I won't be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_oldtales2_02_s_9","text":"Keep on waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_10","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_oldtales2_02_s_10","text":"... I rescind my apology. You deserve one directly from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_11","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_s_11","text":"Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_12","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_oldtales2_02_s_12","text":"You said you were Cinderella, right? I have a lot of questions about Glass Slippers, can I take a look at it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_13","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_oldtales2_02_s_13","text":"If at all possible, I'd love to tinker with it and take it apart...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_14","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_oldtales2_02_s_14","text":"Oh my goodness! Talking about undressing on the first meeting? That's rather bold of you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_15","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_oldtales2_02_s_15","text":"It's important to keep in mind where you're undressing as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_16","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_oldtales2_02_s_16","text":"... Anyway. I'd be quite interested in having a look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_s_17","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_ol