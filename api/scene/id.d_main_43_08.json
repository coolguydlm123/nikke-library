{"id":"d_main_43_08","cat":"main","group":{"id":"ch43","label":"Chapter 43 · Key"},"label":"The Changing","stage":"43-22 STAGE · Start","prev":"d_main_43_07","next":"d_main_43_09","speakers":{"freerat":"Free Rat","stall3rd":"Stall III","princess":"Princess"},"icons":{"freerat":"si_c999_00_s","stall3rd":"si_c9019_00_s","princess":"si_c9018_00_s"},"lines":[{"id":"d_main_43_08_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_08_1","text":"A few months later...","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_chapter43_field_password","movie":null,"shown":["stall3rd","princess"],"affinity":null},{"id":"d_main_43_08_2","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_2","text":"I'm telling you, she's insanely good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_3","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_3","text":"She's got zero physical strength, but she's a beast when it comes to hacking and data manipulation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_4","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_4","text":"Better than even some of those big-shot adults out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_5","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_5","text":"Wow, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_6","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_6","text":"Yeah, her going rate has skyrocketed. Everyone's tripping over themselves trying to recruit her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_7","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_7","text":"That's amazing. I'm proud of you, Princess. *Cough, cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_8","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_8","text":"I merely imparted some knowledge to those fools.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_9","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_9","text":"It's too bad, really. If she'd just shut her mouth, she'd be perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_10","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_10","text":"I guess whatever god created us really does have a sense of humor, heh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_11","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_11","text":"Don't speak so lightly of a deity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_12","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_12","text":"Hey, when're you gonna spend money on me? You owe me, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_13","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_13","text":"Why do I owe you anything? You mean from when you showed up, insulted me and beat me half to death?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_14","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_14","text":"Come on. You know you deserved it back then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_15","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_15","text":"You really did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_16","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_16","text":"... Stop trying to mooch off me. I don't have the money for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_17","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_17","text":"What are you saving all that cash for, anyway? You've probably got a decent amount saved up by now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_18","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_18","text":"None of your business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_19","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_19","text":"What a cheapskate... Fine, then. Enjoy your riches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_20","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_20","text":"Are you at least keeping it all somewhere safe? One little slip and you could get cleaned out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_21","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_21","text":"Big Madam is holding onto it, so it shouldn't be an issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_22","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_22","text":"Ooh! *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_23","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_23","text":"You really have become an Outer Rim citizen through and through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_24","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_24","text":"Enough... Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_25","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_25","text":"Marcus has some discounts at his shop today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_26","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_26","text":"Someone's done her homework. Today's actually this month's barter day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_27","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_27","text":"You know all that junk I told you to pick up while working? Bring it with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_28","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_28","text":"You might score some Nutrium if you're lucky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_29","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_29","text":"Nutrium?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_30","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_30","text":"You know, the stuff Big Madam gave you a while back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_31","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_32","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_32","text":"Calling that Nutrium would be an insult to the real thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_33","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_33","text":"Funny, I seem to remember you scarfing it down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_34","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_35","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_35","text":"Hehe. Let's go. If we're late, there'll be nothing left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_36","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_36","text":"I've been saving up bullets just for today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_37","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_37","text":"I've been meaning to ask you about that. Why're you so obsessed with bullets?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_38","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_38","text":"When they go off, the flash lets you see everything around you. That's why I like them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_39","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_39","text":"It's a different feeling from fire or regular lamps. There's this flash and everything suddenly gets all bright. It's exciting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_40","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_08_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_41","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_41","text":"The greater the firepower, the brighter the flash,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_42","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_42","text":"and in that moment, it's like the whole world lights up. It's the best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_43","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_43","text":"I love it when the darkness transforms into light, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_08_44","text":"A few months later...","jump":null,"exit":false,"enter":null,"bg":"UndergroundTunnel","bgArt":"undergroundtunnel","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_45","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_45","text":"Ugh! People make mistakes. She doesn't have to keep nagging me all day...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_46","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_46","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_inark","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_47","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_47","text":"Is that you, Princess? You're back early.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_48","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_48","text":"Huh...? Yeah, didn't you see me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_49","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_49","text":"How was your day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_50","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_50","text":"Even more miserable than usual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_51","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_51","text":"Free Rat talks a lot for someone with no skill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_52","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_52","text":"But what about... *Cough, cough* Ahem! *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_53","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_53","text":"... Will your cough never get better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_54","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_54","text":"No. *Cough* They say it... *cough* won't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_55","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_55","text":"How is anyone supposed to sleep with you coughing up a storm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_56","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_56","text":"Sorry. *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_08_57","text":"Princess sits down and powers up her laptop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_08_58","text":"The small generator rattles loudly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_08_59","text":"After glancing around, she connects the cable trailing from the laptop to her glasses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_08_60","text":"Her gaze locks on the screen, as if drawn into it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_61","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_61","text":"You've been obsessed with that thing ever since you bought it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_62","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_62","text":"What are you even doing? *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_63","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_63","text":"Mind your own business. It's a hobby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_64","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_64","text":"With the money you spent on that, you could've bought a way better home than what we've got now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_65","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_65","text":"Big Madam would've stood as a guarantor for you too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_66","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_66","text":"This is worth far more than a house, you fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_67","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_67","text":"Well, have you eaten?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_68","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_68","text":"I have, pathetic a meal as it was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_69","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_69","text":"Me too. I ate before coming home today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_70","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_70","text":"There are some snacks in my bag that Free Rat left for me, but they don't suit my palate. You can have them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_71","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_72","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_72","text":"... What? Why are you staring at me like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_73","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_08_73","text":"It just hit me how much things have changed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_74","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_08_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_08_75","type":