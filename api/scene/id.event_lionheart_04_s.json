{"id":"event_lionheart_04_s","cat":"event","group":{"id":"ev40037","label":"LION HEART"},"label":"To the Homeland of the Beasts: A","stage":null,"prev":"event_lionheart_intermission_01","next":"event_lionheart_04_e","speakers":{"leona_no":"Leona","biscuit":"Biscuit","ruby":"Ruby","nero":"Nero","gray":"Gray"},"icons":{"leona_no":"si_c382_00_s","biscuit":"si_c381_00_s","ruby":"si_c999_00_s","nero":"si_c380_00_s","gray":"si_c999_00_s"},"lines":[{"id":"event_lionheart_04_s_1","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_1","text":"So,","jump":null,"exit":false,"enter":null,"bg":"SchoolCorridor","bgArt":"schoolcorridor","image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":["leona_no","biscuit","timi","nero"],"affinity":null},{"id":"event_lionheart_04_s_2","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_2","text":"Mustang ordered us all to come back safe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_3","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_04_s_3","text":"Emphatically, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_4","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_4","text":"Haha,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_5","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_5","text":"that sounds like the boss, all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_6","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_6","text":"Always stating the obvious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_7","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_7","text":"Well, is everyone ready to head up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_8","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_04_s_8","text":"Actually, I haven't packed yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_9","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_04_s_9","text":"No worries, I already prepared everything for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_10","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_04_s_10","text":"All you've got to do is come with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_11","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_04_s_11","text":"Oh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_12","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_12","text":"We're only staying for a day, so there wasn't much to pack anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_13","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_04_s_13","text":"Just a day? Is that enough time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_14","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_14","text":"No, one day is just right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_15","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_15","text":"If we stayed any longer, our furry friends might be tempted not to come back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_16","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_04_s_16","text":"That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_17","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_04_s_17","text":"You could hardly blame them for not wanting to come back after having a chance to run wild in the open fields.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_18","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_18","text":"Is everyone ready?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_19","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_19","text":"I'll handle Timi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_20","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_20","text":"Hmm, Teddy's a pretty big boy too, so I'll lead him with my other hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_21","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_21","text":"Biscuit, can I ask you to take care of Gray?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_22","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_22","text":"Gray is fairly similar to a dog, so it should be easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_23","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_04_s_23","text":"You mean the gray wolf?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_24","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_04_s_24","text":"Uh... sure!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_25","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_04_s_25","text":"I'll do my best!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_26","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_26","text":"As for you Commander, I'll entrust Ruby to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_27","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_04_s_27","text":"And that would be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_28","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_28","text":"The eagle. Her red eyes are as bright and beautiful as rubies, hence the name.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_29","type":"Speech","speaker":"ruby","key":"Locale_SubScenario:event_lionheart_04_s_29","text":"*Screech screech*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_04_s_30","text":"How exactly should I carry her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_31","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_31","text":"First off, you'll want to wear these safety gloves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_32","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_32","text":"I'll give you a whistle that you can blow on once in a while should you need to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_33","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_33","text":"Don't worry though, these guys are all well-behaved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_34","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_34","text":"All the smaller ones can be left in their cages,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_35","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_35","text":"and the rest of them are quite responsive to the call of the whistle, so we can just let them follow us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_36","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_04_s_36","text":"How are we gonna reach the Elevator with all these animals in tow?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_37","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_37","text":"There's an elevator near the shelter that allows us to bring animals found on the surface directly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_38","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_38","text":"That's where we'll be heading.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_04_s_39","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_04_s_39","text":"Let's go.","jump":null,"exit":false,"enter