ke_crust_02_80","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_02_81","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_02_81","text":"Food from up on the surface shouldn't be easily attainable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_02_82","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_02_82","text":"If it were, it would wreak havoc in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_02_83","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_02_83","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_02_84","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_02_84","text":"So, do we just need to take the ingredients here back with us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_02_85","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_02_85","text":"Hehe, I'm afraid it's not that easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_02_86","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_02_86","text":"We'll have to head outside of this area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_02_87","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_02_87","text":"Th