":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_27","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_27","text":"And if we burn dead branches, not a wisp of smoke shall appear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_28","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_chime_01_28","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_29","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_29","text":"Fie! Make haste and do it; why so much wailing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_30","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_30","text":"Had I erred, I had perished many a year ago!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_31","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_31","text":"... I guess you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_32","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_chime_01_32","text":"... Yeah, that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_33","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_chime_01_33","text":"... Can't argue with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"