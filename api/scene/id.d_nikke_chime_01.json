{"id":"d_nikke_chime_01","cat":"bond","group":{"id":"char5157","label":"Chime"},"label":"The King's Subjects","stage":null,"prev":null,"next":"d_nikke_chime_02","speakers":{"chime":"Chime","anis":"Anis","neon":"Neon","crown":"Crown"},"icons":{"chime":"si_c331_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","crown":"si_c330_00_s"},"lines":[{"id":"d_nikke_chime_01_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_1","text":"On the way to Red Hood's hometown,","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_2","text":"Chime tells everyone to stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["chime"],"affinity":null},{"id":"d_nikke_chime_01_3","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_3","text":"Let us tarry here but a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_girls","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_4","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_4","text":"I'm fine. Let's keep going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_5","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_5","text":"Dost thou think thou wouldst still be well after walking so long without rest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_6","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_7","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_7","text":"Rest when it is time to rest; thus shalt thou go the farther.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_8","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_chime_01_8","text":"Let's do what she says and chill for a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis","neon"],"affinity":null},{"id":"d_nikke_chime_01_9","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_chime_01_9","text":"Even you, Commander, aren't made of steel, and we've been walking forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_10","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_chime_01_10","text":"Yeah! You know what they say, haste makes waste!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_11","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_chime_01_11","text":"I believe in Rapi!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_12","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_chime_01_12","text":"Er... I mean, the Rapi inside this person called Red Hood!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_13","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_13","text":"Neon moves ahead and sees Red Hood and Dorothy sitting by the roadside, talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_14","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_14","text":"... Okay, fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_15","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_15","text":"Now then, I shall prepare but a simple morsel, that we may regain our strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_16","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_16","text":"*Clatter*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_17","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_01_17","text":"Chime pulls out what looks like camping gear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_18","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_18","text":"Ye two, go yonder to that hillside and gather some branches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_19","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_01_19","text":"Break none that are yet living, but only take those that lie fallen and dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_01_20","type":"Self","speaker":null,"key":"Local