it":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_66","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_66","text":"and you still wouldn't pose the slightest threat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_67","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_67","text":"So, out with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_68","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_68","text":"You're out of options.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_69","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_69","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_70","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_70","text":"Just say the words, and you can live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_71","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_71","text":"I don't know what twisted sense of duty you've conjured up in your mind,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_72","type":"Speech","speaker":"talkative","key":"Locale_MainScena