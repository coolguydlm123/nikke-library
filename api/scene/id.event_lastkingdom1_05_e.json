chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_13","text":"Just get it over with and kill me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_14","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_14","text":"I'm not going to tell you anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_15","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_15","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_16","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_16","text":"Chatterbox, this isn't as much fun as I imagined it would be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_17","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_17","text":"You say that, but your face says otherwise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_18","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_18","text":"You don't even care what she has to say, do you? You just want to play with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_19","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_19","text":"All right, guilty as charged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_20","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_20","text":"That's right. I'm not really interested in what's inside that castle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_21","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_21","text":"Finding that out will be simple enough. All I have to do is go down there myself to find out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_22","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_22","text":"You want to know why I'm doing this to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_23","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_23","text":"I want to see you break. To see you sell your friends down the river.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_24","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_24","text":"Unfortunately, it seems you aren't going to be very cooperative in that regard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_25","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_25","text":"Hehe, sorry to disappoint you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_26","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_26","text":"Speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_27","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_27","text":"What is inside that castle? What is inside the cold storage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_28","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_28","text":"What's so important that it's making you all dig your heels in and refuse to retreat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_29","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_29","text":"Has anyone told you that your breath stinks? You can borrow one of my toothbrushes if you need to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_30","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_31","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_31","text":"When did Marian join you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_32","type":"Speech","speaker":"chime","key":"