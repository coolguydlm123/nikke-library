5_e_79","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_79","text":"My king... forgive me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_80","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_81","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_81","text":"I'm leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_82","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_82","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_83","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_83","text":"Don't play with me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_84","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_84","text":"you filthy bastards!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_85","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_85","text":"I am a subject of the kingdom and the king's proud royal aide!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_86","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_86","text":"My mission is to bring light and glory to the entire kingdom and to live for the king!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_87","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_87","text":"I would never abandon my mission. Only filthy turncoats like you would even consider such a heinous act!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_88","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_88","text":"I would never betray my king!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_89","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_89","text":"I would never stoop so low as scum like you, who don't know the first thing about pride or nobility!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_90","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_90","text":"I've said it before, and I'll say it again: I have nothing to say to you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_91","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_91","text":"The only words I have for you are curses and insults!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_92","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_92","text":"So go ahead and do your worst!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_93","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_93","text":"Kill me. Corrupt me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_94","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_94","text":"If my king finds out something has happened to me, she'll chase you to the ends of the earth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_95","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_95","text":"She will have her revenge, and see to it that your corpses hang at the city gates for the next hundred years!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_96","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_96","text":"King? Did you say king?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_97","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_97","text":"That's right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_98","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_98","text":"My life's purpose is to serve and worship my king.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_99","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_99","text":"She is far stronger and nobler than any of you could possibly imagine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_100","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_100","text":"So stand aside, or prepare to be mowed down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_101","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_05_e_101","text":"For my king will come here personally to take your heads as a trophy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_102","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_05_e_102","text":"... I don't think our interrogation is going as planned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_103","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_103","text":"You are an obstinate fool who has been blinded by your mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_104","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_104","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_05_e_105","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_05_e_105","text":"Despite that, I am envious of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}