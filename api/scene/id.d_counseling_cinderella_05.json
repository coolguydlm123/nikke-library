{"id":"d_counseling_cinderella_05","cat":"counsel","group":{"id":"char5124","label":"Cinderella"},"label":"Advising Cinderella: 05","stage":null,"prev":"d_counseling_cinderella_04","next":"d_counseling_cinderella_06","speakers":{"cinderella":"Cinderella","Narration":"Narration"},"icons":{"cinderella":"si_c511_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_counseling_cinderella_05_1","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_05_1","text":"Whenever I look in the mirror, I think about how truly beautiful I am.","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["cinderella"],"affinity":"_0"},{"id":"d_counseling_cinderella_05_2","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_05_2","text":"And what about you, Prince?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_05_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_05_3","text":"How impressive my muscles are.","jump":"d_counseling_cinderella_05_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_05_4","text":"How it gives me motivation to get through the day.","jump":"d_counseling_cinderella_05_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_05_5","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_05_5","text":"You don't seem used to receiving compliments from others about your appearance,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"