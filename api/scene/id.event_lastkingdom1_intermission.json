{"id":"event_lastkingdom1_intermission","cat":"event","group":{"id":"ev40045","label":"LAST KINGDOM · Part 1"},"label":"Decisive Moment","stage":null,"prev":"event_lastkingdom1_b01_e","next":"event_lastkingdom1_b02_s","speakers":{"indivilia":"Indivilia","talkative":"Chatterbox","kilo":"Kilo","talos":"T.A.L.O.S.","chime":"Chime","crown":"Crown","marian_q":"Marian"},"icons":{"indivilia":"si_c263_00_s","kilo":"si_c977_00_s","talos":"si_c361_00_s","chime":"si_c331_00_s","crown":"si_c330_00_s","marian_q":"si_c260_02_s"},"lines":[{"id":"event_lastkingdom1_intermission_1","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_1","text":"When I decided to follow that Rapture formation,","jump":null,"exit":false,"enter":null,"bg":"land_d","bgArt":"land_d","image":null,"bgm":"event_bgm_lastkingdom_whisperoffear","movie":null,"shown":["indivilia","talkative"],"affinity":null},{"id":"event_lastkingdom1_intermission_2","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_2","text":"I hardly expected to encounter such a classic structure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_3","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_3","text":"Classic? Shabby and dilapidated is more like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_4","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_4","text":"You ought to appreciate aesthetic beauty more,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_5","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_5","text":"especially since you, yourself, are a work of art.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_6","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_6","text":"Give me a break.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_7","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_7","text":"Haven't you noticed? After consuming that fire dragon, your beauty has ascended to new heights.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_8","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_8","text":"Your strength has increased exponentially and your external features have also changed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_9","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_9","text":"I'm looking forward to seeing your metamorphosis as you consume more of your kin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_10","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_10","text":"I wonder, how much more striking will you become?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_11","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_11","text":"Must you insist on referring to it as \"consuming my kin\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_12","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_12","text":"Ah, pardon me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_13","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_13","text":"Perhaps you'd find \"consumption\" more preferable?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_14","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_14","text":"At any rate, it seems some human imposters have settled in that fortress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_15","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_15","text":"Yes. Although there are only a few of them, they seem quite organized.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_16","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_16","text":"I couldn't confirm who they are due to the distance,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_17","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_17","text":"but I'm guessing they are what the humans call Pilgrims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_18","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_18","text":"It looks like I'll be able to quench my blade's thirst for blood soon enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_19","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_20","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_20","text":"My wounds from our previous encounter with them have since mended entirely... I'm very much looking forward to this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_21","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_21","text":"Are you planning on annihilating them all?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_22","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_22","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_23","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_23","text":"Don't be a fool and use your head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_24","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_24","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_25","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_25","text":"They're residing in a rundown castle that in itself possesses no value.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_26","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_26","text":"They fought tooth and nail to defend a worthless place they should've ditched ages ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_27","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_27","text":"Don't you realize what that means?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_28","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_28","text":"... That there is something there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_29","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_29","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_30","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_30","text":"Something that they're willing to defend with their lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_31","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_31","text":"I wonder what it could be? The anticipation is killing me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_32","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_32","text":"We can interrogate them after capturing them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_33","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_33","text":"I know many \"persuasive\" methods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_34","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_34","text":"You don't know the first thing about how these human imposters operate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_35","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_35","text":"You won't get anything out of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_36","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_36","text":"They're probably deluding themselves into thinking they're serving a higher purpose. Torture will get you nowhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_37","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_37","text":"You seem to know an awful lot about Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_38","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_38","text":"Then again, I'm not surprised.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_39","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_40","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_40","text":"Very well. We'll do it your way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_41","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_41","text":"I'm not sure what good an object so important to such unimportant creatures would do for us,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_42","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_42","text":"but I'll go along with your wishes since you will soon blossom into a creature of rapturous beauty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom1_intermission_43","text":"As Indivilia extends her finger, the air around her swirls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_44","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_44","text":"Optical camouflage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_45","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_45","text":"You do know your stuff. Yes, it's a small Rapture equipped with optical camouflage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_46","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_46","text":"We can't make anything bigger at the moment, but it's the most sure-fire method for recon work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_47","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_47","text":"It's not completely transparent, so we shouldn't rely on it too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_48","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_48","text":"The first order of business is to take control of those nearby Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_49","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_49","text":"Let them hit the castle once more, then exploit the ensuing chaos to slip a few of these through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_50","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_51","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_51","text":"Hehe, now you're starting to think like a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_52","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_lastkingdom1_intermission_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_53","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_53","text":"Now then,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_54","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom1_intermission_54","text":"let's find out what exactly they're hiding in that castle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_55","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_55","text":"T.A.L.O.S., check if the fortress's jamming signal has weakened.","jump":null,"exit":false,"enter":null,"bg":"CrownCastleFrontYard_d","bgArt":"crowncastlefrontyard_d","image":null,"bgm":"event_bgm_lastkingdom_reclusivepilot","movie":null,"shown":["kilo","talos","crown","chime","marian_q"],"affinity":null},{"id":"event_lastkingdom1_intermission_56","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_intermission_56","text":"The jamming signal in the fortress has not weakened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_57","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_intermission_57","text":"Then how does that explain that horde of Raptures? We've never encountered a situation like this before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_58","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_intermission_58","text":"We've had the odd small-scale attack or two, but never anything of this magnitude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_59","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_intermission_59","text":"The only explanation is that something has changed inside the kingdom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_60","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_60","text":"Yes, that seems right...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_61","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_61","text":"Hold on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_62","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_62","text":"That's me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_63","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_intermission_63","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_64","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_intermission_64","text":"You're the main change that's occurred recently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_65","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_65","text":"I-I'm not working for the Raptures!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_66","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_intermission_66","text":"I know that. So the question is, what could it be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_67","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_67","text":"I'm trying to think, but I can't...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_68","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_intermission_68","text":"Jamming signals and rescue signals are still being sent out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_69","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_intermission_69","text":"Although the signal is being blocked by the castle walls, there is a chance that it can pass through and reach the outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_70","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_70","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_71","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_71","text":"Why have you left that on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_72","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_intermission_72","text":"You did not issue a command to cease transmission. Should I cease transmission now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_73","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_73","text":"Yes, you idiot! Turn it off now, quickly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_74","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_intermission_74","text":"Roger. Stopping the generation of jamming signals and rescue signals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_75","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_75","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_76","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermission_76","text":"T.A.L.O.S. was sending out signals this entire time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_intermission_77","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_intermi