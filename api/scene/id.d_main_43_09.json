{"id":"d_main_43_09","cat":"main","group":{"id":"ch43","label":"Chapter 43 · Key"},"label":"Daily Greetings","stage":"43-27 STAGE · Start","prev":"d_main_43_08","next":"d_main_43_10","speakers":{"princess":"Princess"},"icons":{"princess":"si_c9018_00_s"},"lines":[{"id":"d_main_43_09_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_1","text":"Princess awakens.","jump":null,"exit":false,"enter":null,"bg":"UndergroundTunnel","bgArt":"undergroundtunnel","image":null,"bgm":"bgm_story_monochrome","movie":null,"shown":["princess"],"affinity":null},{"id":"d_main_43_09_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_2","text":"She picks up the plain Splendamin bar left near her head and eats it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_3","text":"She rises groggily, casually greets the guard,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_4","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_4","text":"and heads to work, shaking off the last of her sleep.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_5","text":"Princess's job is scavenging through the electronic waste yard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_6","text":"Amid the mountains of discarded devices brought down from the Ark, she searches for anything that might still be usable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_7","text":"It's heavy labor, and something she isn't particularly good at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_8","text":"Free Rat nags at her from the side, but she ignores it and does her best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_9","text":"This is her least favorite time of day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_10","text":"The morning's work ends, and they spread out makeshift mats to gather for a meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_11","text":"She always wonders what difference morning and afternoon make in a place this dark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_12","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_12","text":"She puts a slice of bread soaked in a questionable sauce into her mouth. Despite its appearance, it doesn't taste bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_13","text":"After a short lunch break, they inspect the collected electronics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_14","text":"This is her favorite time of day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_15","text":"She hacks the data left on the devices and sells any valuable information she finds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_16","text":"It pays far better than selling the devices outright, and fortunately, she is exceptionally skilled at it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_17","text":"Thanks to that, the workload is relatively easy, and her pay is quite decent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_18","text":"Free Rat says Princess could easily make a name for herself in the Outer Rim if she wanted to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_19","text":"The compliment lifts her spirits for a moment, but once she looks around, her heart turns cold once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_20","text":"She sees a place that is dark, foul-smelling, and covered in filth. Above all, it is a place without hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_21","text":"Hope found in the gutter may seem utterly insignificant to those on the outside,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_22","text":"but everyone here clings to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_23","text":"Princess reaffirms to herself her decision not to try and find hope here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_24","text":"Her hope lies in the Ark, not in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_25","text":"She is certain that the moment she allows herself to find hope here, she'll be done for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_26","text":"The workday comes to an end.","jump":null,"exit":false,"enter":null,"bg":"ArkCleanIndoor","bgArt":"arkcleanindoor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_27","text":"She visits Big Madam, engages in small talk, and receives her pay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_28","text":"She returns home.","jump":null,"exit":false,"enter":null,"bg":"UndergroundTunnel","bgArt":"undergroundtunnel","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_29","text":"After briefly greeting the guard, she turns toward the sound of coughing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_30","text":"She sees a goofy smile, filthy clothes...","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_01_2","bgArt":"eventscene_chap_43_01_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_31","text":"and a poor child.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_32","text":"Princess's heart wavers. She suddenly finds herself wanting to hold onto hope here, if only for this child.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_33","text":"She approaches the child,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_09_34","text":"and responds to the greeting that had somehow become part of her everyday life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_35","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_09_35","text":"No, I haven't eaten yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_09_36","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_09_36","text":"Let's eat together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}