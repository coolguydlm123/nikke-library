{"id":"d_main_36_05","cat":"main","group":{"id":"ch36","label":"Chapter 36 · Betrayal"},"label":"Long-Term Plan","stage":"36-18 STAGE · Start","prev":"d_main_36_04","next":"d_main_36_06","speakers":{"leviathan":"Leviathan","rapi_red":"Rapi","maxwell":"Maxwell"},"icons":{"leviathan":"si_c562_00_s","rapi_red":"si_c016_00_s","maxwell":"si_c102_00_s"},"lines":[{"id":"d_main_36_05_1","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_1","text":"Behemoth is quite the voracious eater. Even when she was feeling fine, she could really put it away. We need to gather Rapture fragments to feed her.","jump":null,"exit":false,"enter":null,"bg":"Jungle2","bgArt":"jungle2","image":null,"bgm":"bgm_story_empathize","movie":null,"shown":["leviathan","rapi_red","maxwell"],"affinity":null},{"id":"d_main_36_05_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_36_05_2","text":"Following Leviathan's request, we start to gather Rapture fragments nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_3","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_3","text":"It seems Behemoth is able to regenerate from Rapture parts alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_4","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_4","text":"What's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_5","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_5","text":"It was the same with Material H... or Indivilia, rather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_6","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_6","text":"She only absorbed Nikkes, and only a part of them at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_7","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_7","text":"378 grams, to be specific.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_8","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_8","text":"Not the most effective yield. Raptures make much better use of whatever they con...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_9","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_9","text":"Hold on, 378 grams?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_10","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_10","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_11","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_11","text":"That's how much a NIMPH weighs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_12","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_12","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_13","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_13","text":"That's the weight of a NIMPH, on the dot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_14","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_14","text":"Are you saying that Indivilia only absorbed the NIMPH of Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_15","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_15","text":"Could be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_16","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_16","text":"Why would she do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_17","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_17","text":"Maybe she's a picky eater.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_18","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_18","text":"She could only be interested in consuming nanomachines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_19","text":"Do you really think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_20","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_20","text":"I wouldn't put it past them. The Offspring are all bonkers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_21","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_21","text":"Every last one of them has a screw loose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_22","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_22","text":"Being a picky eater would be far from the weirdest things they've done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_23","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_23","text":"But Behemoth and I aren't picky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_24","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_24","text":"We eat just about everything, and happily so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_25","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_05_25","text":"Even Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_26","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_26","text":"We've never tried, but I'm sure we could.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_27","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_27","text":"The idea of eating something that looks like us is repugnant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_28","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_05_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_29","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_29","text":"So let's stick to gathering Rapture fragments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_30","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_30","text":"She's sleeping and can't exactly be discerning with her diet. She'll eat anything we give her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_31","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_31","text":"If we end up feeding her something that disagrees with her, she'll be peeved when she wakes up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_32","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_32","text":"You're very devoted to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_33","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_33","text":"This is nothing compared to what Behemoth has done for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_34","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_34","text":"She's risked her own life to save mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_35","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_35","text":"I could never betray that trust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_36","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_36","text":"I've experienced enough betrayal in my life as is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_37","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_37","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_38","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_38","text":"Any other questions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_39","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_39","text":"Your attitude has softened quite a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_40","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_40","text":"Are you going to ask me a question or not?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_41","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_41","text":"Do you want to replace humans?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_42","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_42","text":"That's the same question you asked me before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_43","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_43","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_44","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_44","text":"We don't want to replace humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_45","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_45","text":"We don't have any desire to live alongside them either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_46","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_46","text":"Our goal is clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_47","text":"Strike back at the Offspring?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_48","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_48","text":"That's it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_49","text":"Then why are you trying to construct an Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_50","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_50","text":"We're following the ritual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_51","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_51","text":"To us, the Ark is like a protective womb that produces human imposters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_52","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_52","text":"Of course, I realize your kind existed before the Ark was created,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_53","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_53","text":"but once the Ark went online, you all began pouring out,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_54","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_54","text":"and basically became a new species.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_55","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_55","text":"That's why we view the Ark as the origin of your evolution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_56","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_57","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_57","text":"The Four Beasts are trying to become a new species altogether.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_58","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_58","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_59","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_59","text":"Neither Rapture, nor Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_60","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_60","text":"A new species, capable of crushing the Offspring as well as other Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_61","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_61","text":"As for what comes after that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_62","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_62","text":"We haven't thought that far ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_63","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_63","text":"Where exactly are you building this Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_64","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_64","text":"Why? If I tell you, are you gonna head over there and smash it up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_65","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_65","text":"I could tell you, but even if I did, it's not like you'd be able to do anything about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_66","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_66","text":"All we've done is create a rudimentary copy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_67","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_67","text":"You weren't planning on utilizing it in some way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_68","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_68","text":"We were considering","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_69","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_69","text":"how to take it a step further with the eggs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_70","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_05_70","text":"You were planning on delving deeper into seeing what these eggs could produce.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_71","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_71","text":"Yeah. It's a bit of a random draw with what you get either way, but over there, the results could be special.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_72","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_72","text":"It was a shot in the dark, but there's a chance the eggs could produce something far superior in that environment than they could here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_73","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_05_73","text":"Sounds to me like you're not giving us much choice; we have to put a stop to this plan of yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_74","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_74","text":"I told you. Even if you all went over to the Ark, there's nothing you could do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_75","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_75","text":"Nothing is prepared yet. Not a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_76","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_76","text":"If we had an extra 100 years, then maybe we'd be able to get somewhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_77","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_77","text":"But you'd be dead by then, you poor, ordinary human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_78","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_78","text":"No. The Commander will live forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_79","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_79","text":"I hope so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_80","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_05_80","text":"You're really thinking in the long term.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_81","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_81","text":"Naturally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_82","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_82","text":"Striking back at the Offspring isn't something that will happen overnight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_83","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_83","text":"We've got to take it slow and steady.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_84","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_84","text":"That's what we're best at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_85","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_85","text":"I must admit, it's remarkable that not a single shred of information about you has ever shown up in any of our reports.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_86","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_86","text":"I'll give you that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_87","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_87","text":"The Ark is a dangerous place, and so we've been extremely careful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_88","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_88","text":"We remain in the shadows and work quietly. It may seem cowardly and unseemly to you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_89","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_89","text":"but in the end, we'll be the ones with smiles on our faces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_90","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_90","text":"Once Behemoth is revived, we'll go into hiding again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_91","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_91","text":"You'll never be able to find us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_92","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_92","text":"No. You won't be able to hide from us again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_93","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_93","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_94","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_36_05_94","text":"You of all people should know that conversation is the cornerstone of evolution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_95","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_95","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_05_96","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_05_96","text":"Hmph. Whatever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}