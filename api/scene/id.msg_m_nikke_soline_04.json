{"id":"msg_m_nikke_soline_04","cat":"messenger","group":{"id":"room_soline_s","label":"Soline · Chat"},"label":"1. Commander, any free time?","stage":null,"prev":null,"next":"msg_m_nikke_soline_frostticket_04","speakers":{"soline":"Soline"},"icons":{"soline":"si_c071_00_s"},"lines":[{"id":"m_nikke_soline_04_1","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_1","text":"Commander, any free time?","jump":null},{"id":"m_nikke_soline_04_2","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_soline_04_2","text":"Anything I can do for you?","jump":null},{"id":"m_nikke_soline_04_3","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_3","text":"Perhaps...","jump":null},{"id":"m_nikke_soline_04_4","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_4","text":"Uh...","jump":null},{"id":"m_nikke_soline_04_5","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_5","text":"Can you go to the surface","jump":null},{"id":"m_nikke_soline_04_6","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_6","text":"with me?","jump":null},{"id":"m_nikke_soline_04_7","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_soline_04_7","text":"The surface? Just the two of us?","jump":null},{"id":"m_nikke_soline_04_8","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_8","text":"Yes.","jump":null},{"id":"m_nikke_soline_04_9","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_9","text":"I finally realize what I'm supposed to do now.","jump":null},{"id":"m_nikke_soline_04_10","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_10","text":"I'm a Nikke","jump":null},{"id":"m_nikke_soline_04_11","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_11","text":"and Nikkes are supposed to be strong.","jump":null},{"id":"m_nikke_soline_04_12","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_12","text":"If I complete a mission that normally requires two or three Nikkes then,","jump":null},{"id":"m_nikke_soline_04_13","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_13","text":"people will understand my capability.","jump":null},{"id":"m_nikke_soline_04_14","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_soline_04_14","text":"It's dangerous.","jump":null},{"id":"m_nikke_soline_04_15","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_15","text":"It's not dangerous at all!","jump":null},{"id":"m_nikke_soline_04_16","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_16","text":"I just have to bring back an object that was thrown away!","jump":null},{"id":"m_nikke_soline_04_17","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_soline_04_17","text":"Even so, it's still dangerous on the surface.","jump":null},{"id":"m_nikke_soline_04_18","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_18","text":"I know but","jump":null},{"id":"m_nikke_soline_04_19","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_19","text":"this is the only way left right now.","jump":null},{"id":"m_nikke_soline_04_20","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_20","text":"Please Commander.","jump":null},{"id":"m_nikke_soline_04_21","type":"Speech","speaker":"soline","key":"Locale_NikkeEpisode:m_nikke_soline_04_21","text":"I'm really sorry.","jump":null},{"id":"m_nikke_soline_04_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_soline_04_22","text":"I understand.","jump":null}],"chat":true}