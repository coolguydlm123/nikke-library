{"id":"d_counseling_rapi_11","cat":"counsel","group":{"id":"char3001","label":"Rapi"},"label":"Advising Rapi: 11","stage":null,"prev":"d_counseling_rapi_10","next":"d_counseling_rapi_12","speakers":{"rapi":"Rapi"},"icons":{"rapi":"si_c010_00_s"},"lines":[{"id":"d_counseling_rapi_11_1","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_11_1","text":"Lately, there have been more Nikkes at the Outpost than usual.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rapi"],"affinity":"_0"},{"id":"d_counseling_rapi_11_2","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_11_2","text":"On the plus side, it's increased the number of troops we have available, but it's also led to a few more altercations and other incidents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_11_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_11_3","text":"We should open our own court.","jump":"d_counseling_rapi_11_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rapi_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_11_4","text":"We can go on patrol together.","jump":"d_counseling_rapi_11_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rapi_11_5","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_11_5","text":"We've already got one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_11_6","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_11_6","text":"It's just never been used properly","jump":"d_counseling_rapi_11_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_11_7","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_11_7","text":"Right, everyone is so fond of you that they may not be willing to cause a ruckus so openly if you're around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_11_8","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_11_8","text":"Just let me know what time works for you, and I'll let you join me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_11_9","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_11_9","text":"Rapi and I discussed how to maintain peace in the Outpost.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}