{"id":"event_hightechtoy_epilogue","cat":"event","group":{"id":"ev40002","label":"Hightech Toy"},"label":"Hero or Toy?","stage":null,"prev":"event_hightechtoy_06_e","next":null,"speakers":{"tvvoice":"TV","syuen":"Syuen","laplace":"Laplace","maxwell_w":"Maxwell","drake":"Drake","unknown":"???","massproduction01":"Mass-produced Nikke"},"icons":{"tvvoice":"si_c999_00_s","syuen":"si_c901_00_s","laplace":"si_c100_00_s","maxwell_w":"si_c102_01_s","drake":"si_c101_00_s","unknown":"si_c999_00_s","massproduction01":"si_c253_00_s"},"lines":[{"id":"event_hightechtoy_06_e_89","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_06_e_89","text":"Missilis has destroyed the Rapture which caused the disappearance of numerous mass-produced Nikkes and proceeded to have the finest quarter in its history.","jump":null,"exit":false,"enter":null,"bg":"MachineRoom","bgArt":"machineroom","image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_90","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_06_e_90","text":"We take you now to an interview with Missilis's CEO Syuen, and the Matis Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_91","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_91","text":"[Testing, testing... Can you hear me?]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_92","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_92","text":"I'm happy to report that the tyrant-class Rapture responsible for the disappearance of countless mass-produced Nikkes has been captured,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_93","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_93","text":"[and it's all thanks to Matis.]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_94","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_94","text":"[I feel it is worth mentioning that the other two company's mass-produced Nikke budget has been slashed significantly in light of all this.]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_95","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_95","text":"[Here at Missilis, we don't need army training. We have Matis!]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_96","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_96","text":"[Laplace, say a few words.]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_97","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_06_e_97","text":"[Citizens of the Ark, do not fear. Going forward, Matis will be your knight in shining armor. We, the true heroes, will protect you.]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_98","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_98","text":"[You all got that?]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_99","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_99","text":"[I, Syuen, the CEO of Missilis,]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_100","type":"Speech","speaker":"syuen","key":"Locale_SubScenario:event_hightechtoy_06_e_100","text":"[made Matis what it is today, and don't you forget it!]","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_101","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_06_e_101","text":"Wow, I've never seen Syuen so happy. She's beaming from ear to ear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["laplace","drake","maxwell_w"],"affinity":null},{"id":"event_hightechtoy_06_e_102","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_06_e_102","text":"At least she's not so ornery for once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_103","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_06_e_103","text":"Bah, I didn't speak loudly enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_104","type":"Speech","speaker":"drake","key":"Locale_SubScenario:event_hightechtoy_06_e_104","text":"Yeah, I can barely hear you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_105","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_06_e_105","text":"Next time I'll shout it from the rooftops!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_106","type":"Speech","speaker":"drake","key":"Locale_SubScenario:event_hightechtoy_06_e_106","text":"Yeah, so the whole world can hear you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_107","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_06_e_107","text":"Don't you two start again. Go and play outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_108","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_06_e_108","text":"Maxwell! How many times have I told you? Heroes don't play outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_109","type":"Speech","speaker":"unknown","key":"Locale_SubScenario:event_hightechtoy_06_e_109","text":"Hey...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["massproduction01"],"affinity":null},{"id":"event_hightechtoy_06_e_110","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_06_e_110","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_111","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_06_e_111","text":"It's you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_06_e_112","type":"Speech","speaker":"massproduction01","key":