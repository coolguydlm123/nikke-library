{"id":"event_boomtheghost1_02_s","cat":"event","group":{"id":"ev40084","label":"BOOM! THE GHOST! · Part 1"},"label":"Luxury Cruise: A","stage":null,"prev":"event_boomtheghost1_01_e","next":"event_boomtheghost1_02_e","speakers":{"yan":"Yan","tove":"Tove","centi":"Centi","pepper":"Pepper","frima":"Frima","dorothy":"Dorothy","rapi_ss":"Rapi","elegg":"Elegg"},"icons":{"yan":"si_c201_00_s","tove":"si_c192_00_s","centi":"si_c080_00_s","pepper":"si_c131_00_s","frima":"si_c142_00_s","dorothy":"si_c233_00_s","rapi_ss":"si_c016_01_s","elegg":"si_c500_00_s"},"lines":[{"id":"event_boomtheghost1_02_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_1","text":"*Vrooooom*!","jump":null,"exit":false,"enter":null,"bg":"Voyage_d","bgArt":"voyage_d","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_2","text":"In the middle of the vast blue sea, a small boat speeds across at full throttle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_3","text":"Refreshing bursts of ocean spray, the endless horizon, drifting clouds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_4","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_4","text":"The conditions are perfectly suited for spirits to be high, and yet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_5","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_5","text":"A heavy silence hangs over everyone in the boat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_6","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_6","text":"More precisely, all that can be heard amongst the crew are subdued murmurs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":["dorothy","tove","yan","centi","pepper"],"affinity":null},{"id":"event_boomtheghost1_02_s_7","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_7","text":"Isn't that Dorothy? The Pilgrim who came to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_8","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_8","text":"Yeah. It's my first time seeing her in person too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_9","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_9","text":"What's she doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_10","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_10","text":"Not sure. She did help the Ark before, so maybe she felt compelled to lend a hand again with this mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_11","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_11","text":"I don't think that's it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_12","type":"Speech","speaker":"centi","key":"Locale_MainScenario:event_boomtheghost1_02_s_12","text":"If you're so curious, why don't you just ask her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_13","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_13","text":"Absolutely not. You can't go around asking things like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_14","type":"Speech","speaker":"pepper","key":"Locale_MainScenario:event_boomtheghost1_02_s_14","text":"You're not scared, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_15","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_15","text":"Of course I am! You're telling me you're not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_16","type":"Speech","speaker":"pepper","key":"Locale_MainScenario:event_boomtheghost1_02_s_16","text":"Not in the slightest. During that incident back in the Ark, she fought against the Heretics, didn't she?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_17","type":"Speech","speaker":"pepper","key":"Locale_MainScenario:event_boomtheghost1_02_s_17","text":"Thanks to her, a lot of people were saved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_18","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_18","text":"You're not wrong, but that's exactly why this is so suspicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_19","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_19","text":"No one in this world does a favor without expecting something in return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_20","type":"Speech","speaker":"pepper","key":"Locale_MainScenario:event_boomtheghost1_02_s_20","text":"You're only saying that because you're a merchant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_21","type":"Speech","speaker":"centi","key":"Locale_MainScenario:event_boomtheghost1_02_s_21","text":"Yeah, you shouldn't be so cynical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_22","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_22","text":"There are plenty of people who do good without expecting to be repaid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_23","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_02_s_23","text":"Sorry, but I'm not convinced. She's definitely up to something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["frima"],"affinity":null},{"id":"event_boomtheghost1_02_s_24","type":"Speech","speaker":"frima","key":"Locale_MainScenario:event_boomtheghost1_02_s_24","text":"Zzzzz...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_ss"],"affinity":null},{"id":"event_boomtheghost1_02_s_25","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_25","text":"Your friends don't seem to understand the concept of whispering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_26","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_02_s_26","text":"You can hear them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_27","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_27","text":"Every word. Loud and clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_28","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_02_s_28","text":"All of you, be quiet! Dorothy can hear everything you're saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_29","text":"Everyone jolts in shock,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_30","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_30","text":"and true silence falls over the boat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["elegg"],"affinity":null},{"id":"event_boomtheghost1_02_s_31","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_32","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_32","text":"I'm sorry for their behavior.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_33","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_33","text":"An apology from someone else doesn't mean all that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_34","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_boomtheghost1_02_s_34","text":"Ms. Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_35","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_36","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_boomtheghost1_02_s_36","text":"Do you like starfish?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_37","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_37","text":"I don't know. I've never seen one before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_38","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_boomtheghost1_02_s_38","text":"Are you sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_39","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_boomtheghost1_02_s_39","text":"There's one stuck on your shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_40","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_41","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_41","text":"What the...?! How do I get it off?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_42","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_02_s_42","text":"Don't worry. I'll get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_43","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_43","text":"Rapi reaches for the starfish stuck to Dorothy's shoulder,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_44","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_44","text":"and it begins to wriggle grotesquely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_45","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_02_s_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_46","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_02_s_46","text":"On second thought, I don't think I can do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_47","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_47","text":"I'll do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_48","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_48","text":"I reach out for the starfish on Dorothy's shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_49","text":"The creature wriggles even more intensely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_50","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_50","text":"... Actually, I don't think I can touch it either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_51","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_51","text":"What are you two doing?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_52","text":"*Thunk*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_53","text":"Tove walks over and casually removes the starfish from Dorothy's shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_54","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_55","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_55","text":"It's just an ordinary starfish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_56","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_56","text":"It probably got tossed out of the water by a dolphin that was playing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_57","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_57","text":"Did you know that starfish are edible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_58","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_58","text":"They are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_59","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_59","text":"In extreme survival situations, they can be a good source of protein.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_60","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_60","text":"I don't think our situation qualifies as extreme just yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_61","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_61","text":"It may not taste great, but if you close your eyes before taking a bite...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_62","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_02_s_62","text":"Wait, what are you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_63","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_02_s_63","text":"*Chomp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_02_s_64","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_02_s_64","text":"*Bleeeech*!