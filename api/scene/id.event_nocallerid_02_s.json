,"affinity":null},{"id":"event_nocallerid_02_s_33","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_nocallerid_02_s_33","text":"So it's unprecedented to be receiving a voice message like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_34","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_nocallerid_02_s_34","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_35","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_nocallerid_02_s_35","text":"Okay, now I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_36","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_nocallerid_02_s_36","text":"I just hope we can find some survivors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_37","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_nocallerid_02_s_37","text":"Likewise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_38","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_nocallerid_02_s_38","text":"Me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}