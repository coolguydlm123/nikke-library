llerid_02_s_13","text":"In the decades that followed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_14","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_nocallerid_02_s_14","text":"the Rapture laid waste to mankind's old home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_risk","movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_15","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_nocallerid_02_s_15","text":"They've demolished all the significant landmarks, and slaughtered all the humans left on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_16","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_nocallerid_02_s_16","text":"They operated with incredible precision. Especially when it came to killing humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_17","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_nocallerid_02_s_17","text":"On the surface, there may be a chance of coming across some old knick-knacks or settlements,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_18","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_nocallerid_02_s_18","text":"but the Raptures didn't leave a single human alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_19","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_nocallerid_02_s_19","text":"But the surface is a big place, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_20","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_nocallerid_02_s_20","text":"It'd be impossible to search every nook and cranny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_21","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_nocallerid_02_s_21","text":"How can you be so sure there aren't any survivors?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_22","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_nocallerid_02_s_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_23","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_nocallerid_02_s_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_24","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_nocallerid_02_s_24","text":"... So you've decided.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_25","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_nocallerid_02_s_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nocallerid_02_s_26","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_nocallerid_02_s_26","text":"... Mm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,