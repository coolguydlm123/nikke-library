{"id":"d_main_46_04","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"Red Mirror","stage":"46-14 STAGE · Start","prev":"d_main_46_03","next":"d_main_46_05","speakers":{"nayuta":"Nayuta","snowwhite_h":"Snow White","cecil_op_r":"Cecil","johan_op_l":"Johan","mirror_r":"Mirror","janghwa_n":"Rose"},"icons":{"nayuta":"si_c223_00_s","snowwhite_h":"si_c471_00_s","cecil_op_r":"si_c929_00_s","johan_op_l":"si_c925_00_s","mirror_r":"si_c982_00_s","janghwa_n":"si_c971_01_s"},"lines":[{"id":"d_main_46_04_1","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_1","text":"Hmm... I desire to draw nearer still, yet it proves not feasible.","jump":null,"exit":false,"enter":null,"bg":"SpaceStationRoad","bgArt":"spacestationroad","image":null,"bgm":"bgm_chapter46_field_redlight","movie":null,"shown":["snowwhite_h","nayuta"],"affinity":null},{"id":"d_main_46_04_2","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_2","text":"However, to venture any deeper would be to invite battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_3","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_3","text":"Why avoid combat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_4","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_4","text":"I cast no doubt upon thy abilities nor thy newfound powers, White Snow. Yet why spend that strength for naught?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_5","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_5","text":"You have to pick apart everything, don't you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_6","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_6","text":"Sometimes, the simplest option is the best one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_7","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_7","text":"And sometimes it is not. Hence why I am deliberating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_8","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_9","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_9","text":"Young Lady Cecil. Wouldst thou be able to confirm the spread of Raptures in the vicinity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_10","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_10","text":"There are far too many. There's no point even trying to count them all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_r","johan_op_l"],"affinity":null},{"id":"d_main_46_04_11","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_11","text":"Charging in would be a suicide mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_12","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_04_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_13","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_04_13","text":"You're out of options. Fall back for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_14","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_04_14","text":"We now know something's amiss here. That alone is a significant find.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_15","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_16","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_04_16","text":"We'll pick this back up when {AccountData.NickName} arrives with the cavalry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_17","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_17","text":"Do you think the Queen is just going to sit around twiddling her thumbs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_18","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_04_18","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_19","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_19","text":"Nayuta, find a way to scout the area without getting drawn into a fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_20","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_04_20","text":"This is not your call to make, Cecil. I'm the one in command here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_21","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_21","text":"Letting fear dictate our every move won't get us anywhere, Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_22","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_22","text":"Especially in a situation like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_23","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_04_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_24","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_24","text":"With no way of knowing what Queen is up to, we can't turn back now, not after coming this far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_25","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_25","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soundonly","soundonly_left"],"affinity":null},{"id":"d_main_46_04_26","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_26","text":"What's... wrong... comm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_27","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_27","text":"Young Lady Cecil. Can my voice reach thee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_28","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_28","text":"Alv... particle density... too low...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_29","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_29","text":"You two... Listen care... Find whatever... then... back...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_30","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_04_30","text":"Find whatever you can and then fall back. Understood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_04_31","text":"The line goes to static.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_32","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_32","text":"... Communications are completely cut off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_33","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_33","text":"Our communication equipment is functioning normally. This wasn't caused by elevated Alva particles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_34","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_34","text":"To lose contact within Eden of all places? A strange thing indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_35","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_35","text":"In any case, \"Find whatever you can and then fall back.\" Words most ill-advised, and yet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_36","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_36","text":"Let's go. We'll avoid the areas where there are too many Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_37","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_37","text":"Playing it safe will gain us nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_38","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_39","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_39","text":"Very well. I shall entrust this matter to thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_40","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_40","text":"My, my. They say people lose their heads when cornered. Guess it's true after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_anothermirror","movie":null,"shown":["mirror_r","janghwa_n"],"affinity":null},{"id":"d_main_46_04_41","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_41","text":"Don't go rushing in now. You'll get yourself killed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_42","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_42","text":"Young Lady Mirror...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_43","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_04_43","text":"Hello.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_44","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_44","text":"Swordwarden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_45","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_45","text":"... Who are they?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_46","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_46","text":"Snow White. Youngest member of the Goddess Squad. The fourth Grimms model. The White Reaper of the Horizon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_47","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_47","text":"What an honor to have such a distinguished guest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_48","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_48","text":"... Identify yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_49","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_49","text":"Pleasure meeting you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_50","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_50","text":"The name's Mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_51","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_51","text":"I'm an old friend of Nayuta's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_52","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_52","text":"Someone like her wouldn't have any friends, so who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_53","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_53","text":"Goodness, quite perceptive, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_54","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_04_55","text":"Snow White reaches out toward Mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_04_56","text":"Her hand passes straight through her. The point of contact crackles with static.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_57","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_57","text":"You're just a hologram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_58","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_58","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_59","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_59","text":"You're the one who cut our communications with Johan and Cecil?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_60","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_60","text":"Mmhm, guilty as charged. I've nothing to gain from making my presence known, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_61","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_61","text":"Just what are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_62","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_62","text":"I already told you. I'm Nayuta's associate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_63","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_63","text":"At the moment... yes, I'm acting as a spy and pretending to side with the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_64","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_65","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_65","text":"Hehe, it's been a while since I've been greeted with such distrust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_66","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_66","text":"Nayuta, could you please say something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_67","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_67","text":"My character is in doubt before I've even had the chance to relay any useful information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_68","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_68","text":"... She speaks the truth, White Snow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_69","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_04_69","text":"She is indeed my associate. It is likewise true that she hath taken to the Raptures' side, carrying out espionage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_70","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_70","text":"There you have it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_71","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_72","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_04_72","text":"Fine. I'll take your word for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_73","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_73","text":"Hehe, much appreciated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_74","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_74","text":"Now then, shall I show you around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_04_75","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_04_75","text":"There is quite a lot I need to convey regarding the current situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}