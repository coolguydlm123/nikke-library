miss","key":"Locale_SideStory:s005_12_37","text":"Bright stars cast their light over everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_38","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_38","text":"Those who gaze up at them are captivated and forget their troubles, even if only for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_39","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_39","text":"For that brief instant, pain fades, and all that remains is joy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_40","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_40","text":"That's the power of entertainment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_41","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_12_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_42","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_42","text":"You're a star. The Ark's star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_43","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_43","text":"My job is to buy as much time as I can until that star dims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_44","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_44","text":"Until the next one 