"Speech","speaker":"pretty","key":"Locale_SideStory:s005_12_22","text":"If I can't be a pop star forever, and I can't retire,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_23","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_12_23","text":"what does that leave me with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_24","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_24","text":"... At this point, all I can do is delay the inevitable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_25","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_12_25","text":"And in the end, I'll vanish completely, leaving no trace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_26","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_27","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_27","text":"I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_28","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_12_28","text":"... I didn't expect you to say something like that, Mrs. Miss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_12_29","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_12_29","text":"I'm the one who made you a pop star,","jump":null,"exit":f