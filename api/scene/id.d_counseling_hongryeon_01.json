{"id":"d_counseling_hongryeon_01","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 01","stage":null,"prev":null,"next":"d_counseling_hongryeon_02","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_01_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_01_1","text":"Tell me, my Lord. Which do you prefer?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_01_2","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_01_2","text":"Bitter spirits, or sweet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_01_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_01_3","text":"Sweet!","jump":"d_counseling_hongryeon_01_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_01_4","text":"Bitter!","jump":"d_counseling_hongryeon_01_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_01_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_01_5","text":"So you are still partial to alcohol's sweet embrace?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_01_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_01_6","text":"My Lord, you are but a novice still.","jump":"d_counseling_hongryeon_01_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_01_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_01_7","text":"Never have truer words been spoken! Spirits are much like life itself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_01_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_01_8","text":"One adjusts to life's ebb and flow much in the way you allow the bitterness of spirits to ease down your gullet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_01_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_01_9","text":"You possess a greater mind than your looks let on, my Lord!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_01_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_01_10","text":"I spend time with Scarlet and share a drunken conversation.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}