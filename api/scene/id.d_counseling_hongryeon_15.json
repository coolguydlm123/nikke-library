{"id":"d_counseling_hongryeon_15","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 15","stage":null,"prev":"d_counseling_hongryeon_14","next":"d_counseling_hongryeon_16","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_15_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_15_1","text":"If perchance one day we doth succeed in reclaiming the surface, what shall ye do with the days that remain?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_15_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_15_2","text":"I'd be content living a quiet life on my own patch of land.","jump":"d_counseling_hongryeon_15_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_15_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_15_3","text":"I'd want to spend it with the friends that are closest to me.","jump":"d_counseling_hongryeon_15_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_15_4","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_15_4","text":"A fine notion indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_15_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_15_5","text":"Up until now, thy life has been one full of strife and fractiousness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_15_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_15_6","text":"The day will come when we can bask in the light of the sun, and the moon alike.","jump":"d_counseling_hongryeon_15_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_15_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_15_7","text":"Ye will live a life much different than mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_15_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_15_8","text":"As it stands, the surface is a land of great strife and disarray.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_15_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_15_9","text":"When this all comes to an end, mine greatest desire is to live a quiet life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_15_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_15_10","text":"Scarlet and I dreamt about the future.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}