{"id":"event_bowwowparadise_01_e","cat":"event","group":{"id":"ev40010","label":"BOW WOW PARADISE"},"label":"Looking for Lost Dogs: B","stage":null,"prev":"event_bowwowparadise_01_s","next":"event_bowwowparadise_02_s","speakers":{"biscuit":"Biscuit"},"icons":{"biscuit":"si_c381_00_s"},"lines":[{"id":"event_bowwowparadise_01_e_1","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_1","text":"The dogs escaped from the shelter?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":["biscuit"],"affinity":null},{"id":"event_bowwowparadise_01_e_2","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_2","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_3","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_3","text":"It's all my fault. I'm sorry to drag you into this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_4","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_4","text":"but can you help me look for them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_5","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_5","text":"Biscuit stares at me woefully, her eyes welling up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_6","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_6","text":"Pet her on the head.","jump":"event_bowwowparadise_01_e_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_7","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_7","text":"Pet her on the shoulder.","jump":"event_bowwowparadise_01_e_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_8","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_8","text":"Thank you for cheering me up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_9","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_9","text":"Is there any chance of the dogs being in danger?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_10","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_10","text":"No, we don't have to worry about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_11","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_11","text":"I might have to explain a few things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_12","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_12","text":"Only certain members of the upper class can have pets,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_13","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_13","text":"and even then, you need approval from the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_14","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_14","text":"If anyone took one of those dogs without permission, the Central Government would throw the book at them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_15","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_15","text":"The Ark's animal protection laws are quite strict, and heavily enforced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_16","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_16","text":"The only thing that worries me is","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_17","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_17","text":"one of them getting hurt or causing a problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_18","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_18","text":"None of them have been to the Ark before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_19","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_20","text":"Not even once?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_21","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_21","text":"Not a one. They've been at the shelter ever since they were little pups. Many of them still haven't been trained properly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_22","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_22","text":"There's no need for them to visit the Ark anyway. The shelter has everything they'd possibly need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_23","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_23","text":"There's a training center, an examination room, a play room...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_24","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_24","text":"Biscuit's ears droop down while she speaks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_25","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_25","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_26","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_26","text":"Why do you think the dogs ran away?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_27","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_27","text":"They've never done that before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_28","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_28","text":"Why don't we ask them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_29","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_29","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_30","text":"Let's find the dogs and ask them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_31","type":"Self","speaker":null,"key":"Locale_SubScenario:event_bowwowparadise_01_e_31","text":"There must be a reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bowwowparadise_01_e_32","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_bowwowparadise_01_e_32","te