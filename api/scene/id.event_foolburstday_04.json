{"id":"event_foolburstday_04","cat":"event","group":{"id":"ev130007","label":"Foolburstday"},"label":"Robot Feast","stage":null,"prev":"event_foolburstday_03","next":"event_foolburstday_05","speakers":{"privaty_m":"Privaty","mechashifty":"Mecha Shifty","cocoa":"Cocoa","ade":"Ade","soda":"Soda"},"icons":{"privaty_m":"si_c313_00_s","mechashifty":"si_c993_00_s","cocoa":"si_c311_00_s","ade":"si_c310_00_s","soda":"si_c312_00_s"},"lines":[{"id":"event_foolburstday_04_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_1","text":"So much has happened in such a short span of time, so I decide to go to the Maid Cafe to soothe both my mind and my hunger.","jump":null,"exit":false,"enter":null,"bg":"MaidCafe","bgArt":"maidcafe","image":null,"bgm":"bgm_story_daytoday","movie":null,"shown":["mechashifty","privaty_m"],"affinity":null},{"id":"event_foolburstday_04_2","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_2","text":"I'll have an omurice, please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_3","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_3","text":"Yes, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_4","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_4","text":"Um... and you, Master? Is there anything you would like to order?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_5","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_5","text":"I can order whatever I want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_6","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_6","text":"Yes, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_7","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_7","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_8","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_8","text":"Are you a hu... er, what I mean is, you are aware of what type of establishment this is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_9","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_9","text":"Of course I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_10","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_10","text":"All the information about the Outpost is stored digitally in my brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_11","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_11","text":"This place sells cheap food at exorbitant prices,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_12","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_12","text":"and gets away with it because they've got hot female servers dressed up in maid outfits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_13","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_13","text":"Wh-what did you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_14","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_14","text":"I don't see the appeal myself, but since I'm meant to learn more about human emotions, I'll play along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_15","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_15","text":"I'm sorry, but I must respond to that accusation you just made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_16","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_16","text":"There's more to the Maid Cafe than servers dressed in maid outfits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_17","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_17","text":"It's a place where the customers and staff respect each other, and have a therapeutic experience through this mutual hospitality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_18","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_18","text":"I cannot tolerate someone so crudely dismissing such a precious place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_19","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_19","text":"Privaty sure does take being a maid seriously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_20","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_20","text":"Does the fact she belongs to Triangle, which itself is part of the Central Government, even matter anymore?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_21","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_22","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_22","text":"At any rate, if you are to frequent our establishment, I would kindly ask you to conduct yourself in a civilized fashion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_23","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_23","text":"Understood. I will act appropriately as the surroundings dictate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_24","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_24","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_25","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_25","text":"Now then, what would you like to order?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_26","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_26","text":"A glass of your finest gasoline, and quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_27","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_27","text":"You run on gasoline? Actually, more importantly, where are your manners?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_28","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_28","text":"Don't worry about that. Just bring over the gasoline, and make it snappy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_29","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_29","text":"Ugh! I just can't with you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_30","text":"Mecha Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_31","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_31","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_32","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_32","text":"Apologize right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_33","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_33","text":"Once you've done that, we're leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_34","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_34","text":"What? I did nothing wrong. I was simply behaving in accordance with how I see the environment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_lastbullet","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_35","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_35","text":"You're free to have your own opinion about this place,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_36","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_36","text":"but that doesn't mean you should say those thoughts out loud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_37","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_37","text":"There's something called mutual respect in society. It means that you don't blurt out whatever comes to mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_38","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_38","text":"You're suppressing my freedom of expression.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_39","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_39","text":"Freedom of expression doesn't excuse being a jerk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_40","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_40","text":"It doesn't matter what your personal opinions are. You shouldn't insult people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_41","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_41","text":"Regardless of how you feel, or even if you're in fact correct, you still need to be careful with your words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_42","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_42","text":"That's what being respectful is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_43","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_43","text":"Commander... I mean, Master...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_44","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_45","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_45","text":"Okay, I was rude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_46","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_04_46","text":"As an apology, I will perform a display of self-destruction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_47","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_47","text":"Er... please don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_48","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_48","text":"And you don't need to leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_49","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_49","text":"Like I said before, this is meant to be a therapeutic space.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_daytoday","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_50","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_50","text":"You didn't know, and you apologized, so it's fine.",