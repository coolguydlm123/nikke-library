y_04_57","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_foolburstday_04_57","text":"Ade and Soda deserve a good rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_58","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_04_58","text":"What about Privaty...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_59","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_foolburstday_04_59","text":"She came to hang out, but then ended up helping out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_60","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_60","text":"I... I just came to lend a hand is all. It's not because I thought you couldn't handle it on your own or anything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_61","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_foolburstday_04_61","text":"That's very nice of you to say, Privaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_62","type":"Speech","speaker":"privaty_m","key":"Locale_SubScenario:event_foolburstday_04_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_04_63","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_foolburstday_04_63","text":"Anyway, dig in before it gets cold.","jump":null,"exit":false,"enter":null,"bg":null,"b