{"id":"d_counseling_viper_20","cat":"counsel","group":{"id":"char1022","label":"Viper"},"label":"Advising Viper: 20","stage":null,"prev":"d_counseling_viper_19","next":null,"speakers":{"viper":"Viper"},"icons":{"viper":"si_c112_00_s"},"lines":[{"id":"d_counseling_viper_20_1","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_1","text":"I'm not really in a good mood today.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["viper"],"affinity":"_0"},{"id":"d_counseling_viper_20_2","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_2","text":"My makeup didn't come out right, and my hair is a mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_20_3","text":"I didn't expect you to care about stuff like that.","jump":"d_counseling_viper_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_viper_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_20_4","text":"We can always reschedule our session for another time.","jump":"d_counseling_viper_20_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_viper_20_5","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_5","text":"Of course. Physical attributes are useful in many ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_20_6","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_6","text":"Everyone's a sucker for a pretty lady. I have an easier time persuading people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_20_7","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_7","text":"I wonder if that applies to you as well?","jump":"d_counseling_viper_20_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_20_8","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_8","text":"You really don't know how to take a hint, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_20_9","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_9","text":"If I didn't want to talk to you, then I wouldn't have come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_20_10","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_20_10","text":"I always feel a little better when I see you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_20_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_viper_20_11","text":"I have a conversation with Viper about the powers of physical attributes.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}