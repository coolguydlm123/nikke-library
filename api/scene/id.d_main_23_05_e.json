{"id":"d_main_23_05_e","cat":"main","group":{"id":"ch23","label":"Chapter 23 · Prison"},"label":"Snake in the Grass: B","stage":"23-16 STAGE · End","prev":"d_main_23_05_s","next":"d_main_23_06_s","speakers":{"viper":"Viper","rapi":"Rapi","Self":"Commander"},"icons":{"viper":"si_c112_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_23_05_e_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_05_e_1","text":"Viper continues to walk with her back to us.","jump":null,"exit":false,"enter":null,"bg":"Drain","bgArt":"drain","image":null,"bgm":"bgm_greyhaze_b","movie":null,"shown":["viper","rapi"],"affinity":null},{"id":"d_main_23_05_e_2","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_2","text":"The Raptures breached in through the hole made in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_3","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_3","text":"If the timing had been off by even the slightest margin, things could have really gone sour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_4","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_4","text":"But we made it happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_5","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_5","text":"And now you've come to apprehend us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_6","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_6","text":"In order to buy ourselves some time, we made it appear like Heavenly Ascension was behind it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_7","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_7","text":"However, I suppose it was only a matter of time before we were caught.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_8","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_8","text":"It's okay now, since everyone is busy with the Raptures,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_9","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_9","text":"but if the entire Ark devoted itself to tracking us down...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_10","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_10","text":"Hehe. Well, I doubt we'd last more than an hour at best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_11","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_05_e_11","text":"(Rapi. Cut the large cable line with the yellow dots.)","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_05_e_12","text":"(Should I cut it completely?)","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_13","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_05_e_13","text":"(Yes, but do it in small increments, so Viper doesn't know.)","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_05_e_14","text":"(Roger).","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_15","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_15","text":"I knew it would all catch up to us eventually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_16","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_16","text":"You could have just waited, Honey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_17","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_17","text":"Why did you come looking for us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_18","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_05_e_18","text":"Was there something else you wanted to do to us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_19","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_23_05_e_19","text":"I want to get even for you plugging me in the stomach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_05_e_20","type":"Speech","speaker":"viper","key":"Locale_MainScenar