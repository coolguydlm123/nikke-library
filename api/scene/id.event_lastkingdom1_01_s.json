{"id":"event_lastkingdom1_01_s","cat":"event","group":{"id":"ev40045","label":"LAST KINGDOM · Part 1"},"label":"Kingdom Life: A","stage":null,"prev":"event_lastkingdom1_prologue","next":"event_lastkingdom1_01_e","speakers":{"chime":"Chime","kilo":"Kilo","crown":"Crown","kilo_op_c":"Kilo","talos":"T.A.L.O.S."},"icons":{"chime":"si_c331_00_s","kilo":"si_c977_00_s","crown":"si_c330_00_s","kilo_op_c":"si_c977_00_s","talos":"si_c361_00_s"},"lines":[{"id":"event_lastkingdom1_01_s_1","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_1","text":"Listen well.","jump":null,"exit":false,"enter":null,"bg":"CrownCastleFrontYard_d","bgArt":"crowncastlefrontyard_d","image":null,"bgm":"event_bgm_lastkingdom_morningstar","movie":null,"shown":["kilo","talos","chime","crown"],"affinity":null},{"id":"event_lastkingdom1_01_s_2","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_2","text":"Now that you are a citizen, you must work for the kingdom and its king.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_3","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_3","text":"What do you mean by work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_4","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_4","text":"It's simple. You're to venture beyond our kingdom's walls and bring back whatever seems useful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_5","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_5","text":"What? I'm supposed to go out and collect junk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_6","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_6","text":"It's not junk. We are giving long-forgotten objects a renewed sense of purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_7","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_7","text":"To be a king is to infuse everything around you with purpose. That is my main goal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_8","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_8","text":"How come you're saying \"king\" and not \"queen\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_9","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_9","text":"Because the king holds the highest position in the kingdom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_10","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_10","text":"... Uh-huh. Gotcha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_11","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_11","text":"Of course, we do far more than merely scavenge items.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_12","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_12","text":"If we encounter someone wandering the surface, we recruit them as our subjects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_13","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_13","text":"Recruit, you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_14","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_14","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_15","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_15","text":"Our finding you was a very fortunate development since we lost a valuable citizen recently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_16","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_16","text":"You are referring to the one in red?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_17","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_17","text":"There is no need for sadness. Perhaps we will meet her again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_18","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_18","text":"Okay,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_19","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_19","text":"I get that this is your kingdom, Crown's the king, and Chime's the royal aide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_20","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_20","text":"But... where are all these so-called \"citizens\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_21","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_21","text":"We have you, don't we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_22","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_22","text":"Uh, yeah, I guess. But when you throw around words like \"kingdom\", I just... expected more people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_23","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_23","text":"Chime, how many subjects are there in our kingdom at the moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_24","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_24","text":"82, including Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_25","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_25","text":"That many? But I don't see anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_26","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_26","text":"They're up on the surface conducting expeditions for the kingdom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_27","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_27","text":"I have enacted no law that mandates citizens to remain inside the kingdom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_28","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_28","text":"It comprises 12 clauses in total. Though challenging to memorize, with some effort on your part, it is certainly possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_29","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_29","text":"Er... okay, I'll get right on that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_30","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_30","text":"So are all the citizens Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_31","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_31","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_32","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_32","text":"No, they're not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_33","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_33","text":"The birds flying in the sky, the fish swimming across the ocean, the horses galloping across the prairie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_34","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_01_s_34","text":"Everyone who has received the grace of the kingdom is a citizen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_35","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_35","text":"Oh, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_36","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_36","text":"Huh? Wait a moment. I think there's something weird with T.A.L.O.S.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_37","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_37","text":"T.A.L.O.S.? Oh yes, the robot you rode here on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_38","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_01_s_38","text":"Now that you mention it, I have a few questions pertaining to that robot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_39","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom1_01_s_39","text":"Just a moment. Give me five minutes to check the cockpit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom1_01_s_40","text":"Kilo quickly climbs into T.A.L.O.S.'s cockpit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom1_01_s_41","text":"The cockpit door closes with a hydraulic hiss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_42","type":"Speech","speaker":"kilo_op_c","key":"Locale_MainScenario:event_lastkingdom1_01_s_42","text":"T.A.L.O.S., wake up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_boing","movie":null,"shown":["kilo_op_c"],"affinity":null},{"id":"event_lastkingdom1_01_s_43","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_43","text":"Reboot complete. Hello, Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_44","type":"Speech","speaker":"kilo_op_c","key":"Locale_MainScenario:event_lastkingdom1_01_s_44","text":"Let's blow this joint. These cult weirdoes are giving me the creeps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_45","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_45","text":"Shall I set the escape route to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_46","type":"Speech","speaker":"kilo_op_c","key":"Locale_MainScenario:event_lastkingdom1_01_s_46","text":"Yes, do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_47","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_47","text":"Power reserves are currently insufficient to reach the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_48","type":"Speech","speaker":"kilo_op_c","key":"Locale_MainScenario:event_lastkingdom1_01_s_48","text":"How much do we need?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_49","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_49","text":"Such a journey would require a full charge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_50","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_50","text":"If we utilize the battery provided by the self-proclaimed king and the royal aide, a full charge will require 17 hours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_51","type":"Speech","speaker":"kilo_op_c","key":"Locale_MainScenario:event_lastkingdom1_01_s_51","text":"Forget all that. This place is coo-coo bananas. We've gotta get out of here, pronto.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_52","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_52","text":"I do not recommend such a course of action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_53","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_53","text":"The surface is a dangerous place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_54","type":"Speech","speaker":"kilo_op_c","key":"Locale_MainScenario:event_lastkingdom1_01_s_54","text":"So you're suggesting I should stay with these weirdo Nikkes? Surely that can't be safe either?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_55","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_55","text":"This location appears to have significant signal-jamming capabilities. Raptures will be unable to detect us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_01_s_56","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom1_01_s_56","text":