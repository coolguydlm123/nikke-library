{"id":"event_hightechtoy_01_s","cat":"event","group":{"id":"ev40002","label":"Hightech Toy"},"label":"Heroes, to the Surface!: A","stage":null,"prev":"event_hightechtoy_prologue","next":"event_hightechtoy_01_e","speakers":{"andersen":"Andersen","laplace":"Laplace","drake":"Drake","maxwell_w":"Maxwell"},"icons":{"andersen":"si_c903_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s","maxwell_w":"si_c102_01_s"},"lines":[{"id":"event_hightechtoy_01_s_1","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_hightechtoy_01_s_1","text":"Many of the mass-produced Nikkes that have been sent up the surface have gone missing.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":["andersen"],"affinity":null},{"id":"event_hightechtoy_01_s_2","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_hightechtoy_01_s_2","text":"As of now, we haven't discovered any reasoning as to why this is happening,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_01_s_3","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_hightechtoy_01_s_3","text":"but our best guess is that the Black Smith or some other Raptures are behind it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_01_s_4","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_01_s_4","text":"Am I to attempt to ascertain the reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_01_s_5","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_hightechtoy_01_s_5","text":"That was the plan, but Syuen contacted me out of the blue.","jump":null,"exit":false,"enter":null,"b