_court_09_41","text":"You held fan meet-and-greets in quiet neighborhoods and brought business back to the area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_09_42","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_09_42","text":"You let everyone know you were in the area, so the crime rates dropped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_09_43","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_09_43","text":"How's any of that villainous? Anyone can see those are good deeds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_09_44","type":"Speech","speaker":"yulha","key":"Locale_SuddenStory:d_ex_court_09_44","text":"Newbie, get her out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_09_45","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_09_45","text":"This is bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_09_46","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_09_46","text":"If Drake and I leave now, she'll throw a fit over being looked down on as a villain,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_09_47","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_09_47","text":"and I might end up spending hours listening to her ramble about all her great villainous exploits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":n