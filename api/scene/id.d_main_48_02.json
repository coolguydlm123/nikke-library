48_02_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_48_02_27","text":"We know! But we can at least cut them off in the middle!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_28","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_48_02_28","text":"T-take hold, everyone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_29","text":"Ziz flies up into the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_30","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_30","text":"She spreads her wings and deploys a black veil downward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_31","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_31","text":"Just as the Counters are about to grab on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["egovista"],"affinity":null},{"id":"d_main_48_02_32","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_48_02_32","text":"Where goest thou in such haste?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_boss_xbg005","movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_48_02_33","text":"*Swoosh!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_34","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_48_02_34","text":"Wh-what the...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_35","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_35","text":"The black wings are sliced in two, and Ziz plummets to the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_36","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_48_02_36","text":"Since thou hast journeyed thus far, prithee leave thy head as a gift before parting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_37","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_48_02_37","text":"Egovista!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_38","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:d_main_48_02_38","text":"Oh, so you're the shoddy knockoff of Scarlet and Isabel!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_39","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_48_02_39","text":"... What's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_48_02_40","text":"If you're so confident in close-quarters combat, I'll be your opponent!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_41","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_48_02_41","text":"Are ye the greatest combatants amongst this rabble?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_42","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_48_02_42","text":"Excellent. My spirits had grown dull for want of a worthy adversary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_43","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_48_02_43","text":"Let's go, Rapi! I'll take the left!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_48_02_44","text":"No, you take the right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_45","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_48_02_45","text":"And as they draw your attention...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_48_02_46","text":"*Bang! Bang! Bang!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_47","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_47","text":"Rapi and Behemoth split off to either side as they charge towards Egovista.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_48","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_48","text":"Egovista's front is left wide open, and Neon, standing right in front of her, unleashes a barrage of rocket fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_49","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_48_02_49","text":"Mark me well. Naught exists but what my blade can cleave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_50","text":"Egovista raises her sword.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_51","text":"Just as she is about to swing at the incoming barrage,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["altruia"],"affinity":null},{"id":"d_main_48_02_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_52","text":"a familiar silhouette steps in to block her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_53","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_48_02_53","text":"Do not waste your strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_54","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_48_02_54","text":"Altruia deploys a shield, blocking Neon's attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affi