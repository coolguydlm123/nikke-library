{"id":"d_main_48_02","cat":"main","group":{"id":"ch48","label":"Chapter 48 · Reborn"},"label":"The Silent Titan","stage":"48-14 STAGE · End","prev":"d_main_48_01","next":"d_main_48_03","speakers":{"anis_i_w":"Anis","snowwhite_h":"Snow White","behemoth":"Behemoth","rapi_red":"Rapi","leviathan":"Leviathan","bahamut":"Bahamut","ziz":"Ziz","neon_v_w":"Neon","egovista":"Egovista","altruia":"Altruia"},"icons":{"anis_i_w":"si_c017_00_s","snowwhite_h":"si_c471_00_s","behemoth":"si_c560_00_s","rapi_red":"si_c016_00_s","leviathan":"si_c562_00_s","bahamut":"si_c563_00_s","ziz":"si_c561_00_s","neon_v_w":"si_c018_00_s","egovista":"si_c9025_00_s","altruia":"si_c9017_00_s"},"lines":[{"id":"d_main_48_02_1","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:d_main_48_02_1","text":"What's going on?! They just keep coming!","jump":null,"exit":false,"enter":null,"bg":"SpaceElevator","bgArt":"spaceelevator","image":null,"bgm":"bgm_chapter48_spot_reborn_a_loop","movie":null,"shown":["bahamut","ziz","behemoth","snowwhite_h","anis_i_w","neon_v_w","rapi_red","leviathan"],"affinity":null},{"id":"d_main_48_02_2","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_48_02_2","text":"Then we just need to keep wiping them out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_3","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_48_02_3","text":"Time to transform!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_4","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_48_02_4","text":"No! We don't know when a Heretic will appear! Conserve your strength!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_5","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_48_02_5","text":"But we can't keep fighting these things like this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_6","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_48_02_6","text":"I, the sagacious Bahamut, shall inform you. The Raptures are currently—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_7","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_48_02_7","text":"If you're going to say something stupid again, save it! We're too busy fighting to deal with your rambling!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_8","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_48_02_8","text":"... Some of them are heading toward the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_9","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_48_02_9","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_10","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_48_02_10","text":"Ziz!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_11","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_48_02_11","text":"I-I'm on it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_02_12","type":"Monologue","speaker":null,"key":"Locale_MainS