{"id":"msg_m_ex_seraphim_03","cat":"messenger","group":{"id":"room_seraphim","label":"Seraphim · Group"},"label":"4. Commander.","stage":null,"prev":"msg_m_event_fullfoolday_03","next":"msg_m_ex_seraphim_04","speakers":{"pepper":"Pepper","mary":"Mary"},"icons":{"pepper":"si_c131_00_s","mary":"si_c130_00_s"},"lines":[{"id":"m_ex_seraphim_03_1","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_1","text":"Commander.","jump":null},{"id":"m_ex_seraphim_03_2","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_2","text":"Can I talk to you for a moment?","jump":null},{"id":"m_ex_seraphim_03_3","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_3","text":"Pepper,","jump":null},{"id":"m_ex_seraphim_03_4","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_4","text":"this is a group chat.","jump":null},{"id":"m_ex_seraphim_03_5","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_5","text":"You didn't mistake it for a private conversation, did you?","jump":null},{"id":"m_ex_seraphim_03_6","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_6","text":"No!","jump":null},{"id":"m_ex_seraphim_03_7","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_7","text":"I meant to send this in the group chat.","jump":null},{"id":"m_ex_seraphim_03_8","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_8","text":"Oh?","jump":null},{"id":"m_ex_seraphim_03_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_03_9","text":"So what is it?","jump":null},{"id":"m_ex_seraphim_03_10","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_10","text":"I personally feel that,","jump":null},{"id":"m_ex_seraphim_03_11","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_11","text":"if for nothing else than the sake of reassuring their patients,","jump":null},{"id":"m_ex_seraphim_03_12","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_12","text":"doctors should themselves lead a healthy lifestyle.","jump":null},{"id":"m_ex_seraphim_03_13","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_13","text":"If you stretch yourself too thin and don't take care of yourself,","jump":null},{"id":"m_ex_seraphim_03_14","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_14","text":"it'll end up showing in your physical appearance, and your bedside manner.","jump":null},{"id":"m_ex_seraphim_03_15","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_15","text":"Wouldn't you both agree?","jump":null},{"id":"m_ex_seraphim_03_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_03_16","text":"I'd say that's a valid point.","jump":null},{"id":"m_ex_seraphim_03_17","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_17","text":"You're right.","jump":null},{"id":"m_ex_seraphim_03_18","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_18","text":"No matter how skilled a doctor is,","jump":null},{"id":"m_ex_seraphim_03_19","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_19","text":"if they look like they're about to keel over,","jump":null},{"id":"m_ex_seraphim_03_20","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_20","text":"it won't be good for the patients' morale.","jump":null},{"id":"m_ex_seraphim_03_21","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_21","text":"That's a very perceptive observation, Pepper.","jump":null},{"id":"m_ex_seraphim_03_22","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_22","text":"Mary...","jump":null},{"id":"m_ex_seraphim_03_23","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_23","text":"Yes?","jump":null},{"id":"m_ex_seraphim_03_24","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_24","text":"I was...","jump":null},{"id":"m_ex_seraphim_03_25","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_25","text":"talking about you.","jump":null},{"id":"m_ex_seraphim_03_26","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_26","text":"!!","jump":null},{"id":"m_ex_seraphim_03_27","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_27","text":"We've had a big influx of patients recently,","jump":null},{"id":"m_ex_seraphim_03_28","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_28","text":"but you've continued to work non-stop.","jump":null},{"id":"m_ex_seraphim_03_29","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_29","text":"You've even been studying and giving lectures on holidays.","jump":null},{"id":"m_ex_seraphim_03_30","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_30","text":"Have I?","jump":null},{"id":"m_ex_seraphim_03_31","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_31","text":"Yes!","jump":null},{"id":"m_ex_seraphim_03_32","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_32","text":"Commander, say something.","jump":null},{"id":"m_ex_seraphim_03_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_03_33","text":"Doesn't that schedule make you exhausted, Mary?","jump":null},{"id":"m_ex_seraphim_03_34","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_34","text":"Hmm...","jump":null},{"id":"m_ex_seraphim_03_35","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_35","text":"It's something that I enjoy doing,","jump":null},{"id":"m_ex_seraphim_03_36","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_36","text":"so I've never felt the slightest bit tired.","jump":null},{"id":"m_ex_seraphim_03_37","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_37","text":"But if my appearance makes patients feel uneasy,","jump":null},{"id":"m_ex_seraphim_03_38","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_38","text":"then it definitely warrants further consideration.","jump":null},{"id":"m_ex_seraphim_03_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_03_39","text":"How about taking a vacation?","jump":null},{"id":"m_ex_seraphim_03_40","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_40","text":"I can't leave the patients behind.","jump":null},{"id":"m_ex_seraphim_03_41","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_41","text":"Anything could happen while I'm gone.","jump":null},{"id":"m_ex_seraphim_03_42","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_42","text":"I'm here too, you know!","jump":null},{"id":"m_ex_seraphim_03_43","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_43","text":"But then you'll have to take on twice the work.","jump":null},{"id":"m_ex_seraphim_03_44","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_44","text":"Er...","jump":null},{"id":"m_ex_seraphim_03_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_03_45","text":"How about this...","jump":null},{"id":"m_ex_seraphim_03_46","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_46","text":"What have you got in mind, Commander?","jump":null},{"id":"m_ex_seraphim_03_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_03_47","text":"Let's all regularly meet for tea in the hospital lounge, the three of us.","jump":null},{"id":"m_ex_seraphim_03_48","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_48","text":"Oooh,","jump":null},{"id":"m_ex_seraphim_03_49","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_49","text":"that's a lovely idea.","jump":null},{"id":"m_ex_seraphim_03_50","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_03_50","text":"How about we start today?","jump":null},{"id":"m_ex_seraphim_03_51","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_51","text":"That sounds wonderful!","jump":null},{"id":"m_ex_seraphim_03_52","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_03_52","text":"I'll stop by the hospital after work.","jump":null},{"id":"m_ex_seraphim_03_53","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_53","text":"Sounds good.","jump":null},{"id":"m_ex_seraphim_03_54","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_03_54","text":"Thank you, Commander!","jump":null}],"chat":true}