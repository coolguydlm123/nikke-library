{"id":"d_main_28_06","cat":"main","group":{"id":"ch28","label":"Chapter 28 · The Unknown"},"label":"The End of a Dangerous Road","stage":"28-28 STAGE · Start","prev":"d_main_28_05_e","next":"d_main_28_07_s","speakers":{"elegg":"Elegg","hammering":"Hammering","liveryn":"Liveryn","rapi":"Rapi","anis":"Anis","neon":"Neon","shifty":"Shifty"},"icons":{"elegg":"si_c500_00_s","hammering":"si_c490_00_s","liveryn":"si_c480_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","shifty":"si_c907_00_s"},"lines":[{"id":"d_main_28_06_1","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_06_1","text":"Darn, there's a puddle of water in the way.","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":"bgm_destroyingcalamity_b","movie":null,"shown":["rapi","liveryn","elegg","hammering"],"affinity":null},{"id":"d_main_28_06_2","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_06_2","text":"What's the big deal? Just step over it. It's shallow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_3","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_06_3","text":"Can you carry me for a bit? Electronic devices are susceptible to water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_4","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_06_4","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_5","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_5","text":"Can you carry me too, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_28_06_6","text":"If you're not feeling well, I can carry you, Liveryn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_7","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_7","text":"... Never mind, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_28_06_8","text":"A few moments later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["anis","neon"],"affinity":null},{"id":"d_main_28_06_9","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_06_9","text":"The ceiling is awfully low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_destroyingcalamity","movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_06_10","text":"We might have to crawl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_06_11","text":"Crawling is our specialty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_06_12","text":"Do you want to go first, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_13","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_06_13","text":"Even if I'm crawling, I might have a hard time squeezing through there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_06_14","text":"Then just lie down. I'll pull you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_15","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_06_15","text":"Okay, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_06_16","text":"You make it sound like she's a piece of luggage...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_17","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_17","text":"I'm surprised you were able to find a passable route.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_28_06_18","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_18","text":"None of the scans I conducted found any viable routes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_19","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_19","text":"Well, this is what I do for a living.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_20","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_20","text":"Do you have any tips for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_21","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_21","text":"Sorry, can't go sharing trade secrets. Gotta make my money somehow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_28_06_22","text":"A few moments later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["elegg"],"affinity":null},{"id":"d_main_28_06_23","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_23","text":"It's too dark in here. I can't see anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_24","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_24","text":"Not even changing to night vision helps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_25","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_26","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_26","text":"What should I do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_27","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_27","text":"Commander, could you hold my hand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_28_06_28","text":"*Slap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_29","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_06_29","text":"Ow, who just slapped the back of my hand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_06_30","text":"All right, it's time for me to shine once again... pardon the pun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_31","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_06_31","text":"Twinkle Vision, activate!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_28_06_32","text":"*Pop*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_33","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_06_33","text":"You do realize each of our phones has flashlights on them, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_06_34","text":"Sure, but isn't it cooler when I do it with my eyes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_28_06_35","text":"A few moments later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_main_28_06_36","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_36","text":"Turn a little more to the left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_28_06_37","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_37","text":"Okay, no threats detected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_06_38","text":"Never thought we'd use the operation device like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_39","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_39","text":"The camera provides a surprisingly good view of your surroundings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_40","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_40","text":"It's also small enough to attach to your ear, so I can check narrow areas that a person wouldn't be able to cross through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_06_41","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_06_41","text":"The only reason this usually doesn't happen is because it's 