kke_guillotine_04_6","text":"The street is now deserted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_7","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_7","text":"The corrupted Nikke stands in the middle of the street, firing her gun repeatedly like a malfunctioning machine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_8","type":"Speech","speaker":"erodednikke","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_8","text":"I was a Nikke","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_9","type":"Speech","speaker":"erodednikke","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_9","text":"made to protect the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_10","type":"Speech","speaker":"erodednikke","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_10","text":"I must protect the Raptures and help them reclaim the surface. I must help them regain the glory of the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_11","type":"Speech","speaker":"erodednikke","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_11","text":"To do this, I must kill humans. Kill them all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["guillotine"],"affinity":null},{"id":"d_nikke_guillotine_04_12","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_12","text":"What is this?","jump":"d_nikke_guillotine_04_14","exit":false,"ente