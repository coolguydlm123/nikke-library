Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_19","text":"In a way, it's ironic.","jump":"d_nikke_guillotine_04_21","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_20","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_20","text":"Humans sold their souls to the devil, and now he's come to collect.","jump":"d_nikke_guillotine_04_23","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_21","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_21","text":"Perhaps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_22","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_22","text":"The Raptures have exploited the weaknesses in human technology and made a mockery of it.","jump":"d_nikke_guillotine_04_26","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_23","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_23","text":"... This is all certainly a new experience, I can say that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_24","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_24","text":"Humans used a few trivial orders to brainwash Nikkes, and now they're paying the price.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_25","type":"Speech","speaker":"guillotine","key"