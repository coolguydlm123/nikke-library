ype":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_72","text":"Listen up, you moron.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_73","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_73","text":"Do you realize what will happen if I don't execute her? All the friends and family of those lying dead back there will go ballistic, not to mention the Nikkephobia groups! It'll be chaos.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_74","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_74","text":"Who's going to take the responsibility for that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_75","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_75","text":"What about suppressing demonstrations? Who's going to step in when public order ceases to exist and this city falls into shambles?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_76","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_76","text":"You? Your boss? Or Ingrid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_78","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_78","text":"Get out of the way. Don't make me say it again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_79","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_79","text":"You can't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_80","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_80","text":"*Click*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_81","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_81","text":"I feel the corrupted Nikke press the gun barrel against my back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_82","type":"Speech","speaker":"erodednikke","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_82","text":"You are, are, are a human being. I must kill you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_83","type":"Speech","speaker":"erodednikke","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_83","text":"For, for, for the sake of Raptures, humans, Raptures, all humans must be killed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_84","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_84","text":"You see?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_85","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_85","text":"There's no use in trying to reason with it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_86","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_86","text":"Guillotine takes off her eye patch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_87","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_87","text":"The power of darkness that dwells within me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_88","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_88","text":"the pulsating energy lying dormant under the Devil Prince's wings","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_89","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_89","text":"awaken from your slumber, and offer rest to this poor soul.","jump":null,"exit":false,"enter":null,"bg":"White","bgArt":"white","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_90","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_90","text":"Extermination!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_91","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_92","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_92","text":"Although it doesn't quite live up to Guillotine's blood-and-thunder speech","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_mystery","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_93","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_93","text":"some kind of wave does emit from her right eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_94","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_94","text":"The corrupted Nikke collapses, and lies still.","jump":null,"exit":false,"enter":null,"bg":"Backstreet_n","bgArt":"backstreet_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_95","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_95","text":"What was that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["guillotine"],"affinity":null},{"id":"d_nikke_guillotine_04_96","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_96","text":"Didn't you see? The One-Winged Dark Lord allowed her to rest in peace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_97","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_97","text":"If you want to get technical, it identifies all brains within one meter that are not registered as citizens. It stops their brainwaves from fluctuating, then it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_98","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_98","text":"Bah, I'm not in the mood to explain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_99","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_99","text":"What will happen to her now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_100","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_100","text":"She'll be taken to the factory, where she'll be disassembled and either used to produce a new Nikke","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_101","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_101","text":"or utilized for corrosion code research.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_102","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_102","text":"All in the name of The Big O leading mankind towards a better future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_103","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_103","text":"Is there no funeral?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_104","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_104","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_105","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_105","text":"You've got one hell of a sense of humor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_106","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_106","text":"Who on earth would hold a funeral for a machine past its expiration date?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_107","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_107","text":"A Nikke is not a machine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_108","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_108","text":"Haha, my point is that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_109","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_109","text":"this is how the people in The Big O feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_110","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_110","text":"So spare me the death glare, because this isn't a problem that I can solve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_111","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_111","text":"A.C.P.U. sirens began to blare out in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_112","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_112","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_113","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_113","text":"Time for this urban legend to make herself scarce.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_114","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_114","text":"The A.C.P.U. will be here soon. After they're done dealing with everything here, they'll have the Nikke's body recycled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_115","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_115","text":"When the time comes, you can try to ask Poli or Miranda if there's anything they can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_116","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_116","text":"Almost all of her parts will be reused, but not her brain. They have no use for it anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_117","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_117","text":"... I'm willing to bet those guys would listen to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_118","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_118","text":"Guillotine turns and leaves, jacket flapping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_119","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_119","text":"... Soon after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_120","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_120","text":"Commander, is that you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["miranda","poli"],"affinity":null},{"id":"d_nikke_guillotine_04_121","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_121","text":"What are you doing wandering around here? This place is dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_122","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_122","text":"I intend on cremating the brain of this dead Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_123","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_123","text":"Um... come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_124","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_04_124","text":"I want to give her a dignified death, something that a human would have.  Even if it is only a part of her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_125","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_125","text":"Um... well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_126","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_126","text":"Let me confirm and see if I have that authority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_127","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_127","text":"Miranda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_128","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_128","text":"It's fine, just do as the Commander says.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_04_129","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_guillotine_04_129","text":"From where I'm standing, this is the right thing to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}