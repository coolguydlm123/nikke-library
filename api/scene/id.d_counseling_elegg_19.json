{"id":"d_counseling_elegg_19","cat":"counsel","group":{"id":"char5107","label":"Elegg"},"label":"Advising Elegg: 19","stage":null,"prev":"d_counseling_elegg_18","next":"d_counseling_elegg_20","speakers":{"elegg":"Elegg"},"icons":{"elegg":"si_c500_00_s"},"lines":[{"id":"d_counseling_elegg_19_1","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_1","text":"Mr. Commander, did you know that electricity can change color?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["elegg"],"affinity":"_0"},{"id":"d_counseling_elegg_19_2","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_2","text":"Depending on the temperature and air composition, it can come in different hues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_19_3","text":"I didn't know that.","jump":"d_counseling_elegg_19_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_elegg_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_19_4","text":"Actually, I did know that.","jump":"d_counseling_elegg_19_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_elegg_19_5","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_5","text":"This principle is actually something we see in our everyday lives, although you'd never guess where:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_6","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_6","text":"It's neon signs!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_7","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_7","text":"The reason neon signs have various colors is because they use different combinations of gases.","jump":"d_counseling_elegg_19_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_8","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_8","text":"No kidding!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_9","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_9","text":"You know way more about this stuff than I thought you would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_10","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_10","text":"I won't lie, though; it is a little disappointing that I won't have much to teach you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_11","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_19_11","text":"Then... did you know that neon signs operate using these principles?","jump":"d_counseling_elegg_19_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_19_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_19_12","text":"Elegg and I enthusiastically discuss how neon signs work.","