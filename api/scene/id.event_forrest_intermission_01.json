","speaker":"trina","key":"Locale_SubScenario:event_forrest_intermission_01_19","text":"But didn't you say it was okay since Sun was here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_forrest_intermission_01_20","type":"Speech","speaker":"liter_c","key":"Locale_SubScenario:event_forrest_intermission_01_20","text":"That's not what I meant!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_forrest_intermission_01_21","type":"Speech","speaker":"liter_c","key":"Locale_SubScenario:event_forrest_intermission_01_21","text":"If anything, his being here makes it worse!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_forrest_intermission_01_22","type":"Speech","speaker":"trina","key":"Locale_SubScenario:event_forrest_intermission_01_22","text":"Oh, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_forrest_intermission_01_23","type":"Speech","speaker":"liter_c","key":"Locale_SubScenario:event_forrest_intermission_01_23","text":"Stop being ridiculous!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_forrest_intermission_01_24","type":"Speech","speaker":"liter_c","key":"Locale_SubScenario:event_forrest_intermission_01_24","text":"I can't stand here","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_forrest_intermission_01_25","type":"Speech","speaker":"liter_c","key":"Locale_SubScenario:event_forrest_intermission_01_25","text":"and allow you to waltz around naked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":nu