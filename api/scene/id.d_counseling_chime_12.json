{"id":"d_counseling_chime_12","cat":"counsel","group":{"id":"char5157","label":"Chime"},"label":"Advising Chime: 12","stage":null,"prev":"d_counseling_chime_11","next":"d_counseling_chime_13","speakers":{"chime":"Chime"},"icons":{"chime":"si_c331_00_s"},"lines":[{"id":"d_counseling_chime_12_1","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_1","text":"Oh my... the sky hath turned all cloudy.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["chime"],"affinity":"_0"},{"id":"d_counseling_chime_12_2","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_2","text":"Methinks we are in for a downpour, I daresay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_12_3","text":"I'm sure it'll feel nice and refreshing.","jump":"d_counseling_chime_12_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_chime_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_12_4","text":"Best to avoid it.","jump":"d_counseling_chime_12_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_chime_12_5","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_5","text":"Surely thou dost not mean to say...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_6","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_6","text":"thou enjoyest being drenched in the rain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_7","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_7","text":"What a curious taste thou hast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_8","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_8","text":"As for me, I shall seek shelter; I've no fondness for the rain.","jump":"d_counseling_chime_12_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_9","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_9","text":"Aye,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_10","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_10","text":"'tis most vexing to be soaked for no reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_11","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_12_11","text":"We must find shelter from this rain forthwith.","jump":"d_counseling_chime_12_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_12_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_chime_12_12","text":"A little later, Chime and I watch the pouring rain together.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}