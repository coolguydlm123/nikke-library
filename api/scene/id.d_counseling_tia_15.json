{"id":"d_counseling_tia_15","cat":"counsel","group":{"id":"char5100","label":"Tia"},"label":"Advising Tia: 15","stage":null,"prev":"d_counseling_tia_14","next":"d_counseling_tia_16","speakers":{"tia":"Tia"},"icons":{"tia":"si_c451_00_s"},"lines":[{"id":"d_counseling_tia_15_1","type":"Speech","speaker":"tia","key":"Locale_Counseling:d_counseling_tia_15_1","text":"I wolfed down 50 desserts at the cafe yesterday.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["tia"],"affinity":"_0"},{"id":"d_counseling_tia_15_2","type":"Speech","speaker":"tia","key":"Locale_Counseling:d_counseling_tia_15_2","text":"You should have seen the owner. They were stunned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tia_15_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_tia_15_3","text":"That's all you ate?","jump":"d_counseling_tia_15_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_tia_15_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_tia_15_4","text":"You ate that much?","jump":"d_counseling_tia_15_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_tia_15_5","type":"Speech","speaker":"tia","key":"Locale_Counseling:d_counseling_tia_15_5","text":"Yeah, I had to stop before I scared the owner too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tia_15_6","type":"Speech","speaker":"tia","key":"Locale_Counseling:d_counseling_tia_15_6","text":"It's a real shame, because I could have eaten way more.","jump":"d_counseling_tia_15_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tia_15_7","type":"Speech","speaker":"tia","key":"Locale_Counseling:d_counseling_tia_15_7","text":"How come you're so surprised?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tia_15_8","type":"Speech","speaker":"tia","key":"Locale_Counseling:d_counseling_tia_15_8","text":"You of all people should know that I usually eat way more than that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tia_15_9","type":"Speech","speaker":"tia","key":"Locale_Counseling:d_counseling_tia_15_9","text":"Looks like I'll have to take you along with me on these cafe excursions.","jump":"d_counseling_tia_15_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tia_15_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_tia_15_10","text":"Tia explains to me how there is a separate stomach for dessert, and another for regular food.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}