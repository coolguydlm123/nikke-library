{"id":"d_main_04_02","cat":"main","group":{"id":"ch4","label":"Chapter 4 · Bouquet"},"label":"Warm Hands","stage":"4-3 STAGE · End","prev":"d_main_04_01","next":"d_main_04_03_s","speakers":{"anis":"Anis","mihara":"Mihara","neon":"Neon","rapi":"Rapi","yuni":"Yuni","Self":"Commander","Narration":"Narration"},"icons":{"anis":"si_c012_00_s","mihara":"si_c161_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","yuni":"si_c160_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_04_02_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_02_1","text":"Mihara.","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":"bgm_floraltribute","movie":null,"shown":["rapi","anis","neon","mihara","yuni"],"affinity":null},{"id":"d_main_04_02_2","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_02_2","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_02_3","text":"Seems to me like the Commander is running off with your woman. Are you okay with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_4","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_02_4","text":"Heh heh, as long as Yuni is happy, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04_02_5","text":"They look like father and daughter from this angle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_02_6","text":"... From the way they walk together, yes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_7","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_04_02_7","text":"Yuni reaches out and begins holding your hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_8","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04_02_8","text":"Heh heh, Commander, can I hold it a little harder?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_9","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04_02_9","text":"... Sure, but just a little bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_10","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_04_02_10","text":"She grabs you tight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_11","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04_02_11","text":"You're cutting off my circulation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_12","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04_02_12","text":"You're so warm, Commander, I like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_02_13","text":"A Nikke who enjoys heat? Never thought I'd see the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_02_14","text":"Could her sensors be malfunctioning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_15","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_02_15","text":"That's not it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_16","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_02_16","text":"Only through physical contact with someone else...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_17","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_02_17","text":"can she ever feel anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_18","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_02_18","text":"I don't know whether she was like this from the very beginning, or if it has something to do with her ability.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_19","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_02_19","text":"Either way, it's made her very... touchy-feely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_02_20","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_02_20","text":"...","jump":nul