{"id":"memorial_101304","cat":"memorial","group":{"id":"memorial101300","label":"Memoirs · A Girl's Memoir"},"label":"July 26, XX (Sunny)","stage":null,"prev":"memorial_101303","next":"memorial_101305","speakers":{},"icons":{},"lines":[{"id":"memorial_101304_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_04_description","text":"I took a carousel ride with Daddy today."},{"id":"memorial_101304_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_04_description","text":"Though the carousel didn't move,"},{"id":"memorial_101304_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_04_description","text":"Daddy hugged me and let me sit on top of the horsey."},{"id":"memorial_101304_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_04_description","text":"We were about to leave when I heard the aliens from the movie making loud noises."},{"id":"memorial_101304_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_04_description","text":"Daddy kept saying that he loved me."}]}