{"id":"d_counseling_anis_star_06","cat":"counsel","group":{"id":"char5169","label":"Anis: Star"},"label":"Advising Anis: Star: 06","stage":null,"prev":"d_counseling_anis_star_05","next":"d_counseling_anis_star_07","speakers":{"anis_i":"Anis"},"icons":{"anis_i":"si_c017_00_s"},"lines":[{"id":"d_counseling_anis_star_06_1","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_1","text":"Ugh...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis_i"],"affinity":"_0"},{"id":"d_counseling_anis_star_06_2","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_2","text":"I'm dying...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_3","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_3","text":"I want to get back on stage so bad it's killing me...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_star_06_4","text":"Don't dwell on it too much.","jump":"d_counseling_anis_star_06_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anis_star_06_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_star_06_5","text":"You'll get another chance someday.","jump":"d_counseling_anis_star_06_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_anis_star_06_6","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_6","text":"I know...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_7","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_7","text":"I get it, but it's not that simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_8","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_8","text":"If things really worked out just because you said they would, I wouldn't be going through this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_9","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_9","text":"Still, it was my choice. I can't take it out on anyone else.","jump":"d_counseling_anis_star_06_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_10","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_10","text":"Thanks, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_11","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_11","text":"But I can't go back just because I miss it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_12","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_12","text":"I chose to retire, so I have to live with that decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_13","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_13","text":"Missing it while moving forward isn't the same as just standing still and looking back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_14","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_06_14","text":"... But it's okay if I miss it a little longer, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_06_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_anis_star_06_15","text":"I watch T.T. STAR's performance with Anis and revisit old memories.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}