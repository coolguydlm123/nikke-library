:m_ex_admi_02_13","text":"What is it?","jump":null},{"id":"m_ex_admi_02_14","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_14","text":"Um...","jump":null},{"id":"m_ex_admi_02_15","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_15","text":"nothing important.","jump":null},{"id":"m_ex_admi_02_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_16","text":"Just tell me.","jump":null},{"id":"m_ex_admi_02_17","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_17","text":"Actually, I'm taking a walk in the park by myself.","jump":null},{"id":"m_ex_admi_02_18","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_18","text":"I've had a lot on my mind recently, so I wanted to have an early night.","jump":null},{"id":"m_ex_admi_02_19","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_19","text":"It's just that I can't seem to fall asleep.","jump":null},{"id":"m_ex_admi_02_20","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_20","text":"even though I'm not physically tired at all.","jump":null},{"id":"m_ex_admi_02_21","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_21","text":"One of the inconveniences of having a mechanical body, I suppose.","jump":null},{"id":"m_ex_admi_02_22","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_22","text":"Emotional exhaustion doesn't affect me physically.","jump":null},{"id":"m_ex_admi_02_23","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_23","text":"So it can be a challenge trying to fall asleep naturally.","jump":null},{"id":"m_ex_admi_02_24","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_24","text":"Oh boy, I'm starting to ramble again...","jump":null},{"id":"m_ex_admi_02_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_25","text":"It's okay.","jump":null},{"id":"m_ex_admi_02_26","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_26","text":"Do you mind","jump":null},{"id":"m_ex_admi_02_27","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_27","text":"sharing some of your own stories?","jump":null},{"id":"m_ex_admi_02_28","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_28","text":"There's no one else around in the park right now.","jump":null},{"id":"m_ex_admi_02_29","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_29","text":"I have an overactive imagination,","jump":null},{"id":"m_ex_admi_02_30","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_30","text":"so it may be good to fill my mind","jump":null},{"id":"m_ex_admi_02_31","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_31","text":"with someone else's stories.","jump":null},{"id":"m_ex_admi_02_32","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_32","text":"Today has been rough.","jump":"m_ex_admi_02_34"},{"id":"m_ex_admi_02_33","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_33","text":"I processed many documents today.","jump":"m_ex_admi_02_34"},{"id":"m_ex_admi_02_34","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_34","text":"I knew it.","jump":null},{"id":"m_ex_admi_02_35","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_35","text":"You always seem so","jump":null},{"id":"m_ex_admi_02_36","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_36","text":"focused on your work.","jump":null},{"id":"m_ex_admi_02_37","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_37","text":"You've already had a long day, so I feel bad for disturbing you.","jump":null},{"id":"m_ex_admi_02_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_38","text":"But after receiving your message,","jump":null},{"id":"m_ex_admi_02_39","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_39","text":"I won't do it aga...","jump":null},{"id":"m_ex_admi_02_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_40","text":"it's as if all my fatigue has vanished.","jump":null},{"id":"m_ex_admi_02_41","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_41","text":"Huh?","jump":null},{"id":"m_ex_admi_02_42","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_42","text":"But I","jump":null},{"id":"m_ex_admi_02_43","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_43","text":"haven't given any words of encouragement or anything.","jump":null},{"id":"m_ex_admi_02_44","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_44","text":"You've been the one listening to me the entire time.","jump":null},{"id":"m_ex_admi_02_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_45","text":"That means you trust me.","jump":null},{"id":"m_ex_admi_02_46","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_46","text":"...","jump":null},{"id":"m_ex_admi_02_47","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_47","text":"That's true,","jump":null},{"id":"m_ex_admi_02_48","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_48","text":"but I didn't expect you to feel the same way...","jump":null},{"id":"m_ex_admi_02_49","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_49","text":"I just...","jump":null},{"id":"m_ex_admi_02_50","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_50","text":".","jump":null},{"id":"m_ex_admi_02_51","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_51","text":".","jump":null},{"id":"m_ex_admi_02_52","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_52","text":".","jump":null},{"id":"m_ex_admi_02_53","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_53","text":"So, can I talk to you again in the future?","jump":null},{"id":"m_ex_admi_02_54","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_54","text":"Every once in a while, that's all.","jump":null},{"id":"m_ex_admi_02_55","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_55","text":"We can talk anytime.","jump":null},{"id":"m_ex_admi_02_56","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_56","text":"Thank you.","jump":null},{"id":"m_ex_admi_02_57","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_57","text":"Uh oh, Yulha is coming.","jump":null},{"id":"m_ex_admi_02_58","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_58","text":"She must be worried since I'm not in the dorm.","jump":null},{"id":"m_ex_admi_02_59","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_59","text":"I'd love to chat with you more, but","jump":null},{"id":"m_ex_admi_02_60","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_60","text":"I should head back with Yulha.","jump":null},{"id":"m_ex_admi_02_61","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_61","text":"If I text you while she's talking,","jump":null},{"id":"m_ex_admi_02_62","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_62","text":"she'll give me an earful.","jump":null},{"id":"m_ex_admi_02_63","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_63","text":"Thank you for your time.","jump":null},{"id":"m_ex_admi_02_64","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_02_64","text":"Catch you later.","jump":null},{"id":"m_ex_admi_02_65","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_65","text":"Okay!","jump":null},{"id":"m_ex_admi_02_66","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_02_66","text":"That's a deal!","jump":null}],"chat":true}