ump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_06_43","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_06_43","text":"The CEO of Missilis Industry. You think she's going to sit down with us","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_06_44","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_06_44","text":"and have a nice chat about what she did to us, and why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_06_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_03_06_45","text":"Fair enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_06_46","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_06_46","text":"All we know is that we have these abilities,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_06_47","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_06_47","text":"and that we intend on using those abilities to capture Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_06_48","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_06_48","text":"That's all there is to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_06_49","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_03_06_49","text":"If you say so.","jump":null,"exit":false,"enter":