{"id":"d_ex_church_03","cat":"outpost","group":{"id":"outpost11701","label":"Church"},"label":"Folkwang and the Witch's Elixir","stage":null,"prev":"d_ex_church_01","next":"d_ex_church_04","speakers":{"folkwang":"Folkwang","harran":"Harran"},"icons":{"folkwang":"si_c242_00_s","harran":"si_c230_00_s"},"notes":["Unlock: Folkwang · Harran","Featuring Harran · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_church_03_1","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_1","text":"Oh, Creator!","jump":null,"exit":false,"enter":null,"bg":"Church","bgArt":"church","image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["folkwang"],"affinity":null},{"id":"d_ex_church_03_2","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_2","text":"Can you please cure me of this ailment, of this sweating?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_3","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_3","text":"It would be a great act of humanitarianism... No, wait... Nikketarianism... Anyway, I can't go on like this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_4","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_4","text":"Why must I sit here drenched in my own sweat","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_5","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_5","text":"while the other Nikkes are as dry as a bone? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_6","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_6","text":"I beg of you, please spare me from this affliction and make me perspire no longer!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_7","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_church_03_7","text":"... Folkwang?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_8","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_8","text":"Save your prayers. The Creator won't listen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["harran"],"affinity":null},{"id":"d_ex_church_03_9","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_9","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_10","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_10","text":"You scared me... who is that beside you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_11","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_11","text":"A Nikke with excessive perspiration...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_12","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_12","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_13","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_13","text":"Your wish. You want to stop sweating so much, am I right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_14","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_14","text":"Well... yes, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_15","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_15","text":"If you don't want to sweat...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_16","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_16","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_17","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_17","text":"You're lucky I have nothing else going on right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_18","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_18","text":"I'll prepare a unique potion for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_19","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_19","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_20","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_20","text":"You mean... you can cure me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_21","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_21","text":"I turned to science for a cure, but it wasn't any help...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_22","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_22","text":"Hehe, a witch's elixir trumps any of your so-called science.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_23","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_23","text":"What did you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_24","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_24","text":"That's right. A witch's elixir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_25","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_25","text":"Use it correctly, and it will free from all your woes, my clammy compadre.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_26","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_27","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_27","text":"Well, are you up for it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":n