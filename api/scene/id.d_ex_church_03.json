null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_36","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_36","text":"Are you sure it's safe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_37","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_37","text":"You're not doubting me, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_38","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_38","text":"Don't you pray to gods you've never even met before? If you're so devout, take some of that faith and place it in me, you sweaty fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_39","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_39","text":"It's not my fault that I sweat so much...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_40","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_40","text":"If you're not willing to, I won't force you to drink it. Then you can go crawling back to that oh-so-mighty god of yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_41","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_41","text":"And I'll dump this out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_42","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_42","text":"No, don't! I'll drink it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_43","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_43","text":"I can drink with a ladle, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_44","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_church_03_44","text":"Folkwang takes the ladle, scoops up some of the green liquid, and proceeds to drink it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_45","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_church_03_45","text":"*Gulp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_46","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_46","text":"...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_47","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_church_03_47","text":"Folkwang?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_48","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_48","text":"Wow! This is much tastier than I thought it'd be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_49","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_49","text":"The neon green may be a bit off-putting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_50","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_50","text":"but it is delicious!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_51","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_51","text":"Who do you take me for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_52","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_52","text":"I'd never survive at the top of the food chain if I didn't know how to cook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_53","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_church_03_53","text":"Wow, that's amazing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_54","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_54","text":"Finally, some respect. That's more like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_55","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_03_55","text":"Anyway, enough talk. Let's see if the elixir had any effect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_church_03_56","type":"Speech","speaker":"harran","key":"Locale_SuddenStory:d_ex_church_0