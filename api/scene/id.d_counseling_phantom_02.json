 petty thief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_02_13","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_02_13","text":"I thought you understood the difference between a noble thief and a common criminal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_02_14","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_02_14","text":"Could you maybe elaborate more on your thoughts?","jump":"d_counseling_phantom_02_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_02_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_02_15","text":"Phantom and I have a passionate discussion about thieves.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}