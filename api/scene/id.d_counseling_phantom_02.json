{"id":"d_counseling_phantom_02","cat":"counsel","group":{"id":"char5122","label":"Phantom"},"label":"Advising Phantom: 02","stage":null,"prev":"d_counseling_phantom_01","next":"d_counseling_phantom_03","speakers":{"phantom":"Phantom"},"icons":{"phantom":"si_c580_00_s"},"lines":[{"id":"d_counseling_phantom_02_1","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_02_1","text":"What do you think is the most important trait for a thief to have?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["phantom"],"affinity":"_0"},{"id":"d_counseling_phantom_02_2","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_02_2","text":"N-not that I have any ulterior motives or anything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_02_3","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_02_3","text":"I just figured you were a fan of thieves, so I was curious to hear your thoughts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_02_4","text":"A sense of justice.","jump":"d_counseling_phantom_02_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_phantom_02_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_02_5","text":"A determination not to get caught.","jump":"d_counseling_phantom_02_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_phantom_02_6","type":"Speech","speaker":"phantom","key":"Loc