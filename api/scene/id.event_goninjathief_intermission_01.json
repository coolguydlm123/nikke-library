01_18","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_goninjathief_intermission_01_18","text":"\"and have come into your hands through unjust means!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_intermission_01_19","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goninjathief_intermission_01_19","text":"*Flip*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_intermission_01_20","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_goninjathief_intermission_01_20","text":"\"Ill-gotten gains must be returned to their rightful place. This principle stands beneath both moonlight and sunlight alike.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_intermission_01_21","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goninjathief_intermission_01_21","text":"*Flip*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_intermission_01_22","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_goninjathief_intermission_01_22","text":"\"Justice is such that, at times, one must first set foot into darkness before the light may be reached!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_intermission_01_23","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_intermission_01_23","text":"Just a sec...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjat