{"id":"event_ce006_2_03_e","cat":"event","group":{"id":"ev40080","label":"MEMORIES TELLER · Part 2"},"label":"It Has to Be This Way: B","stage":null,"prev":"event_ce006_2_03_s","next":"event_ce006_2_intermission_01","speakers":{"anis":"Anis","privaty":"Privaty","rapi":"Rapi","neon":"Neon","elegg":"Elegg","hermin":"Hermin","ce006_03":"Lily","roam":"Roam"},"icons":{"anis":"si_c012_00_s","privaty":"si_c170_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","elegg":"si_c500_00_s","hermin":"si_c998_00_s","ce006_03":"si_c852_00_s","roam":"si_c931_00_s"},"lines":[{"id":"event_ce006_2_03_e_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_1","text":"I can't say I'm surprised. I knew this would happen.","jump":null,"exit":false,"enter":null,"bg":"artcity_d","bgArt":"artcity_d","image":null,"bgm":"collab_bgm_sb_hallofrecords","movie":null,"shown":["anis","privaty","rapi","neon"],"affinity":null},{"id":"event_ce006_2_03_e_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_2","text":"Did they give a reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_3","text":"Surely the oh-so grand Central Government has an equally grand reasoning for this stance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_4","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_5","text":"Whatever. If you don't want to tell us, suit yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_6","text":"We can take the old man with us regardless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_7","text":"Privaty already issued the report, which complicates matters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_8","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_9","text":"Privaty has been given strict orders not to bring in Hermin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_10","text":"If we do otherwise, they're likely to charge her with insubordination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_12","text":"Well, I'm sorry to hear that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_13","text":"but one way or another, we're bringing this guy back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_14","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_14","text":"I know. I figured that's what you all would do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_03_e_15","text":"How about we knock out Privaty and then bring back Hermin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_16","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_16","text":"Then we'd be guilty of unprovoked assault on a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_03_e_17","text":"Oh, right. I didn't think about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_18","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_18","text":"Did the Central Government offer an explanation? If we know the reason behind their decision, we might be able to work around it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_19","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_19","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_20","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_20","text":"1. The high possibility of rare infectious diseases. If he is infected with a disease that cannot be treated, the Ark will be in danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_21","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_21","text":"2. The high possibility of him being a dangerous criminal, which would naturally pose a threat to the residents of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_22","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_22","text":"3. The high possibility of him being a Rapture spy, which would likely result in the leaking of vital information about the Ark and its location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_23","text":"Hehe, that's a new one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_24","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_24","text":"4. The possibility of him not in fact being human. There is a chance that he might be a Rapture or another type of beast pretending to be human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_25","text":"Oh suuuuure, that's totally it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_26","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_26","text":"5. The possibility of it being a hitherto unreported new species, which would pose a threat to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_27","text":"Now they're really thinking outside the box.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_28","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_28","text":"I realize how absurd these reasons sound. They gave plenty more, close to 100 of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_29","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_29","text":"The most important of which was the one given at the very end of their response:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_30","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_30","text":"“The number of human survivors on the surface must be zero.”","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_31","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_31","text":"As far as they are concerned, the risks are far too great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_32","text":"What a load of bull. They just don't want to entertain the possibility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_33","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_03_e_33","text":"What do you mean by that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_34","text":"If it's revealed that there are in fact survivors on the surface, then the government would naturally have to go searching for more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_35","text":"That would mean devoting a whole bunch of resources, with no guarantee that they'd turn up anything. So, they decided their best option was to insist that the figure is zero, and leave it at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_36","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_36","text":"I think that's an awfully big leap in logic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_37","text":"Any chance you could stop trembling while you speak? Maybe then I'd be less convinced that the Central Government has completely brainwashed you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_38","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_38","text":"What the...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_39","text":"If it comes to light that there are survivors on the surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_40","text":"it'd spell serious trouble for the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_41","text":"For all these years, they've been assuring us there's no one out there, and then it turns out it was all a lie?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_42","text":"The oh-so esteemed Central Government's reputation would take a serious nosedive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_43","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_43","text":"Don't be ridiculous. There's no way they'd do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_44","text":"Privaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_45","text":"Take a good look at that document again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_46","text":"Explain to me how else this is supposed to make any sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_47","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_48","text":"We're going to take Hermin with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_49","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_49","text":"That's the least we can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_50","text":"Right, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_51","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_51","text":"Yes. It's what we must do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_52","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_52","text":"Give me some time. I'll try to convince them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_53","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_53","text":"How?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_54","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_55","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_55","text":"Hermin doesn't look well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_56","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_56","text":"I'm not so sure he'd even survive the trip back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_57","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_57","text":"If we borrowed the Tetrapod, that would shorten the travel time, but if Storm Bringer were to appear, there's no telling what would happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_58","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_58","text":"In other words, we don't have time to wait while you try and persuade the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_59","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_59","text":"Especially when we don't even know if you'll succeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_60","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_61","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_61","text":"The Commander will make sure you aren't faulted for this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_62","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_62","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_63","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_63","text":"Do you think I'm only doing this to save my own skin?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_64","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_64","text":"Duh, why else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_65","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_65","text":"Do you have any idea what would happen if people lost faith in the Central Government?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_66","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_66","text":"Everything would fall apart! Everything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_67","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_67","text":"In a rigid society like ours, if the people cease to trust the one absolute authority, it's all over!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_68","text":"So what are we supposed to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_69","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_69","text":"Kill this innocent old man and head back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_70","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_70","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_71","text":"Sounds to me like that's what you're proposing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_72","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_72","text":"O-of course not. Don't be absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_73","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_73","text":"Privaty. Please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_74","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_74","text":"Don't give us... Don't give me a reason to hate you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_75","text":"I'm begging you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_76","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_76","text":"We leave Privaty, who stands motionless with her head bowed, and start moving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_77","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["elegg"],"affinity":null},{"id":"event_ce006_2_03_e_78","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_03_e_78","text":"Wow. I've seen something like this in the Ark.","jump":null,"exit":false,"enter":null,"bg":"bunkerofartist","bgArt":"bunkerofartist","image":null,"bgm":"collab_bgm_sb_camp_04","movie":null,"shown":["hermin"],"affinity":null},{"id":"event_ce006_2_03_e_79","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_03_e_79","text":"You have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_80","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_03_e_80","text":"Yeah. Whenever it rains, the water flows down the roof, and it looks beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_81","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_03_e_81","text":"I've even waited for it to rain before just so I could see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_82","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_03_e_82","text":"Hehe, that makes me happy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_83","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_03_e_83","text":"Huh? Why's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_84","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_03_e_84","text":"I'm the one who designed this roof.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_85","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_03_e_85","text":"No way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_86","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_03_e_86","text":"Something that you built has lasted this long?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_87","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_03_e_87","text":"According to you, apparently so, hehe. Hence why I'm so pleased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_88","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_03_e_88","text":"Oh, have you seen this kind of roof, by any chance? Here...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_89","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_03_e_89","text":"I have! I've seen it in the stadium, above the seating for the spectators.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_90","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_03_e_90","text":"No kidding!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_91","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_91","text":"Hermin, whose condition has improved significantly, is spending time with Elegg going through the stored data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["roam","ce006_03","anis","privaty","rapi"],"affinity":null},{"id":"event_ce006_2_03_e_92","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_92","text":"Those two are getting along like a house on fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_93","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_03_e_93","text":"Any progress with the recordings?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_94","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_94","text":"Yeah. I'm pretty sure Com was here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_95","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_95","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_96","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_96","text":"I saw it in the footage that we recovered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_97","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_97","text":"At first, I wasn't sure, since all robots look awfully similar to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_98","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_03_e_98","text":"False. I look better than Com.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_99","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_99","text":"... Anyway, the serial number I saw was the same as the one engraved on Com.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_100","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_100","text":"Also, look at the floor. Even though it's dark, you can still make out track marks everywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_101","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_101","text":"I'd bet good money that Com was here at some point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_102","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_03_e_102","text":"What in the world is going on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_103","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_103","text":"I'll see what else I can find.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_104","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_104","text":"It would be nice if Elegg could lend a hand...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_105","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_105","text":"Lily glances at Hermin and Elegg, who are happily chatting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_106","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_106","text":"Then again, it's not the end of the world if it takes a little more time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_107","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_107","text":"Sorry for throwing this all in your lap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_108","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_108","text":"Nah, I'm having a blast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_109","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_03_e_109","text":"It's always fun learning new technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_110","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_03_e_110","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_111","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_111","text":"Privaty looks at Hermin, who is chatting and laughing along with Elegg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_112","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_112","text":"She lowers her head and looks at her phone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_113","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_113","text":"rereading the last line of the document she received earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_114","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_114","text":"“The number of human survivors on the surface must be zero.”","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_115","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_115","text":"Privaty squeezes her eyes shut,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_03_e_116","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_2_03_e_116","text":"then reopens them and walks forward,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":