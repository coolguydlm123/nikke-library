{"id":"d_main_21_04_e","cat":"main","group":{"id":"ch21","label":"Chapter 21 · Giant Whale"},"label":"Secret and Truth: B","stage":"21-12 STAGE · End","prev":"d_main_21_04_s","next":"d_main_21_05_s","speakers":{"cecil_op_c":"Cecil","Self":"Commander","Narration":"Narration","Monologue":"Monologue"},"icons":{"cecil_op_c":"si_c929_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_21_04_e_1","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_1","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_story_cecil","movie":null,"shown":["cecil_op_c"],"affinity":null},{"id":"d_main_21_04_e_2","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_2","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_3","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_3","text":"This is just for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_4","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_4","text":"Let's talk. You can even whisper and I'll still be able to hear you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_5","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_5","text":"Did you tell Johan about my blood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_6","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_6","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_7","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_7","text":"How do I know you're not lying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_8","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_8","text":"If Johan knew about your blood, he'd have split you open from head to toe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_9","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_9","text":"I won't tell him anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_10","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_10","text":"What good would that do me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_11","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_11","text":"Besides, you can make a deal with Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_12","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_12","text":"A deal? What kind of deal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_13","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_13","text":"We'll extract as much blood as we can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_14","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_14","text":"We should be able to craft two bullets that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_15","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_15","text":"I arrived at these calculations by gauging the ratio of metal to the amount of Vapaus in the blood that will be present during synthesis. I know I'm right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_16","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_16","text":"As much as...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_17","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_17","text":"Relax, it won't kill you. You'll just feel a little woozy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_18","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_18","text":"Once we gain access to Mother Whale's core, we'll make two Vapaus bullets for Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_19","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_19","text":"Two months later, he'll get another two bullets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_20","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_20","text":"It's an option available to you. Think about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_21","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_21","text":"I'll keep it in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_22","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_22","text":"We don't know how Vapaus will react with a bullet containing your blood,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_23","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_23","text":"but you should be able to cut some kind of deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_24","text":"So we're going to deceive Johan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_25","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_25","text":"How is that deceiving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_26","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_26","text":"We're just not disclosing everything, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_27","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_28","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_28","text":"And to be honest, both you and Johan have a point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_29","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_29","text":"Killing the Heretic. Giving Nikkes freedom of choice. Both sound like great options.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_30","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_30","text":"Why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_31","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_31","text":"Heretics are dangerous,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_32","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_32","text":"and so is NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_e_33","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_e_34","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_04_e_34","text":"We'll talk about that next time. You'll arrive at the cannon soon.","