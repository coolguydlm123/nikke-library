{"id":"event_ce_01_prologue","cat":"event","group":{"id":"ev40008","label":"Collab 01 · Part 1"},"label":"Strange Phenomenon","stage":null,"prev":null,"next":"event_ce_01_01","speakers":{"rapi":"Rapi","andersen":"Andersen","anis":"Anis","Self":"Commander","neon":"Neon"},"icons":{"rapi":"si_c010_00_s","andersen":"si_c903_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"event_ce_01_prologue_1","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_prologue_1","text":"Do you mean the Lift?","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["neon","rapi","anis","andersen"],"affinity":null},{"id":"event_ce_01_prologue_2","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_2","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_3","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_prologue_3","text":"There's nothing there. Perhaps, they don't mean for us to go to space?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_4","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_4","text":"We picked up an abnormal reaction in the area surrounding the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_5","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_5","text":"The energy waves we discovered have an entirely new pattern that is unlike anything anyone at the Central Government, or the entire Ark, has ever seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_6","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_6","text":"They're blanketing the entire area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_7","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_7","text":"We're at a loss as to exactly what is happening here, and the entire intelligence department is bewildered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_8","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_prologue_8","text":"Can we scan the area?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_9","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_9","text":"Impossible. We tried, but all we got was a white screen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_10","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_10","text":"We don't have much to go on, but I'm willing to bet these aberrations are due to the energy wave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_11","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce_01_prologue_11","text":"I assume that's why we're being sent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_12","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_12","text":"Precisely. I want you all to head over there and get to the bottom of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_13","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_13","text":"I want eyes on the ground for this one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_14","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_prologue_14","text":"Can we expect additional support of any kind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_15","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_15","text":"I'm afraid not. We're hesitant about sending troops en masse to a place we know nothing about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_16","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_prologue_16","text":"I get it. Since we're a small group, it doesn't matter whether we live or die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_17","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_17","text":"No, I'm sending you because we've hit a wall on our end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_18","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_18","text":"I'm confident that nothing egregious will happen to any of you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_19","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_19","text":"no matter what you encounter over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_20","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce_01_prologue_20","text":"Quite the inspiring pep talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_21","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_21","text":"That concludes the briefing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_22","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_prologue_22","text":"Safe travels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_23","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_prologue_23","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_prologue_24","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_prologue_24","text":"I've got a bad feeling about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}