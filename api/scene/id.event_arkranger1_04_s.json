{"id":"event_arkranger1_04_s","cat":"event","group":{"id":"ev40112","label":"ARK RANGER · Part 1"},"label":"Even Without Me: A","stage":null,"prev":"event_arkranger1_intermission_01","next":"event_arkranger1_04_e","speakers":{"mustang":"Mustang","black":"Ark Ranger Black","black_c":"Ark Ranger Black"},"icons":{"mustang":"si_c902_00_s","black":"si_c570_00_s","black_c":"si_c570_99_s"},"lines":[{"id":"event_arkranger1_04_s_1","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_1","text":"Oh là là. So you want a heavier body and a qualité militaire weapon?","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["black","mustang"],"affinity":null},{"id":"event_arkranger1_04_s_2","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_2","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_3","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_3","text":"Pourquoi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_4","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_4","text":"The stronger I am, the more people I can save.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_5","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_5","text":"And only then can I become a true hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_6","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_6","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_7","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_7","text":"Giving you a heavier body and qualité militaire weapon c'est facile, ma chérie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_8","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_8","text":"Mais... would that truly make you un héros?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_9","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_9","text":"If I'd only had the strength during the Ark's attack...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_10","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_10","text":"Maybe all those sacrifices wouldn't have happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_11","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_11","text":"I need power. Real power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_12","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_12","text":"... Je comprends. So you still carry this traumatisme within you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_13","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_13","text":"I will never forget it. Not for as long as I live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_14","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_15","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_15","text":"Très bien. I shall équip you with a heavier body and qualité militaire weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_16","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_16","text":"Ones with the same spécifications as les chéries who combattent on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_17","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_04_s_17","text":"Thank you, Mustang. With this I can finally become a real hero...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_18","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_18","text":"Mais.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_04_s_19","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger1_04_s_19","text":"If you b