","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_1ch_08_t_p_02_113","text":"But in that case...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_1ch_08_t_p_02_114","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_1ch_08_t_p_02_114","text":"Next time, let's drink in your room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_1ch_08_t_p_02_115","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_1ch_08_t_p_02_115","text":"I never expected you to see my room like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_1ch_08_t_p_02_116","type":"Self","speaker":null,"key":"Locale_MainScenario:event_twoxtwolove_1ch_08_t_p_02_116","text":"It's clean enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_1ch_08_t_p_02_117","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_1ch_08_t_p_02_117","text":"I... I'm glad you think so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_1ch_08_t_p_02_118","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_1ch_08_t_p_02_118","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_1ch_08_t_p_02_119","type":"Self","speaker":null,"key":"Locale_MainScenario:event_twoxtwolove_1ch_08_t_p_02_119","text":"...","jump":null,"exit":false,"enter":null,"bg":null