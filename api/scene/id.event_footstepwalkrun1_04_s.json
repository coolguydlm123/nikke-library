9","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_69","text":"and you left three alive so you could take their heads with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_70","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_70","text":"You did it all so you could get that goofy medal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_71","type":"Speech","speaker":"loudnikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_71","text":"Hey, what's gotten into you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_72","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_72","text":"Doesn't this all seem awfully suspicious to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_73","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_73","text":"If she wants to make up stories, fine, but she's making herself out to be some kind of Goddess! What a load of crap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_74","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_74","text":"If you want to be a hero, do it the right way. Don't resort to dirty tricks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_75","type":"Speech","speaker":"loudnikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_75","text":"What if she's telling the truth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_76","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_76","text":"How does that make any sense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_77","type":"Speech","speaker":"loudnikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_78","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_78","text":"Don't you find this even the slightest bit bizarre?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_79","type":"Speech","speaker":"loudnikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_79","text":"I mean... it does seem far-fetched.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_80","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_80","text":"You see?! I'm telling you, she's lying through her teeth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_81","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_81","text":"I'm not lying to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_82","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_82","text":"Of course you are!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_83","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_83","text":"Ugh, without any proof though, there's nothing I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_84","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_84","text":"I just feel terrible for those innocent Nikkes who died by your hand!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_85","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_85","text":"Do you remember their faces? Their names?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_86","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_86","text":"Do you remember what kind of people they were?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_87","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":nul