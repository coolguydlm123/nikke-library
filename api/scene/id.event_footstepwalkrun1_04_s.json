run1_04_s_56","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_57","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_57","text":"And you didn't run into any Raptures on the way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_58","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_58","text":"I attempted to avoid combat as much as possible, but I ended up in 12 separate engagements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_59","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_59","text":"And you defeated them all? By yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_60","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_60","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_61","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_04_s_62","type":"Speech","speaker":"behavenikke","key":"Locale_MainScenario:event_footstepwalkrun1_04_s_62","text":"Haha, I know what you're doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"sh