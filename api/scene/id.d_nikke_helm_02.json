ull,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_82","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_helm_02_82","text":"You haven't even lifted a finger!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_83","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_helm_02_83","text":"You're pretty good at ordering us around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_84","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_helm_02_84","text":"Sovereigns are all the same. They think everyone else is beneath them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_85","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_86","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_86","text":"Effective immediately, you're all banned from drinking. This is punishment for disobeying orders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_87","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_helm_02_87","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_88","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_88","text":"If you don't clean the washrooms this instant, I'll ban you from watching the seagulls next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_89","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_helm_02_89","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_90","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_90","text":"Honestly, when will you get your act together? We're the Aegis Squad. We must always uphold the highest standards...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_91","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_helm_02_91","text":"What do you mean, standards?! We're practically begging for handouts!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_92","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_helm_02_92","text":"I'm too embarrassed to even tell people what I do!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_93","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_93","text":"Are you just doing this so you can brag about it to others?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_94","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_helm_02_94","text":"It's not like we have anything to brag about! Hell, we've got no pride left! Is this really what I signed up for?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id"