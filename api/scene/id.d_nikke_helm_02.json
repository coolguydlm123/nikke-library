vie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_27","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_27","text":"That's quite all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_28","type":"Speech","speaker":"burningum","key":"Locale_NikkeEpisode:d_nikke_helm_02_28","text":"Well, I'll leave the rest to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_29","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_29","text":"Yes, thank you for your efforts tonight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_30","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_30","text":"Burningum leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_31","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_31","text":"What was that all about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_32","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_33","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_33","text":"Donations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_34","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_34","text":"For what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_35","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_35","text":"Well,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_36","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_36","text":"to keep the Admire afloat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_37","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_37","text":"Tell me, do you believe the Ark truly needs a navy? I'd like you to be honest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_38","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_38","text":"Of course we do.","jump":"d_nikke_helm_02_40","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_39","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_39","text":"Honestly... I don't think we need it.","jump":"d_nikke_helm_02_41","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_40","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_40","text":"If you think that's necessary, then you clearly have a terrible grasp of military matters.","jump":"d_nikke_helm_02_42","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_41","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_41","text":"You're right.","jump":"d_nikke_helm_02_42","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_42","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_42","text":"There's no sea in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_43","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_43","text":"The oceans on the surface no longer belong to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_44","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_44","text":"You could call it an investment in the future, but the Admire...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_45","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_45","text":"It's simply too expensive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_46","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_46","text":"The maintenance costs alone are astronomical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_47","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_47","text":"So, let me ask you again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_48","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_48","text":"... Is there really any reason to spend such an exorbitant amount of money maintaining a massive ship we have no use for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_49","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_50","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_50","text":"We have no victories to our name.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_51","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_51","text":"We don't even have a battlefield to prove ourselves on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_52","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_52","text":"Then why was the Admire created in the first place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_53","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_53","text":"It was all meant to showcase Elysion's technological prowess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_54","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_54","text":"They set out to build the most powerful battleship in existence, and succeeded. The Admire truly lives up to that claim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"