eech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_67","text":"So we won't know how much we'll receive until they're sold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_68","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_68","text":"... And even that sum has been shrinking by the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_69","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_69","text":"Is there anything I can do to help?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_70","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_70","text":"Of course there is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_71","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_71","text":"You can help with the cleanup, just as you did yesterday.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_72","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_helm_02_72","text":"Three hours later...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":["mast","anchor"],"affinity":null},{"id":"d_nikke_helm_02_73","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_helm_02_73","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_74","type":"Speech","spea