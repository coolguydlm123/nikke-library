ull},{"id":"d_nikke_helm_02_55","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_55","text":"However, the Central Government wouldn't allow one company to keep such a powerhouse for themselves,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_56","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_56","text":"and bought the Admire at a low price.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_57","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_57","text":"What you see now is the fallout from that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_58","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_58","text":"We haven't seen any action, and the cost of maintaining the ship has become a massive burden, but we can't even prove that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_59","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_59","text":"The Central Government has been slashing subsidies left and right,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_60","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_helm_02_60","text":"so we've been forced to depend on donations from the Ark's upper crust to keep the Admire afloat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_helm_02_61","type":"Speech","speaker":"helm",