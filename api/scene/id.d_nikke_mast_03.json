l},{"id":"d_nikke_mast_03_84","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_84","text":"Why they used the real actors' voices in the original, I'll never know. Like nails on a chalkboard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_85","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_mast_03_85","text":"So you mean you can't sing the sea shanty? But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_86","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_86","text":"Okay, I get it now. You're not a fan of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_87","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_87","text":"You're one of those \"fans\" who's obsessed with that outdated original, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_88","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_88","text":"No wonder you were making such a fuss earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_89","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_89","text":"It's exhausting trying to act with non-professionals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_90","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mast_03_90","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_91","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_mast_03_91","text":"Wha...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_92","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:d_nikke_mast_03_92","text":"What are you saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_93","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_93","text":"You're not an actor, am I right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_94","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_94","text":"That's why you've been so disruptive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_95","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_95","text":"Stomping around all over the set and blabbering about how excited you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_96","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_nikke_mast_03_96","text":"You're an extra, so act like one. Keep your mouth shut, be quiet, and don't disturb the main actors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mast_03_97","type":"Speech","speaker":"jackrowactor","key":"Locale_NikkeEpisode:d_ni