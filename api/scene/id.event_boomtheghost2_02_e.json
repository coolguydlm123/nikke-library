","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_69","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_69","text":"Two hours later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_70","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_70","text":"No no, not like that! Use your hands for that, not the electric drill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_71","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_71","text":"We mustn't rely on machines for everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_72","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_72","text":"Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_73","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_73","text":"No, that's not it! You can't just rely on brute force.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_74","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_74","text":"Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_75","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_75","text":"As Fixy gets a personal lesson from Centi,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_76","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_76","text":"even the lower-tier holograms gather around and watch, transfixed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_77","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_77","text":"Another two hours later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_78","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_78","text":"We've still got a long way to go. You need to memorize the revised edition of Welding Reactions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_79","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_79","text":"Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_80","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_80","text":"After that, I want you to read this dissertation on stress and weight distribution for various materials.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_81","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_81","text":"Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_82","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_e_82","text":"Is it just me, or is Fixy speaking differently?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_83","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_83","text":"Not only is it picking up knowledge, but it's adopting Centi's way of speaking. Impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_84","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_84","text":"Another two hours later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_85","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_85","text":"Whew! That should do it! How do you feel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_86","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_86","text":"I'll build everything you need!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_87","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_87","text":"Saw teeth... entire buildings... you name it, I can make it for you, and fast!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_88","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_88","text":"I like the confidence!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_89","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_89","text":"This isn't Fixy. This is Centi 2.0.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_90","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_90","text":"Should we connect to its emitter, Mr. Alfred?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_91","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_e_91","text":"I already conducted the necessary repairs while it was learning new skills. I did not encounter any resistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_92","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_92","text":"... So was all that waiting we just did a waste of time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_93","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_e_93","text":"Not necessarily, dear passengers. I wanted to help it be rid of its guilt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":