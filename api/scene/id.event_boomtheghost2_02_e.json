{"id":"event_boomtheghost2_02_e","cat":"event","group":{"id":"ev40085","label":"BOOM! THE GHOST! · Part 2"},"label":"Operation Enlightenment: B","stage":null,"prev":"event_boomtheghost2_02_s","next":"event_boomtheghost2_03_s","speakers":{"alfred":"Alfred","elegg_s":"Elegg","rapi_ss":"Rapi","centi_s":"Centi","repairghost":"Fixy"},"icons":{"alfred":"si_c9000_00_s","elegg_s":"si_c502_00_s","rapi_ss":"si_c016_01_s","centi_s":"si_c080_02_s","repairghost":"si_c9000_03_s"},"lines":[{"id":"event_boomtheghost2_02_e_1","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_e_1","text":"I see. In order to investigate the power source of the Utopia, I must access the energy source data.","jump":null,"exit":false,"enter":null,"bg":"Kitchen","bgArt":"kitchen","image":null,"bgm":"bgm_story_cottoncandy","movie":null,"shown":["alfred","elegg_s","rapi_ss","centi_s"],"affinity":null},{"id":"event_boomtheghost2_02_e_2","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_e_2","text":"Unfortunately, I currently lack sufficient clearance to do so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_3","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_e_3","text":"Once I have regained full authorization, I will be able to access that information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_4","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_e_4","text":"I will also be able to control the Utopia and change course before we are swept into the current.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_5","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_5","text":"A nice and clear goal. I like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_6","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_6","text":"Let's commence Operation Enlightenment!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_7","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_e_7","text":"The closest high-tier hologram from our current location is... Fixy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_8","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_e_8","text":"Fixy... Its role must be to bonk passengers on the head with a wrench.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_9","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_9","text":"In what world would it do that? It's a hologram responsible for maintenance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_10","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_e_10","text":"In that case...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_11","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_11","text":"Yes. I'll take charge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_12","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_12","text":"Since it involves maintenance, I'm the right person for the job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_13","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_e_13","text":"Good, that feels reassuring. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_14","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_14","text":"Must fix... but don't know why.","jump":null,"exit":false,"enter":null,"bg":"BuildingLobby","bgArt":"buildinglobby","image":null,"bgm":"none","movie":null,"shown":["repairghost"],"affinity":null},{"id":"event_boomtheghost2_02_e_15","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_15","text":"If it were fixed, no one would have suffered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_16","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_16","text":"Fixy is so dumb! Fixy doesn't know anything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_17","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_17","text":"Huh. Not exactly what I was expecting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_18","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_18","text":"In these types of cases, there's usually something broken that needs to be repaired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_19","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_19","text":"Commencing approach. Elegg, watch my back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_20","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_20","text":"Okay. I'll suck in the lower-tier holograms with my magnificent BFG so you can make contact with Fixy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_21","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_21","text":"Just be careful not to get too close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_22","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_22","text":"Got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_23","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_23","text":"Elegg begins battling with the rest of the holograms, giving Centi an opening to approach Fixy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_24","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_24","text":"Hi, nice to meet you. I'm Centi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_25","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_25","text":"Must fix... but don't know why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tragedy","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_26","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_26","text":"If it were fixed, no one would have suffered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_27","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_27","text":"Fixy is so dumb! Fixy doesn't know anything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_28","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_28","text":"Do you want to learn some skills? I can help you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_29","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_29","text":"If I had fixed it, everyone might have been okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_30","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_30","text":"There would have been warm water, and the heating would have worked properly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_31","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_31","text":"No one would have had to suffer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_32","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_33","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_33","text":"Do you feel your lack of skills made everyone unhappy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_34","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_34","text":"The pipes froze suddenly. The pipes got hot suddenly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_35","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_35","text":"Fixy doesn't know why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_36","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_36","text":"The floor started shaking. The exhaust fan stopped working.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_37","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_37","text":"Fixy didn't learn anything! Fixy didn't learn why everything went wrong!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_38","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_38","text":"It's Fixy's fault! Everyone was unhappy because of Fixy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_39","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_39","text":"Everyone trusted Fixy, but Fixy couldn't do anything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_40","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_40","text":"Fixy betrayed their trust!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_41","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_41","text":"Fixy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_42","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_42","text":"Stop whining, will you?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_43","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_43","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_44","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_44","text":"It's always tragic when mishaps occur due to personal mistakes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_45","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_45","text":"but instead of wasting time bellyaching, you should try to learn and increase your skillset!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_46","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_46","text":"That way, when the same situation occurs again, you'll be able to fix it instead of standing here sucking your thumb.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_47","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_48","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_48","text":"Everyone gets a one-time excuse for a pity party when something goes wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_49","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_49","text":"But if it happens again, and you aren't able to fix it again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_50","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_50","text":"That's laziness, pure and simple! That means you're stagnating!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_51","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_52","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_52","text":"We can't rest on our laurels. Even a small step forward counts. We must always grow as people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_53","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_53","text":"Only then can we repay other people for being kind enough to trust us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_54","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_54","text":"We must master every skill we possibly can, so that others can have peace of mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_55","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_55","text":"So they feel free to go wherever they please without worry or concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_56","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_02_e_56","text":"That's something which they've entrusted us with, and we can't let them down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_57","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_e_57","text":"... She's giving a life lesson to a hologram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_58","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_e_58","text":"As to be expected from Liter's protégé.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_59","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_60","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_60","text":"But Fixy has no way to learn new skills.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_e_61","type":"Speech","speaker":"repairghost","key":"Locale_MainScenario:event_boomtheghost2_02_e_61","text":"Without a software update, evolution is impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown"