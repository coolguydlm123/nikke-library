{"id":"d_main_29_01_e","cat":"main","group":{"id":"ch29","label":"Chapter 29 · Rescue"},"label":"Companions Left Behind: B","stage":"29-3 STAGE · End","prev":"d_main_29_01_s","next":"d_main_29_02_s","speakers":{"fragile":"Fragile","anis":"Anis","neon":"Neon","rapi":"Rapi"},"icons":{"fragile":"si_c481_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_29_01_e_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_1","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":"Drain","bgArt":"drain","image":null,"bgm":"bgm_chapter29_field_drifting","movie":null,"shown":["rapi","anis","neon","fragile"],"affinity":null},{"id":"d_main_29_01_e_2","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_e_2","text":"Exactly what I said. Did Liveryn participate in the search mission as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_3","text":"Yes... why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_4","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_e_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_5","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_e_5","text":"Did she say why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_6","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_7","text":"I think it was something about how she was tired of living a life pleasing others, and wanted to do something worthwhile. Was that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_e_8","text":"Yeah, more or less.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_9","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_e_9","text":"... Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_10","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_e_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_11","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_e_11","text":"Okay. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_12","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_12","text":"Fragile walks ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_13","text":"Looks like Liveryn didn't tell Fragile that she was coming up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_e_14","text":"Apparently not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_15","text":"Who volunteers to go on a search mission and doesn't notify their fellow squad members?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_16","text":"Sounds suspicious to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_17","text":"Something foul is afoot, I say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_e_18","text":"I don't see anything weird about it. You go off and eat pudding on your own and don't tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_19","text":"You bet I don't tell you. Otherwise, you'd steal my chocolate bars.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_20","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_e_20","text":"It's not stealing if I tell you I'm going to eat them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_21","text":"What's the point of telling me when I'm not there?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_22","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_e_22","text":"The point is that I kept you in the loop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_23","text":"If I'm not physically there to stop you, then you're just talking to yourself and stealing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_24","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_e_24","text":"It's better than being a thief who keeps mum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_e_25","text":"A thief is a thief, plain and simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_26","text":"First, Liveryn was obsessed with the messages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_27","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_27","text":"Then she comes up here and keeps it a secret from her own squad members.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_28","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_28","text":"I don't like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_e_29","text":"It may be for personal reasons we don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_30","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_e_30","text":"Fortunately, it hasn't had much impact on the mission so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_e_31","text":"Until we glean more information, it's impossible to ascertain what potential risks there might be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_32","text":"Seriously, we've been betrayed enough for several lifetimes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_33","text":"Fair enough. Still, I'll look into this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_34","text":"Good call. Let's hit 'em with the Commander's devilish charms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_e_35","text":"Just don't go holding their hands or doing anything lovey-dovey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_36","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_e_36","text":"Yes. That's not allowed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_e_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_e_37","text":"Alright, alright.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}