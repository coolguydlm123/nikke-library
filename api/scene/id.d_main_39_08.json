{"id":"d_main_39_08","cat":"main","group":{"id":"ch39","label":"Chapter 39 · Gene"},"label":"The Way to Harmony","stage":"39-25 STAGE · Start","prev":"d_main_39_07","next":"d_main_39_09","speakers":{"ziz":"Ziz","raptilion":"Raptilion","leviathan":"Leviathan"},"icons":{"ziz":"si_c561_00_s","leviathan":"si_c562_00_s"},"lines":[{"id":"d_main_39_08_1","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_1","text":"Wh-what's this? Is this a vegetable garden?","jump":null,"exit":false,"enter":null,"bg":"RaptilionFarm","bgArt":"raptilionfarm","image":null,"bgm":"bgm_chapter39_field_gliding","movie":null,"shown":["raptilion","ziz","leviathan"],"affinity":null},{"id":"d_main_39_08_2","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_2","text":"That's right! I grow vegetables here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_3","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_3","text":"I-It's incredible... to have something like this on top of the Mother Whale...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_4","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_5","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_5","text":"Er... Whaley, I mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_6","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_6","text":"Haha! You're too kind!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_7","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_7","text":"I have a friend who loves to wander around, and she's given me a great deal of help!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_8","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_8","text":"So, as far as irrigation is concerned, water comes out of this blowhole?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_9","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_9","text":"Yep! Whaley drinks seawater and desalinates it using an internal filter before watering the plants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_10","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_10","text":"These vegetables are all edible. Here, try some!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_11","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_11","text":"Wow, so cool!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_12","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_12","text":"Oh... I'm not really that into vegetables.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_13","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_13","text":"But you need your veggies to grow big and strong...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_14","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_15","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_15","text":"N-not that I'm saying you're small!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_16","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_16","text":"Why are you bothering with all of this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_17","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_17","text":"Because it's fun!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_18","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_18","text":"Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_19","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_19","text":"I've built a garden on the back of a flying whale. Isn't that neat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_20","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_20","text":"Yeah, totally!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_21","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_21","text":"My next goal is to build an orchard and even a ranch right here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_22","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_22","text":"F-for real?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_23","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_23","text":"Ultimately, I'd like to turn Whaley's back into a forest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_24","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_24","text":"Wooooow! That sounds amazing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_25","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_25","text":"If you like it so much, why don't you live here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_26","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_26","text":"I didn't mean it like that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_27","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_28","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_28","text":"Tell me something, Reptile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_29","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_29","text":"My name's Raptilion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_30","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_30","text":"Yeah, yeah, gotcha. So, Raptoid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_31","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_31","text":"Raptilion!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_32","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_33","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_33","text":"Fine. Raptilion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_34","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_34","text":"Care to explain what's going on with those things?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_35","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_35","text":"Sorry? What exactly are you referring to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_36","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_36","text":"Those Raptures on top of Moth... Whaley.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_37","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_37","text":"Oh! You're talking about my friends. What would you like to know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_38","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_38","text":"How come they're not attacking us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_39","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_39","text":"Because they're my friends!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_40","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_40","text":"Don't be absurd. How can Raptures and humans possibly be friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_41","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_41","text":"Because there's no language barrier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_42","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_43","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_43","text":"If you can communicate, you can express exactly how you feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_44","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_44","text":"I don't like this. This is fine. I like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_45","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_45","text":"Thank you. I'm sorry. I'm happy. I'm sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_46","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_46","text":"All of that can be clearly conveyed through communication.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_47","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_47","text":"And by doing so, we come to understand each other more deeply","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_48","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_48","text":"and become better able to help one another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_49","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_49","text":"That's the power of communication!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_50","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_50","text":"Sounds like communication is the cornerstone to evolution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_51","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_51","text":"Oh! That's wonderfully put!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_52","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_52","text":"That's right! Communication is indeed the cornerstone of evolution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_53","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_54","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_54","text":"So, you should actively try to communicate as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_55","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_55","text":"You never know what kind of new possibilities await!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_56","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_57","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_57","text":"Levi...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_58","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_58","text":"Would you like to try touching my Rapture friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_59","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_59","text":"They're as gentle as can be. They'd rather bask in the sun than hurt anyone, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_60","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_60","text":"Ooh! Yeah! I wanna touch them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_61","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_08_61","text":"... I'll pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_08_62","text":"Soon after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_63","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_63","text":"Whoa, it feels... just like touching steel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_64","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_64","text":"Haha, that's because Raptures are made of steel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_65","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_65","text":"It's just that you made them sound so much like animals, I half-expected them to feel soft and cuddly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_66","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_66","text":"Hey, you never know, we might encounter a Rapture covered in fur one day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_67","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_67","text":"They are amazingly docile though. I've never seen Raptures act this way before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_68","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_68","text":"That's because I was able to communicate with them, and let them know we meant them no harm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_69","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_39_08_69","text":"Come on, I still have lots to show you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_08_70","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_08_70","text":"All right! Let's go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}