"d_main_12af_02_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_12af_02_29","text":"Spare me the sermon and get to the point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_30","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_30","text":"The Vapaus. How much are you willing to sell it for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_31","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_31","text":"Name your price.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_32","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_32","text":"Where did you hear about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_33","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_33","text":"Hey, I'm a CEO too, you know. You didn't think you and Andersen could hide this from me forever, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_34","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_34","text":"You have it, don't you? Sell it to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_35","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_35","text":"I'm willing to pay, so hand it over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_12af_02_36","text":"Does this have something to do with Matis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_37","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_37","text":"Yes. You got a problem with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_main_12af_02_38","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_38","text":"If I terminate the NIMPH, doesn't that mean I can cure them from the corruption?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_39","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_39","text":"So name your price.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_12af_02_40","text":"You know, you really shouldn't play favorites like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_41","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_41","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_12af_02_42","text":"You always go on about how Nikkes are hunks of junk, yet you're going through all this for Matis's sake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_12af_02_43","text":"Shouldn't they be the same as any other Nikke to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_12af_02_44","text":"You didn't lift a finger when the same thing happened to Mihara, so why are you acting like you care now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_45","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_45","text":"They're special, not like you scrap heaps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_12af_02_46","text":"How so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_47","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_47","text":"You don't need to know that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_48","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_48","text":"Come on, {AccountData.NickName}., sell me the Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_12af_02_49","text":"No can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_50","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_50","text":"Then give it to me as a gift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_51","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_51","text":"You are being awfully stubborn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_52","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_52","text":"You must forgive my bluntness, but Matis nearly sabotaged the entire mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_53","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_53","text":"Destroying the bridge, being subjected to corruption, putting the Counters and Absolute in danger...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_54","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_54","text":"Not to mention the tremendous operational costs incurred as a result.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_55","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_55","text":"I even had to end up using my \"ace-in-the-hole\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_56","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_56","text":"This is all on your shoulders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_57","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_58","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_02_58","text":"Yet despite all of this, you still come here and ask us to give you the Vapaus? That's a new low for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_12af_02_59","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_59","text":"Then let me borrow that bucket of bolts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_60","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_12af_02_60","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["yuni"],"affinity":null},{"id":"d_main_12af_02_61","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_12af_02_61","text":"The memory wipe didn't work on you because you were exposed to Vapaus. You weren't affected by the corruption either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_62","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_12af_02_62","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_02_63","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_12af_02_6