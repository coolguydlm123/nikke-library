{"id":"d_main_23_06_e","cat":"main","group":{"id":"ch23","label":"Chapter 23 · Prison"},"label":"One-Sided Deal: B","stage":"23-19 STAGE · End","prev":"d_main_23_06_s","next":"d_main_23_07_s","speakers":{"anis":"Anis","viper":"Viper","neon":"Neon","jackal":"Jackal","crow":"Crow","rapi":"Rapi"},"icons":{"anis":"si_c012_00_s","viper":"si_c112_00_s","neon":"si_c011_00_s","jackal":"si_c111_00_s","crow":"si_c110_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_23_06_e_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_1","text":"They don't stand a chance.","jump":null,"exit":false,"enter":null,"bg":"Drain","bgArt":"drain","image":null,"bgm":"bgm_greyhaze_b","movie":null,"shown":["anis","neon","rapi","viper","crow","jackal"],"affinity":null},{"id":"d_main_23_06_e_2","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_2","text":"You all just don't quit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_3","text":"We can thank all those missions up on the surface for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_4","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_23_06_e_4","text":"Gasp... Gasp...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_5","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_23_06_e_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_6","text":"*Koooo*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_7","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_7","text":"Flames start to belch out from the tunnel walls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_emergency","movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_8","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_23_06_e_8","text":"All of the flamethrowers have been activated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_06_e_9","text":"What are you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_10","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_23_06_e_10","text":"I'm raising the temperature and burning up all the oxygen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_11","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_23_06_e_11","text":"This is an enclosed space. Before long, this place will be like a giant oven.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_06_e_12","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_06_e_13","text":"How could you?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_14","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_23_06_e_14","text":"I wouldn't move if I were you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_15","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_23_06_e_15","text":"I'm the only one","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_16","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_23_06_e_16","text":"who knows how to shut these off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_17","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_17","text":"I can feel a sharp spike in the temperature,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_18","text":"and my breathing becomes labored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_19","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_19","text":"Don't even think about retreating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_20","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_20","text":"There's fire coming from the back as well, and like I said before, these flames can incinerate Nikkes just as well as humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_21","text":"Are you trying to suffocate us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_22","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_22","text":"Of course not. We're in no danger of suffocation. Neither are you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_23","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_23","text":"The same thing can't be said for the Commander, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_24","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_24","text":"Do you see this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_25","text":"An oxygen mask? So you were planning on taking the Commander hostage this entire time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_26","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_26","text":"It was our contingency plan if negotiations fell through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_27","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_27","text":"And none of you exactly seem willing to speak with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_28","text":"Fine, I'll play ball. Let's talk. Just hurry up and turn these things off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_29","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_29","text":"We're far past that now. Hand over the Commander, and we'll give him the oxygen mask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_30","text":"If we hand over the Commander, how do we know you'll let us go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_31","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_31","text":"You don't. You're not in a position to negotiate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_32","text":"Gasp...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_33","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_33","text":"My vision is becoming blurry, and I'm struggling to breathe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_34","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_34","text":"My head is pounding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_35","text":"Master! Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_36","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_36","text":"Neon holds me up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_37","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_37","text":"I'm not sure, but it feels like she puts something in my pocket...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_38","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_38","text":"Well? What's it gonna be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_39","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_06_e_39","text":"If you so much as lay a finger on them,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_40","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_06_e_40","text":"you're all dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_41","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_41","text":"Why would we ever hurt Honey?\nThat won't ever happen, so don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_42","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_42","text":"So I ask you again: What's it gonna be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_43","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_43","text":"... Just hold in there, Master. We'll come find you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_44","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_44","text":"I feel someone push me gently, and something is put over my face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_45","text":"Hnnyaaah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_46","text":"Finally, I can breathe again. But I'm still disoriented.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_47","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_47","text":"You, Neon, was it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_48","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_48","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_49","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_49","text":"That was pretty sneaky, but you need a little more practice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_50","text":"Viper puts her hands in my pocket and pulls out something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_51","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_51","text":"I don't think we'll be needing this tracking device.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_52","text":"*Crush*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_53","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_main_23_06_e_54","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_54","text":"Everyone, hand over your cellphones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_55","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_55","text":"I don't have a cellphone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_56","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_56","text":"You're only harming Honey by wasting time like this. The temperature is only going to rise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_57","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_58","text":"Rapi, Neon, and Anis all hand over their cell phones to Viper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_59","text":"*Crush* *Crush* *Crush*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_60","text":"Viper stomps on all of the phones, smashing them to smithereens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_61","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_23_06_e_61","text":"Bye bye, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_06_e_62","text":"Exotic disappears into the tunnel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_63","text":"Dammit!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_64","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_64","text":"After them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_65","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_06_e_65","text":"This tunnel is a labyrinth, and we don't know which way they went. We'll only get lost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_66","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_66","text":"Then what should we do?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_67","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_67","text":"Let's go back to where we came from and wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_68","text":"What are you talking about?! Wait for what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_69","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_69","text":"The tracker wasn't the only thing I slipped to Master. I also put a smoke grenade in his inner pocket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_70","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_70","text":"It activates when exposed to external pressure. When it does, it erupts into a giant plume of smoke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_71","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_71","text":"They discovered the tracking device, but not the smoke grenade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_72","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_72","text":"All we've got to do is get to higher ground and wait until Master sets it off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_73","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_73","text":"They are bound to notice it, and when they do, they'll use it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_74","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_06_e_74","text":"That... was incredible!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_75","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_06_e_75","text":"Well done, Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_06_e_76","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_06_e_76","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}