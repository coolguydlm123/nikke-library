{"id":"d_counseling_miranda_05","cat":"counsel","group":{"id":"char5017","label":"Miranda"},"label":"Advising Miranda: 05","stage":null,"prev":"d_counseling_miranda_04","next":"d_counseling_miranda_06","speakers":{"miranda":"Miranda"},"icons":{"miranda":"si_c032_00_s"},"lines":[{"id":"d_counseling_miranda_05_1","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_05_1","text":"Commander, do you ever wonder about the future?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["miranda"],"affinity":"_0"},{"id":"d_counseling_miranda_05_2","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_05_2","text":"I do. I wonder if I'll ever become an accomplished police officer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_05_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_miranda_05_3","text":"I'm sure you will.","jump":"d_counseling_miranda_05_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_miranda_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_miranda_05_4","text":"I wouldn't get your hopes up.","jump":"d_counseling_miranda_05_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_miranda_05_5","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_05_5","text":"The fact that you trust me really gives me confidence!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_05_6","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_05