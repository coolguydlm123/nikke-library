{"id":"d_counseling_rapi_03","cat":"counsel","group":{"id":"char3001","label":"Rapi"},"label":"Advising Rapi: 03","stage":null,"prev":"d_counseling_rapi_02","next":"d_counseling_rapi_04","speakers":{"rapi":"Rapi"},"icons":{"rapi":"si_c010_00_s"},"lines":[{"id":"d_counseling_rapi_03_1","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_03_1","text":"When we're not on an operation, we are free to do whatever we want.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rapi"],"affinity":"_0"},{"id":"d_counseling_rapi_03_2","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_03_2","text":"We spend a lot of time training, but even then, we often have a lot of time left over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_03_3","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_03_3","text":"As such, I've been thinking of picking up a hobby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_03_4","text":"Just kick your feet up and while the hours away.","jump":"d_counseling_rapi_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rapi_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_03_5","text":"How about doing a different kind of training?","jump":"d_counseling_rapi_03_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rapi_03_6","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_0