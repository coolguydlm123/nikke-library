again1_02_e_38","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_38","text":"So, Helm, you go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_39","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_39","text":"It'll be a nice pin on our collective lapel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_40","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_40","text":"We'll boast about that time Helm sailed the high seas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_41","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_41","text":"We can tell them that it won't be long until the Admire will be called into action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_42","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_42","text":"If we say stuff like that, I'm sure donations will come flooding in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_43","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_43","text":"Yeah, like a big ol' tidal wave! Whoooosh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_44","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_44","text":"Leav