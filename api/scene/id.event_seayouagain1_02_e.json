eayouagain1_02_e_12","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_12","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_13","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_13","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_14","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_14","text":"The party is one week away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_15","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_15","text":"I don't know the exact mission schedule, but you should be setting out within the next few days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_16","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_16","text":"So I'm telling you not to worry, and to go take up this mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_17","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_18","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_18","text":"The Aegis Squad has never been deployed to the sea before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_19","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_19","text":"Who knows when we'll get another opportunity like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_20","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_20","text":"I want you guys to experience the sea as much as you can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_21","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_21","text":"So Mast and Anchor, I want you two to go on the mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_22","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_22","text":"Are you sure you can take care of everything here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_23","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_23","text":"You've gotta verify each of the guests' entry tickets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_24","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:event_seayouagain1_02_e_24","text":"Replenish the food and drinks the second they run out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_25","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_25","text":"Not to mention all the cleaning up after the party.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_26","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_26","text":"All the rooms the guests stayed in need to be sorted out before the next guest arrives as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_27","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_27","text":"And the list goes on. Will you be okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_28","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_28","text":"Erm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_29","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain1_02_e_29","text":"I'll just have to do my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_30","type":"Speech","speaker":"mast","key":"Locale_MainScenario:event_seayouagain1_02_e_30","text":"Figures. You're typically cool as a cucumber under pressure, but when it comes to this kind of thing, you fold faster than a house of cards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain1_02_e_31","type":"Speech","speaker":"mast","key":"Locale_MainScenari