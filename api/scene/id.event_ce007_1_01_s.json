ype":"Self","speaker":null,"key":"Locale_SubScenario:event_ce007_1_01_s_7","text":"Two weeks ago, you said?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_8","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce007_1_01_s_8","text":"Why wasn't I notified immediately...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_9","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_9","text":"We had to confirm a few things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_10","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_10","text":"The D-Wave wasn't detected on the surface this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_11","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_11","text":"It came from inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_12","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce007_1_01_s_12","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_13","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_13","text":"We're presently picking up D-Wave signals from a mansion located in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_14","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_14","text":"If we move too hastily, there's a risk of the D-Wave being exposed to external parties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_15","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_15","text":"This could reignite tensions with the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_16","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_16","text":"Especially since the dust has only just settled from the last Outer Rim incident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_17","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_17","text":"As such, the Central Government has decided to handle this case with extreme caution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce007_1_01_s_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_19","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_19","text":"Which brings me to my point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce007_1_01_s_20","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce007_1_01_s_20","text":"Have you ever heard of the Torch of Salvation?","jump":