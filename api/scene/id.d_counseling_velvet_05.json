vet_05_13","type":"Speech","speaker":"velvet_m","key":"Locale_Counseling:d_counseling_velvet_05_13","text":"You're far too kind, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_velvet_05_14","type":"Speech","speaker":"velvet_m","key":"Locale_Counseling:d_counseling_velvet_05_14","text":"But that's exactly what I like about you ♥","jump":"d_counseling_velvet_05_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_velvet_05_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_velvet_05_15","text":"Velvet and I talk about tricking others and being tricked.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}