{"id":"msg_m_ex_aegis_05","cat":"messenger","group":{"id":"room_aegis","label":"Aegis · Group"},"label":"5. Yo, Ho, Ho! Split the sea asunder!","stage":null,"prev":"msg_m_ex_aegis_04","next":"msg_m_ex_aegis_06","speakers":{"mast_m":"Mast","anchor_m":"Anchor","helm":"Helm"},"icons":{"mast_m":"si_c354_00_s","anchor_m":"si_c355_00_s","helm":"si_c352_00_s"},"lines":[{"id":"m_ex_aegis_05_1","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_1","text":"Yo, Ho, Ho! Split the sea asunder!","jump":null},{"id":"m_ex_aegis_05_2","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_2","text":"Yo, Ho, Ho! Azure waves dance as we plunder!","jump":null},{"id":"m_ex_aegis_05_3","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_3","text":"Underneath a blazing sun, we're off to find treasures, son!","jump":null},{"id":"m_ex_aegis_05_4","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_4","text":"Yo, Ho, Ho, raise your swords high!","jump":null},{"id":"m_ex_aegis_05_5","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_5","text":"Yo, Ho, Ho, hoist the flag to the sky!","jump":null},{"id":"m_ex_aegis_05_6","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_6","text":"Pirates we be, and we set sail to chase","jump":null},{"id":"m_ex_aegis_05_7","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_7","text":"our dream of freedom, which none can replace!","jump":null},{"id":"m_ex_aegis_05_8","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_8","text":"How does that sound?","jump":null},{"id":"m_ex_aegis_05_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_9","text":"What's going on?","jump":"m_ex_aegis_05_11"},{"id":"m_ex_aegis_05_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_10","text":"Did you write this?","jump":"m_ex_aegis_05_12"},{"id":"m_ex_aegis_05_11","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_11","text":"We be singing a song that I wrote, aye!","jump":"m_ex_aegis_05_13"},{"id":"m_ex_aegis_05_12","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_12","text":"Aye, that I did!","jump":"m_ex_aegis_05_13"},{"id":"m_ex_aegis_05_13","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_13","text":"Can't you feel the pirate's spirit coursing through you?","jump":null},{"id":"m_ex_aegis_05_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_14","text":"Not sure...","jump":"m_ex_aegis_05_16"},{"id":"m_ex_aegis_05_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_15","text":"Yes, I can feel it!","jump":"m_ex_aegis_05_16"},{"id":"m_ex_aegis_05_16","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_16","text":"What's all this about?","jump":null},{"id":"m_ex_aegis_05_17","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_17","text":"*Gasp*!","jump":null},{"id":"m_ex_aegis_05_18","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_18","text":"*Gasp*!","jump":null},{"id":"m_ex_aegis_05_19","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_19","text":"The fearsome sea witch has appeared!","jump":null},{"id":"m_ex_aegis_05_20","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_20","text":"Anchors aweigh, mateys! Master Captain, man the battle stations!","jump":null},{"id":"m_ex_aegis_05_21","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_21","text":"Roger!","jump":null},{"id":"m_ex_aegis_05_22","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_22","text":"Huh?","jump":"m_ex_aegis_05_24"},{"id":"m_ex_aegis_05_23","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_23","text":"Aye aye, captain!","jump":"m_ex_aegis_05_24"},{"id":"m_ex_aegis_05_24","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_24","text":"Good grief.","jump":null},{"id":"m_ex_aegis_05_25","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_25","text":"Ever since you put on that pirate outfit,","jump":null},{"id":"m_ex_aegis_05_26","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_26","text":"you've gotten much worse.","jump":null},{"id":"m_ex_aegis_05_27","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_27","text":"Port side, all cannons! Prepare to fire!","jump":null},{"id":"m_ex_aegis_05_28","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_28","text":"Heave-ho!","jump":null},{"id":"m_ex_aegis_05_29","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_29","text":"Enough of this silliness.","jump":null},{"id":"m_ex_aegis_05_30","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_30","text":"Fire!","jump":null},{"id":"m_ex_aegis_05_31","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_31","text":"*Boom boom boom KABOOM!*","jump":null},{"id":"m_ex_aegis_05_32","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_32","text":"Subordinate.","jump":null},{"id":"m_ex_aegis_05_33","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_33","text":"Subordinate, I can see you're reading this.","jump":null},{"id":"m_ex_aegis_05_34","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_34","text":"Answer.","jump":null},{"id":"m_ex_aegis_05_35","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_35","text":"Er... hi.","jump":"m_ex_aegis_05_37"},{"id":"m_ex_aegis_05_36","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_36","text":"We're still alive, foul Sea Witch!","jump":"m_ex_aegis_05_42"},{"id":"m_ex_aegis_05_37","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_37","text":"Could you please","jump":null},{"id":"m_ex_aegis_05_38","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_38","text":"do something about this?","jump":null},{"id":"m_ex_aegis_05_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_39","text":"Do something about what?","jump":null},{"id":"m_ex_aegis_05_40","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_40","text":"You know what I'm referring to.","jump":null},{"id":"m_ex_aegis_05_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_41","text":"I think I'm as powerless to stop it as you are.","jump":"m_ex_aegis_05_44"},{"id":"m_ex_aegis_05_42","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_42","text":"... I can't believe this.","jump":null},{"id":"m_ex_aegis_05_43","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_43","text":"Oh boy, we're in big trouble now...","jump":"m_ex_aegis_05_44"},{"id":"m_ex_aegis_05_44","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_44","text":"Our messages show up as read, but Helm doesn't reply for a while.","jump":null},{"id":"m_ex_aegis_05_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_45","text":"Helm?","jump":null},{"id":"m_ex_aegis_05_46","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_46","text":"Master,","jump":null},{"id":"m_ex_aegis_05_47","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_47","text":"I just heard a strange noise from the next room.","jump":null},{"id":"m_ex_aegis_05_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_48","text":"What kind of noise?","jump":null},{"id":"m_ex_aegis_05_49","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_49","text":"It sounded like a scream or something.","jump":null},{"id":"m_ex_aegis_05_50","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_aegis_05_50","text":"Wait.","jump":null},{"id":"m_ex_aegis_05_51","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_51","text":"Now something's breaking.","jump":null},{"id":"m_ex_aegis_05_52","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenMessage:m_ex_aegis_05_52","text":"Uh oh.","jump":null},{"id":"m_ex_aegis_05_53","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_53","text":"I don't think Mast is the one doing it.","jump":null},{"id":"m_ex_aegis_05_54","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_54","text":"Now it seems like no one is reading my messages.","jump":null},{"id":"m_ex_aegis_05_55","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_55","text":"Guys?","jump":null},{"id":"m_ex_aegis_05_56","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_56","text":"Subordinate.","jump":null},{"id":"m_ex_aegis_05_57","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_57","text":"The Aegis Squad will be leaving for a two-week training camp without delay.","jump":null},{"id":"m_ex_aegis_05_58","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_58","text":"It's an urgent matter,","jump":null},{"id":"m_ex_aegis_05_59","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_59","text":"so we'll have to obtain approval after the fact.","jump":null},{"id":"m_ex_aegis_05_60","type":"Speech","speaker":"helm","key":"Locale_SuddenMessage:m_ex_aegis_05_60","text":"I trust that you'll understand.","jump":null},{"id":"m_ex_aegis_05_61","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_05_61","text":"I do.","jump":null}],"chat":true}