{"id":"d_counseling_marian_queen_04","cat":"counsel","group":{"id":"char5185","label":"Marian: Queen"},"label":"Marian: Queen's Memories: 04","stage":null,"prev":"d_counseling_marian_queen_03","next":"d_counseling_marian_queen_05","speakers":{"marian":"Marian"},"icons":{"marian":"si_c013_00_s"},"lines":[{"id":"d_counseling_marian_queen_04_1","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_marian_queen_04_1","text":"Marian closes her eyes and recalls a hazy memory.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"event_bgm_maria-n_coldrain","movie":null,"shown":["marian_queen"],"affinity":"_0"},{"id":"d_counseling_marian_queen_04_2","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_04_2","text":"Commander, what should we have for dinner tonight?","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":null,"movie":null,"shown":["marian"],"affinity":"_0"},{"id":"d_counseling_marian_queen_04_3","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_04_3","text":"I don't really want rations again. I want something tasty... Do we have anything like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marian_queen_04_4","text":"Tell me whatever you want. I'll make it for you.","jump":"d_counseling_marian_queen_04_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_marian_queen_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marian_queen_04_5","text":"I mean... all we've ever really had are rations, right?","jump":"d_counseling_marian_queen_04_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image"