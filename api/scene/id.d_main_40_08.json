ity":null},{"id":"d_main_40_08_35","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_08_35","text":"Don't get greedy with your questions, human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_08_36","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_08_36","text":"I'm being generous with you now, but my generosity has its limits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_08_37","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_08_37","text":"Now it's time for you to answer my question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_08_38","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_08_38","text":"You say the Four Beasts have made a new Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_08_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_08_39","text":"We don't know that for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_08_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_08_40","text":"We're only assuming that they have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_08_41","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_08_41","text":"That's impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_0