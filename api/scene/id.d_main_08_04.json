":null,"shown":null,"affinity":null},{"id":"d_main_08_04_28","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_28","text":"This indicates that her memory remains intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_04_29","text":"Uh... she probably got that information after her memory wipe. Yeah, that's it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_30","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_30","text":"Wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_31","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_31","text":"I told you, none of this information is mentioned in the database.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_32","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_32","text":"So we're talking about gut instinct here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_33","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_34","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_34","text":"Or perhaps street smarts? Something like that anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":n