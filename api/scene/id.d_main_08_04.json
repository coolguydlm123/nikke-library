{"id":"d_main_08_04","cat":"main","group":{"id":"ch8","label":"Chapter 8 · Conflict"},"label":"Secret Sharing","stage":"8-12 STAGE · Start","prev":"d_main_08_03","next":"d_main_08_05","speakers":{"exia_op_r":"Exia","anis":"Anis","neon":"Neon","rapi":"Rapi"},"icons":{"exia_op_r":"si_c210_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_08_04_1","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_1","text":"Hello.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_03","bgArt":"wasteland_03","image":null,"bgm":"bgm_story_heynewbie","movie":null,"shown":["rapi","anis","neon","exia_op_r"],"affinity":null},{"id":"d_main_08_04_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_04_2","text":"Why do you keep doing this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_04_3","text":"If you want to communicate, then just send a message or a video clip.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_4","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_4","text":"Hey, don't take it out on me! It's your own fault for being so paranoid. No wonder your teammates are giving you a hard time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_08_04_5","text":"True. Very true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_04_6","text":"...","jump":null,"