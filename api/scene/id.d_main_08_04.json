04_14","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_15","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_15","text":"You all should know better than to fib.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_16","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_16","text":"Even a Rapture could see through your flimsy lies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_17","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_08_04_17","text":"Why are you saying this to us now of all times?","jump":"d_main_08_04_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_18","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_08_04_18","text":"How did you know?","jump":"d_main_08_04_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_19","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_19","text":"Well, to be more precise, it seems the memory wipe didn't have any effect on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_20","type":"Speech","speaker":"exia_op_r","key":"Locale_MainScenario:d_main_08_04_20","text":"There is a record that indicates memories have been erased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_04_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario: