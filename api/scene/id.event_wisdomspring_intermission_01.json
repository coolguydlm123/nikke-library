n_01_37","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_intermission_01_37","text":"I'm not sure I follow. How exactly did they transpose technology and art into Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_intermission_01_38","type":"Speech","speaker":"mana","key":"Locale_SubScenario:event_wisdomspring_intermission_01_38","text":"By transforming exceptionally gifted artists and engineers into Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_intermission_01_39","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_intermission_01_39","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_intermission_01_40","type":"Speech","speaker":"mana","key":"Locale_SubScenario:event_wisdomspring_intermission_01_40","text":"This way, their skills and knowledge could survive","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_intermission_01_41","type":"Speech","speaker":"mana","key":"Locale_SubScenario:event_wisdomspring_intermission_01_41","text":"without the human limitation of time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_intermission_01_42","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_intermission_01_42","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_intermission_01_43","type":"Speech","speaker":"mana","key":"Locale_SubScenario:e