{"id":"msg_m_ex_dorothy_serendipity_03","cat":"messenger","group":{"id":"room_dorothy","label":"Dorothy · Nikke"},"label":"6. Your Grace,","stage":null,"prev":"msg_m_ex_dorothy_serendipity_02","next":null,"speakers":{"dorothy_s":"Dorothy"},"icons":{"dorothy_s":"si_c234_00_s"},"lines":[{"id":"m_ex_dorothy_serendipity_03_1","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_1","text":"Your Grace,","jump":null},{"id":"m_ex_dorothy_serendipity_03_2","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_2","text":"did you leave this box","jump":null},{"id":"m_ex_dorothy_serendipity_03_3","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_3","text":"on my desk?","jump":null},{"id":"m_ex_dorothy_serendipity_03_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_4","text":"How did you know?","jump":null},{"id":"m_ex_dorothy_serendipity_03_5","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_5","text":"No one would leave something for me","jump":null},{"id":"m_ex_dorothy_serendipity_03_6","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_6","text":"that's clearly a gift.","jump":null},{"id":"m_ex_dorothy_serendipity_03_7","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_7","text":"No one but you.","jump":null},{"id":"m_ex_dorothy_serendipity_03_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_8","text":"Hehe.","jump":null},{"id":"m_ex_dorothy_serendipity_03_9","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_9","text":"Well?","jump":null},{"id":"m_ex_dorothy_serendipity_03_10","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_10","text":"What is it?","jump":null},{"id":"m_ex_dorothy_serendipity_03_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_11","text":"I saw it while I was out and about, and thought it would suit you.","jump":null},{"id":"m_ex_dorothy_serendipity_03_12","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_12","text":"Hmm...","jump":null},{"id":"m_ex_dorothy_serendipity_03_13","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_13","text":"It doesn't seem dangerous,","jump":null},{"id":"m_ex_dorothy_serendipity_03_14","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_14","text":"so I'll open it.","jump":null},{"id":"m_ex_dorothy_serendipity_03_15","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_15","text":"Oh!","jump":null},{"id":"m_ex_dorothy_serendipity_03_16","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_16","text":"A pair of teacups.","jump":null},{"id":"m_ex_dorothy_serendipity_03_17","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_17","text":"Emblazoned with sky-blue waves","jump":null},{"id":"m_ex_dorothy_serendipity_03_18","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_18","text":"and pink dolphins.","jump":null},{"id":"m_ex_dorothy_serendipity_03_19","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_19","text":"What about this made you think of me?","jump":null},{"id":"m_ex_dorothy_serendipity_03_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_20","text":"It reminded me of you flying above the ocean.","jump":null},{"id":"m_ex_dorothy_serendipity_03_21","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_21","text":"I see.","jump":null},{"id":"m_ex_dorothy_serendipity_03_22","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_22","text":"I like it.","jump":null},{"id":"m_ex_dorothy_serendipity_03_23","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_23","text":"The next time I have tea, I will be sure to invite you.","jump":null},{"id":"m_ex_dorothy_serendipity_03_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_24","text":"That'd be great.","jump":null},{"id":"m_ex_dorothy_serendipity_03_25","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_25","text":"I should think about what tea will go well with this teacup.","jump":null},{"id":"m_ex_dorothy_serendipity_03_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_26","text":"Should I extend an invite to Rapi as well?","jump":null},{"id":"m_ex_dorothy_serendipity_03_27","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_27","text":"Rapi?","jump":null},{"id":"m_ex_dorothy_serendipity_03_28","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_28","text":"...","jump":null},{"id":"m_ex_dorothy_serendipity_03_29","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_29","text":"No.","jump":null},{"id":"m_ex_dorothy_serendipity_03_30","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_30","text":"There are only two teacups,","jump":null},{"id":"m_ex_dorothy_serendipity_03_31","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_31","text":"so this time, it'll be just you and me.","jump":null},{"id":"m_ex_dorothy_serendipity_03_32","type":"Speech","speaker":"dorothy_s","key":"Locale_SuddenMessage:m_ex_dorothy_serendipity_03_32","text":"I'll be in touch.","jump":null}],"chat":true}