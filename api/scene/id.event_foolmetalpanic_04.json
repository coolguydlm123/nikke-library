{"id":"event_foolmetalpanic_04","cat":"event","group":{"id":"ev130010","label":"Foolmetalpanic"},"label":"Mekami Shifty's Flash","stage":null,"prev":"event_foolmetalpanic_03_e","next":"event_foolmetalpanic_05","speakers":{"mekamishifty":"Mekami Shifty","liter":"Liter","centi":"Centi","shifty_s":"Shifty","shifty":"Shifty"},"icons":{"mekamishifty":"si_c610_00_s","liter":"si_c082_00_s","centi":"si_c080_00_s","shifty_s":"si_c907_00_s","shifty":"si_c907_00_s"},"lines":[{"id":"event_foolmetalpanic_04_1","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_1","text":"Warning. Batteries low. Please replace the batteries.","jump":null,"exit":false,"enter":null,"bg":"Workshop","bgArt":"workshop","image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["shifty_s","mekamishifty","liter","centi"],"affinity":null},{"id":"event_foolmetalpanic_04_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_2","text":"Mekami Shifty keeps repeating the same words like a broken record.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_3","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_3","text":"So... this is an alien?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_4","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_4","text":"If that's true, why is it asking for new batteries?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_5","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_5","text":"Beats me. Let's have a look...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_6","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_6","text":"Liter feels around Mekami Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_7","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_7","text":"Hmm...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_8","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_8","text":"... This is a robot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_9","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_9","text":"A robot...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_10","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_10","text":"Yeah, although I've never seen one like this before. It's different from a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_11","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_11","text":"Does that mean it wasn't made in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_12","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_12","text":"Seems so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_13","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_13","text":"That explains why the joints look strange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_14","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_14","text":"What I thought were clothes are actually all either paint or water slide decals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_15","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_15","text":"Ugh, water slide decals are always such a pain to put on properly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_16","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_16","text":"These days, most models come with sticker decals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_17","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_17","text":"What are you two even talking about?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_18","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_18","text":"So, uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_19","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_19","text":"This isn't an alien then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_20","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_20","text":"It's too early to jump to conclusions. There is such a thing as silicon-based life-forms too, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_21","text":"I don't have a clue what kind of batteries an alien would use though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_22","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_22","text":"Oh, take a look here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_23","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_23","text":"Hmm? Ah, so this is where the batteries go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_24","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_24","text":"Let's see, I'm sure I left them around here somewhere...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_25","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_25","text":"I remember where they are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_26","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_26","text":"Wow, Mighty Tools really does have everything! Even alien batteries!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_27","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_27","text":"They've got the right tool for every occasion!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_28","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_28","text":"Found them. Here you go, AAA batteries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_29","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_29","text":"Good. Let's put them in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_31","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_31","text":"Warning. Batteries low. Please replace the batteries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_32","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_32","text":"Warning. Batteries low. Please replace the...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_33","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_33","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_34","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_34","text":"Mi...ssy...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_alittlestar","movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_35","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_35","text":"Looks like she's waking up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_36","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_36","text":"It's always good to have a supply of AAA batteries on hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_37","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_37","text":"You saved my life. I am most grateful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_38","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_38","text":"Here. This is a token of my appreciation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_39","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_39","text":"Save it. We didn't do it expecting anything in return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_40","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_40","text":"Mekami Shifty pulls a piece of fruit from between her chest and hands it to Liter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_41","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_41","text":"... What is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_42","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_42","text":"...? It is fruit, the universal currency of the blue star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_43","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_43","text":"Do you not subsist mainly on fruit, and use it as your currency?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_44","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_44","text":"And when you save up enough peels, you can exchange them for new fruit, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_45","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_45","text":"We don't recycle fruit peels like plastic bottles, you goofball. How'd you ever get that idea?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_46","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_46","text":"Boss told us a little about you, but are you really an alien?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_47","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_47","text":"From my perspective, you are the aliens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_48","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_48","text":"You still haven't told us what Planet Shifty is, though, or why you look kind of like me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_49","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_49","text":"I look like... you...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_50","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_50","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_51","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_51","text":"Now that you mention it, you do look a lot like me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_52","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_52","text":"And, you know, our names are both Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_53","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_53","text":"Wait... Are you... *the* Shifty...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_54","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_54","text":"Yeah...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_55","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_55","text":"I can't believe it...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_56","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_56","text":"You must be my ancestor! Said to be the most savage of savages, the most inferior of life-forms to ever grace this universe! It's an honor to meet you, Shifty!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_57","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_57","text":"If you keep that up, I'll show you what true savagery is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_58","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_58","text":"Ah, my apologies. I am overjoyed and got carried away. Ahem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_59","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_59","text":"I should first explain more about Planet Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_60","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_60","text":"It is a planet located 120 light-years away from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_61","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_61","text":"It is a beautiful place, the most technologically advanced in the entire galaxy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_62","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_62","text":"Of course, in order to explain the origin of Planet Shifty, I must needs talk of Mecha Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_63","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_63","text":"Wait, how is Mecha Shifty involved in this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_64","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_64","text":"Right after Mecha Shifty was created, it transmitted signals into space that carried great knowledge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_65","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_65","text":"Those signals reached a then-unnamed planet, and the life-forms that received that knowledge rapidly evolved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_66","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_66","text":"That is how Planet Shifty came into being.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_67","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_67","text":"My appearance is the embodiment of Mecha Shifty's ideal image.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_68","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_68","text":"In fact, everyone on Planet Shifty looks similar to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_69","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_69","text":"I am little better endowed than some, but there are slender types, normal types, and even flat-chested types, although those are quite rare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_70","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_70","text":"But... Mecha Shifty was only built one year ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_71","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_71","text":"How could your planet be 120 light-years away? That doesn't make any sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_72","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_72","text":"That only means it would take light 120 years to travel that distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_73","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_73","text":"If you move a thousand times faster than light, it's just over forty days!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_74","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_74","text":"What fools do you take us for? A thousand times the speed of light? That's impossible!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_75","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_75","text":"Humanity isn't even close to reaching the speed of light yet. How do you get to be a thousand times that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_76","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_76","text":"How? You simply multiply the speed of light times a thousand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_77","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_78","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_78","text":"...Okay, whatever. You all have fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_79","type":"Speech","speaker":"liter","key":"Locale_SubScenario:event_foolmetalpanic_04_79","text":"C'mon, Centi. Let's get back to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_80","type":"Speech","speaker":"centi","key":"Locale_SubScenario:event_foolmetalpanic_04_80","text":"Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_81","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_81","text":"Liter and Centi quickly leave the area. On their way out, it felt like they gave me a look as if to say, \"Good luck,\" but maybe I'm imagining things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_82","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_82","text":"Okay, well now that we understand where you're from, why do you call us insects?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_83","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_83","text":"The very first piece of knowledge transmitted by Mecha Shifty said,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_84","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_84","text":"the life-forms on this planet are fragile and inferior, like insects, and that you must be saved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_85","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_86","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_86","text":"She also said fruit is the staple food and universal currency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_87","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_87","text":"What kind of stupid nonsense was in those transmissions...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_88","type":"Speech","speaker":"shifty","key":"Locale_SubScenario:event_foolmetalpanic_04_88","text":"So that's why you were making all those weird sounds earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_89","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_89","text":"Indeed. However, I see your civilization has developed brilliantly in such a short span of time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_90","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_90","text":"Mecha Shifty, are you watching? The future you protected is very bright.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_91","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_91","text":"Okay, I think I've got a rough picture of everything now,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_92","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_92","text":"but what did you mean when you said you came to save us from a crisis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_93","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_93","text":"Ah, I forgot to mention the most important part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_94","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_94","text":"Your planet is facing imminent destruction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_95","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_95","text":"I am here to prevent such a thing from occurring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_96","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_96","text":"What?! How?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_97","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_97","text":"The giant amalgamated monster Neo Ultima Zaurus will rise again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_98","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_98","text":"But Mecha Shifty already defeated it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_99","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_99","text":"The giant amalgamated monster Neo Ultima Zaurus is immortal and will resurrect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_100","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_100","text":"To put a stop to this, the fragments of the giant amalgamated monster Neo Ultima Zaurus must all be destroyed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_101","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_101","text":"As soon as the fragments are all gathered into one place, the giant amalgamated monster Neo Ultima Zaurus—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_102","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_102","text":"Are you going to keep saying the full name every single time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_103","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_103","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_104","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_104","text":"Very well. I suppose I could call it \"Neo,\" like the character from the Ma—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_105","type":"Speech","speaker":"shifty","key":"Locale_SubScenario:event_foolmetalpanic_04_105","text":"Just call it the giant monster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_106","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_106","text":"The giant monster is immortal, and it is sure to resurrect one day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_107","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_107","text":"When it was defeated, fragments containing its power were scattered across the planet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_108","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_108","text":"If those fragments are found and destroyed, then the giant monster's resurrection can be prevented.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_109","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_109","text":"And if we fail to find them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_110","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_110","text":"The fragments naturally attract each other, so they will eventually gather into one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_111","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_111","text":"How much time do we have left?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_112","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_112","text":"A mere... five hundred years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_113","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_113","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_114","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_114","text":"That sounds like more than enough time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_115","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_115","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_116","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_116","text":"You mustn't flee from impending disaster for the sake of your own leisure!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_117","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_117","text":"Okay, okay. So all we have to do is find those fragments?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_118","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_118","text":"Yes. Luckily, I can sense one of the fragment's energy nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_119","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_119","text":"Please follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_120","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_120","text":"Uh-oh... Ooof. Agh...! Oh no...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_121","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_121","text":"... No way. I think I know what she's doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_122","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_122","text":"Darn it! My stomach really hurts...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_123","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_123","text":"Why didn't I think of that...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_124","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_124","text":"Sorry, but you go on ahead without me. I'll catch up... eventually...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_125","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_125","text":"Oh, certainly. Take your time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_126","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_04_126","text":"Your kind are troublesome, but it cannot be helped. As a superior species, I must be understanding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_127","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_127","text":"Mekami Shifty leaves the workshop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_128","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_128","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_129","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_129","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_130","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_04_130","text":"You double-crossed me, Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_04_131","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_04_131","text":"It's your fault for being an amateur.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}