{"id":"d_counseling_rapunzel_sanctuary_17","cat":"counsel","group":{"id":"char5187","label":"Rapunzel: Sanctuary"},"label":"Advising Rapunzel: Sanctuary: 17","stage":null,"prev":"d_counseling_rapunzel_sanctuary_16","next":"d_counseling_rapunzel_sanctuary_18","speakers":{"rapunzel_s":"Rapunzel"},"icons":{"rapunzel_s":"si_c473_00_s"},"lines":[{"id":"d_counseling_rapunzel_sanctuary_17_1","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_1","text":"Believer, do you think there's anything that lasts forever?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rapunzel_s"],"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_2","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_2","text":"Sometimes, it seems like everything must come to an end, but then I look around, and I wonder if that's really true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_3","text":"Everything comes to an end eventually.","jump":"d_counseling_rapunzel_sanctuary_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rapunzel_sanctuary_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_4","text":"Some things will last forever.","jump":"d_counseling_rapunzel_sanctuary_17_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rapunzel_sanctuary_17_5","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_5","text":"Hehe, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_6","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_6","text":"Still, if we remember and honor even those endings, I don't think they can truly be called endings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_7","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_7","text":"Just as I remember all twelve thousand of my sisters.","jump":"d_counseling_rapunzel_sanctuary_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_8","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_8","text":"... Yes, you're right. Some things do last forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_9","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_9","text":"The hopes and passion of everyone who fights for victory are eternal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_10","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_10","text":"Even if my body were to disappear, there would still be many sisters to remember me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_11","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_11","text":"and I would remember them forever as well. So I do believe eternity exists.","jump":"d_counseling_rapunzel_sanctuary_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_17_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_17_12","text":"Rapunzel and I have a deep discussion about eternity.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}