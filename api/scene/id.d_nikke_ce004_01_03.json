keEpisode:d_nikke_ce004_01_03_26","text":"At first, humanity fought with all its might to stop them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_01_03_27","type":"Speech","speaker":"zwei","key":"Locale_NikkeEpisode:d_nikke_ce004_01_03_27","text":"But eventually, they were defeated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_01_03_28","type":"Speech","speaker":"zwei","key":"Locale_NikkeEpisode:d_nikke_ce004_01_03_28","text":"As a result, they fled to this place, the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_01_03_29","type":"Speech","speaker":"zwei","key":"Locale_NikkeEpisode:d_nikke_ce004_01_03_29","text":"The surface, as you saw,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_01_03_30","type":"Speech","speaker":"zwei","key":"Locale_NikkeEpisode:d_nikke_ce004_01_03_30","text":"is now teeming with Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_01_03_31","type":"Speech","speaker":"zwei","key":"Locale_NikkeEpisode:d_nikke_ce004_01_03_31","text":"Raptures are a complete enigma.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_01_03_32","type":"Speech","speaker":"zwei","key":"Locale_NikkeEpisode:d_nikke_ce004_01_03_32","text":"As you said, there are various types.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_01_03_33","type":"Speech","sp