nStory:d_ex_gym_10_153","text":"It seems that no matter what I tell her, Rumani has no intention of stopping the routine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_10_154","type":"Speech","speaker":"mana","key":"Locale_SuddenStory:d_ex_gym_10_154","text":"So I say we escape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_10_155","type":"Speech","speaker":"mana","key":"Locale_SuddenStory:d_ex_gym_10_155","text":"I'll message Rumani saying that something urgent came up at the lab and I need to leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_10_156","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_gym_10_156","text":"Good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_10_157","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_gym_10_157","text":"Mana and I bolt out of the gym, keeping out of Rumani's sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}