{"id":"msg_m_ex_volume_01","cat":"messenger","group":{"id":"room_volume","label":"Volume · Nikke"},"label":"1. Hi there!","stage":null,"prev":null,"next":"msg_m_ex_volume_02","speakers":{"volume":"Volume"},"icons":{"volume":"si_c431_00_s"},"lines":[{"id":"m_ex_volume_01_1","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_1","text":"Hi there!","jump":null},{"id":"m_ex_volume_01_2","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_2","text":"Hello.","jump":"m_ex_volume_01_4"},{"id":"m_ex_volume_01_3","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_3","text":"Nice to meet you.","jump":"m_ex_volume_01_5"},{"id":"m_ex_volume_01_4","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_4","text":"Quick response, I like it!","jump":"m_ex_volume_01_6"},{"id":"m_ex_volume_01_5","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_5","text":"What's with all the formality? Loosen up, will ya?","jump":null},{"id":"m_ex_volume_01_6","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_6","text":"I assume there's no need to introduce myself.","jump":null},{"id":"m_ex_volume_01_7","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_7","text":"If you don't know me, you've been living under a rock.","jump":null},{"id":"m_ex_volume_01_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_8","text":"I see you on the news quite often.","jump":null},{"id":"m_ex_volume_01_9","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_9","text":"Huh?","jump":null},{"id":"m_ex_volume_01_10","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_10","text":"The news?","jump":null},{"id":"m_ex_volume_01_11","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_11","text":"What about on stage?","jump":null},{"id":"m_ex_volume_01_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_12","text":"Erm...","jump":null},{"id":"m_ex_volume_01_13","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_13","text":"Have you ever seen me perform?","jump":null},{"id":"m_ex_volume_01_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_14","text":"Not yet.","jump":null},{"id":"m_ex_volume_01_15","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_15","text":"You're kidding!","jump":null},{"id":"m_ex_volume_01_16","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_16","text":"How is that even possible?","jump":null},{"id":"m_ex_volume_01_17","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_17","text":"Let me ask you something. Are you one of my fans?","jump":null},{"id":"m_ex_volume_01_18","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_18","text":"I am.","jump":"m_ex_volume_01_20"},{"id":"m_ex_volume_01_19","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_19","text":"No, I'm not.","jump":"m_ex_volume_01_23"},{"id":"m_ex_volume_01_20","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_20","text":"What?","jump":null},{"id":"m_ex_volume_01_21","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_21","text":"You haven't even seen a single show of mine.","jump":null},{"id":"m_ex_volume_01_22","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_22","text":"How can you call yourself a fan?","jump":"m_ex_volume_01_25"},{"id":"m_ex_volume_01_23","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_23","text":"Wha... but if not me, then who?","jump":null},{"id":"m_ex_volume_01_24","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_24","text":"Noise? Aria?","jump":null},{"id":"m_ex_volume_01_25","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_25","text":"Either way, talk about a blow to my pride...","jump":null},{"id":"m_ex_volume_01_26","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_26","text":"I'll send you a ticket to my concert soon.","jump":null},{"id":"m_ex_volume_01_27","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_27","text":"Be there, or be square.","jump":null},{"id":"m_ex_volume_01_28","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_01_28","text":"I'll put on a show you'll never forget.","jump":null},{"id":"m_ex_volume_01_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_01_29","text":"Deal.","jump":null}],"chat":true}