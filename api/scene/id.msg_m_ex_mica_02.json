{"id":"msg_m_ex_mica_02","cat":"messenger","group":{"id":"room_mica","label":"Mica · Nikke"},"label":"2. Hey, Old-Timer!","stage":null,"prev":"msg_m_ex_mica_01","next":"msg_m_ex_mica_03","speakers":{"mica":"Mica"},"icons":{"mica":"si_c061_00_s"},"lines":[{"id":"m_ex_mica_02_1","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_1","text":"Hey, Old-Timer!","jump":null},{"id":"m_ex_mica_02_2","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_2","text":"Can I ask you something?","jump":null},{"id":"m_ex_mica_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_02_3","text":"Ask away.","jump":null},{"id":"m_ex_mica_02_4","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_4","text":"Which do you like more?","jump":null},{"id":"m_ex_mica_02_5","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_5","text":"Eating...","jump":null},{"id":"m_ex_mica_02_6","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_6","text":"or fireworks?","jump":null},{"id":"m_ex_mica_02_7","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_7","text":"I made a bet with Belorta","jump":null},{"id":"m_ex_mica_02_8","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_8","text":"and she said you'd like eating more!","jump":null},{"id":"m_ex_mica_02_9","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_9","text":"My money's on you liking fireworks more, hehehe.","jump":null},{"id":"m_ex_mica_02_10","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_10","text":"So I'm curious which one","jump":null},{"id":"m_ex_mica_02_11","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_11","text":"comes out on top! ^____^","jump":null},{"id":"m_ex_mica_02_12","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_02_12","text":"I like eating more.","jump":"m_ex_mica_02_14"},{"id":"m_ex_mica_02_13","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_02_13","text":"I like fireworks more.","jump":"m_ex_mica_02_18"},{"id":"m_ex_mica_02_14","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_14","text":"!!","jump":null},{"id":"m_ex_mica_02_15","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_15","text":"Aw man, I thought for sure you'd prefer fireworks.","jump":null},{"id":"m_ex_mica_02_16","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_16","text":"Belorta was right... Go figures.","jump":null},{"id":"m_ex_mica_02_17","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_17","text":"Well, she'll be happy when she hears this at any rate.","jump":"m_ex_mica_02_24"},{"id":"m_ex_mica_02_18","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_18","text":"!!","jump":null},{"id":"m_ex_mica_02_19","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_19","text":"I knew it! I knew you'd prefer fireworks.","jump":null},{"id":"m_ex_mica_02_20","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_20","text":"Um...","jump":null},{"id":"m_ex_mica_02_21","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_21","text":"If Belorta comes and asks you the same question,","jump":null},{"id":"m_ex_mica_02_22","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_22","text":"can you tell her that you like eating more?","jump":null},{"id":"m_ex_mica_02_23","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_23","text":"She might be disappointed otherwise.","jump":"m_ex_mica_02_24"},{"id":"m_ex_mica_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_02_24","text":"To be honest, I like both.","jump":null},{"id":"m_ex_mica_02_25","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_25","text":"Whoa! Really?","jump":null},{"id":"m_ex_mica_02_26","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_26","text":"You really do like both?","jump":null},{"id":"m_ex_mica_02_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_02_27","text":"Definitely. I can't really choose which is better.","jump":null},{"id":"m_ex_mica_02_28","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_28","text":"That's great!","jump":null},{"id":"m_ex_mica_02_29","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_29","text":"That means Belorta and I are tied!","jump":null},{"id":"m_ex_mica_02_30","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_30","text":"Just wait till Belorta hears this! Hehehe!","jump":null},{"id":"m_ex_mica_02_31","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_31","text":"She's gonna flip!","jump":null},{"id":"m_ex_mica_02_32","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_32","text":"Thanks, Old-Timer!","jump":null},{"id":"m_ex_mica_02_33","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_33","text":"Let's talk again soon.","jump":null},{"id":"m_ex_mica_02_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_02_34","text":"Sure thing. Until next time.","jump":null},{"id":"m_ex_mica_02_35","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_02_35","text":"Take care of yourself, Old-Timer!","jump":null}],"chat":true}