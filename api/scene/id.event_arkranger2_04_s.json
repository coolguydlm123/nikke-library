nt_arkranger2_04_s_72","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_04_s_72","text":"*Clap, clap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_73","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_04_s_73","text":"Mustang claps again, and someone walks in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["trony"],"affinity":null},{"id":"event_arkranger2_04_s_74","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_74","text":"H-hello...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_75","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_04_s_75","text":"... Trony?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_76","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_04_s_76","text":"The hero of Ark...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_77","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_77","text":"Wh-what? Don't be ridiculous...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_78","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_78","text":"Trony, Missilis's top mechanic, will customize the Ark Machine for use in real combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_79","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_79","text":"Of course, les élites de Tetra et Elysion will be joining as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_80","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_80","text":"The Ark Machine isn't built pour le combat? Non, non! That is a thing of the past now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_81","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_81","text":"Wh-when I first heard the plan, it sounded completely ridiculous...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_82","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_82","text":"B-but if we're doing this, I wanted to be the one to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_83","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_83","text":"I couldn't resist being part of the Ark Rangers' biggest performance yet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_84","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_04_s_84","text":"... Thank you, Trony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_85","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_85","text":"N-no, thank you. Being able to modify a real-life Ark Machine, one that's not just a model, is such an honor!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_86","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_04_s_86","text":"No need to thank me. The honor is mine, getting help from the hero of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_87","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_87","text":"Oh, b-but the honor really is all mine...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_88","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_04_s_88","text":"That's kind of you, but really the honor is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_89","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_04_s_89","text":"N-no, I must insist...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_90","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_04_s_90","text":"Yes, but I too insist...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_91","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_04_s_91","text":"... While we let them sort that out, I want to ask something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_92","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_04_s_92","text":"There's no way people won't see through this whole thing. Do you really think it's going to work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_93","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_93","text":"Oh? That is what you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_94","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_94","text":"Me and Tetra,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_95","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_95","text":"as well as le Central Government,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_96","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_96","text":"are working together to transformer le faux into something real, et vice versa.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_97","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_04_s_97","text":"Do you really think we are so incapables?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_04_s_98",