er":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_12","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_06_s_12","text":"Anyway, I guess we'll have to make it work somehow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_13","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_13","text":"No need to worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_14","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_14","text":"We'll handle Annihilio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_15","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_06_s_15","text":"We...? As in, Elysion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_16","text":"*Rumble*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_17","text":"A thunderous noise rips through the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_18","text":"Maxwell looks up at the source of the sound and gulps.","jump":null,"exit":false,"enter":null,"bg":"EventScene_arkranger_08","bgArt":"eventscene_arkranger_08","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_19","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_06_s_19","text":"Whoa! This plane is huge! And it can actually fly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_20","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_20","text":"It's a plane. Of course it can fly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_21","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_06_s_21","text":"Did you take your shoes off? You're supposed to take your shoes off before boarding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_22","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_06_s_22","text":"Huh? We are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_23","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_23","text":"Huh? We are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_24","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_24","text":"You of all people should know that's not true.","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":null,"movie":null,"shown":["cielo","sora","sky","anis_i_w","rapi_red","neon_v_w"],"affinity":null},{"id":"event_arkranger2_06_s_25","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_25","text":"I just went with the flow and boarded. What're we doing exactly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_26","type":"Speech","speaker":"sora","key":"Locale_MainScenario:event_arkranger2_06_s_26","text":"You could say this is the long-awaited fruit of our labor ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_27","type":"Speech","speaker":"sora","key":"Locale_MainScenario:event_arkranger2_06_s_27","text":"You remember how we searched everywhere for that legendary aircraft that supposedly crashed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_28","type":"Speech","speaker":"sora","key":"Locale_MainScenario:event_arkranger2_06_s_28","text":"Well, we finally found it and repaired it. Pretty impressive, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_29","type":"Speech","speaker":"sora","key":"Locale_MainScenario:event_arkranger2_06_s_29","text":"The Wings of Victory has been fully restored! ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_30","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_30","text":"As we repaired it, we made a lot of upgrades too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_31","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_31","text":"All the outdated weaponry has been replaced with modern systems, and everything from the engine to the exterior shell has been reinforced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_32","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_32","text":"We even installed a gravity control system to make navigation far more precise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_33","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_06_s_33","text":"A gravity control system? Sounds like what Endless had.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_34","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_34","text":"Yeah, now that you mention it, I remember hearing Elysion was testing something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_35","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_06_s_35","text":"Aw, and here I thought Ingrid was ditching being tactical and going full sci-fi. I was totally off base!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_36","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_36","text":"With all that rebuilding, though, is there anything of the original even left?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_37","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_06_s_37","text":"Oh, I know what you're talking about. The Plane of Thesises, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_06_s_38","text":"It's the Ship of Theseus...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_39","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_39","text":"We wanted to preserve the original as much as possible, of course,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_40","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_40","text":"but it was so old, and while parts of it may have been functional, it's better to have something... better, y'know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_41","type":"Speech","speaker":"sky","key":"Locale_MainScenario:event_arkranger2_06_s_41","text":"Don't call Zoomie old!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_42","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_42","text":"Oh, sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_43","type":"Speech","speaker":"sky","key":"Locale_MainScenario:event_arkranger2_06_s_43","text":"Anyone who says one more bad word about Zoomie is getting kicked off immediately!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_44","type":"Speech","speaker":"sky","key":"Locale_MainScenario:event_arkranger2_06_s_44","text":"Everyone repeat after me: \"Zoomie is the best aircraft around!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_45","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_45","text":"Zoomie is the best aircraft around!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_46","type":"Speech","speaker":"sora","key":"Locale_MainScenario:event_arkranger2_06_s_46","text":"Zoomie is the best aircraft around! ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_47","type":"Speech","speaker":"sky","key":"Locale_MainScenario:event_arkranger2_06_s_47","text":"Counters! Want to get ejected? Say it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_48","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_48","text":"Zoomie is...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_49","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_49","text":"Hold on, why is it called \"Zoomie\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_50","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_50","text":"Because planes go zoom through the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_51","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_52","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_52","text":"Enough chatter. Need I remind you that you're in the middle of an operation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"event_arkranger2_06_s_53","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_53","text":"Now, how does it feel to be aboard the Wings of Victory, Elysion Edition? It's equipped with every bit of technology Elysion has.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_54","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_54","text":"Didn't you just say enough chatter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_55","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_55","text":"... Ahem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_56","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_56","text":"As of this moment, your mission is to stop the Heretic missile, Annihilio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_57","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_57","text":"The Wings of Victory versus a Heretic... Heh, what a wonderfully tactical showdown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_58","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_58","text":"... What part of that is tactical?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_59","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_59","text":"Go forth, Wings of Victory!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_60","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_60","text":"Show them who rules the skies!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_61","type":"Speech","speaker":"sky","key":"Locale_MainScenario:event_arkranger2_06_s_61","text":"Yes, ma'am!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_62","type":"Speech","speaker":"sky","key":"Locale_MainScenario:event_arkranger2_06_s_62","text":"Zoomie! Full speed ahead!","jump":null,"exit":false,"enter":null,"bg":"EventScene_arkranger_08","bgArt":"eventscene_arkranger_08","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_63","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_63","text":"*Whoosh!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_64","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_64","text":"The Wings of Victory rapidly approaches the descending Annihilio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_65","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_65","text":"Whoa, whoa, whoa! We're not just going to ram it, are we?!","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":null,"movie":null,"shown":["cielo","sora","sky","anis_i_w","rapi_red","neon_v_w"],"affinity":null},{"id":"event_arkranger2_06_s_66","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_66","text":"Of course not. We'll dive at the same speed that Annihilio is descending.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"event_arkranger2_06_s_67","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_67","text":"All you need to do is take it out before it hits the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_68","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_68","text":"... Where are we gonna fight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_69","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:event_arkranger2_06_s_69","text":"On the deck, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_70","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_06_s_70","text":"This is tactical warfare personified.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_71","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_06_s_71","text":"If by \"tactical\" you mean completely reckless, I guess I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_72","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_06_s_72","text":"It's pretty exciting, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_73","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_06_s_73","text":"It certainly is. Is your blood pumping too, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_74","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_06_s_75","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_06_s_75","text":"Sora walks up to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":n