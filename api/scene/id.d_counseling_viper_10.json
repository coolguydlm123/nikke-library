{"id":"d_counseling_viper_10","cat":"counsel","group":{"id":"char1022","label":"Viper"},"label":"Advising Viper: 10","stage":null,"prev":"d_counseling_viper_09","next":"d_counseling_viper_11","speakers":{"viper":"Viper"},"icons":{"viper":"si_c112_00_s"},"lines":[{"id":"d_counseling_viper_10_1","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_10_1","text":"What's the best thing about living in the Outer Rim?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["viper"],"affinity":"_0"},{"id":"d_counseling_viper_10_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_10_2","text":"I don't know.","jump":"d_counseling_viper_10_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_viper_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_10_3","text":"I get to see you often.","jump":"d_counseling_viper_10_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_viper_10_4","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_10_4","text":"While I appreciate your honesty,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_10_5","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_10_5","text":"you should try a little harder to come up with something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_10_6","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_10_6","text":"If someone from the Outer Rim heard you say that, they might feel hurt.","jump"