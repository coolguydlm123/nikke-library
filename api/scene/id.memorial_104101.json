{"id":"memorial_104101","cat":"memorial","group":{"id":"memorial104100","label":"Data · Dark Matter is What?!"},"label":"Overview","stage":null,"prev":null,"next":"memorial_104102","speakers":{},"icons":{},"lines":[{"id":"memorial_104101_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_41_01_description","text":"Dark Matter is liquid metal."},{"id":"memorial_104101_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_41_01_description","text":"It is both hard and soft all at once, possessing the viscosity of a liquid, yet the durability of a metal."}]}