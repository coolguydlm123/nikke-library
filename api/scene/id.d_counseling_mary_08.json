{"id":"d_counseling_mary_08","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 08","stage":null,"prev":"d_counseling_mary_07","next":"d_counseling_mary_09","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_08_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_1","text":"I'm always used to having to listen to others talk, so I really enjoy it when I can talk to you.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_08_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_2","text":"It puts my mind at ease and my worries all just melt away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_3","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_3","text":"But, Commander... don't you ever want other people to listen to what's on your mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_08_4","text":"I do.","jump":"d_counseling_mary_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_08_5","text":"I don't.","jump":"d_counseling_mary_08_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_08_6","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_6","text":"How about you tell me what's on your mind next time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_7","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_7","text":"Maybe that way I can find a way to help you relax.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_8","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_8","text":"Come to me any time you want to talk. Really.","jump":"d_counseling_mary_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_9","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_9","text":"That's a normal reaction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_10","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_10","text":"Well, if you ever want to talk about anything that's bothering you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_11","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_08_11","text":"just come find me.\nI'll always make myself available for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_08_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_08_12","text":"The time I spent with Mary was very meaningful.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}