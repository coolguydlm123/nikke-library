{"id":"d_counseling_laplace_18","cat":"counsel","group":{"id":"char1010","label":"Laplace"},"label":"Advising Laplace: 18","stage":null,"prev":"d_counseling_laplace_17","next":"d_counseling_laplace_19","speakers":{"laplace":"Laplace"},"icons":{"laplace":"si_c100_00_s"},"lines":[{"id":"d_counseling_laplace_18_1","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_1","text":"Today's topic is: can villains be forgiven?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["laplace"],"affinity":"_0"},{"id":"d_counseling_laplace_18_2","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_2","text":"Birdie! Tell me what you think!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_18_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_laplace_18_3","text":"Yes, they can.","jump":"d_counseling_laplace_18_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_laplace_18_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_laplace_18_4","text":"No, they can't.","jump":"d_counseling_laplace_18_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_laplace_18_5","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_5","text":"I can't say that I agree with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_18_6","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_6","text":"Even if a villain changes their ways, they can never take back all the evil deeds they've committed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_18_7","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_7","text":"To me, that means they can never be forgiven.","jump":"d_counseling_laplace_18_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_18_8","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_8","text":"So, we're on the same page.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_18_9","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_9","text":"Broken glass can never be put back together again. Even if they repent, they can't undo the damage they've done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_18_10","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_18_10","text":"Evil acts have repercussions which last forever. They can never be erased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_18_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_laplace_18_11","text":"I spend time with Laplace looking at the encyclopedia of villains.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}