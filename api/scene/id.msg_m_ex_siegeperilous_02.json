{"id":"msg_m_ex_siegeperilous_02","cat":"messenger","group":{"id":"room_siegeperilous","label":"Perilous Siege · Group"},"label":"2. Honey,","stage":null,"prev":"msg_m_ex_siegeperilous_01","next":null,"speakers":{"d_k":"D","k":"K"},"icons":{"d_k":"si_c043_00_s","k":"si_c041_00_s"},"lines":[{"id":"m_ex_siegeperilous_02_1","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_1","text":"Honey,","jump":null},{"id":"m_ex_siegeperilous_02_2","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_2","text":"are you awake?","jump":null},{"id":"m_ex_siegeperilous_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_3","text":"Yeah.","jump":null},{"id":"m_ex_siegeperilous_02_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_4","text":"Did you sleep well?","jump":null},{"id":"m_ex_siegeperilous_02_5","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_5","text":"Yes.","jump":null},{"id":"m_ex_siegeperilous_02_6","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_6","text":"You only have one day left on your business trip, right?","jump":null},{"id":"m_ex_siegeperilous_02_7","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_7","text":"Today will be the last time","jump":null},{"id":"m_ex_siegeperilous_02_8","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_8","text":"I wake up alone.","jump":null},{"id":"m_ex_siegeperilous_02_9","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_9","text":"!","jump":null},{"id":"m_ex_siegeperilous_02_10","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_10","text":"^@%$^$","jump":null},{"id":"m_ex_siegeperilous_02_11","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_11","text":"This is driving me crazy.","jump":null},{"id":"m_ex_siegeperilous_02_12","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_12","text":"What the hell is wrong with you?","jump":null},{"id":"m_ex_siegeperilous_02_13","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_13","text":"Why are you doing this here","jump":null},{"id":"m_ex_siegeperilous_02_14","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_14","text":"instead of a personal message?","jump":null},{"id":"m_ex_siegeperilous_02_15","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_15","text":"You ought to be aware of our current setup","jump":null},{"id":"m_ex_siegeperilous_02_16","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_16","text":"so you'll be equipped to handle any unexpected situations that crop up.","jump":null},{"id":"m_ex_siegeperilous_02_17","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_17","text":"...","jump":null},{"id":"m_ex_siegeperilous_02_18","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_18","text":"I'm only doing this for the sake of the mission.","jump":null},{"id":"m_ex_siegeperilous_02_19","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_19","text":"I'm meeting you half-way here,","jump":null},{"id":"m_ex_siegeperilous_02_20","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_20","text":"so please take it seriously.","jump":null},{"id":"m_ex_siegeperilous_02_21","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_21","text":"At any rate, I wanted to add more to our arrangement.","jump":null},{"id":"m_ex_siegeperilous_02_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_22","text":"In that case...","jump":null},{"id":"m_ex_siegeperilous_02_23","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_23","text":"Yes?","jump":null},{"id":"m_ex_siegeperilous_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_24","text":"If we were to add more to the arrangement,","jump":null},{"id":"m_ex_siegeperilous_02_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_25","text":"what about making K my sister-in-law?","jump":null},{"id":"m_ex_siegeperilous_02_26","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_26","text":"What?","jump":null},{"id":"m_ex_siegeperilous_02_27","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_27","text":"What?","jump":null},{"id":"m_ex_siegeperilous_02_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_28","text":"...","jump":null},{"id":"m_ex_siegeperilous_02_29","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_29","text":"What in the world are you talking about, Honey?","jump":null},{"id":"m_ex_siegeperilous_02_30","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_30","text":"Sister-in-law?","jump":null},{"id":"m_ex_siegeperilous_02_31","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_31","text":"Seriously?","jump":null},{"id":"m_ex_siegeperilous_02_32","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_32","text":"I don't even have a sister. At least, not that kind.","jump":null},{"id":"m_ex_siegeperilous_02_33","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_33","text":"{AccountData.NickName}.","jump":null},{"id":"m_ex_siegeperilous_02_34","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_34","text":"Get your mind out of the gutter!","jump":null},{"id":"m_ex_siegeperilous_02_35","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_35","text":"That's a bit much,","jump":null},{"id":"m_ex_siegeperilous_02_36","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_36","text":"even for you, Honey.","jump":null},{"id":"m_ex_siegeperilous_02_37","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_37","text":"Too much?","jump":null},{"id":"m_ex_siegeperilous_02_38","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_38","text":"You're one to talk.","jump":null},{"id":"m_ex_siegeperilous_02_39","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_39","text":"If I'm not qualified to protest, then who is?","jump":null},{"id":"m_ex_siegeperilous_02_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_40","text":"Sorry.","jump":null},{"id":"m_ex_siegeperilous_02_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_41","text":"Really...","jump":null},{"id":"m_ex_siegeperilous_02_42","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_42","text":"...","jump":null},{"id":"m_ex_siegeperilous_02_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_43","text":"I was wrong.","jump":null},{"id":"m_ex_siegeperilous_02_44","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_44","text":"No, Honey, you did nothing wrong.","jump":null},{"id":"m_ex_siegeperilous_02_45","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_45","text":"I'm sorry for getting worked up. That's not like me.","jump":null},{"id":"m_ex_siegeperilous_02_46","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_46","text":"@K, you and I can discuss this further on our own.","jump":null},{"id":"m_ex_siegeperilous_02_47","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_47","text":"Fine by me.","jump":null},{"id":"m_ex_siegeperilous_02_48","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_48","text":"Today, we settle this once and for all.","jump":null},{"id":"m_ex_siegeperilous_02_49","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_49","text":"With words, right?","jump":null},{"id":"m_ex_siegeperilous_02_50","type":"Speech","speaker":"d_k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_50","text":"Of course...","jump":null},{"id":"m_ex_siegeperilous_02_51","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_siegeperilous_02_51","text":"Not.","jump":null},{"id":"m_ex_siegeperilous_02_52","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_siegeperilous_02_52","text":"... I figured.","jump":null}],"chat":true}