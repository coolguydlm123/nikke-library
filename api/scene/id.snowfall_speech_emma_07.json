ry.","jump":null,"exit":true,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_7","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_7","text":"Hey, Commander! Are you here to rest for a bit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_8","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_emma_07_8","text":"I planned on it. What are you up to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_9","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_9","text":"I was thinking about the food we ate during the cooking competition today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_10","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_10","text":"What did you think of it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_11","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_11","text":"Wasn't it delicious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_12","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_emma_07_12","text":"Very much so.","jump":"snowfall_speech_emma_07_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_13","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_emma_07_13","text":"It was, especially the dish that you made.","jump":"snowfall_speech_emma_07_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_14","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_14","text":"I'm glad to hear that, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_15","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_15","text":"I didn't realize the others were so good at cooking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_16","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_16","text":"I guess I'll have to work harder so I don't fall behind.","jump":"snowfall_speech_emma_07_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_17","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_17","text":"You really think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_18","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_18","text":"I put my heart and soul into that dish, so it's incredibly rewarding to hear you say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_19","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_19","text":"If there's ever anything specific you want to eat, let me know and I'll make it for you.","jump":"snowfall_speech_emma_07_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_20","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_20","text":"I'm just over the moon that the competition went so well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_21","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_21","text":"It was a real pleasure seeing everyone get so much enjoyment out of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_22","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_22","text":"Actually, I was so worried about the competition, that I hadn't gotten much sleep the past few nights.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_23","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_speech_emma_07_23","text":"But I think I'll finally be able to have a good night's sleep tonight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_emma_07_24","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_emma_07_24","text":"I have a pleasant time talking with Emma about the cooking competition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}