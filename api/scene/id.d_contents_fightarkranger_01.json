{"id":"d_contents_fightarkranger_01","cat":"event","group":{"id":"ev83101","label":"ARK RANGER"},"label":"FIGHT! ARK RANGER!","stage":null,"prev":null,"next":null,"speakers":{"arkrangerblack":"Ark Ranger Black","director":"Director","red":"Ark Ranger Red","blue":"Ark Ranger Blue"},"icons":{"arkrangerblack":"si_c570_00_s","director":"si_c999_00_s","red":"si_c571_00_s","blue":"si_c572_00_s"},"lines":[{"id":"d_contents_fightarkranger_01_1","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_1","text":"Director.","jump":null,"exit":false,"enter":null,"bg":"ArkRangerOffice","bgArt":"arkrangeroffice","image":null,"bgm":"bgm_story_cosmos","movie":null,"shown":["arkrangerblack","red","blue"],"affinity":null},{"id":"d_contents_fightarkranger_01_2","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_2","text":"I'd like to learn how to operate Ark Leon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_3","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_3","text":"Huh? Ark Leon? That's rather sudden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_4","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_4","text":"We're still a long way from filming the Ark Machine scenes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_5","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_5","text":"I know, but it wouldn't hurt to get some practice in beforehand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_6","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_6","text":"Don't worry. You'll have plenty of time to practice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_7","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_7","text":"I wouldn't dream of overworking you guys.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_8","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_9","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_9","text":"I see... Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_10","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_10","text":"Huh? You never think twice about causing trouble on any given day. Why are you being so hesitant now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_11","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_11","text":"Just admit you want to try out the Ark Leon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_12","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_12","text":"She's right. You always request for retakes during shoots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_13","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_13","text":"No, I can't take the Ark Leon out for a spin just to satisfy my personal curiosity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_14","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_14","text":"Sure, I'm curious about how the drive system works, what kind of weapons it has, how responsive the controls are, and what the cockpit's field of view is like, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_15","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_15","text":"I won't throw a fit about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_16","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_16","text":"That's exactly what you're doing right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_17","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_17","text":"Wait... don't tell me this is because of the budget?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_18","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_19","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_19","text":"... I can't deny that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_20","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_20","text":"I don't know much about budgets, but even I know operating something as massive as an Ark Machine must be exorbitantly expensive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_21","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_21","text":"I can't burn through the budget just to indulge my own dreams, wishes, longings, aspirations, expectations, urges and yearnings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_22","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_22","text":"Just say you want to do it already. That was really uncomfortable to listen to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_23","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_23","text":"Can we make it happen, Director? I can't listen to this anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_24","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_24","text":"Absolutely not. Just moving that thing once costs a small fortune.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_25","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_25","text":"... Right. I thought so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_26","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_26","text":"But if you stick with the simulator, all it costs is electricity, so that we can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_27","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_27","text":"What...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_28","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_28","text":"We always planned on having you learn to pilot the Ark Machines through a simulator anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_29","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_29","text":"Can't have you moving around something that massive just for practice. Every time that thing moves, we burn through mountains of cash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_30","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_30","text":"It may be a simulator, but the controls and the feel of piloting it have been recreated perfectly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_31","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_31","text":"Feel free to use it as much as you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_32","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_33","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_33","text":"All right. I'll take you up on that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_34","type":"Speech","speaker":"director","key":"Locale_SubScenario:d_contents_fightarkranger_01_34","text":"Great. Hang tight while I get everything set up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_35","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_35","text":"You're such a handful, you know that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_36","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_36","text":"What she said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_37","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_37","text":"Red, Blue. Get ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_38","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_38","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_39","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_39","text":"Us too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_40","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_40","text":"Of course. Ark Leon isn't the only Ark Machine we have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_41","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_42","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_43","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_43","text":"Let's go, Ark Rangers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_44","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_44","text":"... Fine. I'll play along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_45","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_45","text":"Be honest, Red. You were interested too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_46","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_46","text":"I'd be lying if I said I wasn't. I mean, that thing is a giant robot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_47","type":"Speech","speaker":"red","key":"Locale_SubScenario:d_contents_fightarkranger_01_47","text":"If seeing that doesn't get your heart racing, there's something wrong with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_48","type":"Speech","speaker":"arkrangerblack","key":"Locale_SubScenario:d_contents_fightarkranger_01_48","text":"True.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_fightarkranger_01_49","type":"Speech","speaker":"blue","key":"Locale_SubScenario:d_contents_fightarkranger_01_49","text":"Yeah, yeah. Of course you'd agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}