{"id":"d_counseling_tove_02","cat":"counsel","group":{"id":"char5081","label":"Tove"},"label":"Advising Tove: 02","stage":null,"prev":"d_counseling_tove_01","next":"d_counseling_tove_03","speakers":{"tove":"Tove"},"icons":{"tove":"si_c192_00_s"},"lines":[{"id":"d_counseling_tove_02_1","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_02_1","text":"You've been going through a rough patch, haven't you?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["tove"],"affinity":"_0"},{"id":"d_counseling_tove_02_2","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_02_2","text":"That's why I brought you some nourishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_02_3","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_tove_02_3","text":"Tove takes two bags out of her pocket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_02_4","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_02_4","text":"I'll eat one and give one to you. Now, pick one!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_02_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_tove_02_5","text":"Pick the bag that is wriggling.","jump":"d_counseling_tove_02_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_tove_02_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_tove_02_6","text":"Pick the bag that is tinged with a faint touch of red.","jump":"d_counseling_tove_02_10","ex