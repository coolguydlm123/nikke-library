,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_20","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_20","text":"I apologize.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_21","text":"... Well, at least you're quick with an apology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_22","text":"So why have you got this axe to grind with the Ark? Why do you want to destroy what belongs to it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_23","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_23","text":"Because the Ark stole what belonged to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_24","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_24","text":"An eye for an eye. A tooth for a tooth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_25","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_e_25","text":"What was taken from you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_26","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_26","text":"-----","jump":