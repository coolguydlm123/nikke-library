,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_6","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_e_6","text":"I'll go get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_7","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_e_7","text":"Meanwhile, we start our conversation with Com, who has been revived, or had its fuse reinserted, rather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce006_01","com","rapi","roam","anis","neon"],"affinity":null},{"id":"event_ce006_1_03_e_8","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_8","text":"I have nothing to say to the likes of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_9","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_9","text":"Untie me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_10","text":"Why did you attack us out of nowhere?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_11","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_11","text":"I didn't intend on harming you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_12","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_12","text":"I was only trying to destroy Ark property.","