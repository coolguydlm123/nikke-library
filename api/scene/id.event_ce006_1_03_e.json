ity":null},{"id":"event_ce006_1_03_e_34","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_34","text":"I didn't ask for help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_35","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_35","text":"You're nothing but an Ark lapdog who licks their boots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_36","text":"Dang, this robot can even talk smack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_37","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_37","text":"Harsh words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_38","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_38","text":"I'm hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_39","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_39","text":"-----","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_40","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_e_40","text":"Com.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_41","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_e_41","text":"Won't you tell us what happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_42","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_e_42","text":"I... hate the Ark as well. We might be able to help you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_43","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_03_e_43","text":"Get lost, Ark lapdog.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_44","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_e_44","text":"Hey, that hurt...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_45","text":"Whatever. Screw this thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_46","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_03_e_46","text":"But shouldn't we try to help? It's clearly been through some trauma. Maybe we can help it heal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_47","text":"If it was the least bit conflicted, maybe. But it clearly has no intention of cozying up to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_48","text":"It doesn't even want to talk to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_49","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_49","text":"So screw it. It's unarmed and we've got it locked up, so it's not like it can do anything anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_50","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_03_e_50","text":"Hm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_51","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_51","text":"Let's leave this thing to rot, and go help them fix the Tetrapod.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_e_52","text":"Or stand guard nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_53","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_03_e_53","text":"I think at least one person should stand guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_54","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_54","text":"I will stay here and keep an eye on Com.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_55","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_03_e_55","text":"You will?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_56","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_56","text":"Yes. I do not need to sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_57","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_57","text":"Perfect for standing guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_58","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_58","text":"Com is also weaker than Roam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_59","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_59","text":"I will win every time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_60","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_e_60","text":"Out of 100 fights, I win 100.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_e_61","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_e_61","text":"Okay. We'll leave it to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce