{"id":"event_ltk_02_s","cat":"event","group":{"id":"ev40012","label":"LICENSE TO KILL"},"label":"Company Life: A","stage":null,"prev":"event_ltk_01_e","next":"event_ltk_02_e","speakers":{"Self":"Commander","k":"K","d":"D","Narration":"Narration","Monologue":"Monologue","supervisor":"Supervisor"},"icons":{"k":"si_c041_00_s","d":"si_c040_00_s","Narration":"si_c999_00_s","supervisor":"si_c911_00_s"},"lines":[{"id":"event_ltk_02_s_1","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_1","text":"... We're going to get jobs?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["d","k"],"affinity":null},{"id":"event_ltk_02_s_2","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_2","text":"That's right. We'll get hired at the target's company, and see what we can dig up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_3","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_3","text":"If we want to find out the truth, we've got to get on the inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_4","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_4","text":"How exactly do you plan on all of us getting hired?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_5","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_5","text":"Starting tomorrow, all we've got to do is show up at the office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_6","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_6","text":"We've got it all taken care of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_7","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_7","text":"We just need to start working from tomorrow morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_8","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_8","text":"Don't worry, we didn't do anything illegal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_9","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_9","text":"We've got our official employee documentation all in order. They look so good, you'd never know they were fake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_10","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_10","text":"That's illegal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_11","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_11","text":"Don't be such a stick in the mud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_12","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_12","text":"Anyway, good luck at work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_13","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_13","text":"You talk as if you're not going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_14","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_14","text":"That's exactly right. I'm not going to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_15","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_15","text":"I'm going to look into the medical institutions that the target has been putting money into.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_16","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_16","text":"That's important too, y'know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_17","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_17","text":"You and D can handle this side of things without me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_18","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_18","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_19","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_19","text":"Get some rest tonight. We put our plan into action starting tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_20","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_20","text":"One last thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_21","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_21","text":"Ugh, what is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_22","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_22","text":"Why can't you just ask Enikk to make a judgment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_23","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_23","text":"A fair question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_24","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_24","text":"Enikk doesn't make judgments unless requested by the Judges.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_25","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_25","text":"The target has an uncomfortable association with the Judges. There's no way they'd take this to Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_26","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_26","text":"The only scenario where Enikk would act on her own","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":null,"movie":null,"shown":["enikk"],"affinity":null},{"id":"event_ltk_02_s_27","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_27","text":"would be if someone was causing untold damage to the Ark or its inhabitants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_28","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_28","text":"Otherwise, she grants the Judges full autonomy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_29","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_29","text":"Basically,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":["d","k"],"affinity":null},{"id":"event_ltk_02_s_30","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_30","text":"regardless of what this guy is up to, it doesn't constitute a major threat to security, at least not in Enikk's eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_31","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_31","text":"So long as that's the case, she won't act on her own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_32","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_32","text":"I'll give you an example.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_33","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_33","text":"Human trafficking. An unforgivable offense, wouldn't you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_34","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_34","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_35","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_35","text":"Not from Enikk's perspective.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_36","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_36","text":"Nobody gets killed. It's not a question of how traumatic an experience is or isn't. For Enikk, it's purely numbers. If they don't change, then it's not a problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_37","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_38","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_38","text":"Having said that, human trafficking often involves a litany of other heinous offenses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_39","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_39","text":"However warped it seems, the essential act of human trafficking in and of itself is not a problem as far as Enikk is concerned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_40","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_40","text":"She operates according to different standards than us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_41","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_41","text":"Therefore, this case is something that the Judges and us need to figure out on our own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_42","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_02_s_42","text":"Yourself included.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_43","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_43","text":"Okay. I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_44","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_44","text":"Don't take this lightly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_45","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_45","text":"This can be a heavy burden, but it is one you must carry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_46","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_46","text":"I'll keep that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_47","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_ltk_02_s_47","text":"Next day.","jump":null,"exit":false,"enter":null,"bg":"Storage","bgArt":"storage","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_48","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_02_s_48","text":"D and I started work at the distribution warehouse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_49","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_02_s_49","text":"We sort items, move others, and carry out inventory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_50","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_02_s_50","text":"After moving around non-stop, it's finally break time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_51","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["d"],"affinity":null},{"id":"event_ltk_02_s_52","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_53","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_54","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_55","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_55","text":"This is exhausting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_56","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_56","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_57","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_57","text":"Are you used to this kind of work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_58","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_58","text":"Nope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_59","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_59","text":"... All right then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_60","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_61","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_61","text":"You don't talk much, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_62","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_62","text":"Nope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_63","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_63","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_64","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_64","text":"Hey there, you two. You're the new hires, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["supervisor"],"affinity":null},{"id":"event_ltk_02_s_65","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_65","text":"How's the work so far?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_66","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_66","text":"Nothing too difficult, I hope?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_67","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_67","text":"No, no problems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_68","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_68","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_69","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_69","text":"Are you the supervisor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_70","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_70","text":"Guilty! I'm the supervising officer for this line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_71","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_71","text":"In that case, if it's all right,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_72","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_72","text":"I do have a question for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_73","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_73","text":"Oh... um... sure. Go right ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_74","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_74","text":"How's the cafeteria food here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_75","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_75","text":"Haha, a very important question indeed! I think you'd be hard-pressed to find anywhere with better lunch options than us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_76","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_76","text":"I must admit that I haven't exactly eaten at many other companies, but I still stand by our food here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_77","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_77","text":"Why, are you hungry already?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_78","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_78","text":"I didn't have any breakfast because I was nervous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_79","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_79","text":"My goodness! You mustn't forget breakfast. It's the most important meal of the day!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_80","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_80","text":"I see that you both started at the same time and are working on the same line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_81","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_81","text":"May I ask how you two know each other?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_82","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_82","text":"We're newlyweds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_83","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_83","text":"Just got hitched two weeks ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_84","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_84","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_85","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_85","text":"Oh, I see. Well, good luck with all of that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_86","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_86","text":"We're very grateful for you giving us this job. Aren't we, honey?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_87","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_87","text":"Yeah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_88","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_88","text":"You two seem like nice people, so let me say this to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_89","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_89","text":"This is a fine company to work for. It may be tough going at first,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_90","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_90","text":"but if you stick it out, you're sure to be noticed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_91","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_91","text":"Take me for example. My legs aren't in the greatest shape, but they still let me work here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_92","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_92","text":"As a matter of fact, I'll be working directly under the president starting tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_93","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_93","text":"Wow, no kidding?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_94","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_94","text":"What does that position entail, exactly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_95","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_95","text":"Actually, I don't know the details myself, but if it's directly under the president, it must be good, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_96","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_96","text":"Not to mention the pay...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_97","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_02_s_97","text":"The supervisor lifts his hand far above his head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_98","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_98","text":"Let's just say I might be in for an early retirement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_99","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_99","text":"You lucky son of a gun!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_100","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_100","text":"All you need is a good work ethic. Work hard, and you'll reap the rewards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_101","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_101","text":"The president admires people like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_102","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_102","text":"I've only been here 3 weeks as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_103","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_103","text":"You came on as a supervisor, but you've moved up that fast in less than a month? Remarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_104","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_104","text":"The president just takes a shine to people who put their noses to the grindstone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_105","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_105","text":"So long as you two work hard, you can become like me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_106","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_106","text":"I certainly hope so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_107","type":"Speech","speaker":"supervisor","key":"Locale_SubScenario:event_ltk_02_s_107","text":"Best of luck!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_108","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_108","text":"You too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_109","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_02_s_109","text":"The supervisor walks away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_110","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_110","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_111","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_111","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_112","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_112","text":"You got something to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_113","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_113","text":"No, I was just admiring your acting skills back there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_114","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_114","text":"Presenting an amiable and innocuous image is beneficial to gathering information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_115","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_115","text":"I'm just surprised you can turn on a dime like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_116","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_116","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_117","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_02_s_117","text":"You're starting to make me self-conscious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_02_s_118","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_02_s_118","text":"... Sorry.","jump":null,"exit":false,"ent