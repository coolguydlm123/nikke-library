{"id":"event_ce003_2_intermission_01","cat":"event","group":{"id":"ev40042","label":"MAID IN VALENTINE · Part 2"},"label":"A Long, Long Time Ago","stage":null,"prev":"event_ce003_2_03_e","next":"event_ce003_2_04_s","speakers":{"ce_003_01":"Rem","ce_003_03":"Ram","epicurean":"Food Connoisseur"},"icons":{"ce_003_01":"si_c820_00_s","ce_003_03":"si_c822_00_s"},"lines":[{"id":"event_ce003_2_intermission_01_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_1","text":"In the waiting room, several displays are installed on one side of the wall,","jump":null,"exit":false,"enter":null,"bg":"LivingRoom","bgArt":"livingroom","image":null,"bgm":"event_bgm_ce003_story_1","movie":null,"shown":["ce_003_03","ce_003_01"],"affinity":null},{"id":"event_ce003_2_intermission_01_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_2","text":"which broadcast footage of the competition venue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_3","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_3","text":"Emilia seems to be doing fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_4","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_intermission_01_4","text":"She has a complete understanding of","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_5","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_intermission_01_5","text":"how to adjust the heat,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_6","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_intermission_01_6","text":"and the amount of ingredients,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_7","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_7","text":"It would appear all your hard work paid off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_8","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_8","text":"Have you been spying on us in secret? Should we hand you over to the A.C.P.U?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_9","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_intermission_01_9","text":"There you are, Sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_10","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_intermission_01_10","text":"You were amazing out there. I expected nothing less.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_11","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_intermission_01_11","text":"I'll do my best to measure up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_12","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_12","text":"I'm sure you'll do just fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_13","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_13","text":"Well done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_14","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_14","text":"I only did what was asked of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_15","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_15","text":"More than that, I think I'm on to something. I'll be back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_16","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_16","text":"Take care of Miss Emilia for me, Rem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_17","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_17","text":"Huh? Where are you going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_18","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_18","text":"You should know better than to pester a girl about where she's going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_19","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_19","text":"Ram browses through the collectibles in the lobby.","jump":null,"exit":false,"enter":null,"bg":"BuildingLobby","bgArt":"buildinglobby","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_20","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_20","text":"In order to get back to our world,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_21","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_21","text":"I need to secure something in this mansion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_22","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_22","text":"If what I heard is true, there is a high chance it could be an item from Lugunica. It must be displayed here somewhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_23","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_23","text":"Ram passes by a dented pot, a worn-out bed sheet, and a compass,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_24","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_24","text":"before stopping in front of a book.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_25","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_25","text":"How did you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_26","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_26","text":"A golden dragon is etched on the cover.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_27","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_27","text":"The fairytale book that was in the mansion... That must be it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_28","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_28","text":"Excuse me, are you lost, by any chance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":["epicurean"],"affinity":null},{"id":"event_ce003_2_intermission_01_29","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_29","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_30","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_30","text":"I believe you should be in the waiting room, should you not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_31","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_31","text":"I-I just found these items intriguing and was browsing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_32","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_32","text":"Are you interested in my collection?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_33","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_33","text":"It's been a long time since I met someone with such good taste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_34","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_34","text":"Most people find my hobby absurd, that I'm collecting useless scraps of junk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_35","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_35","text":"There certainly doesn't seem to be much rhyme or reason to the collection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_36","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_36","text":"If it weren't for your personal interest in them, I doubt they'd be worthy of display. I'm also dubious as to their monetary value.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_37","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_37","text":"Haha, I see you don't beat around the bush.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_38","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_38","text":"Perhaps, but I don't intend to criticize someone else for their hobbies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_39","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_39","text":"Where did you get this book?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_40","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_40","text":"Oh, you mean this? Considering it came from the surface, it's in pristine condition, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_41","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_41","text":"It's written in characters I've never seen before, so I'm unable to decipher it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_42","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_42","text":"My daughter was terribly curious about what's inside its page, but I was unable to read it to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_43","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_43","text":"May I ask if you've seen this book before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_44","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_44","text":"No, I haven't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_45","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_45","text":"It just reminded me of something who can't read to save his life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_46","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_46","text":"Very well. Everyone has a right to keep some stories to themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_47","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_47","text":"If you're interested, I could share some of the stories behind the items exhibited here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_48","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_48","text":"Oh, that's okay, I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_49","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_49","text":"I obtained that compass there in order to aid in my search for ancient underwater ruins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_50","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_50","text":"With zero awareness of Ram's evident disinterest, the Connoisseur excitedly launches into another story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_51","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_51","text":"If you take a closer look at that bed sheet over there, you'll see one of the ends is slightly burnt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_52","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_52","text":"It ended up this way 'cause I blew up three beds while dukin' it out with the huge Rapture...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_53","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_53","text":"Why do you need to detonate beds while fighting with a Rapture?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_54","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_54","text":"The Connoisseur works his way through each item until he stops in front of the dented pot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_55","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_55","text":"The knight was attempting to rescue the princess, and just when all hope seemed lost...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_56","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_56","text":"Bang! He used this pot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_57","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_57","text":"Used it how?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_58","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_58","text":"To knock out a Rapture, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_59","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_59","text":"He therefore bought himself some time and was able to rescue the princess safely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_60","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_60","text":"The knight and princess escaped the castle and lived happily ever after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_61","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_61","text":"And that's how the story ends. What did you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_62","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_intermission_01_62","text":"Sounds like a fairytale for children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_63","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_intermission_01_63","text":"Haha, you caught me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_intermission_01_64","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_2_intermission_01_64","text":"The tale told by the Connoisseur is one that Ram realizes she has heard before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}