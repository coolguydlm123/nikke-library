_05_41","text":"Without the ability to create Nikkes, restoring them is impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_42","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_42","text":"Our chances of victory would be even lower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_43","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_43","text":"Also, if we can get our hands on that technology,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_44","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_44","text":"we might even be able to bring Noah back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_05_45","text":"... Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_05_46","text":"All right. I'll make it happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_47","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_47","text":"Thank you. I appreciate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_48","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_05_48","text":"Can't Papillon sneak that informa