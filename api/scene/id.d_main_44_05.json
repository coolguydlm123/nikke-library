nymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_56","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_05_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_57","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_05_57","text":"Anyway, that's Eden's situation at present.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_58","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_05_58","text":"We would strike the Queen head-on right now if we could, but we're in no condition to do so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_59","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_05_59","text":"That is why we need your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_05_60","text":"All right. I'll do everything I can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_61","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_05_61","text":"But Johan...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_62","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_05_62","text":"I don't think we can take down the Queen without the Ark's support.","jump":null,"exit":false,"enter":null,"b