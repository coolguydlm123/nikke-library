ovie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_28","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_05_28","text":"I look around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_05_29","text":"The place was never crowded to begin with, but now it feels unbearably empty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_30","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_05_30","text":"Okay. What can I do to help?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_31","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_05_31","text":"Cecil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_32","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_32","text":"What we need the most right now is the ability to produce Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_33","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_33","text":"We can modify and enhance existing units, but Eden does not have the technology to produce them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_34","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_34","text":"We want you to do whatever it takes to secure it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bg