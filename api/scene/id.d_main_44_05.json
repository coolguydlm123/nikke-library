":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_05_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_14","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_14","text":"We're evaluating and attempting all possible methods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_15","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_15","text":"We will use every means necessary to save her,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_16","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_05_16","text":"so don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_17","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_05_17","text":"... All right. I trust you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_18","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_05_18","text":"So, when are you planning a counterattack?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_19","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_05_19","text":"Not now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_05_20","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_05_20","text":"Why not?","jump":null,"exit":false,"enter":null,"