{"id":"d_counseling_guilty_14","cat":"counsel","group":{"id":"char5055","label":"Guilty"},"label":"Advising Guilty: 14","stage":null,"prev":"d_counseling_guilty_13","next":"d_counseling_guilty_15","speakers":{"guilty":"Guilty"},"icons":{"guilty":"si_c400_00_s"},"lines":[{"id":"d_counseling_guilty_14_1","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_1","text":"When I first entered the Rehabilitation Center, all the other Nikkes came over and were sizing me up.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty"],"affinity":"_0"},{"id":"d_counseling_guilty_14_2","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_2","text":"What do you think I did when that happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_14_3","text":"You ignored them.","jump":"d_counseling_guilty_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_14_4","text":"You punched them out.","jump":"d_counseling_guilty_14_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_14_5","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_5","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_6","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_6","text":"You really do understand me... good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_7","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_7","text":"That's right. I ignored them... at first.","jump":"d_counseling_guilty_14_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_8","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_8","text":"Why would I do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_9","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_9","text":"You really must think I'm some kind of depraved criminal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_10","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_10","text":"I just ignored them, since it was our first time meeting and all.","jump":"d_counseling_guilty_14_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_11","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_14_11","text":"Okay, but what did you do later on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_12","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_12","text":"Afterwards, I told them that if they were so interested, they should come in for a closer look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_13","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_13","text":"Then I gave a biiiiig ol' squeeze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_14","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_14_14","text":"To every last one of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_14_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_14_15","text":"... I better tell the rest of the Nikkes at the Outpost not to stare at Guilty.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}