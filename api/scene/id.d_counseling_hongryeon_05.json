{"id":"d_counseling_hongryeon_05","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 05","stage":null,"prev":"d_counseling_hongryeon_04","next":"d_counseling_hongryeon_06","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_05_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_1","text":"Snow White appears to be having have a hard time. She must scrounge for morsels to call a feast.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_05_2","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_2","text":"She would be wise to take some of that time spent dispatching Raptures","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_3","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_3","text":"and instead devote it to farming, so that she does not starve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_05_4","text":"Why don't you farm for her?","jump":"d_counseling_hongryeon_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_05_5","text":"She doesn't need sympathy. This is the life she chose.","jump":"d_counseling_hongryeon_05_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_05_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_6","text":"That, I cannot do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_7","text":"We have agreed not to involve ourselves in each other's lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_8","text":"Living a life of starvation is what Snow White chose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_9","text":"The moment we intervene,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_10","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_10","text":"we are then meddling in her life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_11","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_11","text":"Therefore, I shan't ever do anything in her stead.","jump":"d_counseling_hongryeon_05_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_12","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_12","text":"Precisely. Sympathy is for fools.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_13","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_13","text":"This is the life that Snow White has chosen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_14","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_05_14","text":"I have learned something from you today, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_05_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_05_15","text":"I have a conversation with Scarlet about Snow White.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}