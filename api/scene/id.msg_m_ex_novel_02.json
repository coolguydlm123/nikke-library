{"id":"msg_m_ex_novel_02","cat":"messenger","group":{"id":"room_novel","label":"Novel · Nikke"},"label":"2. Watson,","stage":null,"prev":"msg_m_ex_novel_01","next":"msg_m_ex_novel_03","speakers":{"novel":"Novel"},"icons":{"novel":"si_c212_00_s"},"lines":[{"id":"m_ex_novel_02_1","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_1","text":"Watson,","jump":null},{"id":"m_ex_novel_02_2","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_2","text":"something terrible, has happened,,,","jump":null},{"id":"m_ex_novel_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_3","text":"What is it?","jump":null},{"id":"m_ex_novel_02_4","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_4","text":"I, touched, Exia's gaming console, today,","jump":null},{"id":"m_ex_novel_02_5","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_5","text":"and her, game file, disappeared.","jump":null},{"id":"m_ex_novel_02_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_6","text":"Does Exia know?","jump":null},{"id":"m_ex_novel_02_7","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_7","text":"No, not yet,,,","jump":null},{"id":"m_ex_novel_02_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_8","text":"Does it not show up on the main screen?","jump":null},{"id":"m_ex_novel_02_9","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_9","text":"No,","jump":null},{"id":"m_ex_novel_02_10","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_10","text":"there's, nothing.","jump":null},{"id":"m_ex_novel_02_11","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_11","text":"If Exia finds out,","jump":null},{"id":"m_ex_novel_02_12","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_12","text":"I'm done for,,,","jump":null},{"id":"m_ex_novel_02_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_13","text":"Most, likely,,,","jump":null},{"id":"m_ex_novel_02_14","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_14","text":"Why are you, imitating me,,,","jump":null},{"id":"m_ex_novel_02_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_15","text":"Cause it, looks like fun,,,","jump":null},{"id":"m_ex_novel_02_16","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_16","text":"This is, serious, Watson!","jump":null},{"id":"m_ex_novel_02_17","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_17","text":"Just download the game again.","jump":"m_ex_novel_02_19"},{"id":"m_ex_novel_02_18","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_18","text":"Just pretend you know nothing about it.","jump":"m_ex_novel_02_21"},{"id":"m_ex_novel_02_19","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_19","text":"This is the first time, I've ever handled a game console,","jump":null},{"id":"m_ex_novel_02_20","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_20","text":"I have no, idea how to download, games.","jump":"m_ex_novel_02_23"},{"id":"m_ex_novel_02_21","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_21","text":"But, I already, told Exia,","jump":null},{"id":"m_ex_novel_02_22","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_22","text":"that I would use, her, game console,,,","jump":null},{"id":"m_ex_novel_02_23","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_23","text":"Exia, is, coming back, soon,,,","jump":null},{"id":"m_ex_novel_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_24","text":"Steer clear of her.","jump":null},{"id":"m_ex_novel_02_25","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_25","text":"Watson,,,","jump":null},{"id":"m_ex_novel_02_26","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_26","text":"Watson,,,","jump":null},{"id":"m_ex_novel_02_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_27","text":"What?","jump":null},{"id":"m_ex_novel_02_28","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_28","text":"I can hear, Exia's, foot, steps,,,","jump":null},{"id":"m_ex_novel_02_29","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_29","text":"I just hid, the gaming console,,,","jump":null},{"id":"m_ex_novel_02_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_30","text":"Good job.","jump":null},{"id":"m_ex_novel_02_31","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_02_31","text":"Wat...","jump":null},{"id":"m_ex_novel_02_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_32","text":"??","jump":null},{"id":"m_ex_novel_02_33","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_33","text":"Novel doesn't reply.","jump":null},{"id":"m_ex_novel_02_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_34","text":"Novel??","jump":null},{"id":"m_ex_novel_02_35","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_02_35","text":"A long time passes, and still there are no further messages from Novel.","jump":null}],"chat":true}