{"id":"s004_05","cat":"side","group":{"id":"side4","label":"EDEN SPEAR"},"label":"EDEN SPEAR: 5","stage":null,"prev":"s004_04","next":"s004_06","speakers":{"nayuta_n":"Nayuta","johan":"Johan","cecil":"Cecil"},"icons":{"nayuta_n":"si_c9008_00_s","johan":"si_c925_00_s","cecil":"si_c929_00_s"},"lines":[{"id":"s004_05_1","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_05_1","text":"Nayuta stares at the badly damaged Nihilister, now locked inside the Atlas Cage.","jump":null,"exit":false,"enter":null,"bg":"AtlasCage_02","bgArt":"atlascage_02","image":null,"bgm":"bgm_chapter40_field_turningpoint","movie":null,"shown":["nayuta_n","johan","cecil"],"affinity":null},{"id":"s004_05_2","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_3","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_4","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_4","text":"Ah, I do believe I have come to comprehend the matter at hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_5","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_5","text":"Eden hath long waged an arduous battle against the Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_6","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_6","text":"Yet no unequivocal victor hath emerged, and this weighed upon the heart of Young Hero Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_7","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_7","text":"Thus, he resolved to fashion a model of the shattered Fire Dragon and place it on display, so that by beholding it, he might find solace in the thought that Eden hath prevailed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_8","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_8","text":"Do I look like I have that much free time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_9","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_9","text":"Haha, what then? Dost thou truly intend to aver that this be the true Fire Dragon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_10","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_10","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_11","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_12","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_12","text":"... Dost thou say that this which lies before me is truly","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_13","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_13","text":"the Fire Dragon, Nihilister?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_14","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_14","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_15","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_15","text":"How, verily?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_16","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_16","text":"That's none of your concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_17","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_17","text":"Fix her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_18","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_18","text":"But only enough so she can't go on another rampage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_19","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_20","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_20","text":"Pray tell, what is thy purpose?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_21","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_21","text":"From her condition, it is evident she shall soon perish of her own accord. Why then dost thou strive so stubbornly to restore her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_22","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_22","text":"Verily, the fewer Heretics there be, the better for our battles yet to come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_23","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_23","text":"My objective is information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_24","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_24","text":"Information that only a Heretic can provide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_25","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_25","text":"What information dost thou seek?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_26","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_26","text":"Isn't it obvious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_27","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_27","text":"The method to capture the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_28","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_28","text":"Dost thou truly believe the Fire Dragon will be forthcoming with that information, verily?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_29","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_29","text":"We have many ways of getting her to talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_30","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_31","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_31","text":"We must also ask about the Queen's location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_32","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_32","text":"We know she's somewhere in space, but we have no idea where exactly. Nor do we know her travel route.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_33","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_33","text":"You don't need to find that out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_34","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_34","text":"Monk will know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_35","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_35","text":"How canst thou be so certain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_36","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_36","text":"That's what you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_37","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_37","text":"It's what you've been doing all this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_38","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_38","text":"When the time comes, you'll tell us yourself. So there's no need to dig into that right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_39","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_39","text":"Verily, thou art well-versed in the craft of using others, as most who hail from Eden are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_40","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_40","text":"Say whatever you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_41","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_41","text":"Enough chit-chat. Get Nihilister fixed, now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_42","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_42","text":"This humble one knows not the method.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_43","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_43","text":"You wouldn't be this relaxed if you didn't know how.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_44","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_44","text":"So you're acting calm because you do know the method, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_45","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_45","text":"Egads!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_46","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_46","text":"Should you come to possess a dear friend, I would extend mine deepest regrets unto them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_47","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_47","text":"That's quite an indirect way to say he has no friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_48","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_48","text":"Such words ought not be spoken before the party concerned, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_49","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_49","text":"... You just did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_50","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_50","text":"Young Lady Cecil, art thou acquainted with the manner whereby Heretics are repaired?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_51","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_51","text":"It's through their nanomachines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_52","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_52","text":"Indeed, 'tis so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_53","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_53","text":"They harness the power born of their core to activate the nanomachines in each part, causing them to proliferate and repair the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_54","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_54","text":"But when the core's very output doth wane, as with this Fire Dragon, the nanomachines cease to heed their commands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_55","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_55","text":"Verily, the core's power must first be restored ere the nanomachines obey to proliferate and repair the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_56","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_56","text":"I know. I believe I taught you that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_57","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_57","text":"Ah, so it is. It seems I had forgotten.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_58","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_58","text":"Each Heretic hath a differing manner by which they restore the power to their core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_59","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_59","text":"Verily, Heretics are sentient beings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_60","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_60","text":"Though the process be unknown, they are said to be a fusion of Nikkes and Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_61","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_61","text":"Just as each sentient being hath their own tastes and preferences,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_62","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_62","text":"so too doth each Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_63","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_63","text":"Then we must figure out exactly what Nihilister prefers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_64","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_64","text":"Young Lady Cecil, hast thou perchance tried oral ingestion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_65","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_65","text":"Oral ingestion? Are you suggesting we place Rapture parts into Nihilister's mouth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_66","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_66","text":"Aye, that is so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_67","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_67","text":"... She didn't even respond to electric shocks. How could she possibly ingest anything orally?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_68","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_68","text":"I have beheld it ere now: the Fire Dragon voraciously devouring Rapture parts with its mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_69","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_69","text":"Verily, mine covert gaze was swiftly discovered, and thus was reduced to a charred lump.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_70","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_71","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_05_71","text":"Cecil uses a robotic arm to bring a Rapture part to Nihilister's mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_72","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_72","text":"Such devoted nursing. Why not spoon-feed her some soup while you're at it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_73","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_73","text":"Quiet. Do you think I want to do this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_74","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_05_74","text":"*Crunch!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_75","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_05_75","text":"*Swallow*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_76","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_76","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_77","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_78","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_05_78","text":"Cecil once again uses the robotic arm to bring Rapture parts to Nihilister's mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_79","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_05_79","text":"*Crunch!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_80","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_05_80","text":"*Swallow*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_81","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_82","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_82","text":"Core output is rising. Slightly, but rising nonetheless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_83","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_83","text":"Unbelievable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_84","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_84","text":"I will authorize full use of all Rapture parts currently secured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_85","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_85","text":"Yes, that's for the best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_86","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_86","text":"How say you? Hath mine humble knowledge been of any aid to thee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_87","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_87","text":"... Fine. I admit it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_88","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_88","text":"Thank you, Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_89","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_89","text":"It will take some time before Nihilister's output stabilizes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_90","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_90","text":"While you wait, perhaps you would like to take a look around Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_91","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_91","text":"Oh, that is indeed a most heartening thing to hear, verily!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_92","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_92","text":"Johan, could you show her around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_93","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_94","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_94","text":"Surely thou dost not intend to cast away the noble benefactor who hath aided thee without first bestowing some token of thanks?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_95","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_95","text":"... Won't it be dangerous if Nihilister were to wake up suddenly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_96","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_96","text":"You know better than anyone what an Atlas Cage is capable of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_97","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_97","text":"It's equipped with monstrous specs: electric shocks, cryo gas, combustible gas, and more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_98","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_98","text":"Should any problems arise, I'll request assistance. There should be ample time for you to return here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_99","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_99","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_100","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_05_100","text":"Stop throwing a tantrum like a child to avoid work you dislike, and behave like an adult.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_101","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_05_101","text":"Hahaha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_05_102","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_05_102","text":"... Follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}