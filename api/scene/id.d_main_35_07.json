{"id":"d_main_35_07","cat":"main","group":{"id":"ch35","label":"Chapter 35 · Conversation"},"label":"Concerns","stage":"35-27 STAGE · Start","prev":"d_main_35_06","next":"d_main_35_08_s","speakers":{"maxwell":"Maxwell","rapi_red":"Rapi","laplace":"Laplace","drake":"Drake","cinderella":"Cinderella","grave_p":"Grave"},"icons":{"maxwell":"si_c102_00_s","rapi_red":"si_c016_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s","cinderella":"si_c511_00_s","grave_p":"si_c514_00_s"},"lines":[{"id":"d_main_35_07_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_1","text":"How has Syuen been?","jump":null,"exit":false,"enter":null,"bg":"Jungle2","bgArt":"jungle2","image":null,"bgm":"bgm_story_marrybad","movie":null,"shown":["laplace","drake","rapi_red","maxwell"],"affinity":null},{"id":"d_main_35_07_2","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_2","text":"In pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_3","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_3","text":"No external injuries, but she still feels the sensation of having a bullet lodged in her skull.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_4","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_4","text":"The test results conclusively showed that there were no abnormalities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_5","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_5","text":"There's really nothing that can be done in terms of treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_6","text":"How about Mihara and Yuni?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_7","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_7","text":"I haven't heard any news about them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_8","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_8","text":"They must be keeping a tight lid on it all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_9","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_9","text":"I can't even find a single lead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_11","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_11","text":"Anyway, back to Syuen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_12","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_12","text":"She's at a real existential crossroads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_13","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_13","text":"The public doesn't know what Syuen did or what punishment she received,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_14","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_14","text":"but the high-ranking officials in the Ark are fully aware.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_15","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_15","text":"Do you know what that means?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_16","text":"That someone new might be running Missilis soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_17","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_17","text":"Precisely. Syuen is being assaulted from all directions,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_18","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_18","text":"and she's hardly in the condition to be warding off threats.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_19","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_19","text":"Her only recourse is to put Matis front and center stage in an attempt to improve her image.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_20","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_20","text":"But we're being kept on a pretty short leash ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_21","text":"Because you're suspected of aiding and abetting the attack against the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_22","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_22","text":"Even if it wasn't intentional, we did draw the Raptures to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_23","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_23","text":"It feels like we've not been in the good books of the higher-ups since that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_24","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_24","text":"The last real operation that we did was teaming up with Absolute to prevent more Raptures from reaching the Ark during the incident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_25","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_25","text":"And even then, we failed to stop Nihilister from gaining access to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_26","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_26","text":"Our reputation as Missilis's strongest squad has lost much of its luster. We're no longer heroes of the Ark, that much is for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_28","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_28","text":"Syuen couldn't have sent you all up here out of the goodness of her heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_29","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_29","text":"Naturally not. She has her own motives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_30","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_30","text":"She's having Matis play a crucial part","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_31","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_31","text":"in one of the most important missions the Ark has ever led; exploring the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_32","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_32","text":"In her mind, this will show people that Matis can still contribute to the cause, and that it's her strong leadership which makes that possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_33","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_33","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_34","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_34","text":"I figured as much. Benevolence is practically a dirty word for Syuen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_35","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_36","text":"How about you guys?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_37","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_37","text":"What about us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_38","text":"How are you holding up, what with everything that's happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_39","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_39","text":"We...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_40","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_07_40","text":"Would you like a heroic snack, Drake?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_41","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_07_41","text":"Hmph, your so-called \"heroic snacks\" are nothing more than artery-clogging junk food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_42","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_07_42","text":"Try this high-protein, low-calorie villainous snack. I brought plenty to share.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_43","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_07_43","text":"But they taste awful...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_44","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_07_44","text":"You fool! Anyone who prioritizes taste over health can't call themselves a hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_45","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_07_45","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_46","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_46","text":"How do we look?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_47","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_48","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_48","text":"Healthy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_49","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_49","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_50","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_50","text":"It's a bit of a conundrum for me, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_51","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_51","text":"Those two are special, whereas I'm just a plain, ordinary Nikke. And I get pushed around because of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_52","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_52","text":"So I have a lot on my mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_53","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_53","text":"Have you tried talking to them about Matis's situation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_54","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_54","text":"No. I haven't even brought it up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_55","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_55","text":"They may seem like they have their heads in the clouds, but I wouldn't be so sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_56","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_07_56","text":"Why don't you try talking to them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_57","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_57","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_58","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_58","text":"They're better off living in their own bubbles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_59","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_59","text":"I worry enough for all of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_07_60","text":"What's your next move?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_07_61","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_07_61","text":"I'm a Nikke affiliated with Missilis Industry.","jump"