{"id":"d_counseling_hongryeon_06","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 06","stage":null,"prev":"d_counseling_hongryeon_05","next":"d_counseling_hongryeon_07","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_06_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_1","text":"I met Rapunzel at our regular meeting this month.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_06_2","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_2","text":"She was practically drooling over you, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_3","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_3","text":"What has transpired between the two of you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_06_4","text":"I have become a victim of her fantasy.","jump":"d_counseling_hongryeon_06_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_06_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_06_5","text":"She and I are indulging in a pleasant fantasy.","jump":"d_counseling_hongryeon_06_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_06_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_6","text":"Good heavens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_7","text":"You have truly been put through the wringer, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_8","text":"But alas, that is merely Rapunzel's way of showing affection.","jump":"d_counseling_hongryeon_06_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_9","text":"Yes. Word of you becoming the subject of Rapunzel's fantasy has reached my ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_10","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_10","text":"Have you been enjoying it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_11","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_06_11","text":"My Lord is certainly more... open-minded than I imagined.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_06_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_06_12","text":"I have a conversation with Scarlet about Rapunzel.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}