{"id":"msg_m_ex_underworldqueen_06","cat":"messenger","group":{"id":"room_underworldqueen","label":"Underworld Queen · Group"},"label":"7. Mister!","stage":null,"prev":"msg_m_ex_underworldqueen_05","next":null,"speakers":{"rosanna_s":"Rosanna","sakura_s":"Sakura","moran":"Moran"},"icons":{"rosanna_s":"si_c283_00_s","sakura_s":"si_c284_00_s","moran":"si_c281_00_s"},"lines":[{"id":"m_ex_underworldqueen_06_1","type":"Speech","speaker":"rosanna_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_1","text":"Mister!","jump":null},{"id":"m_ex_underworldqueen_06_2","type":"Speech","speaker":"rosanna_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_2","text":"Remember those photos we took together?","jump":null},{"id":"m_ex_underworldqueen_06_3","type":"Speech","speaker":"rosanna_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_3","text":"I'm going to send them in this group chat, okay?","jump":null},{"id":"m_ex_underworldqueen_06_4","type":"Speech","speaker":"sakura_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_4","text":"I'll DM mine to you.","jump":null},{"id":"m_ex_underworldqueen_06_5","type":"Speech","speaker":"rosanna_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_5","text":"Seriously?","jump":null},{"id":"m_ex_underworldqueen_06_6","type":"Speech","speaker":"rosanna_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_6","text":"I get that they're personal,","jump":null},{"id":"m_ex_underworldqueen_06_7","type":"Speech","speaker":"rosanna_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_7","text":"but I wanna see them too!","jump":null},{"id":"m_ex_underworldqueen_06_8","type":"Speech","speaker":"sakura_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_8","text":"I can't do that.","jump":null},{"id":"m_ex_underworldqueen_06_9","type":"Speech","speaker":"sakura_s","key":"Locale_SuddenMessage:m_ex_underworldqueen_06_9","text":"These photos contain precious memories between {AccountData.NickName}-kun and me.","jump":null},{"i