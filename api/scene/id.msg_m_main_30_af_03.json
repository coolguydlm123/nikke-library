{"id":"msg_m_main_30_af_03","cat":"messenger","group":{"id":"room_six0_s","label":"#000000 · Chat"},"label":"8. Did you bring","stage":null,"prev":"msg_m_main_30_af_02","next":null,"speakers":{"six0":"#000000","liveryn":"Liveryn"},"icons":{"liveryn":"si_c480_00_s"},"lines":[{"id":"m_main_30_af_03_1","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_1","text":"Did you bring","jump":null},{"id":"m_main_30_af_03_2","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_2","text":"what I asked for?","jump":null},{"id":"m_main_30_af_03_3","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_3","text":"Fragile told me you spoke to her.","jump":null},{"id":"m_main_30_af_03_4","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_4","text":"Well well.","jump":null},{"id":"m_main_30_af_03_5","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_5","text":"I'm surprised.","jump":null},{"id":"m_main_30_af_03_6","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_6","text":"I thought you would be trembling in fear.","jump":null},{"id":"m_main_30_af_03_7","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_7","text":"Yes, I told her everything.","jump":null},{"id":"m_main_30_af_03_8","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_8","text":"What of it?","jump":null},{"id":"m_main_30_af_03_9","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_9","text":"I pleaded with you not to.","jump":null},{"id":"m_main_30_af_03_10","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_10","text":"Why should I have to listen to a single word you say?","jump":null},{"id":"m_main_30_af_03_11","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_11","text":"Besides,","jump":null},{"id":"m_main_30_af_03_12","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_12","text":"I kept the most important thing from her,","jump":null},{"id":"m_main_30_af_03_13","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_13","text":"so you ought to be thanking me,","jump":null},{"id":"m_main_30_af_03_14","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_14","text":"don't you think?","jump":null},{"id":"m_main_30_af_03_15","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_15","text":"Well.","jump":null},{"id":"m_main_30_af_03_16","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_16","text":"No response?","jump":null},{"id":"m_main_30_af_03_17","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_17","text":"Don't you have anything to say?","jump":null},{"id":"m_main_30_af_03_18","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_18","text":"... Thank you.","jump":null},{"id":"m_main_30_af_03_19","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_19","text":"Good.","jump":null},{"id":"m_main_30_af_03_20","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_20","text":"That's better.","jump":null},{"id":"m_main_30_af_03_21","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_21","text":"I'm quite disappointed in you.","jump":null},{"id":"m_main_30_af_03_22","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_22","text":"In exchange for keeping a big secret,","jump":null},{"id":"m_main_30_af_03_23","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_23","text":"I asked for one small favor,","jump":null},{"id":"m_main_30_af_03_24","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_24","text":"and you couldn't even do that.","jump":null},{"id":"m_main_30_af_03_25","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_25","text":"The search mission was too dangerous.","jump":null},{"id":"m_main_30_af_03_26","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_26","text":"That's not my concern.","jump":null},{"id":"m_main_30_af_03_27","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_27","text":"I figured this might happen, but I must admit,","jump":null},{"id":"m_main_30_af_03_28","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_28","text":"I still have a soft spot for you.","jump":null},{"id":"m_main_30_af_03_29","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_29","text":"So I'll forgive you for failing me on this search.","jump":null},{"id":"m_main_30_af_03_30","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_30","text":"For not responding immediately to my message.","jump":null},{"id":"m_main_30_af_03_31","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_31","text":"For talking back to me.","jump":null},{"id":"m_main_30_af_03_32","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_32","text":"I'm even going to give you one more chance to make it up to me.","jump":null},{"id":"m_main_30_af_03_33","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_33","text":"Thank you.","jump":null},{"id":"m_main_30_af_03_34","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_34","text":"One hour later.","jump":null},{"id":"m_main_30_af_03_35","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_35","text":"A fire is going to break out in the detention center shortly.","jump":null},{"id":"m_main_30_af_03_36","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_36","text":"You'll be able to escape","jump":null},{"id":"m_main_30_af_03_37","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_37","text":"in the ensuing pandemonium.","jump":null},{"id":"m_main_30_af_03_38","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_38","text":"What?","jump":null},{"id":"m_main_30_af_03_39","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_39","text":"Once you're out,","jump":null},{"id":"m_main_30_af_03_40","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_40","text":"I want you to bring me the one thing you got from the search mission.","jump":null},{"id":"m_main_30_af_03_41","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_41","text":"But there's nothing left from the expedition...","jump":null},{"id":"m_main_30_af_03_42","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_42","text":"Yes, there is.","jump":null},{"id":"m_main_30_af_03_43","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_43","text":"Her head.","jump":null},{"id":"m_main_30_af_03_44","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:m_main_30_af_03_44","text":"You mean...","jump":null},{"id":"m_main_30_af_03_45","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_45","text":"Yes, Hammering's head.","jump":null},{"id":"m_main_30_af_03_46","type":"Speech","speaker":"six0","key":"Locale_MainScenario:m_main_30_af_03_46","text":"Bring it to me.","jump":null}],"chat":true}