null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_03_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_03_03_14","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_03_15","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_03_15","text":"Hell if I know. They told us to bring him in a few months ago, but never told us why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_03_16","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_03_03_16","text":"Is there anything about him that stands out? Any previous engagements?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_03_17","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_03_17","text":"I know as much as you do. I've never actually seen him myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_03_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_03_03_18","text":"Jeez, this is gonna be like finding a needle in an ocean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_03_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_03_03_19","text":"Don't you mean a nail in a haystack?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_03_20","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_03_03_20","text":"It's a needle in a haystack, you morons.","jump":null,"exit":false,